        {
          "id": "6482093",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<div class=\"ldi-v2\">\n<section class=\"section section-courses\">\n      <div class=\"container\">\n        <h2 class=\"section-heading text-center\">Qualifications that expand what you treat</h2>\n        <div class=\"course-grid\">\n          <a class=\"course-card\" href=\"#\"><img src=\"https://media.londondentalinstitute.com/wp-content/uploads/2026/07/16020016/course-1.png\"\n              alt=\"Diploma in Orthodontics & Dentofacial Orthopaedics\" /></a>\n          <a class=\"course-card\" href=\"#\"><img src=\"https://media.londondentalinstitute.com/wp-content/uploads/2026/07/16020023/course-2.png\"\n              alt=\"Diploma in Aesthetic & Restorative Dentistry\" /></a>\n          <a class=\"course-card\" href=\"#\"><img src=\"https://media.londondentalinstitute.com/wp-content/uploads/2026/07/16020025/course-3.png\"\n              alt=\"Diploma in Dental Implantology & Oral Surgery\" /></a>\n        </div>\n      </div>\n    </section>\n</div>"
          },
