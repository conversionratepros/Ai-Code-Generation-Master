        "_title": "LDI V2 · hero"
      },
      "elements": [
        {
          "id": "2434eae",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<div class=\"ldi-v2\">\n<section class=\"section section-hero\" id=\"hero\">\n      <div class=\"hero-panel\">\n        <div class=\"hero-content\">\n          <div class=\"hero-copy\">\n            <span class=\"eyebrow\">Postgraduate Dental Courses</span>\n            <h1 class=\"hero-heading\">Take on more of the cases you currently refer out</h1>\n            <p class=\"body-text\">\n              The London Dental Institute gives you the knowledge, skills and confidence to expand what you treat,\n              through UK-accredited postgraduate training delivered online and studied without stepping away from\n              practice.\n            </p>\n          </div>\n          <div class=\"hero-actions\">\n            <a href=\"#form-section\" class=\"btn btn-primary open-register\">\n              Register your interest\n              <svg class=\"btn-arrow\" width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" fill=\"none\">\n                <path d=\"M3 9h11M9.5 4.5L14 9l-4.5 4.5\" stroke=\"currentColor\" stroke-width=\"1.8\"\n                  stroke-linecap=\"round\" stroke-linejoin=\"round\" />\n              </svg>\n            </a>\n            <blockquote class=\"hero-quote\">\n              <p>“I could not take a step back, so the online environment was perfect for me.”</p>\n              <cite>Dr Mark Travis · United Kingdom | PG Dip. Graduate</cite>\n            </blockquote>\n          </div>\n        </div>\n      </div>\n      <div class=\"hero-image\">\n        <img src=\"https://media.londondentalinstitute.com/wp-content/uploads/2026/07/16020029/hero.jpg\" alt=\"Dentist reviewing a patient's dental X-ray\" />\n      </div>\n    </section>\n</div>"
          },
          "elements": []
        }
      ]
    },
    {
      "id": "c0f72ba",
      "elType": "container",
      "isInner": false,
      "settings": {
        "content_width": "full",
        "flex_direction": "column",
