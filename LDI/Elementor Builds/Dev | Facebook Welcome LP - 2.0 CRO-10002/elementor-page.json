        {
          "id": "dd0838e",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<div class=\"ldi-v2\">\n<header class=\"site-header\">\n    <div class=\"header-inner\">\n      <a href=\"#\" class=\"logo-wrap\">\n        <img src=\"https://media.londondentalinstitute.com/wp-content/uploads/2026/07/16020030/logo.png\" alt=\"London Dental Institute\" class=\"logo\" />\n      </a>\n      <div class=\"google-badge\">\n        <span class=\"g-icon\" aria-hidden=\"true\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\">\n            <path fill=\"#4285F4\" d=\"M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.7-2.4 3.6v3h3.9c2.3-2.1 3.5-5.2 3.5-8.8z\"/>\n            <path fill=\"#34A853\" d=\"M12 24c3.2 0 5.9-1.1 7.9-2.9l-3.9-3c-1.1.7-2.4 1.2-4 1.2-3.1 0-5.7-2.1-6.6-4.9H1.4v3.1C3.4 21.4 7.4 24 12 24z\"/>\n            <path fill=\"#FBBC05\" d=\"M5.4 14.4c-.2-.7-.4-1.4-.4-2.4s.1-1.6.4-2.4V6.5H1.4C.5 8.2 0 10 0 12s.5 3.8 1.4 5.5l4-3.1z\"/>\n            <path fill=\"#EA4335\" d=\"M12 4.8c1.8 0 3.3.6 4.6 1.8l3.4-3.4C17.9 1.2 15.2 0 12 0 7.4 0 3.4 2.6 1.4 6.5l4 3.1C6.3 6.8 8.9 4.8 12 4.8z\"/>\n          </svg>\n        </span>\n        <span class=\"rating\"><strong>4.9</strong> / 5</span>\n        <span class=\"stars\" aria-label=\"4.9 out of 5\">\n          <svg width=\"82\" height=\"16\" viewBox=\"0 0 82 16\" fill=\"#FBBC05\">\n            <path d=\"M8 0l2.2 4.9L15.5 5.5l-3.9 3.6.9 5.4L8 11.9 3.5 14.5l.9-5.4L.5 5.5l5.3-.6z\"/>\n            <path d=\"M28.5 0l2.2 4.9L36 5.5l-3.9 3.6.9 5.4-4.5-2.6L24 14.5l.9-5.4L21 5.5l5.3-.6z\"/>\n            <path d=\"M49 0l2.2 4.9 5.3.6-3.9 3.6.9 5.4L49 11.9l-4.5 2.6.9-5.4-3.9-3.6 5.3-.6z\"/>\n            <path d=\"M69.5 0l2.2 4.9 5.3.6-3.9 3.6.9 5.4-4.5-2.6L65 14.5l.9-5.4L62 5.5l5.3-.6z\"/>\n          </svg>\n        </span>\n      </div>\n    </div>\n  </header>\n</div>"
          },
          "elements": []
        }
      ]
