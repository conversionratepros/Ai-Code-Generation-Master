        "_title": "LDI V2 · benefits"
      },
      "elements": [
        {
          "id": "e12191c",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<div class=\"ldi-v2\">\n<section class=\"section section-benefits\">\n      <div class=\"container\">\n        <h2 class=\"section-heading text-center\">Why dentists choose LDI</h2>\n        <div class=\"benefit-grid\">\n          <div class=\"benefit-card\">\n            <span class=\"benefit-icon\" aria-hidden=\"true\">\n              <svg width=\"40\" height=\"40\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2b5e7d\" stroke-width=\"1.5\"\n                stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                <path d=\"M12 2l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V5l7-3z\" />\n                <path d=\"M9 12l2 2 4-4\" />\n              </svg>\n            </span>\n            <h3 class=\"benefit-title\">UK-accredited qualifications</h3>\n            <p class=\"body-text\">Recognised credentials that expand the cases you can treat</p>\n          </div>\n          <div class=\"benefit-card\">\n            <span class=\"benefit-icon\" aria-hidden=\"true\">\n              <svg width=\"40\" height=\"40\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2b5e7d\" stroke-width=\"1.5\"\n                stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                <circle cx=\"9\" cy=\"8\" r=\"3.2\" />\n                <path d=\"M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6\" />\n                <path d=\"M16 5.2a3 3 0 010 5.6M17.5 14.4c2.6.5 4 2.6 4 5.6\" />\n              </svg>\n            </span>\n            <h3 class=\"benefit-title\">Taught by expert faculty</h3>\n            <p class=\"body-text\">Specialists and experienced clinicians from around the world</p>\n          </div>\n          <div class=\"benefit-card\">\n            <span class=\"benefit-icon\" aria-hidden=\"true\">\n              <svg width=\"40\" height=\"40\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2b5e7d\" stroke-width=\"1.5\"\n                stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                <circle cx=\"12\" cy=\"12\" r=\"9.5\" />\n                <path d=\"M2.5 12h19M12 2.5c2.7 2.6 4.2 6 4.2 9.5s-1.5 6.9-4.2 9.5c-2.7-2.6-4.2-6-4.2-9.5S9.3 5.1 12 2.5z\" />\n              </svg>\n            </span>\n            <h3 class=\"benefit-title\">Global dental network</h3>\n            <p class=\"body-text\">A worldwide community of dentists and faculty</p>\n          </div>\n        </div>\n      </div>\n    </section>\n</div>"
          },
          "elements": []
        }
      ]
    },
    {
      "id": "19230a1",
      "elType": "container",
      "isInner": false,
      "settings": {
