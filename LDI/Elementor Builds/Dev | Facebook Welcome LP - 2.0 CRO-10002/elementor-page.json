        "_title": "LDI V2 · about"
      },
      "elements": [
        {
          "id": "0d2a49c",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<div class=\"ldi-v2\">\n<section class=\"section section-gray section-about\">\n      <div class=\"container about-grid\">\n        <div class=\"about-image\">\n          <img src=\"https://media.londondentalinstitute.com/wp-content/uploads/2026/07/16020006/about.jpg\" alt=\"London Dental Institute clinicians\" />\n        </div>\n        <div class=\"about-text\">\n          <h2 class=\"section-heading\">Who we are</h2>\n          <p class=\"body-text\">\n            The London Dental Institute delivers flexible, fully online postgraduate education for dentists around the\n            world. Our UK-accredited programmes combine expert-led teaching, interactive modules and clinical simulation\n            kits, helping dentists build confidence, advance their clinical skills and treat more cases in-house.\n            Through a global network of dentists and faculty, we make postgraduate dental education accessible to\n            working clinicians wherever they practice.\n          </p>\n          <a href=\"#form-section\" class=\"btn btn-primary open-register\">\n            Register your interest\n            <svg class=\"btn-arrow\" width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" fill=\"none\">\n              <path d=\"M3 9h11M9.5 4.5L14 9l-4.5 4.5\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"\n                stroke-linejoin=\"round\" />\n            </svg>\n          </a>\n        </div>\n      </div>\n    </section>\n</div>"
          },
          "elements": []
        }
      ]
    },
    {
      "id": "72dd41f",
      "elType": "container",
      "isInner": false,
      "settings": {
        "content_width": "full",
        "flex_direction": "column",
