        {
          "id": "80bb859",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<div class=\"ldi-v2\">\n<section class=\"section section-testimonials\">\n      <div class=\"container\">\n        <div class=\"section-heading-wrap text-center\">\n          <span class=\"eyebrow\">Testimonials from recent graduates</span>\n          <h2 class=\"section-heading\">What graduates say about studying with us</h2>\n        </div>\n        <div class=\"testimonial-grid\">\n          <a class=\"testimonial-card\" href=\"#\"><img src=\"https://media.londondentalinstitute.com/wp-content/uploads/2026/07/16020033/testimonial-1.png\"\n              alt=\"Dr. Mark Travis testimonial\" /></a>\n          <a class=\"testimonial-card\" href=\"#\"><img src=\"https://media.londondentalinstitute.com/wp-content/uploads/2026/07/16020037/testimonial-2.png\"\n              alt=\"Dr. Thabo Travis testimonial\" /></a>\n          <a class=\"testimonial-card\" href=\"#\"><img src=\"https://media.londondentalinstitute.com/wp-content/uploads/2026/07/16020040/testimonial-3.png\"\n              alt=\"Dr. Muchaneta Vipvahene testimonial\" /></a>\n        </div>\n      </div>\n    </section>\n</div>"
