        },
        "_title": "LDI V2 · modal"
      },
      "elements": [
        {
          "id": "0508c6c",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<div class=\"ldi-v2\">\n<div class=\"modal-overlay\" id=\"register-modal\" aria-hidden=\"true\">\n    <div class=\"modal-dialog\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"register-modal-title\">\n      <button class=\"modal-close\" type=\"button\" aria-label=\"Close\" data-close-modal>\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" fill=\"none\">\n          <path d=\"M2 2L16 16M16 2L2 16\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" />\n        </svg>\n      </button>\n      <div class=\"modal-body\">\n        <div class=\"modal-head\">\n          <span class=\"eyebrow\">Register your interest</span>\n          <h2 class=\"section-heading\" id=\"register-modal-title\">Fill in your details below and we'll send you\n            everything you need to get started</h2>\n        </div>\n        <!-- ═══ Gravity Form 41 ═══\n             In the WordPress/Elementor build, drop this shortcode into a Shortcode widget\n             (or use the Gravity Forms widget → Form 41) inside the popup.\n             Renders the live form and saves submissions to Forms → Entries.\n             Field map: input_1 = First Name · input_3 = Last Name · input_2 = Email ·\n                        input_5.1 = \"I am a registered dental professional *\" checkbox\n             Note: shortcodes only render inside WordPress — the local preview shows the code as text. -->\n        <div class=\"modal-form gf-embed\">\n          [gravityform id=\"41\" title=\"false\" description=\"false\" ajax=\"true\"]\n        </div>\n      </div>\n    </div>\n  </div>\n\n<script>\n    // ─── Register modal ───────────────────────────────────────────────\n    (function () {\n      const modal = document.getElementById('register-modal');\n      let lastFocused = null;\n\n      function openModal(e) {\n        if (e) e.preventDefault();\n        lastFocused = document.activeElement;\n        modal.classList.add('is-open');\n        modal.setAttribute('aria-hidden', 'false');\n        document.body.style.overflow = 'hidden';\n      }\n\n      function closeModal() {\n        modal.classList.remove('is-open');\n        modal.setAttribute('aria-hidden', 'true');\n        document.body.style.overflow = '';\n        if (lastFocused) lastFocused.focus();\n      }\n\n      document.querySelectorAll('.open-register').forEach(btn => btn.addEventListener('click', openModal));\n      modal.querySelectorAll('[data-close-modal]').forEach(el => el.addEventListener('click', closeModal));\n      // click outside dialog closes\n      modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });\n      // ESC closes\n      document.addEventListener('keydown', e => { if (e.key === 'Escape' && modal.classList.contains('is-open')) closeModal(); });\n    })();\n  </script>\n</div>"
          },
          "elements": []
        }
      ]
    }
