          "settings": {
            "html": "<div class=\"ldi-v2\">\n<section class=\"section section-accreditation\">\n      <div class=\"container accred-grid\">\n        <div class=\"accred-logos\">\n          <img src=\"https://media.londondentalinstitute.com/wp-content/uploads/2026/07/16020010/accreditation.png\" alt=\"EduQual and ADEE accreditation\" />\n        </div>\n        <div class=\"accred-text\">\n          <div class=\"accred-head\">\n            <span class=\"eyebrow\">Accreditation</span>\n            <h2 class=\"section-heading\">Recognised, accredited dental education</h2>\n          </div>\n          <p class=\"body-text\">\n            Our diplomas are accredited by EduQual (Level 7), meeting the quality standards required to provide a\n            globally recognised qualification. LDI is also an institutional member of the Association for Dental\n            Education in Europe, working to raise standards and bring dental education closer together across the region.\n          </p>\n        </div>\n      </div>\n    </section>\n</div>"
