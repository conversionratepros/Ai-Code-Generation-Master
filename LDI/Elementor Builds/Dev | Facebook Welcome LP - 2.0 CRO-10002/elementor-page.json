        "_title": "LDI V2 · study"
      },
      "elements": [
        {
          "id": "65aabe2",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<div class=\"ldi-v2\">\n<section class=\"section section-study\">\n      <div class=\"container study-grid\">\n        <div class=\"study-text\">\n          <div class=\"study-head\">\n            <span class=\"eyebrow\">For the LDI community</span>\n            <h2 class=\"section-heading\">Monthly live webinars</h2>\n          </div>\n          <p class=\"body-text\">\n            Every month our faculty hosts a free, expert-led webinar on an essential topic across the dental\n            specialities, sharing current evidence and practical guidance you can apply straight away. Join the\n            community and experience learning at LDI for yourself.\n          </p>\n          <ul class=\"study-features\">\n            <li><span class=\"feature-check\" aria-hidden=\"true\"></span>Live, expert-led sessions</li>\n            <li><span class=\"feature-check\" aria-hidden=\"true\"></span>Open to the whole community</li>\n            <li><span class=\"feature-check\" aria-hidden=\"true\"></span>No cost to attend</li>\n          </ul>\n          <a href=\"#form-section\" class=\"btn btn-primary open-register\">\n            Register your interest\n            <svg class=\"btn-arrow\" width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" fill=\"none\">\n              <path d=\"M3 9h11M9.5 4.5L14 9l-4.5 4.5\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"\n                stroke-linejoin=\"round\" />\n            </svg>\n          </a>\n        </div>\n        <div class=\"study-image\">\n          <img src=\"https://media.londondentalinstitute.com/wp-content/uploads/2026/07/16020031/studyclubs.jpg\" alt=\"LDI faculty presenting a live webinar\" />\n        </div>\n      </div>\n    </section>\n</div>"
          },
          "elements": []
        }
      ]
    },
    {
      "id": "cf03b1c",
      "elType": "container",
      "isInner": false,
      "settings": {
