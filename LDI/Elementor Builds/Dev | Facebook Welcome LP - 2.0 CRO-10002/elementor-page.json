          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<div class=\"ldi-v2\">\n<section class=\"section section-form\" id=\"form-section\">\n      <div class=\"container form-grid\">\n        <div class=\"form-text\">\n          <div class=\"form-head\">\n            <span class=\"eyebrow\">Get Started</span>\n            <h2 class=\"section-heading\">Register your interest and we'll send you the details</h2>\n          </div>\n          <!-- TODO: replace action / wire to WP form plugin shortcode on build -->\n          <form class=\"register-form\" action=\"#\" method=\"POST\">\n            <div class=\"form-row\">\n              <div class=\"form-group\">\n                <label for=\"first-name\">First Name:*</label>\n                <input type=\"text\" id=\"first-name\" name=\"first_name\" required />\n              </div>\n              <div class=\"form-group\">\n                <label for=\"last-name\">Last Name:*</label>\n                <input type=\"text\" id=\"last-name\" name=\"last_name\" required />\n              </div>\n            </div>\n            <div class=\"form-group\">\n              <label for=\"email\">Email Address:*</label>\n              <input type=\"email\" id=\"email\" name=\"email\" required />\n            </div>\n            <label class=\"checkbox-row\">\n              <input type=\"checkbox\" name=\"is_professional\" required />\n              <span>I am a registered dental professional *</span>\n            </label>\n            <button type=\"submit\" class=\"btn btn-primary\">\n              Register your interest\n              <svg class=\"btn-arrow\" width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" fill=\"none\">\n                <path d=\"M3 9h11M9.5 4.5L14 9l-4.5 4.5\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"\n                  stroke-linejoin=\"round\" />\n              </svg>\n            </button>\n            <p class=\"form-disclaimer\">\n              By registering, you consent to receive future communications from us in accordance with our Privacy\n              Policy.\n            </p>\n          </form>\n        </div>\n        <div class=\"form-image\">\n          <img src=\"https://media.londondentalinstitute.com/wp-content/uploads/2026/07/16020028/form.jpg\" alt=\"LDI clinical simulation kit\" />\n        </div>\n      </div>\n    </section>\n</div>"
