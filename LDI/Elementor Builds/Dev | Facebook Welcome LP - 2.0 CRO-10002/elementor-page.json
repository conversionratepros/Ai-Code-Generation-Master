        "_title": "LDI V2 · usp"
      },
      "elements": [
        {
          "id": "64645ed",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<div class=\"ldi-v2\">\n<section class=\"section section-usp\">\n      <div class=\"container\">\n        <div class=\"usp-header\">\n          <h2 class=\"section-heading text-center\">Can you really learn dentistry online?</h2>\n          <p class=\"body-text text-center usp-sub\">\n            Yes. Our programmes pair online study with hands-on clinical training and direct support from tutors.\n          </p>\n        </div>\n        <div class=\"benefit-grid\">\n          <div class=\"benefit-card\">\n            <span class=\"benefit-icon\" aria-hidden=\"true\">\n              <svg width=\"40\" height=\"40\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2b5e7d\" stroke-width=\"1.5\"\n                stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                <rect x=\"2.5\" y=\"4\" width=\"19\" height=\"13\" rx=\"1.5\" />\n                <path d=\"M8 21h8M12 17v4\" />\n              </svg>\n            </span>\n            <h3 class=\"benefit-title\">A learning environment built for clinicians</h3>\n            <p class=\"body-text\">Study anytime, anywhere.</p>\n          </div>\n          <div class=\"benefit-card\">\n            <span class=\"benefit-icon\" aria-hidden=\"true\">\n              <svg width=\"40\" height=\"40\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2b5e7d\" stroke-width=\"1.5\"\n                stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                <path d=\"M4 4h12a2 2 0 012 2v6a2 2 0 01-2 2H9l-4 3v-3H4a2 2 0 01-2-2V6a2 2 0 012-2z\" />\n                <path d=\"M7 8h6M7 11h4\" />\n              </svg>\n            </span>\n            <h3 class=\"benefit-title\">1:1 clinical case mentoring</h3>\n            <p class=\"body-text\">Expert guidance on real cases.</p>\n          </div>\n          <div class=\"benefit-card\">\n            <span class=\"benefit-icon\" aria-hidden=\"true\">\n              <svg width=\"40\" height=\"40\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2b5e7d\" stroke-width=\"1.5\"\n                stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                <path d=\"M12 3c3 0 5 2 5 5 0 2-1 3-1 5v2H8v-2c0-2-1-3-1-5 0-3 2-5 5-5z\" />\n                <path d=\"M9 19h6M10 21.5h4\" />\n              </svg>\n            </span>\n            <h3 class=\"benefit-title\">Hands-on clinical simulation kit</h3>\n            <p class=\"body-text\">Practise before treating patients.</p>\n          </div>\n        </div>\n      </div>\n    </section>\n</div>"
          },
          "elements": []
        }
      ]
    },
