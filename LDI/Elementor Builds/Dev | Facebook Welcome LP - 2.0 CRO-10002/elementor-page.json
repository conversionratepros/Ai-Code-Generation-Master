        "_title": "LDI V2 · course-benefit"
      },
      "elements": [
        {
          "id": "956b02c",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<div class=\"ldi-v2\">\n<section class=\"section section-course-benefit\">\n      <div class=\"container\">\n        <h2 class=\"section-heading text-center\">How LDI helps you treat more of your own cases</h2>\n        <div class=\"cb-grid\">\n          <div class=\"cb-item\">\n            <span class=\"cb-check\" aria-hidden=\"true\"></span>\n            <p class=\"body-text\">Get going from day one with <strong>1:1 clinical support</strong> from our tutor team</p>\n          </div>\n          <div class=\"cb-item\">\n            <span class=\"cb-check\" aria-hidden=\"true\"></span>\n            <p class=\"body-text\">Learn through <strong>clinically-directed teaching</strong> on the cases you'll actually\n              treat</p>\n          </div>\n          <div class=\"cb-item\">\n            <span class=\"cb-check\" aria-hidden=\"true\"></span>\n            <p class=\"body-text\">Build skills on real cases with <strong>hands-on practical training</strong></p>\n          </div>\n          <div class=\"cb-item\">\n            <span class=\"cb-check\" aria-hidden=\"true\"></span>\n            <p class=\"body-text\">Apply an <strong>evidence-based approach</strong> grounded in current clinical practice</p>\n          </div>\n          <div class=\"cb-item\">\n            <span class=\"cb-check\" aria-hidden=\"true\"></span>\n            <p class=\"body-text\"><strong>Reduce referrals</strong> and keep more cases in-house</p>\n          </div>\n          <div class=\"cb-item\">\n            <span class=\"cb-check\" aria-hidden=\"true\"></span>\n            <p class=\"body-text\">Build a <strong>stronger, more sustainable</strong> practice by keeping high-value work in\n              your own chair</p>\n          </div>\n        </div>\n      </div>\n    </section>\n</div>"
          },
          "elements": []
        }
      ]
    },
    {
      "id": "2e5128d",
      "elType": "container",
      "isInner": false,
      "settings": {
        "content_width": "full",
        "flex_direction": "column",
        "padding": {
