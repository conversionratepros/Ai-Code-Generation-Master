      "elements": [
        {
          "id": "c78257a",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<div class=\"ldi-v2\">\n<section class=\"section section-demo\">\n      <div class=\"container demo-grid\">\n        <div class=\"demo-text\">\n          <div class=\"demo-head\">\n            <span class=\"eyebrow eyebrow-light\">Free 2-Minute Demo</span>\n            <h2 class=\"section-heading demo-heading\">See what it's like to study at London Dental Institute</h2>\n          </div>\n          <p class=\"body-text demo-body\">\n            Take a guided tour inside our Virtual Learning Environment and see exactly how you'll learn. Explore the\n            modules, clinical demos, 1:1 case support and global community before you enrol.\n          </p>\n          <form class=\"demo-form\" action=\"#\" method=\"POST\">\n            <div class=\"demo-inputs\">\n              <input type=\"text\" name=\"name\" placeholder=\"Enter your name\" required />\n              <input type=\"email\" name=\"email\" placeholder=\"Enter your email address\" required />\n            </div>\n            <button type=\"submit\" class=\"btn btn-purple btn-full\">\n              Send me the demo\n              <svg class=\"btn-arrow\" width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" fill=\"none\">\n                <path d=\"M3 9h11M9.5 4.5L14 9l-4.5 4.5\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"\n                  stroke-linejoin=\"round\" />\n              </svg>\n            </button>\n          </form>\n          <div class=\"demo-note\">\n            <svg width=\"19\" height=\"19\" viewBox=\"0 0 20 20\" fill=\"none\">\n              <circle cx=\"10\" cy=\"10\" r=\"9\" stroke=\"rgba(255,255,255,.5)\" stroke-width=\"1.3\" />\n              <path d=\"M6 10l2.5 2.5L14 7\" stroke=\"#bfe0f0\" stroke-width=\"1.6\" stroke-linecap=\"round\"\n                stroke-linejoin=\"round\" />\n            </svg>\n            <span>No commitment, just a look inside.</span>\n          </div>\n        </div>\n        <div class=\"demo-visual\">\n          <img src=\"https://media.londondentalinstitute.com/wp-content/uploads/2026/07/16020027/demo-vle.png\" alt=\"Inside the LDI Virtual Learning Environment\" />\n        </div>\n      </div>\n    </section>\n</div>"
          },
          "elements": []
        }
      ]
    },
