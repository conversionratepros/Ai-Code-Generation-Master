{%- style -%}
  .as-seen-on {
    background-color: var(--asos-bg-color);
    padding: 20px 20px 40px;
    text-align: center;
  }

  .as-seen-on__heading {
    font-family: 'Montserrat', sans-serif;
    font-weight: 400;
    font-size: 16px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--asos-heading-color);
    margin: 0 0 20px;
  }

  /* Mobile: horizontally scrollable row */
  .as-seen-on__logos {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 32px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .as-seen-on__logos::-webkit-scrollbar {
    display: none;
  }

  .as-seen-on__logo-item {
    flex: 0 0 120px;
    height: 40px;
    scroll-snap-align: start;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .as-seen-on__logo-item img {
    width: 120px;
    height: 40px;
    object-fit: contain;
    display: block;
  }

  /* Desktop: 6-column grid */
  @media screen and (min-width: 750px) {
    .as-seen-on {
      padding: 48px 140px;
    }

    .as-seen-on__heading {
      font-size: 24px;
      margin-bottom: 64px;
    }

    .as-seen-on__logos {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 24px;
      overflow-x: visible;
      scroll-snap-type: none;
      justify-items: center;
    }

    .as-seen-on__logo-item {
      flex: unset;
      width: 100%;
      height: 40px;
    }

    .as-seen-on__logo-item img {
      width: 100%;
      max-width: 120px;
      height: 40px;
    }
  }
{%- endstyle -%}

<div
  class="as-seen-on"
  style="
    --asos-bg-color: {{ section.settings.background_color }};
    --asos-heading-color: {{ section.settings.heading_color }};
  "
>
  {%- if section.settings.heading != blank -%}
    <h2 class="as-seen-on__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="as-seen-on__logos">
      {%- for block in section.blocks -%}
        {%- if block.settings.logo != blank -%}
          <div class="as-seen-on__logo-item" {{ block.shopify_attributes }}>
            {{
              block.settings.logo
              | image_url: width: 240
              | image_tag:
                loading: 'lazy',
                alt: ''
            }}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "As Seen On Logos",
  "tag": "section",
  "class": "section-as-seen-on",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "As Seen On"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour",
      "default": "#0e0e0e"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background colour",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "As Seen On Logos",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
