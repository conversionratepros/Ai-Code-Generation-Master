{%- style -%}
  .expandable-buybox {
    border: 1px solid var(--buybox-border-color);
    background-color: var(--buybox-bg-color);
  }

  .expandable-buybox__item {
    border-bottom: 1px solid var(--buybox-border-color);
  }

  .expandable-buybox__item:last-child {
    border-bottom: none;
  }

  .expandable-buybox__trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 48px;
    padding: 12px 16px;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    gap: 12px;
  }

  .expandable-buybox__heading {
    font-family: 'Nunito', sans-serif;
    font-weight: 500;
    font-size: 14px;
    line-height: 1.4;
    color: var(--buybox-heading-color);
  }

  .expandable-buybox__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    color: var(--buybox-heading-color);
  }

  .expandable-buybox__icon .icon-minus {
    display: none;
  }

  .expandable-buybox__item.is-open .expandable-buybox__icon .icon-plus {
    display: none;
  }

  .expandable-buybox__item.is-open .expandable-buybox__icon .icon-minus {
    display: block;
  }

  .expandable-buybox__content {
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.3s ease;
  }

  .expandable-buybox__item.is-open .expandable-buybox__content {
    max-height: 600px;
  }

  .expandable-buybox__content-inner {
    padding: 0 16px 16px;
    font-family: 'Nunito', sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 1.7;
    color: var(--buybox-content-color);
  }

  .expandable-buybox__content-inner p {
    margin: 0 0 4px;
  }

  .expandable-buybox__content-inner p:last-child {
    margin-bottom: 0;
  }
{%- endstyle -%}

<div
  class="expandable-buybox"
  style="
    --buybox-heading-color: {{ section.settings.heading_color }};
    --buybox-content-color: {{ section.settings.content_color }};
    --buybox-border-color: {{ section.settings.border_color }};
    --buybox-bg-color: {{ section.settings.background_color }};
  "
>
  {%- for block in section.blocks -%}
    <div
      class="expandable-buybox__item{% if forloop.first %} is-open{% endif %}"
      {{ block.shopify_attributes }}
    >
      <button
        class="expandable-buybox__trigger"
        aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
        aria-controls="buybox-content-{{ block.id }}"
      >
        <span class="expandable-buybox__heading">{{ block.settings.heading }}</span>
        <span class="expandable-buybox__icon" aria-hidden="true">
          <svg class="icon-plus" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M8 2V14M2 8H14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <svg class="icon-minus" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M2 8H14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </span>
      </button>
      <div
        id="buybox-content-{{ block.id }}"
        class="expandable-buybox__content"
        role="region"
        aria-labelledby="buybox-trigger-{{ block.id }}"
      >
        <div class="expandable-buybox__content-inner">
          {{ block.settings.content }}
        </div>
      </div>
    </div>
  {%- endfor -%}
</div>

<script>
  (function () {
    var container = document.querySelector('.expandable-buybox');
    if (!container) return;

    var items = Array.prototype.slice.call(container.querySelectorAll('.expandable-buybox__item'));

    items.forEach(function (item) {
      var trigger = item.querySelector('.expandable-buybox__trigger');

      trigger.addEventListener('click', function () {
        var isOpen = item.classList.contains('is-open');

        // Close all items
        items.forEach(function (i) {
          i.classList.remove('is-open');
          i.querySelector('.expandable-buybox__trigger').setAttribute('aria-expanded', 'false');
        });

        // If the clicked item was closed, open it
        if (!isOpen) {
          item.classList.add('is-open');
          trigger.setAttribute('aria-expanded', 'true');
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Expandable Buy Box",
  "tag": "section",
  "class": "section-expandable-buybox",
  "settings": [
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour",
      "default": "#0e0e0e"
    },
    {
      "type": "color",
      "id": "content_color",
      "label": "Content colour",
      "default": "#404040"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border colour",
      "default": "#e3e3e3"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background colour",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "accordion_item",
      "name": "Accordion item",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Accordion heading"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Add your accordion content here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Expandable Buy Box",
      "blocks": [
        {
          "type": "accordion_item",
          "settings": {
            "heading": "Shipping",
            "content": "<p>Free shipping on orders over R5000. Standard delivery: 1-3 business days nationwide. Express: [X-X] business days (+ R[X]).</p>"
          }
        },
        {
          "type": "accordion_item",
          "settings": {
            "heading": "Returns & Refund",
            "content": "<p>Add your returns and refund policy here.</p>"
          }
        },
        {
          "type": "accordion_item",
          "settings": {
            "heading": "Secure Payment",
            "content": "<p>Add your secure payment details here.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
