{% if section.blocks.size > 0 %}
  <div class="pdp-bundle__top-icons">
    {% for block in section.blocks %}
      {% if block.type == 'trust_item' %}
        <div class="pdp-bundle__top-icon-item" {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}
            <div class="pdp-bundle__top-icon-image">
              <img
                src="{{ block.settings.icon | image_url: width: 80 }}"
                alt="{{ block.settings.text | escape }}"
                loading="lazy"
              >
            </div>
          {% endif %}

          {% if block.settings.text != blank %}
            <div class="pdp-bundle__top-icon-text">
              {{ block.settings.text }}
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
{% endif %}