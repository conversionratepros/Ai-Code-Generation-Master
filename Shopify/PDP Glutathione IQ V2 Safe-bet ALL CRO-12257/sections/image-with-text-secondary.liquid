{%- assign id = 'section-' | append: section.id -%}

{% render 'section-paddings',
  id: id
  paddingTop: section.settings.padding-top,
  paddingBottom: section.settings.padding-bottom,
  paddingTopMobile: section.settings.padding-top-mobile,
  paddingBottomMobile: section.settings.padding-bottom-mobile
%}

{{ 'component-image-with-text.css' | asset_url | stylesheet_tag }}


{% if section.settings.enable_outer_spacing %}
  <style>
    #section-elem-{{ section.id }} {
      margin-top: {{ section.settings.padding-top-outer | append: 'px' }};
      margin-bottom: {{ section.settings.padding-bottom-outer | append: 'px' }};

      @media screen and (max-width: 999px) {
        margin-top: {{ section.settings.padding-top-mobile-outer | append: 'px' }};
        margin-bottom: {{ section.settings.padding-bottom-mobile | append: 'px' }};
      }
    }
  </style>
{% endif %}

<section class="imw__text" style="background: {{ section.settings.bg_color }};" id="section-elem-{{ section.id }}">
  <div class="c-container">
  
    <div class="imw__text-wrapper_outer {% if section.settings.disable_divider_line == true %}disable-divider{% endif %} {% if section.settings.disable_divider_line_top %}disable-divider-top{% endif %}" id="{{ id }}">
      {% if section.settings.heading != blank %}
        <h2 class="imw__text-main_heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}
      {% if section.settings.subtitle != blank %}
        <div class="imw__text-subtitle">
          {{ section.settings.subtitle }}
        </div>
      {% endif %}
      <div class="imw__text-wrapper type-{{ section.settings.layout_type }}">
        {% for block in section.blocks %}
          {% if block.type == 'image' %}
            {% if block.settings.image != blank %}
            
              <div class="imw__text-image absolute-img {% if section.settings.enable_smaller_image %}is-smaller-image{% endif %} {% if section.settings.enable_extra_smaller_image %}is--extra-smaller-image{% endif %}" {{ block.shopify_attributes }}>
                {% if block.settings.image_mobile != blank %}
                  {% render 'image',
                    image: block.settings.image_mobile,
                    width: 767,
                    widths: '320, 550, 767, 990',
                    fetchpriority: false,
                    loading: 'lazy',
                    class: 'mobile'
                  %}
                {% endif %}
                {% render 'image',
                  image: block.settings.image,
                  width: 1440,
                  widths: '750, 900, 1024, 1440',
                  fetchpriority: false,
                  loading: 'lazy'
                %}
              </div>
            {% endif %}
          {% endif %}
        {% endfor %}
        <div class="imw__text-block">
          {% for block in section.blocks %}
            {% if block.type == 'heading' %}
              {% if block.settings.heading != blank %}
                <h2 class="imw__text-heading {% if block.settings.remove_br_on_mobile %}mob-hide-br{% endif %}" {{ block.shopify_attributes }}>
                  {{ block.settings.heading }}
                </h2>
              {% endif %}
            {% endif %}
          {% endfor %}
          
          <div class="imw__text-block_content {% if section.settings.enable_30px_paddings %}p-30{% endif %} {% if section.settings.enable_20px_paddings %}p-20{% endif %}">
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'content' %}
                  {% if block.settings.content != blank %}
                    <div class="imw__text-content {% if block.settings.smaller_row_spacing == true %}smaller-row-spacing{% endif %}" {{ block.shopify_attributes }}>
                      {{ block.settings.content }}
                    </div>
                  {% endif %}

                {% when 'icon-heading-content' %}
                  {% if block.settings.heading != blank or block.settings.content != blank %}
                    <div class="imw__text-icon_heading-content" {{ block.shopify_attributes }}>
                      <div class="wrap">
                        {% if block.settings.icon != blanl %}
                          <img src="{{ block.settings.icon | image_url: width: 60, height: 60 }}" alt="{{ block.settings.icon.alt }}" width="30" height="30" loading="lazy">
                        {% endif %}
                        {% if block.settings.heading != blank %}
                          <h3 class="imw__text-h">{{ block.settings.heading }}</h3>
                        {% endif %}
                      </div>
                      {% if block.settings.content != blank %}
                        <div class="imw__text-c">{{ block.settings.content }}</div>
                      {% endif %}
                    </div>
                  {% endif %}
                  
              {% endcase %}
            {% endfor %}
          </div>
          {% for block in section.blocks %}
            {% if block.type == 'button' %}
              {% if block.settings.cta_text != blank and block.settings.cta_link != blank %}
                <a href="{{ block.settings.cta_link }}" class="custom-btn" {{ block.shopify_attributes }}>
                  {{ block.settings.cta_text }} 
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <g clip-path="url(#clip0_261_111)">
                    <path d="M1.15137 5.57151H10.8489M10.8489 5.57151L6.0001 0.722778M10.8489 5.57151L6.0001 10.4203" stroke="black" stroke-width="1.28571" stroke-linecap="round" stroke-linejoin="round"/>
                    </g>
                    <defs>
                    <clipPath id="clip0_261_111">
                    <rect width="12" height="11.1429" fill="white"/>
                    </clipPath>
                    </defs>
                  </svg>
                </a>
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Image with text secondary",
    "settings": [
      {
        "type": "select",
        "id": "layout_type",
        "label": "Layout type",
        "options": [
          {
            "value": "image-first",
            "label": "Image first"
          },
          {
            "value": "text-first",
            "label": "Text first"
          },
          {
            "value": "image-second-mob",
            "label": "Image second mobile"
          }
        ],
        "default": "image-first"
      },
      {
        "type": "color",
        "id": "bg_color",
        "label": "Background color"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      },
      {
        "type": "text",
        "id": "subtitle",
        "label": "Subtitle"
      },
      {
        "type": "checkbox",
        "id": "enable_outer_spacing",
        "label": "Enable outer spacing",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "enable_30px_paddings",
        "label": "Enable 30px paddings for the content",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "enable_20px_paddings",
        "label": "Enable 20px paddings for the content",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "enable_smaller_image",
        "label": "Enable smaller image",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "enable_extra_smaller_image",
        "label": "Enable extra smaller image",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "disable_divider_line",
        "label": "Disable divider line bottom",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "disable_divider_line_top",
        "label": "Disable divider line top",
        "default": true
      },
      {
        "type": "range",
        "id": "padding-top",
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px",
        "label": "Padding top desktop",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding-bottom",
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px",
        "label": "Padding bottom desktop",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding-top-mobile",
        "min": 0,
        "max": 70,
        "step": 2,
        "unit": "px",
        "label": "Padding top mobile",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding-bottom-mobile",
        "min": 0,
        "max": 70,
        "step": 2,
        "unit": "px",
        "label": "Padding bottom mobile",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding-top-outer",
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px",
        "label": "Padding top desktop outer",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding-bottom-outer",
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px",
        "label": "Padding bottom desktop outer",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding-top-mobile-outer",
        "min": 0,
        "max": 70,
        "step": 2,
        "unit": "px",
        "label": "Padding top mobile outer",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding-bottom-mobile-outer",
        "min": 0,
        "max": 70,
        "step": 2,
        "unit": "px",
        "label": "Padding bottom mobile outer",
        "default": 0
      }
    ],
    "blocks": [
      {
        "type": "image",
        "name": "Image",
        "limit": 1,
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "image_picker",
            "id": "image_mobile",
            "label": "Image mobile"
          }
        ]
      },
      {
        "name": "Heading",
        "type": "heading",
        "settings": [
          {
            "type": "text",
            "id": "heading",
            "label": "Heading"
          },
          {
            "type": "checkbox",
            "id": "remove_br_on_mobile",
            "label": "Remove br on mobile",
            "default": false
          }
        ]
      },
      {
        "name": "Content",
        "type": "content",
        "settings": [
          {
            "type": "richtext",
            "id": "content",
            "label": "Content",
            "default": "<p></p>"
          },
          {
            "type": "checkbox",
            "id": "smaller_row_spacing",
            "label": "Smaller row spacing",
            "default": false
          }
        ]
      },
      {
        "name": "Icon/Heading/Content",
        "type": "icon-heading-content",
        "settings": [
          {
            "type": "image_picker",
            "id": "icon",
            "label": "Icon"
          },
          {
            "type": "text",
            "id": "heading",
            "label": "Heading"
          },
          {
            "type": "richtext",
            "id": "content",
            "label": "Content",
            "default": "<p></p>"
          }
        ]
      },
      {
        "name": "Button",
        "type": "button",
        "settings": [
          {
            "type": "text",
            "id": "cta_text",
            "label": "CTA Text"
          },
          {
            "type": "url",
            "id": "cta_link",
            "label": "CTA Link"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Image with text secondary"
      }
    ]
  }
{% endschema %}
