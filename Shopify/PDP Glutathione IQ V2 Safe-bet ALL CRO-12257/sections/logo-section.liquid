{{ 'component-logo-section.css' | asset_url | stylesheet_tag }}

{%- assign id = 'section-' | append: section.id -%}

{% render 'section-paddings',
  id: id
  paddingTop: section.settings.padding-top,
  paddingBottom: section.settings.padding-bottom,
  paddingTopMobile: section.settings.padding-top-mobile,
  paddingBottomMobile: section.settings.padding-bottom-mobile
%}

<section class="logo__section" id="{{ id }}" style="background: {{ section.settings.bg_color }};">
  <div class="c-container">
    <div class="logo__section-wrapper">
      <div class="logo__section-text">
        {% if section.settings.heading != blank %}
          <h2 class="logo__section-heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.content != blank %}
          <div class="logo__section-content">{{ section.settings.content }}</div>
        {% endif %}
      </div>
      {% if section.settings.logo != blank %}
        <div class="logo__section-icon">
          <img src="{{ section.settings.logo | img_url: 'master' }}" alt="{{ section.settings.logo.alt }}" width="508" height="123" loading="lazy">
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Logo section",
    "settings": [
      {
        "type": "richtext",
        "id": "heading",
        "label": "Heading",
        "default": "<p></p>"
      },
      {
        "type": "richtext",
        "id": "content",
        "label": "Content",
        "default": "<p></p>"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "color",
        "id": "bg_color",
        "label": "Background color",
        "default": "#FEF9F2"
      },
      {
        "type": "range",
        "id": "padding-top",
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px",
        "label": "Padding top desktop",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding-bottom",
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px",
        "label": "Padding bottom desktop",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding-top-mobile",
        "min": 0,
        "max": 70,
        "step": 2,
        "unit": "px",
        "label": "Padding top mobile",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding-bottom-mobile",
        "min": 0,
        "max": 70,
        "step": 2,
        "unit": "px",
        "label": "Padding bottom mobile",
        "default": 0
      }
    ],
    "presets": [
      {
        "name": "Logo section"
      }
    ]
  }
{% endschema %}
