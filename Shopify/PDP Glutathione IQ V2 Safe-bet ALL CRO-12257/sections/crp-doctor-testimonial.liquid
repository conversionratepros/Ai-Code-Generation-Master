{% comment %}
  Doctor Testimonial Section
  Exact layout closer to provided desktop/mobile design
{% endcomment %}

<div class="doctor-testimonial" data-section-id="{{ section.id }}">
  <div class="testimonial-container">
    {% if section.settings.section_title != blank %}
      <div class="testimonial-header">
        <h2 class="testimonial-title">{{ section.settings.section_title }}</h2>
      </div>
    {% endif %}

    <div class="testimonial-card">
      <div class="testimonial-image-col">
        {% if section.settings.doctor_image != blank %}
          <img
            src="{{ section.settings.doctor_image | image_url: width: 700 }}"
            alt="{{ section.settings.doctor_name | escape }}"
            class="doctor-image"
            loading="lazy"
          >
        {% else %}
          <div class="image-placeholder"></div>
        {% endif %}
      </div>

      <div class="testimonial-content-col">
        <div class="quote-block">
         <div class="quote-icon quote-icon--desktop" aria-hidden="true">
  {% if section.settings.quote_icon_desktop != blank %}
    <img
      src="{{ section.settings.quote_icon_desktop | image_url: width: 80 }}"
      alt=""
      loading="lazy"
    >
  {% endif %}
</div>

<div class="quote-icon quote-icon--mobile" aria-hidden="true">
  {% if section.settings.quote_icon_mobile != blank %}
    <img
      src="{{ section.settings.quote_icon_mobile | image_url: width: 80 }}"
      alt=""
      loading="lazy"
    >
  {% endif %}
</div>

          <div class="quote-content">
            {{ section.settings.quote_text }}
          </div>
        </div>

        <div class="doctor-details">
          {% if section.settings.doctor_name != blank %}
            <p class="doctor-name">{{ section.settings.doctor_name }}</p>
          {% endif %}
          {% if section.settings.doctor_title != blank %}
            <p class="doctor-title">{{ section.settings.doctor_title }}</p>
          {% endif %}
        </div>

        <div class="badges-desktop">
          <div class="badge-pill">
            <span class="badge-number">{{ section.settings.badge_1_number }}</span>
            <span class="badge-text">{{ section.settings.badge_1_label }}</span>
          </div>

          <div class="badge-pill">
            <span class="badge-number">{{ section.settings.badge_2_number }}</span>
            <span class="badge-text">{{ section.settings.badge_2_label }}</span>
          </div>

          <div class="badge-pill badge-pill--location">
           <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 17 17" fill="none">
  <g clip-path="url(#clip0_4111_1258)">
    <path d="M8.02087 0.427246C11.1279 0.427246 13.6556 2.95498 13.6556 6.06201C13.6556 7.08506 13.2011 8.17826 13.1791 8.23096L13.1781 8.23193C13.0301 8.58308 12.7404 9.12528 12.5297 9.44482L8.72986 15.2017C8.5601 15.4588 8.30307 15.6147 8.02087 15.6147C7.73876 15.6147 7.48164 15.459 7.31189 15.2017L3.51208 9.44482C3.30172 9.12531 3.01162 8.58312 2.86365 8.23193V8.23096C2.84415 8.18391 2.38611 7.08758 2.38611 6.06201C2.38614 2.955 4.91386 0.427275 8.02087 0.427246ZM8.02087 1.26611C5.37667 1.26614 3.225 3.4178 3.22498 6.06201C3.22498 6.90526 3.62489 7.87628 3.63708 7.90576C3.76482 8.21022 4.02929 8.70534 4.21228 8.98291L8.01208 14.7397L8.02087 14.7524C8.02358 14.7485 8.02664 14.7443 8.02966 14.7397L11.8295 8.98291C12.0124 8.70552 12.2768 8.21129 12.4047 7.90674L12.4056 7.90479C12.4068 7.902 12.4129 7.88701 12.4232 7.86084C12.4347 7.83157 12.4516 7.78837 12.4711 7.73486C12.51 7.62784 12.5613 7.4766 12.6127 7.29932C12.7158 6.9429 12.8168 6.48512 12.8168 6.06201C12.8167 3.41779 10.6651 1.26611 8.02087 1.26611Z" fill="#0E0E0E" stroke="#0E0E0E" stroke-width="0.187012"/>
