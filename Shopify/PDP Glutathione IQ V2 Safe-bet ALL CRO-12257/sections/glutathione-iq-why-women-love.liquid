

<style>
  .gwl-section {
    background-color: {{ section.settings.background_color }};
    padding: {{ section.settings.section_padding_vertical }}px 20px;
    font-family: {{ section.settings.body_font }}, sans-serif;
  }

  .gwl-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .gwl-heading {
    text-align: center;
    font-family: 'Montserrat';
    font-size: {{ section.settings.heading_font_size }}px;
    font-weight: {{ section.settings.heading_font_weight }};
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
    color: {{ section.settings.heading_color }};
    text-transform: {{ section.settings.heading_text_transform }};
    margin-bottom: {{ section.settings.heading_margin_bottom }}px;
  }

  .gwl-layout {
    display: flex;
    align-items: center;
    gap: 0px;
    flex-wrap: wrap;
  }

  .gwl-image-col {
    flex: 0 0 auto;
    width: 42%;
    min-width: 260px;
    border-radius: {{ section.settings.image_border_radius }}px;
    overflow: hidden;
    z-index: 1;
  }

  .gwl-image-col img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: {{ section.settings.image_border_radius }}px;
  }

  .gwl-features-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.pill_gap }}px;
    align-items: flex-start;
    margin-left: -34px;
  }

  .gwl-pill {
    display: flex;
    align-items: center;
    gap: 16px;
    background-color: {{ section.settings.pill_background_color }};
    border-radius: {{ section.settings.pill_border_radius }}px;
    padding: 16px 24px 16px 50px;
  }

  .gwl-pill-icon {
    flex-shrink: 0;
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px;
    background: white;
    border-radius: 50px;
  }

  .gwl-pill-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .gwl-pill-icon svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: {{ section.settings.icon_color }};
    stroke-width: 1.5;
  }

  .gwl-pill-text {
    font-size: {{ section.settings.pill_font_size }}px;
    font-weight: {{ section.settings.pill_font_weight }};
    color: {{ section.settings.pill_text_color }};
    line-height: 1.4;
    letter-spacing: {{ section.settings.pill_letter_spacing }}px;
  }

  @media (max-width: 768px) {
    .gwl-image-col {
      width: 100%;
    }

    .gwl-layout {
      flex-direction: column;
    }

    .gwl-heading {
      font-size: {{ section.settings.heading_font_size | times: 0.75 | round }}px;
    }
  }
</style>

<section class="gwl-section">
  <div class="gwl-inner">

    {% if section.settings.heading != blank %}
      <h2 class="gwl-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="gwl-layout">

      <!-- Product Image -->
      <div class="gwl-image-col">
        {% if section.settings.product_image != blank %}
          <img
            src="{{ section.settings.product_image | image_url: width: 900 }}"
            alt="{{ section.settings.product_image.alt | escape | default: section.settings.heading }}"
            width="900"
            height="auto"
            loading="lazy"
          >
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'gwl-placeholder-svg' }}
        {% endif %}
      </div>

      <!-- Feature Pills -->
      <div class="gwl-features-col">
        {% for block in section.blocks %}
          {% if block.type == 'feature' %}
            <div class="gwl-pill" {{ block.shopify_attributes }}>
              <div class="gwl-pill-icon">
                {% if block.settings.icon_image != blank %}
                  <img
                    src="{{ block.settings.icon_image | image_url: width: 80 }}"
                    alt="{{ block.settings.feature_text | escape }}"
                    width="{{ section.settings.icon_size }}"
                    height="{{ section.settings.icon_size }}"
                    loading="lazy"
                  >
                {% else %}
                  <!-- Default SVG fallback icon -->
                  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="12" cy="12" r="9"/>
                    <path d="M9 12l2 2 4-4"/>
                  </svg>
                {% endif %}
              </div>
              <span class="gwl-pill-text">{{ block.settings.feature_text }}</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>

    </div>
  </div>
</section>

