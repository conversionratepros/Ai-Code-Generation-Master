    },
    {
      "type": "range",
      "id": "pill_font_size",
      "label": "Pill Text Font Size (px)",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 15
    },
    {
      "type": "select",
      "id": "pill_font_weight",
      "label": "Pill Text Font Weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
