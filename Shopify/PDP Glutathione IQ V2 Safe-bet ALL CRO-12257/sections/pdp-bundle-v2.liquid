          </div>
        </div>

        {% if has_top_info %}
          <div class="pdp-bundle__top-info pdp-bundle__top-info--mobile">
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'top_info_item' %}
                  <div class="pdp-bundle__top-info-item" {{ block.shopify_attributes }}>
                    {% if block.settings.icon != blank %}
                      <div class="pdp-bundle__top-info-icon">
                        <img
                          src="{{ block.settings.icon | image_url: width: 48 }}"
                          alt="{{ block.settings.text | escape }}"
                          loading="lazy"
                        >
                      </div>
                    {% endif %}
                    {% if block.settings.text != blank %}
                      <div class="pdp-bundle__top-info-text">{{ block.settings.text }}</div>
                    {% endif %}
                  </div>
              {% endcase %}
            {% endfor %}
          </div>
        {% endif %}

        {% assign has_dropdowns = false %}
        {% for block in section.blocks %}
          {% if block.type == 'info_dropdown' %}
            {% assign has_dropdowns = true %}
            {% break %}
          {% endif %}
        {% endfor %}

        {% if has_dropdowns %}
          <div class="pdp-bundle__accordion">
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'info_dropdown' %}
                  <div class="pdp-bundle__accordion-item" {{ block.shopify_attributes }}>
                    <button type="button" class="pdp-bundle__accordion-btn">
                      <span>{{ block.settings.heading }}</span>
                      <span class="pdp-bundle__accordion-icon"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 16 16" fill="none">
  <path d="M4 6L8 10L12 6" stroke="#0E0E0E" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"></path>
</svg></span>
                    </button>
                    <div class="pdp-bundle__accordion-panel">
                      {{ block.settings.description }}
                    </div>
                  </div>
              {% endcase %}
            {% endfor %}
          </div>
        {% endif %}
      {% endform %}
    </div>

    {% assign has_review_cards = false %}
    {% for block in section.blocks %}
      {% if block.type == 'review_card' %}
        {% assign has_review_cards = true %}
        {% break %}
      {% endif %}
    {% endfor %}

    {% if has_review_cards %}
      <div class="pdp-bundle__reviews pdp-bundle__reviews--mobile">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'review_card' %}
              <div class="pdp-bundle__review-card" {{ block.shopify_attributes }}>
                <div class="pdp-bundle__review-top">
                  <div class="pdp-bundle__review-stars" aria-label="{{ block.settings.stars }} out of 5 stars">
                    {% assign star_count = block.settings.stars | plus: 0 %}
                    {% for i in (1..5) %}
                      <span class="{% if i <= star_count %}is-filled{% endif %}">★</span>
                    {% endfor %}
                  </div>

                  {% if block.settings.date_text != blank %}
                    <div class="pdp-bundle__review-date">{{ block.settings.date_text }}</div>
                  {% endif %}
                </div>

                {% if block.settings.review_text != blank %}
                  <div class="pdp-bundle__review-text">
                    {{ block.settings.review_text }}
                  </div>
                {% endif %}

                <div class="pdp-bundle__review-footer">
                  {% if block.settings.customer_name != blank %}
                    <div class="pdp-bundle__review-name">{{ block.settings.customer_name }}</div>
                  {% endif %}

                  {% if block.settings.verified_text != blank %}
                    <div class="pdp-bundle__review-verified">
                      <span class="pdp-bundle__review-check">✓</span>
                      <span>{{ block.settings.verified_text }}</span>
                    </div>
                  {% endif %}
                </div>
              </div>
          {% endcase %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

<style>
 
  .pdp-bundle {
    padding: 48px 20px;
    background: #fff;
  }

  .pdp-bundle__wrap {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 640px) minmax(320px, 520px);
    gap: 48px;
    align-items: start;
  }

  .pdp-bundle__left-column {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .pdp-bundle__gallery {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr);
    gap: 25px;
  }

  .pdp-bundle__thumbs-wrap {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: stretch;
  }

  .pdp-bundle__thumbs-viewport {
    overflow: hidden;
    height: 584px;
  }

  .pdp-bundle__thumbs-track {
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: transform 0.25s ease;
    will-change: transform;
  }

  .pdp-bundle__thumb {
    border: 1px solid rgba(14, 14, 14, 0.08);
    background: #fff;
    padding: 0;
    cursor: pointer;
    overflow: hidden;
    flex: 0 0 86px;
    height: 86px;
  }

  .pdp-bundle__thumb.is-active {
    border-color: #0E0E0E;
  }

  .pdp-bundle__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pdp-bundle__thumb-video {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .pdp-bundle__play {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%,-50%);
    width: 26px;
    height: 26px;
    border-radius: 999px;
    background: rgba(0,0,0,.6);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
  }

  .pdp-bundle__thumb-nav {
    height: 36px;
    border: 1px solid rgba(0,0,0,.15);
    background: #fff;
    cursor: pointer;
    font-size: 18px;
    line-height: 1;
  }

  .pdp-bundle__thumb-nav.is-disabled {
    opacity: .35;
    cursor: not-allowed;
    display: none;
  }

  .pdp-bundle__featured {
    position: relative;
    min-height: 620px;
    border: 1px solid rgba(14, 14, 14, 0.08);
    overflow: hidden;
  }

  .pdp-bundle__slide {
    display: none;
    height: 100%;
  }

  .pdp-bundle__slide.is-active {
    display: block;
  }

  .pdp-bundle__slide img,
  .pdp-bundle__slide video,
  .pdp-bundle__slide iframe,
  .pdp-bundle__slide model-viewer {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .pdp-bundle__nav {
    position: absolute;
    left: 16px;
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    justify-content: space-between;
    pointer-events: none;
  }

  .pdp-bundle__nav-btn {
    pointer-events: auto;
    width: 48px;
    height: 48px;
    border: 1px solid #111;
    background: #fff;
    cursor: pointer;
    font-size: 28px;
    line-height: 1;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .pdp-bundle__nav-btn:hover {
      background-color: #111;
  }

  .pdp-bundle__nav-btn:hover svg path {
      fill: #fff;
  }

  .pdp-bundle__rating {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
  }

  .pdp-bundle__rating.is-hidden {
    display: none !important;
  }

  .pdp-bundle__stars {
    display: flex;
    gap: 0;
    font-size: 14px;
  }

  .pdp-bundle__stars--judgeme span {
    color: #d0d0d0;
  }

  .pdp-bundle__stars--judgeme span.is-filled {
    color: #111;
  }

  .pdp-bundle__rating-copy {
    margin: 0;
    cursor: pointer;
  }

  .pdp-bundle__rating p {
    margin: 0;
    color: #0E0E0E;
    font-family: Montserrat;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: 21px;
  }

  .pdp-bundle__rating strong {
    font-weight: 400;
  }

  .pdp-bundle__rating p u {
    font-weight: 600;
  }

 
  .pdp-bundle__accordion .pdp-bundle__accordion-item .pdp-bundle__accordion-panel> p {
      margin-bottom: 16px;
  }

  .pdp-bundle__accordion .pdp-bundle__accordion-item .pdp-bundle__accordion-panel> h3 {
      margin-bottom: 16px;
  }

  .pdp-bundle__accordion .pdp-bundle__accordion-item .pdp-bundle__accordion-panel> ul {
      margin-bottom: 16px;
  }
  .pdp-bundle__brand {
    margin: 0 0 8px;
    color: #404040;
    font-family: Nunito;
    font-size: 12px;
    font-style: normal;
    font-weight: 600;
    line-height: 15px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
  }

  .pdp-bundle__title {
    margin: 0 0 8px;
    color: #0E0E0E;
    font-family: Montserrat;
    font-size: 52px;
    font-style: normal;
    font-weight: 300;
    line-height: 54.6px;
    font-variant: all-small-caps;
    letter-spacing: -0.5px;
  }

  .pdp-bundle__subtitle h6 {
    margin: 0;
    color: #404040;
    font-family: Nunito;
    font-size: 14px;
    font-style: normal;
    font-weight: 300;
    line-height: 20px;
  }

  .pdp-bundle__divider {
    height: 1px;
    background: rgba(0,0,0,.15);
    margin: 16px 0;
  }

  .pdp-bundle__description {
    margin-bottom: 8px;
    font-size: 14px;
    line-height: 1.7;
    color: #404040;
  }

  .pdp-bundle__description p {
    color: #404040;
    font-family: Nunito;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: 24px;
  }

  .pdp-bundle__top-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 20px;
  }

  .pdp-bundle__top-info-item {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .pdp-bundle__top-info-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .pdp-bundle__top-info-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .pdp-bundle__top-info-text {
    color: #404040;
    font-family: Nunito;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: 20px;
  }

  .pdp-bundle__supply-label {
    margin: 0 0 8px;
    color: #404040;
    font-family: Nunito;
    font-size: 12px;
    font-style: normal;
    font-weight: 600;
    line-height: 15px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
  }

  .pdp-bundle__options {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 20px;
  }

  .pdp-bundle__option {
    position: relative;
    display: flex;
    align-items: center;
    gap: 5px;
    border: 1px solid rgba(0,0,0,.15);
    padding: 12px 10px;
    background: #fff;
    cursor: pointer;
  }

  .pdp-bundle__option.is-selected {
    border: 1px solid #0E0E0E;
    padding: 11px 9px;
  }

  .pdp-bundle__option.is-disabled {
    opacity: .55;
    pointer-events: none;
  }

  .pdp-bundle__radio input[type="radio"] {
    appearance: none;
    -webkit-appearance: none;
    width: 18px;
    height: 18px;
    border: 2px solid rgba(0,0,0,.25);
    border-radius: 50%;
    position: relative;
    margin: 0;
  }

  .pdp-bundle__radio input[type="radio"]:checked {
    border-color: #111;
  }

  .pdp-bundle__radio input[type="radio"]:checked::after {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #111;
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%,-50%);
  }

  .pdp-bundle__option-image {
    width: 52px;
    flex-shrink: 0;
  }

  .pdp-bundle__option-image img {
    width: 100%;
    display: block;
    height: auto;
  }

  .pdp-bundle__option-copy {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .pdp-bundle__option-copy strong {
    color: #0E0E0E;
    font-family: Nunito;
    font-size: 14px;
    font-style: normal;
    font-weight: 600;
    line-height: 20px;
  }

  .pdp-bundle__option-copy > span {
    color: #404040;
    font-family: Nunito;
    font-size: 12px;
    font-style: normal;
    font-weight: 300;
    line-height: 16px;
    margin: 0;
  }

  .pdp-bundle__save {
    color: #555;
  }

  .pdp-bundle__option-price {
    text-align: right;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
  }

  .pdp-bundle__price {
    color: #0E0E0E;
    text-align: center;
    font-family: Montserrat;
    font-size: 18px;
    font-style: normal;
    font-weight: 400;
    line-height: 18px;
  }

  .pdp-bundle__compare {
    margin-top: 4px;
    font-size: 13px;
    color: #888;
    text-decoration: line-through;
  }

  .pdp-bundle__badge {
    position: absolute;
    top: -8.75px;
    right: 20px;
    background: #ebf3ed;
    color: #4A7C59;
    text-align: center;
    font-family: Nunito;
    font-size: 9.5px;
    font-style: normal;
    font-weight: 600;
    line-height: 14.25px;
    white-space: nowrap;
    padding: 6px 8px;
  }

  .pdp-bundle__atc {
    width: 100%;
    height: 52px;
    border: 0;
    background: #111;
    color: #FFF;
    text-align: center;
    font-family: Nunito;
    font-size: 12px;
    font-style: normal;
    font-weight: 600;
    line-height: 16px;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    cursor: pointer;
  }

  .pdp-bundle__atc[disabled] {
    opacity: .6;
    cursor: not-allowed;
  }

  .pdp-bundle__secure-checkout {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    background: #f7f7f7;
    padding: 8px 16px;
    margin-top: 16px;
    margin-bottom: 24px;
    overflow: hidden;
  }

  .pdp-bundle__secure-left {
    display: flex;
    align-items: center;
    gap: 5px;
    flex-shrink: 0;
  }

  .pdp-bundle__secure-lock {
    display: inline-flex;
    color: #6B6B6B;
    width: 16px;
  }

  .pdp-bundle__secure-text {
    color: #6B6B6B;
    font-family: Montserrat;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: 20px;
    white-space: nowrap;
  }

  .pdp-bundle__secure-icons {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: nowrap;
    overflow-x: auto;
  }

  .pdp-bundle__pay-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .pdp-bundle__pay-icon svg {
    display: block;
    max-width: 100%;
    height: auto;
