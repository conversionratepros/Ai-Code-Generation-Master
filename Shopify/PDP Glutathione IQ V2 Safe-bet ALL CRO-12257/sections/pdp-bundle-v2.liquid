<script>
  document.addEventListener('DOMContentLoaded', function () {
    var section = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!section) return;

    function fetchJudgeMeWidget(page, perPage, productId) {
      var shopDomain = (window.Shopify && window.Shopify.shop) ? window.Shopify.shop : location.hostname;

      var url =
        'https://api.judge.me/reviews/reviews_for_widget' +
        '?url=' + encodeURIComponent(shopDomain) +
        '&shop_domain=' + encodeURIComponent(shopDomain) +
        '&platform=shopify' +
        '&page=' + page +
        '&per_page=' + perPage +
        '&product_id=' + encodeURIComponent(productId);

      return fetch(url, {
        method: 'GET',
        headers: {
          accept: 'application/json'
        }
      }).then(function(response) {
        if (!response.ok) {
          throw new Error('Judge.me request failed: ' + response.status);
        }
        return response.json();
      });
    }

    function parseJudgeMeReviewData(html) {
      var parser = new DOMParser();
      var doc = parser.parseFromString(html, 'text/html');
      var reviewEls = doc.querySelectorAll('.jdgm-rev');
      var reviews = [];

      reviewEls.forEach(function(review, index) {
        var id =
          review.getAttribute('data-review-id') ||
          review.getAttribute('id') ||
          ('review-' + index);

        var ratingEl = review.querySelector('.jdgm-rev__rating');
        var rating = 0;

        if (ratingEl) {
          rating =
            parseInt(ratingEl.getAttribute('data-score'), 10) ||
            parseInt(ratingEl.getAttribute('data-rating'), 10) ||
            0;
        }

        if (!rating) {
          rating =
            parseInt(review.getAttribute('data-score'), 10) ||
            parseInt(review.getAttribute('data-rating'), 10) ||
            0;
        }

        if (!rating) {
          var fullStars = review.querySelectorAll('.jdgm-star.jdgm--on').length;
          var allStars = review.querySelectorAll('.jdgm-star').length;
          rating = fullStars || allStars || 0;
        }

        if (rating > 0) {
          reviews.push({
            id: String(id),
            rating: rating
          });
        }
      });

      return reviews;
    }

    function buildUniqueReviewMap(reviewArray) {
      var map = new Map();

      reviewArray.forEach(function(review) {
        if (!map.has(review.id)) {
          map.set(review.id, review);
        }
      });

      return map;
    }

    function calculateAverageFromReviewMap(reviewMap) {
      var reviews = Array.from(reviewMap.values());
      if (!reviews.length) return 0;

      var total = reviews.reduce(function(sum, review) {
        return sum + Number(review.rating || 0);
      }, 0);

      return total / reviews.length;
    }

    function updatePdpJudgeMeRating(averageRating, totalCount) {
      var ratingRoot = section.querySelector('.pdp-bundle__rating--judgeme');
      if (!ratingRoot) return;

      var stars = ratingRoot.querySelectorAll('.pdp-bundle__stars--judgeme span');
      var scoreEl = ratingRoot.querySelector('.pdp-bundle__rating-score');
      var countEl = ratingRoot.querySelector('.pdp-bundle__rating-count');

      averageRating = Number(averageRating || 0);
      totalCount = Number(totalCount || 0);

      if (!totalCount || totalCount < 1) {
        ratingRoot.classList.add('is-hidden');
        return;
      }

      ratingRoot.classList.remove('is-hidden');

      var rounded = Math.round(averageRating);

      stars.forEach(function(star, index) {
        star.classList.toggle('is-filled', index < rounded);
      });

      if (scoreEl) {
        scoreEl.textContent = averageRating.toFixed(1) + '/5';
      }

      if (countEl) {
        countEl.textContent = totalCount + ' Reviews';
      }
    }

    function getNumberFromText(text) {
      if (!text) return 0;
      var match = String(text).match(/[\d.]+/);
      return match ? parseFloat(match[0]) : 0;
    }

    function loadPdpJudgeMeRatingFromCustomSummary() {
      var ratingRoot = section.querySelector('.pdp-bundle__rating--judgeme');
      if (!ratingRoot) return false;

      var customSummary = document.querySelector('.cro-jm-summary');
      if (!customSummary) return false;

      var scoreEl = customSummary.querySelector('.cro-jm-summary-score');
      var countEl = customSummary.querySelector('.cro-jm-summary-count');

      if (!scoreEl || !countEl) return false;

      var averageRating = getNumberFromText(scoreEl.textContent);
      var totalCount = getNumberFromText(countEl.textContent);

      if (!averageRating || !totalCount) return false;

      updatePdpJudgeMeRating(averageRating, totalCount);
      return true;
    }

    function loadPdpJudgeMeRatingFallback() {
      var ratingRoot = section.querySelector('.pdp-bundle__rating--judgeme');
      if (!ratingRoot) return;

      var productId = ratingRoot.getAttribute('data-product-id');
      if (!productId) {
        ratingRoot.classList.add('is-hidden');
        return;
      }

      fetchJudgeMeWidget(1, 100, productId)
        .then(function(firstPageData) {
          var firstPageReviews = parseJudgeMeReviewData(firstPageData.html || '');
          var totalPages = Math.ceil((parseInt(firstPageData.total_count, 10) || firstPageReviews.length || 0) / 100) || 1;

          if (totalPages <= 1) {
            var firstMap = buildUniqueReviewMap(firstPageReviews);
            var firstAverage = calculateAverageFromReviewMap(firstMap);
            updatePdpJudgeMeRating(firstAverage, firstMap.size);
            return;
          }

          var requests = [];

          for (var page = 2; page <= totalPages; page++) {
            requests.push(fetchJudgeMeWidget(page, 100, productId));
          }

          Promise.all(requests)
            .then(function(otherPages) {
              var allReviews = firstPageReviews.slice();

              otherPages.forEach(function(pageData) {
                var pageReviews = parseJudgeMeReviewData(pageData.html || '');
                allReviews = allReviews.concat(pageReviews);
              });

              var uniqueMap = buildUniqueReviewMap(allReviews);
              var averageRating = calculateAverageFromReviewMap(uniqueMap);

              updatePdpJudgeMeRating(averageRating, uniqueMap.size);
            })
            .catch(function() {
              var fallbackMap = buildUniqueReviewMap(firstPageReviews);
              var fallbackAverage = calculateAverageFromReviewMap(fallbackMap);

              updatePdpJudgeMeRating(fallbackAverage, fallbackMap.size);
            });
        })
        .catch(function(error) {
          console.warn('PDP Judge.me rating failed:', error);
          ratingRoot.classList.add('is-hidden');
        });
    }

    function waitForCustomSummaryAndSync() {
      var synced = loadPdpJudgeMeRatingFromCustomSummary();

      if (synced) return;

      var attempts = 0;
      var maxAttempts = 20;

      var interval = setInterval(function() {
        attempts += 1;
        var syncedNow = loadPdpJudgeMeRatingFromCustomSummary();

        if (syncedNow) {
          clearInterval(interval);
          return;
        }

        if (attempts >= maxAttempts) {
          clearInterval(interval);
          loadPdpJudgeMeRatingFallback();
        }
      }, 500);
    }

    function bindPdpJudgeMeRatingClick() {
      var ratingRoot = section.querySelector('.pdp-bundle__rating--judgeme');
      if (!ratingRoot) return;

      ratingRoot.addEventListener('click', function() {
        var target =
          document.querySelector('.cro-jm-section') ||
          document.querySelector('.jdgm-widget') ||
          document.querySelector('.jdgm-review-widget') ||
          document.querySelector('[id*="judgeme"]');

        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    }

    bindPdpJudgeMeRatingClick();
    waitForCustomSummaryAndSync();

    var thumbs = section.querySelectorAll('.pdp-bundle__thumb');
    var slides = section.querySelectorAll('.pdp-bundle__slide');
    var prevBtn = section.querySelector('.pdp-bundle__nav-btn--prev');
    var nextBtn = section.querySelector('.pdp-bundle__nav-btn--next');
    var activeIndex = 0;

    function showSlide(index) {
      if (!slides.length) return;
      if (index < 0) index = slides.length - 1;
      if (index >= slides.length) index = 0;
      activeIndex = index;

      slides.forEach(function (slide, i) {
        slide.classList.toggle('is-active', i === index);
        if (i !== index) {
          slide.querySelectorAll('video').forEach(function (video) { video.pause(); });
          slide.querySelectorAll('iframe').forEach(function (iframe) {
            var src = iframe.src;
            iframe.src = src;
          });
        }
      });

      thumbs.forEach(function (thumb, i) {
        thumb.classList.toggle('is-active', i === index);
      });

      ensureThumbVisible(index);
    }

    thumbs.forEach(function (thumb, index) {
      thumb.addEventListener('click', function () {
        showSlide(index);
      });
    });

    if (prevBtn) {
      prevBtn.addEventListener('click', function () {
        showSlide(activeIndex - 1);
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function () {
        showSlide(activeIndex + 1);
      });
    }

    var thumbViewport = section.querySelector('.pdp-bundle__thumbs-viewport');
    var thumbTrack = section.querySelector('.pdp-bundle__thumbs-track');
    var thumbUp = section.querySelector('.pdp-bundle__thumb-nav--up');
    var thumbDown = section.querySelector('.pdp-bundle__thumb-nav--down');
    var thumbOffset = 0;

    function getThumbStepSize() {
      var firstThumb = section.querySelector('.pdp-bundle__thumb');
      if (!firstThumb) return 0;
      var thumbHeight = firstThumb.offsetHeight;
      return thumbHeight + 12;
    }

    function maxThumbOffset() {
      if (!thumbViewport || !thumbTrack) return 0;
      return Math.max(0, thumbTrack.scrollHeight - thumbViewport.clientHeight);
    }

    function updateThumbTrack() {
      if (!thumbTrack) return;

      if (window.innerWidth <= 999) {
        thumbTrack.style.transform = 'none';
        return;
      }

      thumbTrack.style.transform = 'translateY(-' + thumbOffset + 'px)';

      if (thumbUp) {
        thumbUp.classList.toggle('is-disabled', thumbOffset <= 0);
      }

      if (thumbDown) {
        thumbDown.classList.toggle('is-disabled', thumbOffset >= maxThumbOffset());
      }
    }

    function scrollThumbs(direction) {
      if (window.innerWidth <= 999) return;

      var stepSize = getThumbStepSize();
      if (!stepSize) return;

      thumbOffset += direction * stepSize;
      if (thumbOffset < 0) thumbOffset = 0;
      if (thumbOffset > maxThumbOffset()) thumbOffset = maxThumbOffset();

      updateThumbTrack();
    }

    function ensureThumbVisible(index) {
      if (window.innerWidth <= 999) return;
      if (!thumbViewport || !thumbTrack || !thumbs.length) return;

      var stepSize = getThumbStepSize();
      if (!stepSize) return;

      var thumbTop = index * stepSize;
      var thumbBottom = thumbTop + stepSize;
      var viewTop = thumbOffset;
      var viewBottom = thumbOffset + thumbViewport.clientHeight;

      if (thumbTop < viewTop) {
        thumbOffset = thumbTop;
      } else if (thumbBottom > viewBottom) {
        thumbOffset = thumbBottom - thumbViewport.clientHeight;
      }

      if (thumbOffset < 0) thumbOffset = 0;
      if (thumbOffset > maxThumbOffset()) thumbOffset = maxThumbOffset();

      updateThumbTrack();
    }

    if (thumbUp) {
      thumbUp.addEventListener('click', function () {
        if (thumbUp.classList.contains('is-disabled')) return;
        scrollThumbs(-1);
      });
    }

    if (thumbDown) {
      thumbDown.addEventListener('click', function () {
        if (thumbDown.classList.contains('is-disabled')) return;
        scrollThumbs(1);
      });
    }

    updateThumbTrack();
    window.addEventListener('resize', updateThumbTrack);

    var options = section.querySelectorAll('.pdp-bundle__option');
    var variantInput = section.querySelector('.pdp-bundle__variant-input');
    var addToCartBtn = section.querySelector('.pdp-bundle__atc');

    options.forEach(function (option) {
      option.addEventListener('click', function () {
        if (option.classList.contains('is-disabled')) return;

        options.forEach(function (opt) {
          opt.classList.remove('is-selected');
          var radio = opt.querySelector('input[type="radio"]');
          if (radio) radio.checked = false;
        });

        option.classList.add('is-selected');
        var radio = option.querySelector('input[type="radio"]');
        if (radio) radio.checked = true;

        var variantId = option.getAttribute('data-variant-id');
        var isAvailable = option.getAttribute('data-available') === 'true';

        if (variantInput) variantInput.value = variantId;
        if (addToCartBtn) {
          var label = addToCartBtn.querySelector('span');
          addToCartBtn.disabled = !isAvailable;

          if (label) {
            label.textContent = isAvailable ? '{{ section.settings.add_to_cart_text }}' : 'Sold out';
          }
        }
      });
    });

    var qtyInput = section.querySelector('.pdp-bundle__qty-input');
    var qtyMinus = section.querySelector('.pdp-bundle__qty-btn--minus');
    var qtyPlus = section.querySelector('.pdp-bundle__qty-btn--plus');

    if (qtyMinus && qtyPlus && qtyInput) {
      qtyMinus.addEventListener('click', function () {
        var val = parseInt(qtyInput.value, 10) || 1;
        if (val > 1) qtyInput.value = val - 1;
      });

      qtyPlus.addEventListener('click', function () {
        var val = parseInt(qtyInput.value, 10) || 1;
        qtyInput.value = val + 1;
      });

      qtyInput.addEventListener('change', function () {
        var val = parseInt(qtyInput.value, 10);
        if (!val || val < 1) qtyInput.value = 1;
      });
    }

    var accordionButtons = section.querySelectorAll('.pdp-bundle__accordion-btn');
    var accordionItems = section.querySelectorAll('.pdp-bundle__accordion-item');

    accordionButtons.forEach(function (button) {
      button.addEventListener('click', function () {
        var item = button.closest('.pdp-bundle__accordion-item');
        var isOpen = item.classList.contains('is-open');

        accordionItems.forEach(function (el) {
          el.classList.remove('is-open');
        });

        if (!isOpen) {
          item.classList.add('is-open');
        }
      });
    });
  });
</script>

