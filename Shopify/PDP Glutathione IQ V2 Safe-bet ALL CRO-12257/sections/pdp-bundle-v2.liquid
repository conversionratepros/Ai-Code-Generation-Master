{% assign current_variant = product.selected_or_first_available_variant %}
{% assign recommended_variant = blank %}

{% for variant in product.variants %}
  {% assign variant_title_downcase = variant.title | downcase %}
  {% if variant_title_downcase contains '3 bottle' or variant_title_downcase contains '3 bottles' %}
    {% assign recommended_variant = variant %}
    {% break %}
  {% endif %}
{% endfor %}

{% if recommended_variant == blank %}
  {% assign recommended_variant = current_variant %}
{% endif %}

{% assign subtitle_text = product.metafields.custom.tag_line %} 
{% assign mobile_best_selling_text = product.metafields.custom.best_selling %}
{% assign form_id = 'product-form-' | append: section.id %}
{% assign visible_thumb_count = 6 %}
{% assign media_count = product.media.size %}
{% assign brand_text = product.vendor %}

<div class="pdp-bundle" data-section-id="{{ section.id }}">
  <div class="pdp-bundle__wrap">

    <div class="pdp-bundle__left-column">
      <div class="pdp-bundle__gallery">
        <div class="pdp-bundle__thumbs-wrap {% if media_count > visible_thumb_count %}has-scroll{% endif %}">
          {% if media_count > visible_thumb_count %}
            <button type="button" class="pdp-bundle__thumb-nav pdp-bundle__thumb-nav--up is-disabled" aria-label="Scroll thumbnails up">
              ↑
            </button>
          {% endif %}

          <div class="pdp-bundle__thumbs-viewport">
            <div class="pdp-bundle__thumbs-track">
              {% for media in product.media %}
                <button
                  type="button"
                  class="pdp-bundle__thumb {% if forloop.first %}is-active{% endif %}"
                  data-index="{{ forloop.index0 }}"
                  aria-label="Show media {{ forloop.index }}"
                >
                  {% if media.media_type == 'image' %}
                    <img src="{{ media | image_url: width: 140 }}" alt="{{ media.alt | escape }}" loading="lazy">
                  {% elsif media.media_type == 'video' or media.media_type == 'external_video' %}
                    <div class="pdp-bundle__thumb-video">
                      <img src="{{ media.preview_image | image_url: width: 140 }}" alt="{{ media.alt | escape }}" loading="lazy">
                      <span class="pdp-bundle__play">▶</span>
                    </div>
                  {% else %}
                    {% if media.preview_image %}
                      <img src="{{ media.preview_image | image_url: width: 140 }}" alt="{{ media.alt | escape }}" loading="lazy">
                    {% endif %}
                  {% endif %}
                </button>
              {% endfor %}
            </div>
          </div>

          {% if media_count > visible_thumb_count %}
            <button type="button" class="pdp-bundle__thumb-nav pdp-bundle__thumb-nav--down" aria-label="Scroll thumbnails down">
              ↓
            </button>
          {% endif %}
        </div>

        <div class="pdp-bundle__featured">
          {% for media in product.media %}
            <div class="pdp-bundle__slide {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}">
              {% case media.media_type %}
                {% when 'image' %}
                  <img src="{{ media | image_url: width: 1200 }}" alt="{{ media.alt | escape }}" loading="lazy">
                {% when 'video' %}
                  {{ media | video_tag: controls: true, image_size: '1200x', class: 'pdp-bundle__video' }}
                {% when 'external_video' %}
                  {{ media | external_video_tag }}
                {% else %}
                  {{ media | media_tag }}
              {% endcase %}
            </div>
          {% endfor %}

          {% if product.media.size > 1 %}
            <div class="pdp-bundle__nav">
              <button type="button" class="pdp-bundle__nav-btn pdp-bundle__nav-btn--prev" aria-label="Previous">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="15" viewBox="0 0 16 15" fill="none">
                  <path d="M3.66157 6.4833L8.79235 1.35252L7.43983 0L0 7.43983L7.43983 14.8797L8.79235 13.5271L3.66157 8.39635H15.3043V6.4833H3.66157Z" fill="#0E0E0E"/>
                </svg>
              </button>
              <button type="button" class="pdp-bundle__nav-btn pdp-bundle__nav-btn--next" aria-label="Next">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="15" viewBox="0 0 16 15" fill="none">
                  <path d="M11.6428 6.4833L6.512 1.35252L7.86452 0L15.3043 7.43983L7.86452 14.8797L6.512 13.5271L11.6428 8.39635H0V6.4833H11.6428Z" fill="#0E0E0E"/>
                </svg>
              </button>
            </div>
          {% endif %}
        </div>
      </div>

      {% assign has_review_cards = false %}
      {% for block in section.blocks %}
        {% if block.type == 'review_card' %}
          {% assign has_review_cards = true %}
          {% break %}
        {% endif %}
      {% endfor %}

      {% if has_review_cards %}
        <div class="pdp-bundle__reviews pdp-bundle__reviews--desktop">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'review_card' %}
                <div class="pdp-bundle__review-card" {{ block.shopify_attributes }}>
                  <div class="pdp-bundle__review-top">
                    <div class="pdp-bundle__review-stars" aria-label="{{ block.settings.stars }} out of 5 stars">
                      {% assign star_count = block.settings.stars | plus: 0 %}
                      {% for i in (1..5) %}
                        <span class="{% if i <= star_count %}is-filled{% endif %}">★</span>
                      {% endfor %}
                    </div>

                    {% if block.settings.date_text != blank %}
                      <div class="pdp-bundle__review-date">{{ block.settings.date_text }}</div>
                    {% endif %}
                  </div>

                  {% if block.settings.review_text != blank %}
                    <div class="pdp-bundle__review-text">
                      {{ block.settings.review_text }}
                    </div>
                  {% endif %}

                  <div class="pdp-bundle__review-footer">
                    {% if block.settings.customer_name != blank %}
                      <div class="pdp-bundle__review-name">{{ block.settings.customer_name }}</div>
                    {% endif %}

                    {% if block.settings.verified_text != blank %}
                      <div class="pdp-bundle__review-verified">
                        <span class="pdp-bundle__review-check">✓</span>
                        <span>{{ block.settings.verified_text }}</span>
                      </div>
                    {% endif %}
                  </div>
                </div>
            {% endcase %}
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="pdp-bundle__content">
      <div class="pdp-bundle__rating pdp-bundle__rating--judgeme is-hidden" data-product-id="{{ product.id }}">
        <div class="pdp-bundle__stars pdp-bundle__stars--judgeme" aria-label="Product rating">
          {% for i in (1..5) %}
            <span>★</span>
          {% endfor %}
        </div>
        <p class="pdp-bundle__rating-copy">
          Rated <strong class="pdp-bundle__rating-score">--/5</strong> from
          <u class="pdp-bundle__rating-count">-- Reviews</u>
        </p>
      </div>

      {% if mobile_best_selling_text != blank %}
        <div class="pdp-bundle__mobile-best-selling">
          {{ mobile_best_selling_text }}
        </div>
      {% endif %}

      {% if brand_text != blank %}
        <p class="pdp-bundle__brand">{{ brand_text }}</p>
      {% endif %}

      <h1 class="pdp-bundle__title">{{ product.title }}</h1>

      {% if subtitle_text != blank %}
        <div class="pdp-bundle__subtitle">
          {{ subtitle_text | metafield_tag }}
        </div>
      {% endif %}

      {% comment %} <div class="pdp-bundle__divider"></div> {% endcomment %}

      <div class="pdp-bundle__description">
        {% if product.metafields.custom.short_description != blank %}
          {{ product.metafields.custom.short_description | metafield_tag }}
        {% endif %}
      </div>

      {% assign has_top_info = false %}
      {% for block in section.blocks %}
        {% if block.type == 'top_info_item' %}
          {% assign has_top_info = true %}
          {% break %}
        {% endif %}
      {% endfor %}

      {% if has_top_info %}
        <div class="pdp-bundle__top-info pdp-bundle__top-info--desktop">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'top_info_item' %}
                <div class="pdp-bundle__top-info-item" {{ block.shopify_attributes }}>
                  {% if block.settings.icon != blank %}
                    <div class="pdp-bundle__top-info-icon">
                      <img
                        src="{{ block.settings.icon | image_url: width: 48 }}"
                        alt="{{ block.settings.text | escape }}"
                        loading="lazy"
                      >
                    </div>
                  {% endif %}
                  {% if block.settings.text != blank %}
                    <div class="pdp-bundle__top-info-text">{{ block.settings.text }}</div>
                  {% endif %}
                </div>
            {% endcase %}
          {% endfor %}
        </div>
      {% endif %}

      {% form 'product', product, id: form_id, class: 'pdp-bundle__form' %}
        <input type="hidden" name="id" value="{{ recommended_variant.id }}" class="pdp-bundle__variant-input">

        <div class="pdp-bundle__price-row">
          <span class="pdp-bundle__current-price">{{ recommended_variant.price | money }}</span>
          {% if recommended_variant.compare_at_price > recommended_variant.price %}
            <span class="pdp-bundle__compare-price">{{ recommended_variant.compare_at_price | money }}</span>
          {% endif %}
        </div>

        <div class="pdp-bundle__qty-row">
          <button type="button" class="pdp-bundle__qty-btn pdp-bundle__qty-btn--minus" aria-label="Decrease quantity">&#8722;</button>
          <input type="number" name="quantity" value="1" min="1" class="pdp-bundle__qty-input" aria-label="Quantity">
          <button type="button" class="pdp-bundle__qty-btn pdp-bundle__qty-btn--plus" aria-label="Increase quantity">+</button>
        </div>

  <div class="buy-button-wrapper">
  <button
    type="submit"
    class="pdp-bundle__atc add-to-cart-c"
    data-in-stock-text="{{ section.settings.add_to_cart_text | escape }}"
    data-out-of-stock-text="Sold out"
    {% unless recommended_variant.available %}disabled{% endunless %}
  >
    <span>
      {% if recommended_variant.available %}
        {{ section.settings.add_to_cart_text }}
      {% else %}
        Sold out
      {% endif %}
    </span>
  </button>
</div>

        {{ form | payment_button }}

        <div class="pdp-bundle__secure-checkout">
          <div class="pdp-bundle__secure-left">
            <span class="pdp-bundle__secure-lock">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none">
