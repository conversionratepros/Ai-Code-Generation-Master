{%- style -%}
  .comparison-section {
    background-color: #ffffff;
    padding: 80px 20px;
    text-align: center;
  }
  .comparison-title {
letter-spacing: 1.5px;
    font-size: 28px;
    margin-bottom: 34px;
    text-transform: uppercase;
    text-align: center;
    font-family: 'Montserrat';
    font-weight: 400;
  }
  .comparison-grid {
    max-width: 900px;
    margin: 0 auto 60px auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .comparison-card {
    background-color: #E2D9C9; /* Slightly darker beige for cards */
    text-align: left;
    display: flex;
    flex-direction: column;
  }
  .card-image-wrapper {
    position: relative;
    width: 100%;
    line-height: 0;
  }
  .card-image-wrapper img {
    width: 100%;
    height: auto;
    display: block;
  }
  .badge {
    position: absolute;
    top: 20px;
    left: 20px;
    background: #fff;
    padding: 15px 15px;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .card-content {
    padding: 30px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }
  .card-title {
    font-size: 20px;
    margin: 0 0 15px 0;
    font-weight: normal;
    color: #0E0E0E;
  }
  .card-text {
    font-size: 14px;
    line-height: 1.5;
    color: #0E0E0E;
    margin-bottom: 25px;
    flex-grow: 1;
  }
  .atc-button {
    background: #0E0E0E;
    color: #fff;
    border: none;
    padding: 15px;
    width: 100%;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 12px;
    cursor: pointer;
    transition: opacity 0.3s;
  }
  .atc-button:hover { opacity: 0.8; }

  .comparison-footer-quote {
    max-width: 600px;
    margin: 0 auto;
    font-style: italic;
    font-size: 22px;
    line-height: 36px;
    color: #0E0E0E;
    font-family: 'Montserrat';
  }
  .quote-author {
    margin-top: 20px;
    font-style: normal;
    font-size: 14px;
    display: block;
    line-height: 20px;
  }

   .internal-description-text {
    display: None;
  }

  @media (max-width: 768px) {
    .comparison-grid { grid-template-columns: 1fr; }
    .comparison-title { font-size: 24px; margin-bottom: 16px; }
      .comparison-section {
    padding: 40px 20px;
  }
  .internal-description-text {
    font-size: 16px;
    color: #404040;
    margin-bottom: 32px;
    display: block;
  }
  }
{%- endstyle -%}

<section class="comparison-section">
  <h2 class="comparison-title">{{ section.settings.heading }}</h2>
  <p class="internal-description-text">{{ section.settings.description-text }}</p>

  <div class="comparison-grid">
    {%- for block in section.blocks -%}
      <div class="comparison-card" {{ block.shopify_attributes }}>
        <div class="card-image-wrapper">
          <span class="badge">{{ block.settings.badge_text }}</span>
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy' }}
          {% else %}
            {{ 'image' | placeholder_svg_tag }}
          {% endif %}
        </div>
        
        <div class="card-content">
          <h3 class="card-title">{{ block.settings.product_title }}</h3>
          <p class="card-text">{{ block.settings.description }}</p>
          
          {%- assign product = block.settings.product_handle -%}
          {%- if product != blank -%}
            <form method="post" action="/cart/add">
              <input type="hidden" name="id" value="{{ product.first_available_variant.id }}" />
              <button type="submit" class="atc-button">Add to Cart</button>
            </form>
          {%- else -%}
            <button class="atc-button">Add to Cart (Link Product)</button>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  <div class="comparison-footer-quote">
    <p>"{{ section.settings.footer_quote }}"</p>
    <span class="quote-author">
      <strong>- {{ section.settings.author_name }},</strong><br>
      {{ section.settings.author_title }}
    </span>
  </div>
</section>

{% schema %}
{
  "name": "Internal vs Topical",
  "max_blocks": 2,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "WHY INTERNAL + TOPICAL WORKS BETTER" },
    { "type": "text", "id": "description-text", "label": "Description", "default": "Glutathione IQ works from the inside. Pair it with topical protection for the full treatment Dr Nabila recommends to her clinic patients." },
    { "type": "textarea", "id": "footer_quote", "label": "Footer Quote", "default": "Topical treatments address the surface..." },
    { "type": "text", "id": "author_name", "label": "Author Name", "default": "Dr Nabila" },
    { "type": "text", "id": "author_title", "label": "Author Title", "default": "Aesthetic Medicine Practitioner" }
  ],
  "blocks": [
    {
      "type": "product_comparison",
      "name": "Product",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Product/Face Image" },
        { "type": "text", "id": "badge_text", "label": "Badge (e.g. INSIDE)", "default": "INSIDE" },
        { "type": "text", "id": "product_title", "label": "Title", "default": "Glutathione IQ" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Targets melanin production..." },
        { "type": "product", "id": "product_handle", "label": "Select Product for Cart" }
      ]
    }
  ],
  "presets": [
    { "name": "Internal vs Topical" }
  ]
}
{% endschema %}