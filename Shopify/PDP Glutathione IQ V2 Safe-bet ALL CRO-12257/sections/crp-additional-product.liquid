{% comment %}
  Inside + Outside Section
  Compares internal treatment with topical treatment
{% endcomment %}

{% assign inside_product = section.settings.inside_product_id %}
{% assign outside_product = section.settings.outside_product_id %}

<div class="inside-outside" data-section-id="{{ section.id }}">
  <div class="inside-outside-container">
    <div class="inside-outside-header">
      <h2 class="inside-outside-title">{{ section.settings.section_title }}</h2>

      {% if section.settings.mobile_intro_text != blank %}
        <div class="inside-outside-mobile-intro rte">
          {{ section.settings.mobile_intro_text }}
        </div>
      {% endif %}
    </div>

    <div class="products-grid">
      <div class="product-card inside-card">
        <div class="label-tag">
          {% if section.settings.inside_label_icon != blank %}
            <img
              src="{{ section.settings.inside_label_icon | image_url: width: 28 }}"
              alt=""
              loading="lazy"
            >
          {% endif %}
          <span>{{ section.settings.inside_label }}</span>
        </div>

        <div class="product-image">
          {% if section.settings.inside_image != blank %}
            <img
              src="{{ section.settings.inside_image | image_url: width: 900 }}"
              alt="{{ section.settings.inside_title | escape }}"
              loading="lazy"
            >
          {% else %}
            <div class="image-placeholder"></div>
          {% endif %}
        </div>

        <div class="product-content">
          <h3 class="product-title">{{ section.settings.inside_title }}</h3>
          <div class="product-description rte">
            {{ section.settings.inside_description }}
          </div>
        </div>

        {% if inside_product != blank %}
          <button
            class="add-to-cart-btn"
            data-variant-id="{{ inside_product.selected_or_first_available_variant.id }}"
            type="button"
          >
            {{ section.settings.inside_button_text }}
          </button>
        {% else %}
          <button class="add-to-cart-btn" type="button" disabled>
            {{ section.settings.inside_button_text }}
          </button>
        {% endif %}
      </div>

      <div class="product-card outside-card">
        <div class="label-tag">
          {% if section.settings.outside_label_icon != blank %}
            <img
              src="{{ section.settings.outside_label_icon | image_url: width: 28 }}"
              alt=""
              loading="lazy"
            >
          {% endif %}
          <span>{{ section.settings.outside_label }}</span>
        </div>

        <div class="product-image">
          {% if section.settings.outside_image != blank %}
            <img
              src="{{ section.settings.outside_image | image_url: width: 900 }}"
              alt="{{ section.settings.outside_title | escape }}"
              loading="lazy"
            >
          {% else %}
            <div class="image-placeholder"></div>
          {% endif %}
        </div>

        <div class="product-content">
          <h3 class="product-title">{{ section.settings.outside_title }}</h3>
          <div class="product-description rte">
            {{ section.settings.outside_description }}
          </div>
        </div>

        {% if outside_product != blank %}
          <button
            class="add-to-cart-btn add-to-cart-btn--secondary-mobile"
            data-variant-id="{{ outside_product.selected_or_first_available_variant.id }}"
            type="button"
          >
            {{ section.settings.outside_button_text }}
          </button>
        {% else %}
          <button class="add-to-cart-btn add-to-cart-btn--secondary-mobile" type="button" disabled>
            {{ section.settings.outside_button_text }}
          </button>
        {% endif %}
      </div>
    </div>

    <div class="quote-section">
      <div class="quote-text rte">
        {{ section.settings.quote_text }}
      </div>

      <div class="quote-attribution">
        <p class="author-name">{{ section.settings.quote_author }}</p>
        <p class="author-title">{{ section.settings.quote_author_title }}</p>
      </div>
    </div>
  </div>
</div>

<style>
  .inside-outside {
    background: #ffffff;
    padding: 72px 24px 72px;
  }

  .inside-outside-container {
    max-width: 1080px;
    margin: 0 auto;
  }

  .inside-outside-header {
    text-align: center;
    margin-bottom: 46px;
  }

  .inside-outside-title {
    margin: 0;
    font-family: 'Montserrat', sans-serif;
    font-size: 28px;
    line-height: 1.35;
    font-weight: 400;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: #0E0E0E;
  }

  .inside-outside-mobile-intro {
    display: none;
  }

  .products-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    max-width: 1024px;
    margin: 0 auto 52px;
  }

  .product-card {
    position: relative;
    background: #E2D9C9;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .label-tag {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #ffffff;
    padding: 7px 12px;
    font-family: 'Nunito', sans-serif;
    font-size: 13px;
    line-height: 1;
    font-weight: 500;
    color: #0E0E0E;
  }

  .label-tag img {
    width: 16px;
    height: 16px;
    object-fit: contain;
    display: block;
  }

  .product-image {
    width: 100%;
    overflow: hidden;
    background: #ddd;
  }

  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .image-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #d4cbbf 0%, #c5bbb0 100%);
  }

  .product-content {
    padding: 16px 22px 0;
  }

  .product-title {
    margin: 0 0 12px;
    font-family: 'Montserrat', sans-serif;
    font-size: 20px;
    line-height: 1.35;
    font-weight: 400;
    color: #0E0E0E;
    letter-spacing: 0.4px;
  }

  .product-description {
    font-family: 'Nunito', sans-serif;
    font-size: 14px;
    line-height: 1.8;
    font-weight: 400;
    color: #0E0E0E;
  }

  .product-description p {
    margin: 0;
  }

  .add-to-cart-btn {
    margin: 22px 22px 20px;
    height: 58px;
    border: 1px solid #0E0E0E;
    background: #0E0E0E;
    color: #ffffff;
    font-family: 'Nunito', sans-serif;
    font-size: 12px;
    line-height: 1;
    font-weight: 600;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .add-to-cart-btn:hover {
    background: #ffffff;
    color: #111111;
  }

  .add-to-cart-btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .quote-section {
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
  }

  .quote-text {
    margin-bottom: 18px;
  }

  .quote-text p {
    margin: 0;
    font-family: 'Montserrat', sans-serif;
    font-size: 22px;
    line-height: 36px;
    font-weight: 400;
    font-style: italic;
    color: #0E0E0E;
  }

  .quote-attribution {
    text-align: center;
  }

  .author-name {
    margin: 0 0 4px;
    font-family: 'Nunito', sans-serif;
    font-size: 14px;
    line-height: 1.4;
    font-weight: 700;
    color: #0E0E0E;
  }

  .author-title {
    margin: 0;
    font-family: 'Nunito', sans-serif;
    font-size: 14px;
    line-height: 1.45;
    font-weight: 400;
    color: #0E0E0E;
  }

  @media (max-width: 1024px) {
    .inside-outside {
      padding: 56px 20px 60px;
    }

    .inside-outside-title {
      font-size: 24px;
      letter-spacing: 1.2px;
    }

    .products-grid {
      gap: 20px;
      margin-bottom: 40px;
    }
  }

  @media (max-width: 767px) {
    .inside-outside {
      padding: 40px 16px 44px;
    }

    .inside-outside-header {
      margin-bottom: 24px;
    }

    .inside-outside-title {
      font-size: 24px;
      line-height: 1.45;
      letter-spacing: 1px;
      max-width: 320px;
      margin: 0 auto;
    }

    .inside-outside-mobile-intro {
      display: block;
      max-width: 310px;
      margin: 12px auto 0;
      font-family: 'Nunito', sans-serif;
      font-size: 14px;
      line-height: 1.5;
      color: #4b4b4b;
    }

    .inside-outside-mobile-intro p {
      margin: 0;
    }

    .products-grid {
      grid-template-columns: 1fr;
      gap: 12px;
      margin-bottom: 28px;
      max-width: 100%;
    }

    .product-card {
      background: #E2D9C9;
    }

    .label-tag {
      top: 10px;
      left: 10px;
      padding: 6px 10px;
      font-size: 12px;
    }

    .product-content {
      padding: 12px 14px 0;
    }

    .product-title {
      font-size: 18px;
      line-height: 1.35;
      margin-bottom: 10px;
      letter-spacing: 0.3px;
    }

    .product-description {
      font-size: 14px;
      line-height: 1.7;
    }

    .add-to-cart-btn {
      margin: 16px 14px 14px;
      height: 40px;
      font-size: 11px;
      letter-spacing: 1.4px;
    }

    .outside-card .add-to-cart-btn {
      background: #000;
      color: #fff;
    }

    .quote-section {
      max-width: 320px;
    }

    .quote-text {
      margin-bottom: 16px;
    }

    .quote-text p {
      font-size: 17px;
      line-height: 1.8;
    }

    .author-name {
      font-size: 14px;
    }

    .author-title {
      font-size: 12px;
      color: #333333;
    }
  }
</style>

<script>
  (function() {
    function initInsideOutside(sectionId) {
      const section = document.querySelector('[data-section-id="' + sectionId + '"]');
      if (!section) return;

      const buttons = section.querySelectorAll('.add-to-cart-btn');

      buttons.forEach(function(button) {
        if (button.dataset.cartBound === 'true') return;
        button.dataset.cartBound = 'true';

        button.addEventListener('click', function() {
          const variantId = this.getAttribute('data-variant-id');

          if (!variantId) {
            alert('Please select a product in Shopify settings');
            return;
          }

          this.disabled = true;

          fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify({
              items: [
                {
                  id: Number(variantId),
                  quantity: 1
                }
              ]
            })
          })
            .then(async function(response) {
              const data = await response.json();

              if (!response.ok) {
                throw new Error(data.description || 'Add to cart failed');
              }

              return data;
            })
            .then(function() {
              window.location.href = '/cart';
            })
            .catch(function(error) {
              console.error('Add to cart error:', error);
              alert(error.message || 'Something went wrong while adding to cart.');
            })
            .finally(() => {
              this.disabled = false;
            });
        });
      });
    }

    document.addEventListener('DOMContentLoaded', function() {
      initInsideOutside('{{ section.id }}');
    });

    document.addEventListener('shopify:section:load', function(event) {
      if (event.detail && event.detail.sectionId === '{{ section.id }}') {
        initInsideOutside('{{ section.id }}');
      }
    });
  })();
</script>

