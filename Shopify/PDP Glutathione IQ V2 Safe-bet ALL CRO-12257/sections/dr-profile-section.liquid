{%- style -%}
  .dr-profile-section {
    padding: 60px 20px;
  }
  .dr-profile-container {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 40px;
    background-color: #F1EDE4; /* Matches the beige background */
  }
.dr-profile-image {
    flex: 0 1 360px;
    text-align: center;
}
  .dr-profile-image img {
max-width: 361px;
    height: auto;
    display: block;
    margin-top: -30px;
  }
  .dr-profile-content {
    flex: 1 1;
    padding-right: 120px;
  }
  .dr-profile-header {
letter-spacing: 1.5px;
    font-size: 28px;
    margin-bottom: 60px;
    text-transform: uppercase;
    text-align: center;
    font-family: 'Montserrat';
    font-weight: 400;
  }
  .dr-quote-box {
    position: relative;
    padding-left: 20px;
  }
  .dr-quote-mark {
    font-size: 4rem;
    line-height: 1;
    font-family: serif;
    position: absolute;
    left: -10px;
    top: -20px;
  }
.dr-quote-text {
    font-style: italic;
    font-size: 22px;
    line-height: 36px;
    margin-bottom: 20px;
    color: #0E0E0E;
    font-family: 'Montserrat';
}
.dr-info-name {
    font-weight: bold;
    margin-bottom: 5px;
    display: block;
    font-size: 16px;
    font-family: 'Nunito';
}
.dr-info-title {
    font-size: 14px;
    color: #404040;
    margin-bottom: 20px;
    display: block;
    letter-spacing: 0.55px;
}
  .dr-stats-row {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
  }
  .dr-stat-pill {
    border: 1px solid rgba(14, 14, 14, 0.2);
    border-radius: 50px;
    padding: 10px 20px;
    font-size: 11px;
    display: flex;
    align-items: center;
    background: transparent;
    color: #0E0E0E;
  }
  .dr-stat-pill strong {
    margin-right: 5px;
    font-family: 'Nunito';
    font-weight: 600;
    font-size: 20px;
  }

  @media (max-width: 768px) {
    .dr-profile-container { flex-direction: column-reverse; text-align: center; padding: 0 13px; }
    .dr-quote-mark { left: 0px; top: -26px; opacity: 0.5; }
    .dr-stats-row { justify-content: space-between !important; }
    .dr-stat-pill:nth-child(3) {
    flex-direction: row !important;
    width: 100% !important;
    align-items: center !important;
    gap: 8px;
}
.dr-stat-pill svg {
    width: 25px;
    height: 34px;
}
  .dr-profile-header {
    font-size: 24px;
  }
  }
{%- endstyle -%}

<section class="dr-profile-section">
    <h2 class="dr-profile-header">{{ section.settings.heading }}</h2>
  <div class="dr-profile-container">
    
    <div class="dr-profile-image">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 800 | image_tag: loading: 'lazy' }}
      {% else %}
        {{ 'image' | placeholder_svg_tag }}
      {% endif %}
    </div>

    <div class="dr-profile-content">
      
      <div class="dr-quote-box">
        <span class="dr-quote-mark">“</span>
        <p class="dr-quote-text">{{ section.settings.quote }}</p>
        
        <span class="dr-info-name">{{ section.settings.dr_name }}</span>
        <span class="dr-info-title">{{ section.settings.dr_title }}</span>
      </div>

      <div class="dr-stats-row">
        <div class="dr-stat-pill">
          <strong>{{ section.settings.stat_1_val }}</strong> {{ section.settings.stat_1_text }}
        </div>
        <div class="dr-stat-pill">
          <strong>{{ section.settings.stat_2_val }}</strong> {{ section.settings.stat_2_text }}
        </div>
        <div class="dr-stat-pill">
           <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 17 17" fill="none">
