        </div>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Dr. Profile Section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Doctor Image" },
    { "type": "text", "id": "heading", "label": "Top Heading", "default": "FORMULATED BY DR NABILA" },
    { "type": "textarea", "id": "quote", "label": "Quote Text", "default": "I created Glutathione IQ because..." },
    { "type": "text", "id": "dr_name", "label": "Doctor Name", "default": "Dr Nabila" },
    { "type": "text", "id": "dr_title", "label": "Title", "default": "Aesthetic Medicine Practitioner" },
    { "type": "text", "id": "stat_1_val", "label": "Stat 1 Value", "default": "15" },
    { "type": "text", "id": "stat_1_text", "label": "Stat 1 Label", "default": "yrs aesthetic medicine" },
    { "type": "text", "id": "stat_2_val", "label": "Stat 2 Value", "default": "5000+" },
    { "type": "text", "id": "stat_2_text", "label": "Stat 2 Label", "default": "patients treated" },
    { "type": "text", "id": "location", "label": "Location", "default": "Umhlanga, KZN" }
  ],
  "presets": [
    { "name": "Dr. Profile Section" }
  ]
}
{% endschema %}