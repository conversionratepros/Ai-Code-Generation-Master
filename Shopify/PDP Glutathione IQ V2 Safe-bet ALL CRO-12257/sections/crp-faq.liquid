<section class="faq-accordion-section" id="faq-accordion-{{ section.id }}">
  <div class="faq-accordion-container page-width">
    {% if section.settings.heading != blank %}
      <h2 class="faq-accordion-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="faq-accordion-list">
      {% for block in section.blocks %}
        <div class="faq-accordion-item{% if forloop.first %} is-open{% endif %}" {{ block.shopify_attributes }}>
          <button
            type="button"
            class="faq-accordion-trigger"
            aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
          >
            <span class="faq-accordion-question">{{ block.settings.question }}</span>
            <span class="faq-accordion-icon">
              <span class="faq-accordion-icon-horizontal"></span>
              <span class="faq-accordion-icon-vertical"></span>
            </span>
          </button>

          <div class="faq-accordion-content"{% if forloop.first %} style="display:block;"{% else %} style="display:none;"{% endif %}>
            <div class="faq-accordion-answer">
              {{ block.settings.answer }}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  #faq-accordion-{{ section.id }} {
    background: #fff;
    padding: 72px 20px 84px;
  }

  #faq-accordion-{{ section.id }} .faq-accordion-container {
    max-width: 980px;
    margin: 0 auto;
  }

  #faq-accordion-{{ section.id }} .faq-accordion-heading {
    margin: 0 0 48px;
    text-align: center;
    font-size: 24px;
    line-height: 1.2;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #111111;
  }

  #faq-accordion-{{ section.id }} .faq-accordion-list {
    border-top: 0;
  }

  #faq-accordion-{{ section.id }} .faq-accordion-item {
    border-bottom: 1px solid transparent;
    padding: 0;
  }

  #faq-accordion-{{ section.id }} .faq-accordion-trigger {
    width: 100%;
    padding: 0;
    min-height: 74px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    background: transparent;
    border: 0;
    cursor: pointer;
    text-align: left;
  }

  #faq-accordion-{{ section.id }} .faq-accordion-question {
    font-size: 16px;
    line-height: 1.4;
    font-weight: 400;
    color: #0E0E0E;
  }

  #faq-accordion-{{ section.id }} .faq-accordion-icon {
    width: 22px;
    height: 22px;
    position: relative;
    flex: 0 0 22px;
  }

  #faq-accordion-{{ section.id }} .faq-accordion-icon-horizontal,
  #faq-accordion-{{ section.id }} .faq-accordion-icon-vertical {
    position: absolute;
    top: 50%;
    left: 50%;
    background: #111111;
    transform: translate(-50%, -50%);
    transition: opacity 0.2s ease;
  }

  #faq-accordion-{{ section.id }} .faq-accordion-icon-horizontal {
    width: 20px;
    height: 2px;
  }

  #faq-accordion-{{ section.id }} .faq-accordion-icon-vertical {
    width: 2px;
    height: 20px;
  }

  #faq-accordion-{{ section.id }} .faq-accordion-item.is-open .faq-accordion-icon-vertical {
    opacity: 0;
  }

  #faq-accordion-{{ section.id }} .faq-accordion-content {
    display: none;
    padding: 0 40px 22px 0;
  }

  #faq-accordion-{{ section.id }} .faq-accordion-answer {
    font-size: 14px;
    line-height: 1.7;
    color: #6b6b6b;
    max-width: 760px;
  }

  #faq-accordion-{{ section.id }} .faq-accordion-answer p {
    margin: 0;
  }

  #faq-accordion-{{ section.id }} .faq-accordion-answer p + p {
    margin-top: 12px;
  }

  @media (max-width: 767px) {
    #faq-accordion-{{ section.id }} {
      padding: 52px 20px 60px;
    }

    #faq-accordion-{{ section.id }} .faq-accordion-heading {
      font-size: 24px;
      line-height: 1.35;
      margin-bottom: 28px;
    }

    #faq-accordion-{{ section.id }} .faq-accordion-trigger {
      min-height: 62px;
      align-items: flex-start;
      padding-top: 6px;
      padding-bottom: 6px;
    }

    #faq-accordion-{{ section.id }} .faq-accordion-question {
      font-size: 15px;
      line-height: 1.45;
      padding-top: 10px;
    }

    #faq-accordion-{{ section.id }} .faq-accordion-content {
      padding: 0 28px 18px 0;
    }

    #faq-accordion-{{ section.id }} .faq-accordion-answer {
      font-size: 14px;
      line-height: 1.65;
    }

    #faq-accordion-{{ section.id }} .faq-accordion-icon {
      width: 20px;
      height: 20px;
      flex-basis: 20px;
      margin-top: 12px;
    }

    #faq-accordion-{{ section.id }} .faq-accordion-icon-horizontal {
      width: 18px;
    }

    #faq-accordion-{{ section.id }} .faq-accordion-icon-vertical {
      height: 18px;
    }
  }
</style>

<script>
  (function() {
    const section = document.getElementById('faq-accordion-{{ section.id }}');
    if (!section) return;

    const items = section.querySelectorAll('.faq-accordion-item');

    items.forEach((item) => {
      const trigger = item.querySelector('.faq-accordion-trigger');
      const content = item.querySelector('.faq-accordion-content');

      trigger.addEventListener('click', function() {
        const isOpen = item.classList.contains('is-open');

        items.forEach((otherItem) => {
          otherItem.classList.remove('is-open');
          otherItem.querySelector('.faq-accordion-trigger').setAttribute('aria-expanded', 'false');
          otherItem.querySelector('.faq-accordion-content').style.display = 'none';
        });

        if (!isOpen) {
          item.classList.add('is-open');
          trigger.setAttribute('aria-expanded', 'true');
          content.style.display = 'block';
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "FAQ Accordion",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FREQUENTLY ASKED QUESTIONS"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What does Glutathione IQ taste like?"
