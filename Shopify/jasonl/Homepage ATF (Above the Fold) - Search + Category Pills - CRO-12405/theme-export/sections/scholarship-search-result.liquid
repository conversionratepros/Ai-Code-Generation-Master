<div class="asd-search-result-holder" style="display:none">
    <div class="page-width">
        <h2>Scholarship <span>search results</span></h2>
        <div class="asd-search-result">
            <div class="asd-search-result-top">
                <div class="searchby">Searched by study field: <span>Law / 32 results</span></div>
                <div class="asd-sort">
                    <p class="asd-sort-label" onclick="dropdown_sort(this)">Sort by <span class="icon-arrow1 icon-arrow1--down"></span></p>
                    <div class="asd-sort-list">
                        <ul>
                            <li data-sortvalue="university_name" data-sortorder="asc">University {{svg_sort}}</li>
                            <li data-sortvalue="frequency" data-sortorder="asc">Frequency {{svg_sort}}</li>
                            <li data-sortvalue="student_type" data-sortorder="asc">Citizenship {{svg_sort}}</li>
                            <li data-sortvalue="gender" data-sortorder="asc">Gender {{svg_sort}}</li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="asd-search-result-list">
                <div class="asd-search-result-item">
                    <div class="asd-search-result-text">
                        <div class="asd-search-result-header">
                            <div class="asd-university-name">
                                <h3>Legal Enterpreneur Scholarship</h3>
                                <span>University of Technology Sydney(UTS)</span>
                            </div>
                            <div class="asd-fee">
                                <span>Annual Value: $5000</span>
                                {{svgAnualAmout}}
                            </div>
                        </div>
                        <div class="asd-search-result-body">
                            <p>The University of Melbourne is consistently the top-ranked university in Australia. With
                                a wide range of clubs, cultural
                                activities and sports facilities on campus, Unimelb isn’t just a great place to study –
                                it’s a wonderful place to call
                                home while you study abroad. Over 65,000 students attend the University of Melbourne.
                                Roughly 40% of those are from
                                overseas, validating Unimelb as one of the best universities in Australia for
                                international students.</p>
                        </div>
                        <div class="asd-search-result-footer">
                            <ul class="asd-metainfo">
                                <li>
                                    <strong>Frequency:</strong>
                                    <span>Annual</span>
                                </li>
                                <li>
                                    <strong>Student Citizenship:</strong>
                                    <span>Australian</span>
                                </li>
                                <li>
                                    <strong>Gender:</strong>
                                    <span>NA</span>
                                </li>
                            </ul>
                            <a href="#" class="button">View scholarship</a>
                            <div class="large-up-hide university-logo university-logo--mob">
                                <img src="{{'unsw2.png' | file_img_url :'100x100' , crop : 'center'}}" alt="University of Technology Sydney(UTS) logo" />
                            </div>
                        </div>
                    </div>
                    <div class="asd-search-result-logo">
                        <img src="https://cdn.shopify.com/s/files/1/1249/7859/files/unsw2.png?v=1660117062" alt="University of Technology Sydney(UTS) logo" />
                    </div>
                </div>

                <!-- item -->
                <div class="asd-search-result-item">
                    <div class="asd-search-result-text">
                        <div class="asd-search-result-header">
                            <div class="asd-university-name">
                                <h3>Legal Enterpreneur Scholarship</h3>
                                <span>University of Technology Sydney(UTS)</span>
                            </div>

                        </div>
                        <div class="asd-search-result-body">
                            <p>The University of Melbourne is consistently the top-ranked university in Australia. With
                                a wide range of clubs, cultural
                                activities and sports facilities on campus, Unimelb isn’t just a great place to study –
                                it’s a wonderful place to call
                                home while you study abroad. Over 65,000 students attend the University of Melbourne.
                                Roughly 40% of those are from
                                overseas, validating Unimelb as one of the best universities in Australia for
                                international students.</p>
                        </div>
                        <div class="asd-search-result-footer">
                            <ul class="asd-metainfo">
                                <li>
                                    <strong>Frequency:</strong>
                                    <span>Annual</span>
                                </li>
                                <li>
                                    <strong>Student Citizenship:</strong>
                                    <span>Australian</span>
                                </li>
                                <li>
                                    <strong>Gender:</strong>
                                    <span>NA</span>
                                </li>
                            </ul>
                            <a href="#12" class="button">View scholarship</a>
                        </div>
                    </div>
                    <div class="asd-search-result-logo">
                        <img src="https://cdn.shopify.com/s/files/1/1249/7859/files/bond-university2.png?v=1660117061"
                            alt="University of Technology Sydney(UTS) logo" />
                    </div>
                </div>
            </div>
            <a href="javascript:void(0);" data-page=0 class="button button--more">View more</a>
        </div>
    </div>
</div>

<script>
    const requestdata = {}
    requestdata.state = '';
    requestdata.level = '';
    requestdata.field = '';
    requestdata.sortvalue = '';
    requestdata.sortorder = '';

    const requestdata_label = {}
    requestdata_label.state = '';
    requestdata_label.level = '';
    requestdata_label.field = '';
    requestdata_label.page = 0;

    const submit_button_div = document.querySelector('.button--search');
    const viewmorebutton_div = document.querySelector('.button--more');
    const sortbutton_div = document.querySelectorAll('.asd-sort-list ul li');

   sortbutton_div.forEach(occurence => {
        occurence.addEventListener('click', (e) => {
            let sortvalue = e.target.getAttribute('data-sortvalue');
            let sortorder = e.target.getAttribute('data-sortorder');
            requestdata.sortvalue = sortvalue;
            requestdata.sortorder = sortorder;
            if (sortorder == 'desc') { e.target.setAttribute('data-sortorder', 'asc'); } else { e.target.setAttribute('data-sortorder', 'desc'); }
            const moreButton_div = document.querySelector('.button--more');
            moreButton_div.setAttribute("data-page", 1);
            requestdata.page = 0;
            for (i = 0; i < sortbutton_div.length; i++) {
                sortbutton_div[i].classList.remove('selectedsort');
            }
            e.target.classList.add('selectedsort');
            scholar_request('sort');
        });
    });

    window.addEventListener('load', (event) => {
        scholar_request();
    });

    viewmorebutton_div.addEventListener("click", function (event) {
        event.preventDefault();
        let pagenumber = viewmorebutton_div.getAttribute("data-page");
        requestdata.page = pagenumber++;
        scholar_request('viewmore');
    });

    submit_button_div.addEventListener("click", function (event) {
        event.preventDefault();
        const selectedState = document.querySelectorAll('.state_field .selected');
        const selectedLevel = document.querySelectorAll('.study_level .selected');
        const selectedField = document.querySelectorAll('.study_field .selected');
        requestdata.page = 0;

        const search_image = document.querySelector('.asd-holder');
        const searchresult_section = document.querySelector('.asd-search-result-holder');
        searchresult_section.style = "display:block";
        if (!search_image.classList.contains('asd-holder--search-result')) {
            search_image.classList.add("asd-holder--search-result");
        }

        if (document.querySelector('.featured-universities-section')) {
            document.querySelector('.featured-universities-section').remove();
        }

        const moreButton_div = document.querySelector('.button--more');
        moreButton_div.setAttribute("data-page", 0);

        if (selectedState.length) {
            let state_value = ''; let state_value_label = '';
            for (let i = 0; i < selectedState.length; i++) {
                if (state_value != '') { state_value += ','; state_value_label += ', '; }
                state_value += selectedState[i].getAttribute('data-stateHandle');
                state_value_label += selectedState[i].childNodes['2'].innerHTML;
            }
            requestdata.state = state_value;
            requestdata_label.state = state_value_label;
        }
        else {
            requestdata.state = '';
            requestdata_label.state = '';
        }

        if (selectedLevel.length) {
            let level_value = ''; let level_value_label = '';
            for (let i = 0; i < selectedLevel.length; i++) {
                if (level_value != '') { level_value += ','; level_value_label += ', '; }
                level_value += selectedLevel[i].getAttribute('data-levelHandle');
                level_value_label += selectedLevel[i].childNodes['2'].innerHTML;
            }
            requestdata.level = level_value;
            requestdata_label.level = level_value_label;
        }
        else {
            requestdata.level = '';
            requestdata_label.level = '';
        }

        if (selectedField.length) {
            let field_value = ''; let field_value_label = '';
            for (let i = 0; i < selectedField.length; i++) {
                if (field_value != '') { field_value += ','; field_value_label += ', '; }
                field_value += selectedField[i].getAttribute('data-fieldHandle');
                field_value_label += selectedField[i].childNodes['2'].innerHTML;
            }
            requestdata.field = field_value;
            requestdata_label.field = field_value_label;
        }
        else {
            requestdata.field = '';
            requestdata_label.field = '';
        }
        scholar_request('search');
    });

    function scholar_request(parameterz = false) {
        const main_resultlist_div = document.querySelector('.asd-search-result-list');
        const xhr = new XMLHttpRequest();
        const url = 'https://prnt.jasonl.com.au/scholarship/scholarshiprequest/getRequestScholar';
        xhr.open("POST", url, true);

        // function execute after request is successful 
        xhr.onreadystatechange = function () {
            if (this.readyState == 4 && this.status == 200) {
                const obj = JSON.parse(this.responseText);
                const total_returned = obj['total'];
                const data_value = obj['data'];
                let sum_data=obj['sum'];
                sum_data =sum_data.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
                $appendHtml = '';
                let counter = 1;
                for (const key in data_value) {
                    if (counter > 10) {
                        break;
                    }
                    counter++;

                  //$appendHtml += '<div class="asd-search-result-item"><div class="asd-search-result-text"><div class="asd-search-result-header"><div class="asd-university-name"><h3>' + data_value[key]['scholarship_name'] + '</h3><span>' + data_value[key]['university_name'] + '</span></div></div><div class="asd-search-result-body"><p>' + data_value[key]['scholarship_description'] + '</p></div><div class="asd-search-result-footer"><ul class="asd-metainfo"><li><strong>Frequency: </strong><span>' + data_value[key]['frequency'] + '</span></li><li><strong>Student Citizenship: </strong><span>' + data_value[key]['student_type'] + '</span></li><li><strong>Gender: </strong><span>' + data_value[key]['gender'] + '</span></li></ul><a href="' + data_value[key]['scholarship_url'] + '" target="_blank" class="button">View scholarship</a><div class="large-up-hide university-logo university-logo--mob"><img src="' + data_value[key]['university_logo'] + '" alt="" /></div></div></div><div class="asd-search-result-logo"><img src="' + data_value[key]['university_logo'] + '" alt="' + data_value[key]['university_name'] + '" /></div></div>';
                   $appendHtml+='<div class="asd-search-result-item"><div class="asd-search-result-text"><div class="asd-search-result-header"><div class="asd-university-name"><h3>'+data_value[key]['scholarship_name']+'</h3><span>'+data_value[key]['university_name']+'</span></div>'
                   if(data_value[key]['scholarship_amount'] !=0){  dataval =data_value[key]['scholarship_amount'].toString().replace(/\B(?=(\d{3})+(?!\d))/g, ','); $appendHtml+='<div class="asd-fee"><span>Value: $'+dataval+'</span></div>';}
                   $appendHtml+='</div><div class="asd-search-result-body"><p>'+data_value[key]['scholarship_description']+'</p></div><div class="asd-search-result-footer"><ul class="asd-metainfo"><li><strong>Frequency: </strong><span>'+data_value[key]['frequency']+'</span></li><li><strong>Student Citizenship: </strong><span>'+data_value[key]['student_type']+'</span></li><li><strong>Gender: </strong><span>'+data_value[key]['gender']+'</span></li></ul><a href="'+data_value[key]['scholarship_url']+'" target="_blank" rel="noopener noreferrer" class="button">View scholarship</a><div class="large-up-hide university-logo university-logo--mob"><img src="' + data_value[key]['university_logo'] + '" alt="university logo" /></div></div></div><div class="asd-search-result-logo"><img src="'+data_value[key]['university_logo']+'" alt="'+data_value[key]['university_name']+'" /></div></div>';
                }
                if (parameterz == 'viewmore') {
                    main_resultlist_div.insertAdjacentHTML('beforeend', $appendHtml);
                }
                else {
                    if (parameterz == 'search' || parameterz == 'sort') {
                        if (requestdata_label.state != '' || requestdata_label.level != '' || requestdata_label.field != '') {
                            let displaydata = 'Searched by'; let slash = '';
                            if (requestdata_label.state != '') {
                                displaydata += ' State: <em>' + requestdata_label.state + '</em>';
                                slash = 'yes';
                            }
                            if (requestdata_label.level != '') {
                                if (slash != '') { displaydata += '<br/>'; }
                                displaydata += ' Study level: <em>' + requestdata_label.level + '</em>'; slash = 'yes';
                            }
                            if (requestdata_label.field != '') {
                                if (slash != '') { displaydata += ' <br/> '; }
                                displaydata += ' Study field: <em>' + requestdata_label.field + '</em>'; slash = 'yes';
                            }
                            if (slash != '') { displaydata += '<br/>'; }
                            displaydata+='<div class="scholarship-value">'+total_returned+' Scholarships worth over $'+sum_data + '</div>';
                            document.querySelector('.searchby').innerHTML = displaydata;
                        }
                        else {
                            document.querySelector('.searchby').innerHTML= '<div class="scholarship-value">' + total_returned+' Scholarships worth over $'+sum_data + '</div>';
                        }
                    }
                    main_resultlist_div.innerHTML = $appendHtml;
                }

                const moreButton_div = document.querySelector('.button--more');
                if (parameterz != 'sort') {
                    if (moreButton_div) {
                        let pagenumber = moreButton_div.getAttribute("data-page");
                        if (!isNaN(pagenumber)) { pagenumber++; } else { pagenumber = 1; }
                        moreButton_div.setAttribute("data-page", pagenumber);
                    }
                }

                if (counter > 10) {
                    moreButton_div.style.display = 'flex';
                }
                else {
                    moreButton_div.style.display = 'none';
                }

            }
        }
        xhr.send(JSON.stringify(requestdata));
    }
</script>

<script>
                function dropdown_sort(_this){
                    const __this = _this;
                    const _parent = __this.parentElement;
                        _parent.classList.toggle('active')            
                }    
</script>