        function getInspiredProducts(id) {
            // console.log(id);
            //console.log(id.querySelectorAll('.prod-list-cnt').length);
            if (id.classList.contains('inspiredProductLoaded')) {
                //   console.log('Prod already loaded!');
                return;
            } else {
                //  console.log(111);
            }
            let items = id.querySelectorAll('.prod-list-cnt');
            //items.forEach((item,index) =>{
            for (let i = 0; i < items.length; i++) {
                let prodHandle = items[i].getAttribute('data-prodhandle');
                let prodVariant = items[i].getAttribute('data-prodvariantid');

                let url = 'https://www.jasonl.com.au/products/' + prodHandle + '.js';
                // console.log(url);
                const request = new XMLHttpRequest();
                //let thisFilter = filter;
                request.addEventListener('load', function () {
                    let response = JSON.parse(this.responseText);
                    let prodVariants = response.variants;
                    let prodData = {
                        title: '',
                        img: '',
                        price: '',
                        url: '',
                        variant_id: ''
                    };
                    // console.log(response);
                    //  console.log(prodVariant);
                    // exceptationl cases:
                    // selected variant can be discontinued. 

                    if (prodVariant == null || prodVariant == '' || prodVariant == '0' || prodVariants.length == 1) {
                        prodData = {
                            title: response.title,
                            img: prodVariants[0].featured_image.src,
                            price: prodVariants[0].price,
                            url: response.url,
                            variant_id: prodVariants[0].id
                        }
                    } else {
                        for (let v = 0; v < prodVariants.length; v++) {
                            //  console.log(prodVariants[v].id+'-'+prodVariant);
                            if (prodVariants[v].id == prodVariant) {
                                //let prodImg = prodVariants[v].featured_image.src;
                                prodData = {
                                    title: response.title,
                                    img: prodVariants[v].featured_image.src,
                                    price: prodVariants[v].price,
                                    url: response.url,
                                    variant_id: prodVariants[v].id
                                }
                                break;
                            }
                        }
                    }

                    let truncateTitle = prodData.title.length > 20 ? prodData.title.substring(0, 20) + '...' : prodData.title;
                    {% comment %} let removeDollar = Shopify.formatMoney(prodData.price).replace('$', '');
                    let finalPrice = removeDollar.replace('.00', ''); {% endcomment %}
                    let finalPrice = prodData.price/100;
                    let htmlData = '<picture><img src="' + prodData.img + '" alt="' + prodData.title + '" /></picture>';
                    htmlData += '<div class="prod-info">';
                    htmlData += '<a href="' + prodData.url + '?variant=' + prodData.variant_id + '" target="_blank" rel="noopener noreferrer" title="' + prodData.title + '">';
                    htmlData += '<h5>' + truncateTitle + '</h5>';
                    htmlData += '<p>$' + finalPrice + '</p>';
                    htmlData += '</a>';
                    htmlData += '</div>';
                    htmlData += '<a href="' + prodData.url + '?variant=' + prodData.variant_id + '" target="_blank" rel="noopener noreferrer" class="button button-primary">View product</a>';
                    items[i].innerHTML = htmlData;


                });
                request.open('GET', url, true);
                request.send();
                // return;
            }
            id.classList.add('inspiredProductLoaded');
