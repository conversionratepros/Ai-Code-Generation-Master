        function handleResponse() {
            let response = JSON.parse(this.responseText);
            let searchParams = new URLSearchParams(window.location.search);
            let paramFilter = searchParams.get('filter');
            let paramPage = searchParams.get('page');
            let reponseURL = this.responseURL.split('?')[1];
            let searchParamsResponse = new URLSearchParams(reponseURL);
            if (searchParamsResponse.get('page')) {
                var responseParamPage = searchParamsResponse.get('page');
            }

            let paginate = 7;
            let isLastPage = false;

            const masonryHolder = document.querySelector('.listing-masonry');
            let responseHtml = response['inspired-fitouts'];

            // remove parent sectio tag from response html
            var temp = document.createElement('div');
            temp.innerHTML = responseHtml;
            //let tempHtml = temp.querySelector('.section-inspired-fitouts');
            let items = temp.querySelectorAll('.grid-item');
            if (items.length < 7) {
                isLastPage = true;
            }
            if (temp.querySelector('.grid-item')) {


