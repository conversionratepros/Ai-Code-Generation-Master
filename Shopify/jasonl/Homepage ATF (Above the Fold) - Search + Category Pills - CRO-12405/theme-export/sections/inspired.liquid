        function getFitouts(page) {
            const request = new XMLHttpRequest();
            //let thisFilter = filter;
            request.addEventListener('load', handleResponse);
            request.open('GET', `/blogs/fitouts/?page=${page}&sections=inspired-fitouts`, true);
            request.send();
