        function setGclids(id) {
            const elem = document.getElementById('inspired_gclids');
            const oldHidAttr = elem.getAttribute('data-tf-hidden');
            let typeformBtns = id.querySelectorAll('.typeform-share');
            typeformBtns.forEach((btn, i) => {
                let newHidAttr = btn.getAttribute('data-tf-hidden');
                let combineHidAttr = `${oldHidAttr},${newHidAttr}`;
                btn.setAttribute('data-tf-hidden', combineHidAttr);
            })
        }


        function initSlider(id, goToSlide) {
            var sliderId = id.replace('#slider-', '');
            const swiper = new Swiper(id, {
                effect: "fade",
                loop: true,
                observer: true,
                navigation: {
                    nextEl: '.swiper-button-next-' + sliderId,
                    prevEl: '.swiper-button-prev-' + sliderId,
                },
                on: {
                    init: function (e) {
                        //  console.log(e);
                        // console.log('.swiper-button-next-'+sliderId);
                        e.el.classList.add('slider_loaded');
                        // swiper.slideTo(goToSlide);
                    },
                    slideChangeTransitionStart: function (e) {
                        //console.log(e);
                        let prevIndex = e.previousRealIndex;
                        let activeIndex = e.realIndex;
                        let sliderId = e.el.getAttribute('data-slider');
                        let prodListItem = document.querySelectorAll(`.slider-products-holder[data-slider="${sliderId}"] .slider-products-item`);
                        prodListItem[prevIndex].classList.remove('active');
                        prodListItem[activeIndex].classList.add('active');
                    },
                    afterInit: function (swiper) {
                        swiper.slideTo(goToSlide);
                    }
                }
            });
        }
