        function onModalOpenerClick() {
            let modalBtns = document.querySelectorAll('modal-opener.svg-icon-holder');
            modalBtns.forEach((modalBtn, index) => {
                modalBtn.addEventListener('click', function (e) {
                    let modalId = modalBtn.getAttribute('data-modal');
                    let sliderId = modalBtn.getAttribute('data-slider');
                    let sliderSlideIndex = parseInt(modalBtn.getAttribute('data-sliderSlideIndex'));
                    modalId = modalId.replace("#", "");
                    let docModalId = document.getElementById(modalId);
                    if (docModalId.querySelectorAll('.slider_loaded').length == 0) {
                        initSlider(sliderId, sliderSlideIndex);
                        getInspiredProducts(docModalId);
                        initTypeformLibrary()
                        setGclids(docModalId);

                    } else {
                        //swiper.slideTo(sliderSlideIndex);
                    }
                })
            })
