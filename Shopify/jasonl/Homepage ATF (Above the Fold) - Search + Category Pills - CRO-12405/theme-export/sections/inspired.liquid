                                if (docItem.classList.contains(paramFilter)) {
                                    docItem.style.display = 'block';
                                    visibleCounter++;
                                    visibleItems.push(visibleCounter);
                                } else {
                                    docItem.style.display = 'none';
                                }
                                if (i == docItems.length - 1) {
