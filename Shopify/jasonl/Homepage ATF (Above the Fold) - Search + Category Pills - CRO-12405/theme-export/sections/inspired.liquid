                                    if (visibleItems.length <= 7 && isLastPage == false) {
                                        console.log(111);
                                        getFitouts(parseInt(responseParamPage) + 1);
                                    } else if (visibleItems.length >= 8 || isLastPage == true) {
                                        console.log(222);
                                        searchParams.set('page', responseParamPage);
                                        history.replaceState(null, null, "?" + searchParams.toString());
                                        if (isLastPage == true) {
