                var fragment = document.createDocumentFragment();
                // if(items.length < 7 ){
                //     isLastPage = true;
                // }
                items.forEach((item, index) => {
                    fragment.appendChild(item);
                    elems.push(item);
                    // Callback foreach loop
                    if (index == items.length - 1) {
                        elem.appendChild(fragment);
                        msnry.appended(elems);
                        if (paramFilter == null) {
                            // note: no need to update URL if no filter are set.
                            if (paramPage == null) {
                                imagesLoaded(elem).on('progress', function () {
                                    msnry.layout();
                                    onModalOpenerClick();
                                });
                            } else {
                                if (responseParamPage < paramPage) {
                                    getFitouts(parseInt(responseParamPage) + 1);
                                    // lastpage load msnry layout
                                    if (parseInt(responseParamPage) + 1 == paramPage) {
                                        setTimeout(function () {
                                            msnry.layout();
                                            onModalOpenerClick();
                                        }, 500)
                                    }
                                } else {
                                    imagesLoaded(elem).on('progress', function () {
                                        msnry.layout();
                                        onModalOpenerClick();
                                    });
                                }
                            }

