              <script>
                function delayedLoop() {
                    
        const div = document.getElementById('animate-text');
        const str = div.getAttribute('data-words');
        let items = str.split(",");
        // var items = [1, 2, 3, 4, 5];
         var delay = 3000; // 1 second

         function processItem(index) {
            // Perform some task with the current item
            console.log("Processing item:", items[index]);
            var delay1 = 100;
            let item = items[index];
             div.innerHTML = "";
            //  div.innerHTML = item;
            function e(i){
                let it = item[i];
                let divCnt = div.textContent;
                if(divCnt[i-1] == item[i-1]){
                     div.innerHTML += it;
                }
               
                // Bug: 
                if(div.textContent.length > item.length ){
                    div.innerHTML = "";
                    return;
                }
                    if (i < item.length - 1) {
                    // Set a timeout to process the next item after the delay
                    setTimeout(function () {
                        e(i + 1);
                    }, delay1);
                    }else{ 
                        if(item.length != div.textContent.length ){
                            return;
                        } 
                    } 
            }  
              e(0);  
              
            // Check if there are more items to process
            if (index < items.length - 1) {
               // Set a timeout to process the next item after the delay
               setTimeout(function () {
                  processItem(index + 1);
               }, delay);
            }else{
                 setTimeout(function () {
                  processItem(0);
                }, delay);
            }
         }

         // Start the loop with the first item
         processItem(0);
      }

      delayedLoop();
</script>
