{%- capture shop_by_room -%}
  {{ 'shop-by-room.css' | asset_url | stylesheet_tag }} 
  <div class="shop-by-room-holder">
    <div class="page-width">
      {%- assign section_title = section.settings.section_title -%}
      
      {%- if section_title != blank -%}
        <h2>{{ section_title }}</h2>
      {%- endif -%}

      <div class="item-holder">
        
        {%- assign tag_map = 'business' -%}

        {% if page.title == 'Hospitality' %}
          {%- assign tag_map = 'hospitality' -%}
        {% elsif page.title == 'Education' %}
          {%- assign tag_map = 'education' -%}
        {% endif %}

        {%- assign has_articles = false -%}
        {%- for article in blogs['shop-by-rooms'].articles -%}
            {%- if article.tags contains tag_map -%}
                {%- assign has_articles = true -%}
                {%- break -%}
            {%- endif -%}
        {%- endfor -%}

        {%- if has_articles -%}
          <div class="shop-by-room-slider swiper">
            <div class="loader"></div>
            <ul class="swiper-wrapper">
              {%- for article in blogs['shop-by-rooms'].articles -%}
                {%- if article.tags contains tag_map -%}
                  <li class="swiper-slide">
                    <div>
                      <a href="{{ article.url }}" title="{{ article.title }}"> 
                        {%- if article.image -%}
                          <picture>
                            <source srcset="{{ article.image | image_url: width:964 }} 2x" media="(min-width: 768px) and (min-resolution: 2dppx)">
                            <img src="{{ article.image | image_url: width: 482 }}" alt="{{ article.image.alt | escape }}" width="485" height="auto" loading="lazy">
                          </picture>
                          
                          {% comment %} {{ article.image | image_url: width: 370 | image_tag }} {% endcomment %}
                        {%- endif -%}
                        <div class="item-cnt">
                          <span class="label">Shop by</span>
                          <h4 class="title">{{ article.title }}</h4>
                        </div>
                      </a>
                    </div>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
          <button class="swiper-button-next" id="swiper-btn-next"></button>
          <button class="swiper-button-prev" id="swiper-btn-previous"></button>
        {%- endif -%}

      </div>
    </div>
  </div>
{%- endcapture -%}

  

{{ shop_by_room |  strip_newlines }}
{%- if  has_articles == true  -%}
<script>
window.addEventListener("DOMContentLoaded", (event) => {
const swiper = new Swiper('.shop-by-room-slider', {
  slidesPerView: 2,         // Number of slides visible
  spaceBetween: 15,         // Space between slides
  autoplay: false,
  //centeredSlides: true,
  breakpoints: {
    640: {
      slidesPerView: 3,     // Two slides visible on screens >= 640px
      spaceBetween: 20,
      grid: {
        rows: 1,
      },
    },
    1024: {
      slidesPerView: 4,     // Three slides visible on screens >= 1024px
      spaceBetween: 20,
      centeredSlides: false,
    },
  },
  navigation: {
    nextEl: '.swiper-button-next',
    prevEl: '.swiper-button-prev',
  },
});
});
</script>
{%- endif -%}
{%- schema -%}
{
  "name": "Shop by room",
  "settings": [
  {
    "type":"header",
    "content":"Instruction",
    "info": "Data source is metafield"
  },
  {
    "type": "text",
    "id": "section_title",
    "label": "Section Title"
    
  }
  ]
}
{% endschema %}
