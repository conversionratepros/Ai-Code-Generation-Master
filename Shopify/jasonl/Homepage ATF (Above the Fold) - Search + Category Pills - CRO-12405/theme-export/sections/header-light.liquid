</header>
<script>

document.addEventListener("DOMContentLoaded", function() {
  if(window.innerWidth > 992){
    window.onscroll = function() {
      let snizeWidgetClass = document.querySelector(".snize-instant-widget-is-open");
      let snizeWidget = document.querySelector(".snize-ac-results");
      if (typeof(snizeWidgetClass) != 'undefined' && snizeWidgetClass != null){
          // search dropdown widget opened
          if(window.scrollY > 75 && window.scrollY < 200){
           snizeWidget.setAttribute('style','display:none');
          }
        }
        toggleSticky();
    };
  }
});

function toggleSticky() {
  if (document.querySelector("body").getBoundingClientRect().top < -160 ) {
    //console.log('ready:' + document.querySelector("body").getBoundingClientRect().top);
    //document.body.classList.add("sticky-ready");
  } else {
    //document.body.classList.remove("sticky-ready");
  }

  //if (document.querySelector("body").getBoundingClientRect().top < -300 ) {
    if (document.querySelector("body").getBoundingClientRect().top < -200 ) {
    //console.log('sticky:' + document.querySelector("body").getBoundingClientRect().top);
    document.body.classList.add("sticky-ready");
    document.body.classList.add("sticky");
  } else {
    document.body.classList.remove("sticky");
    document.body.classList.remove("sticky-ready");
  }
}

function triggerClick_burguricon(){
  var element = document.body.querySelector('.header__icon[aria-controls="menu-drawer"]');
  element.click();
}

