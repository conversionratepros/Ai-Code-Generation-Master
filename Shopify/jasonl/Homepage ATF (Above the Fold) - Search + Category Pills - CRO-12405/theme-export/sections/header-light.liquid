                            </symbol>

                            <symbol id="icon-close" class="icon icon-close" fill="none" viewBox="0 0 18 17">
                              <path d="M.865 15.978a.5.5 0 00.707.707l7.433-7.431 7.579 7.282a.501.501 0 00.846-.37.5.5 0 00-.153-.351L9.712 8.546l7.417-7.416a.5.5 0 10-.707-.708L8.991 7.853 1.413.573a.5.5 0 10-.693.72l7.563 7.268-7.418 7.417z" fill="currentColor">
                            </symbol>
                          </svg>
<header class="header header-wrapper header--has-menu">
    <header-drawer data-breakpoint="tablet" class="medium-hide-lg large-up-hide">
        <details class="menu-drawer-container">
          <summary class="header__icon header__icon--menu header__icon--summary link link--text focus-inset" aria-label="{{ 'sections.header.menu' | t }}">
            <span>
              <i class="burger-icon"><div class="burger-icon__bar1"></div> <div class="burger-icon__bar2"></div><div class="burger-icon__bar3"></div></i>
            </span>
          </summary>
          <div id="menu-drawer" class="menu-drawer motion-reduce" tabindex="-1">
             <div class="nav-logo-holder">
                        <a href="{{ routes.root_url }}" class="header__heading-link link link--text focus-inset">
                            <span class="svg-logo">{%- render 'i-logo',  logotype:'logo_with_icon'-%}</span>
                        </a>
                        <span class="menudrawer-nav-close" onclick="triggerClick_burguricon()"></span>
                  </div>
              
              <span id="side-menu-arrow" class="side-menu-arrow"><i></i></span>


            
            <div class="menu-drawer__inner-container" >
              <div class="menu-drawer__navigation-container">
                  
                <nav class="menu-drawer__navigation">
                  <ul class="menu-drawer__menu list-menu" role="list">
                    <li class="menu-item-cols">
                        <span>Your location</span>
                        <span id="mobile-header-current-location">NSW</span>
                        <div class="mobile-header-change-location change-location">
                          <modal-opener class="simple-popup-modal__opener no-js-hidden" data-modal="#PopupModal-modal_change_location" >
                                <button>Change</button>
                          </modal-opener>
                        </div>
                    </li>
                    <li >
                      
                          <a href="/blogs/fitouts"
                            class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if template == "blog.fitouts" %} menu-drawer__menu-item--active{% endif %}"
                            aria-current="page">
                            Fitouts
                          </a>
                          
                      
                      </li>
                    {%- for link in linklists.shop-by-products.links -%}
                        {%- assign titleWithIcon = link.title | split:'|'-%}
                        {%- assign title = titleWithIcon[0]-%}

                      <li>
                        {%- if link.links != blank -%}
                          <details>
                            <summary class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.child_active %} menu-drawer__menu-item--active{% endif %}">
                              {%- render 'menu-titles-test', forloopindex: forloop.index, menutitle: title -%}
                              {% render 'icon-arrow' %}
                              {% render 'icon-caret' %}
                            </summary>
                            <div id="link-{{ title | escape }}" class="menu-drawer__submenu motion-reduce" tabindex="-1">
                              <div class="menu-drawer__inner-submenu">
                                <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
                                  {% render 'icon-arrow' %}
                                   Back to Main Menu
                                </button>
                                <div class="nav-see-all-holder">
                                    <a href="{{link.url}}" data-nsw="{{link.url}}" data-wa="{{link.url | append:'/perth'}}" data-js_updatemenuurl="true"><span>{{ title | escape }}</span><span class="seeall">See all</span></a>
                                </div>

                                <ul class="menu-drawer__menu list-menu nav-child-links" role="list" tabindex="-1">
                                  {%- for childlink in link.links -%}
                                    <li>
                                      {%- if childlink.links == blank -%}
                                        {% capture perthURL %}
                                            {%- assign isChild = false -%}
                                            {%- assign perth = '/perth' -%}
                                            {%- assign linkUrl = childlink.url | split: '/'-%}
                                            {%- if linkUrl.size >= 4 -%}
                                              {%- assign isChild = true -%}
                                            {%- endif -%}

                                            {%- if isChild == true -%}
                                                {%- assign perth = '+perth' -%}
                                            {%- endif -%}
                                            {{perth}}
                                        {% endcapture %}

                                        <a href="{{ childlink.url }}" test="123" data-nsw="{{childlink.url}}" data-wa="{{childlink.url | append:perthURL}}" data-js_updatemenuurl="true" class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if childlink.current %} menu-drawer__menu-item--active{% endif %}"{% if childlink.current %} aria-current="page"{% endif %}>
                                          {{ childlink.title | escape }}
                                           {% render 'icon-arrow' %}
                                        </a>
                                      {%- else -%}
                                        <details>
                                          <summary class="menu-drawer__menu-item link link--text list-menu__item focus-inset">
                                            {{ childlink.title | escape }}
                                            {% render 'icon-arrow' %}
                                            {% render 'icon-caret' %}
                                          </summary>
                                          <div id="childlink-{{ childlink.title | escape }}" class="menu-drawer__submenu motion-reduce">
                                            <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
                                              {% render 'icon-arrow' %}
                                              {{ childlink.title | escape }}
                                            </button>
                                            <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
                                              {%- for grandchildlink in childlink.links -%}
                                                {% capture perthURL %}
                                                  {%- assign isChild = false -%}
                                                  {%- assign perth = '/perth' -%}
                                                  {%- assign linkUrl = grandchildlink.url | split: '/'-%}
                                                  {%- if linkUrl.size >= 3 -%}
                                                    {%- assign isChild = true -%}
                                                  {%- endif -%}
      
                                                  {%- if isChild == true -%}
                                                      {%- assign perth = '+perth' -%}
                                                  {%- endif -%}
                                                  {{perth}}
                                              {% endcapture %}
                                                <li>
                                                  <a href="{{ grandchildlink.url }}" data-nsw="{{grandchildlink.url}}" data-wa="{{grandchildlink.url | append:perthURL}}" data-js_updatemenuurl="true" class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if grandchildlink.current %} menu-drawer__menu-item--active{% endif %}"{% if grandchildlink.current %} aria-current="page"{% endif %}>
                                                    {{ grandchildlink.title | escape }}
                                                     {% render 'icon-arrow' %}
                                                  </a>
                                                </li>
                                              {%- endfor -%}
                                            </ul>
                                          </div>
                                        </details>
                                      {%- endif -%}
                                    </li>
                                  {%- endfor -%}
                                </ul>
                                    
                              </div>
                            </div>
                          </details>
                        {%- else -%}
                          <a href="{{ link.url }}" data-nsw="{{ link.url }}" data-wa="{{ link.url | append:'/perth'}}" data-js_updatemenuurl="true" class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.current %} menu-drawer__menu-item--active{% endif %}"{% if link.current %} aria-current="page"{% endif %}>
                            {{ link.title | escape }}
                            
                          </a>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                    <li class="menu-header-message">
                      <a href="https://builder.jasonl.com.au/catalogue/" target="_blank">
                        <span>
                          <span>CATALOGUE </span>View our brand new 2023 catalogue</span>
                        <svg viewBox="0 0 14 10" fill="none" aria-hidden="true" focusable="false" role="presentation"
                          class="icon icon-arrow" xmlns="http://www.w3.org/2000/svg" style="
                                                          width: 22px;
                                                          fill: #fff;
                                                      ">
                          <path fill-rule="evenodd" clip-rule="evenodd"
                            d="M8.537.808a.5.5 0 01.817-.162l4 4a.5.5 0 010 .708l-4 4a.5.5 0 11-.708-.708L11.793 5.5H1a.5.5 0 010-1h10.793L8.646 1.354a.5.5 0 01-.109-.546z"
                            fill="currentColor">
                          </path>
                        </svg>
                      </a></li>
                  </ul>
                    <div class="menudrawer-bottom-menu">
                      {%- for link in linklists.menudrawer-bottom-menu.links-%}
                        <a {% if link.title contains 'Showrooms' %}onclick="triggerClick_burguricon()" {% endif %}  href="{{link.url}}">{{link.title}}</a>
                        {%- unless forloop.last -%}
                        <span class="sep"></span>
                        {%- endunless-%}
                      {%- endfor-%}
                  </div>
                </nav>
                
              </div>
            </div>
          </div>
          <span id="sidemenu-overlay" class="overlay" onclick="triggerClick_burguricon()"></span>
          </details>
      </header-drawer>
    <div class="header-row header-row--2">
        <div class="page-width">
            <div class="header-row--left">
                {%- render 'logo' -%}
                <div class="shopbycategory header-dropdown small-hide medium-hide-sm">
                    <div class="header-dropdown-title sticky-show">Shop by category</div>
