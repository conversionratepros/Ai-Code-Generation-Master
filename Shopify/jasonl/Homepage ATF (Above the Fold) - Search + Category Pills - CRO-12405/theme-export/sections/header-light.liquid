                                                    {%- endif-%}
                                                {%- endcapture -%}
                                                <div class="more-col {% if forloop.last %}last{% endif %}">
                                                    <h4>
                                                      <a href="{{link1.url}}" data-nsw="{{ link1.url }}" data-wa="{{ link1.url }}/{{locationAvailability_filterTag}}" data-js_updatemenuurl="true">{{- menuTitle_withoutIcon1 -}} {%- render 'icon-arrow'-%}</a>
                                                    </h4>
                                                    <ul class="child-menu">
                                                        {%- render 'header-submenu', parentMenu: link1,locationAvailability_filterTag:locationAvailability_filterTag -%}
                                                    </ul>
                                                </div>
                                          {%- endfor -%}

                                            </div>
                                        </div>
                                    </li>
                                    {% endif %}
                                </ul>
                                <div class="nav-overlay"></div>
                            </div>
