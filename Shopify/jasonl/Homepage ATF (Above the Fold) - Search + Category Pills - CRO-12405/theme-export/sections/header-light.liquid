                                            <span>{%- render 'menu-titles-test', forloopindex: forloop.index, menutitle: menuTitle_withoutIcon -%}</span>
                                        </a>

                                        <div class="header-child-menu">
                                            <div class="child-menu-left">
                                                <h4>
                                                  <a href="{{link.url}}" data-nsw="{{ link.url }}" data-wa="{{ link.url }}/{{locationAvailability_filterTag}}" data-js_updatemenuurl="true">{{- menuTitle_withoutIcon -}} {%- render 'icon-arrow'-%}</a>
                                                </h4>
