{%- capture meet_people -%}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@splidejs/splide@latest/dist/css/splide.min.css"> 
{{"landingpage-meetpeople.css" | asset_url | stylesheet_tag}}
<div  class="meetpeople1-container">         
<div  class="page-width page-width-override">
<div class="">
{%- assign current_page = template.name -%} 
{%- for message in shop.metafields.accentuate.main_text -%}
{%- if current_page == shop.metafields.accentuate.page[forloop.index0] -%} 
<div class="meetpeople-wrapper">
<div class="meetpeople1-left">
<div class="meetpeople-banner">
<div class="people-img">
<picture>
<source media="(min-width: 1200px)" srcset="{{shop.metafields.accentuate.main_image[forloop.index0]| file_img_url:'1200x450_crop_center' }}, {{shop.metafields.accentuate.main_image[forloop.index0]| file_img_url:'1200x450_crop_center' }} 2x">
<img src="{{shop.metafields.accentuate.main_image[forloop.index0]| file_img_url:'1200x450_crop_center' }}" alt="{{ shop.metafields.accentuate.main_title[forloop.index0] }}" loading="lazy"/>
</picture>
</div>
<div class="people-text">
<h2>{{ shop.metafields.accentuate.main_title[forloop.index0] }}<span>.</span></h2>
<p>{{message}}</p>
<img class="signature" loading="lazy" alt="signature" src="{{ shop.metafields.accentuate.main_signature[forloop.index0] | file_img_url }}" loading="lazy"/>
</div>
</div>
</div>
<div class="meetpeople1-right">
<div class="meetpeople-box">
<p>
{{ shop.metafields.accentuate.card_text[forloop.index0] }}
</p>
<strong class="peoplename">{{ shop.metafields.accentuate.card_name[forloop.index0] }}</strong>
<span class="peoplepost">{{ shop.metafields.accentuate.card_designation[forloop.index0] }} at {{ shop.metafields.accentuate.card_company[forloop.index0] }}</span>
<img class="people-img" src="{{ shop.metafields.accentuate.card_image[forloop.index0] | file_img_url }}" loading="lazy" alt="{{ shop.metafields.accentuate.card_name[forloop.index0] }} {{ shop.metafields.accentuate.card_designation[forloop.index0] }} at {{ shop.metafields.accentuate.card_company[forloop.index0] }}" />
</div>
</div>
</div>
{%- endif -%}
{%- endfor -%} 
</div>
</div>         
</div>
{%- endcapture -%}
{{ meet_people  }}
  {%- schema -%}
  {
    "name": "Meet People",
    "class":"meetpeople-section"
  }
  {% endschema %}
