  function showallproducts(btn){
    var hiddenItems = document.getElementsByClassName('showmore-item');
    var hiddentClassname = document.getElementsByClassName('showmore-hide');
    var paginationWrap = document.getElementById('pagination-wrap');
    for( var i = 0; i<hiddenItems.length; i++){
      hiddenItems[i].classList.remove('showmore-hide');
    }
    btn.classList.add('showmore-hide');
    paginationWrap.classList.remove("hide-pagination");
}

{% comment %} custom script for custom select  {% endcomment %}
document.addEventListener("DOMContentLoaded", function () {
  function createCustomSelect(selectWrapper) {
    let selElmnt = selectWrapper.querySelector("select");
    let selectedDiv = document.createElement("DIV");
    selectedDiv.setAttribute("class", "select-selected");
    selectedDiv.innerHTML = selElmnt.options[selElmnt.selectedIndex].innerHTML;
    selectWrapper.appendChild(selectedDiv);

    let optionsDiv = document.createElement("DIV");
    optionsDiv.setAttribute("class", "select-items select-hide");

    for (let i = 0; i < selElmnt.length; i++) {
      let optionDiv = document.createElement("DIV");
      optionDiv.innerHTML = selElmnt.options[i].innerHTML;
      optionDiv.dataset.value = selElmnt.options[i].value; // Store value

      optionDiv.addEventListener("click", function () {
        let selectedText = this.innerHTML;
        let selectedValue = this.dataset.value;

        // ✅ Update the custom select display
        selectedDiv.innerHTML = selectedText;
        console.log("Updated .select-selected to:", selectedText); // 🔥 Debugging

        // ✅ Update the <select> element
        selElmnt.value = selectedValue;

        // ✅ Update #SortBy value dynamically
        let sortBySelect = document.querySelector("#SortBy");
        if (sortBySelect) {
          sortBySelect.value = selectedValue;

          // ✅ Set selected="selected" explicitly
          sortBySelect.querySelectorAll("option").forEach(option => {
            option.removeAttribute("selected");
            if (option.value === selectedValue) {
              option.setAttribute("selected", "selected");
              option.click();
            }
            console.log(option.value);
          });

          // console.log("SortBy changed to:", sortBySelect.value); // 🔥 Debugging

          // ✅ Trigger change event on #SortBy
          sortBySelect.dispatchEvent(new Event("change", { bubbles: true }));
        }

        // Remove previous selection highlight
        let sameSelected = this.parentNode.querySelectorAll(".same-as-selected");
        sameSelected.forEach(el => el.classList.remove("same-as-selected"));
        this.classList.add("same-as-selected");

        selectedDiv.click(); // Close dropdown
      });

      optionsDiv.appendChild(optionDiv);
    }

    selectWrapper.appendChild(optionsDiv);

    selectedDiv.addEventListener("click", function (e) {
      e.stopPropagation();
      closeAllSelect(this);
      optionsDiv.classList.toggle("select-hide");
      this.classList.toggle("select-arrow-active");
    });
  }

  function closeAllSelect(except) {
    document.querySelectorAll(".select-selected").forEach((el, index) => {
      if (el !== except) {
        el.classList.remove("select-arrow-active");
        document.querySelectorAll(".select-items")[index].classList.add("select-hide");
      }
    });
  }

  document.addEventListener("click", closeAllSelect);

  document.querySelectorAll(".custom-select").forEach(createCustomSelect);

  // ✅ Listen for changes in #SortBy and update .select-selected text
  document.querySelector("#SortBy").addEventListener("change", function () {
    let selectedText = this.options[this.selectedIndex].innerHTML;
    let customSelect = document.querySelector(".custom-select .select-selected");

    if (customSelect) {
      customSelect.innerHTML = selectedText;
      // console.log("Updated .custom-select from #SortBy:", selectedText); // 🔥 Debugging
    }
  });
});


