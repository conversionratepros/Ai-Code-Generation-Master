    {% assign count = count | plus:1 %}
    {% assign productReviewMetafield = productReveiwValue | strip | times:1.0 %}
    {% assign reviewAverage = reviewAverage | plus:productReviewMetafield %}
{% endfor %}
{% assign reviewAverage = reviewAverage | divided_by:count | round: 1 %}
{% endpaginate %}
{%- if reviewAverage > 0 -%}
