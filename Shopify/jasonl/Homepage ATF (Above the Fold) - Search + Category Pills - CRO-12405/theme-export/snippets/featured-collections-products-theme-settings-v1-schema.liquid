
{%- assign featured_product_list_handles = product_list_all | replace: '[', ',' | remove : ']' | split: ',' -%}

{%- assign cleaned_handles_string = '' -%}

{%- for handle in featured_product_list_handles -%}

  {%- assign clean_handle = handle | strip | remove: '"' | remove: '\' -%}

  {%- if clean_handle != blank -%}

    {%- if cleaned_handles_string == blank -%}
      {%- assign cleaned_handles_string = clean_handle -%}
    {%- else -%}
      {%- assign cleaned_handles_string = cleaned_handles_string | append: ',' | append: clean_handle -%}
    {%- endif -%}

  {%- endif -%}

{%- endfor -%}

{%- assign cleaned_handles = cleaned_handles_string | split: ',' -%}


<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
  {%- for handle in cleaned_handles %}
    {%- assign product = all_products[handle] -%}
    
    {% if product.title != blank -%}
    {
      "@type": "Product",
      "name": {{ product.title | json }},
      "url": {{ shop.url | append: product.url | json }},
      "image": [
        {%- for image in product.images limit: 3 %}
          "{{ image | image_url: width: 1200 | prepend: 'https:' |  split: "?" | first }}"{% unless forloop.last %},{% endunless -%}
        {% endfor %}
      ],
      "description": "{{ product.metafields.productmeta.product_tab_description | strip_html | strip_newlines | replace: '"', '' }}",
      {%- for tag in product.tags -%}
      {% if tag contains "brand=" %}
        "brand" : {
          "@type": "Brand",
          "name": "{{ tag | remove: "brand=" }}"
        },
        {% break %}
      {%- endif -%}
      {% endfor -%}
      "sku": "{{ product.variants.first.sku }}",
      "offers": {
        "@type": "Offer",
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "price": {{ product.selected_or_first_available_variant.price | divided_by: 100 }},
        "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}",
        "url": {{ shop.url | append: product.url | json }}
      }
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endif -%}
  {%- endfor -%}
  ]
}
</script>
