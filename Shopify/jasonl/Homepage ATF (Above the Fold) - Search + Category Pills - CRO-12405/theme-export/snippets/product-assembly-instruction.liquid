{%- comment -%} start assembly instructio {%- endcomment -%}
<h3 class="no-assembly-insctruction-hide">Assembly instructions</h3>

<ul class="table-list-download">
  {%- if assemblyinstruction contains ',' -%}
    {% assign all_inst_url = assemblyinstruction | split: ',' %}
    {%- for each_url in all_inst_url -%}

      {%- if each_url contains '::' -%}
        {% assign instruction_array = each_url | split: '::' %}
        {% assign instruction_url = instruction_array[1] %}
        {% assign instruction_title = instruction_array[0] %}
      {% else %}
        {% assign instruction_url = each_url %}
        {% assign instruction_title = themeOption_label %}
      {%- endif -%}


      <li class="instruction-item download-item {% if forloop.first %}active{% endif %}">
        <a
          class="download-item-cnt-holder"
          href="{{ instruction_url }}?v={{"now" | date:"%d_%Y"}}"
          target="_blank"
          rel="noopener noreferrer"
          data-ga4="assembly_downloads">
          <div class="instruction-title">{{ instruction_title }}</div>
          <div class="download-btn">
            <span class="link">Download</span>
            {%- render 'icon-download' -%}</div>
        </a>
      </li>

    {%- endfor -%}
  {%- else -%}
    {%- if assemblyinstruction contains '::' -%}
      {% assign instruction_array = assemblyinstruction | split: '::' %}
      {% assign instruction_title = instruction_array[0] %}
      {% assign instruction_url = instruction_array[1] %}
    {% else %}
      {% assign instruction_url = assemblyinstruction %}
      {% assign instruction_title = themeOption_label %}
    {%- endif -%}

    {% if instruction_url != blank %}
      <li class="instruction-item download-item active">
        <a
          class="download-item-cnt-holder"
          href="{{ instruction_url }}?v={{"now" | date:"%d_%Y"}}"
          target="_blank"
          rel="noopener noreferrer"
          data-ga4="assembly_downloads">
          <div class="instruction-title">
            {{ instruction_title | strip | default: "Assembly Instruction" }}
          </div>
          <div class="download-btn">
            <span class="link">Download</span>
            {%- render 'icon-download' -%}</div>
        </a>
      </li>
    {% else %}
      <li class="description-inside-assembly-instruction">
        {%- render 'description-left-inner-wrap', description_content: description_content -%}
      </li>
    {% endif %}

  {%- endif -%}
</ul>
{%- comment -%} assembly instruction end {%- endcomment -%}



