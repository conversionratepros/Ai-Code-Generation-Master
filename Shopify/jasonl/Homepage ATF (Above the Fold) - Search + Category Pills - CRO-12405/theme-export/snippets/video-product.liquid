 
 {% unless template.name == "product"%}
    {{ 'video-section.css' | asset_url | stylesheet_tag }}
    {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
{% endunless %}
<div class="video-section">
  <span class="loader"></span>
  <deferred-media class="video-section__media deferred-media no-js-hidden" data-media-id="{{ video_id }}"
    {% if video_img != blank %} style="padding-bottom: {{ 1 | divided_by: section.settings.cover_image.aspect_ratio | times: 100 }}%;"{% endif %}
  >
    <button
      id="Deferred-Poster-Modal-{{ videoUrl_idOnly}}"
      class="video-section__poster poster-type3 media deferred-media__poster media--landscape"
      type="button"
    >
      {%- if video_img != blank -%}
        <img
          src="{{ video_img }}"
          loading="lazy"
          width="350"
          height="208"
        >
        {%-comment-%}
      {%- else -%}
        <img
          src="{{ videoCoverImgFromSection }}"
          loading="lazy"
          width="{{ videoCoverImgFromSection.width }}"
          height="{{ videoCoverImgFromSection.height }}"
        >
        {%endcomment%}
      {%- endif -%}
      <span class="deferred-media__poster-button motion-reduce">
        {%- render 'icon-play' -%}
      </span>
    </button>
    <template>
        <iframe src="https://www.youtube.com/embed/{{ video_id }}?enablejsapi=1&autoplay=1&rel=0" class="js-youtube" allow="autoplay; encrypted-media" allowfullscreen title="{{ section.settings.description | escape }}"></iframe>
    </template>
    <iframe loading="lazy" class="youtube_iframe"  src="https://www.youtube.com/embed/{{ video_id }}"></iframe> 
  </deferred-media>
  {%- comment -%} rendered from product-videos.liquid for assembly videos and showcase videos {%- endcomment -%}
              {%- render 'video-schema', 
                        youtube_id: video_id,
                        youtube_title: youtube_title, 
                        youtube_description: youtube_description, 
                        youtube_uploaded_date: youtube_uploaded_date
              -%}
</div>