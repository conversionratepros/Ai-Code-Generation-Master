    <div class="swiper-pagination"></div>
  </div>

<!-- Initialize Swiper -->
<script>
    
    window.addEventListener("load", (event) => {
         
        var swiper = new Swiper(".more-about-collection-swiper", {
            slidesPerView: 1.3,
            spaceBetween: 30,
            pagination: {
                el: ".swiper-pagination",
                type: "fraction"
            },
            breakpoints: {
                800: {
                    slidesPerView: 3
                }
            }

        });

        if (window.innerWidth > 768) {
            swiper.destroy(true, true);
        } 
    });
    
  </script>