                      <path d="M6.66683 14.6667V4.66673C6.66683 4.29878 6.36811 4.00006 6.00016 4.00006H2.66683C1.93094 4.00006 1.3335 4.59751 1.3335 5.33339V13.3334C1.3335 14.0693 1.93094 14.6667 2.66683 14.6667H10.6668C11.4027 14.6667 12.0002 14.0693 12.0002 13.3334V10.0001C12.0002 9.63212 11.7014 9.33339 11.3335 9.33339H1.3335" stroke="#161616" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M10.0002 1.33331H14.0002C14.3681 1.33331 14.6668 1.63204 14.6668 1.99998V5.99998C14.6668 6.36792 14.3681 6.66665 14.0002 6.66665H10.0002C9.63222 6.66665 9.3335 6.36792 9.3335 5.99998V1.99998C9.3335 1.63204 9.63222 1.33331 10.0002 1.33331V1.33331" stroke="#161616" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
