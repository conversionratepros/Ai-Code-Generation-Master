    -%}

    <!-- product ld+json  -->
    <script type="application/ld+json">
      {%- assign product_url = shop.url | append: product.url -%}
      {
        "@context": "https://schema.org/",
        {%- if product.variants.size > 1 -%}
          "@type": "ProductGroup",
          {%- comment -%} "@id": "{{ product_url }}#productgroup", {%- endcomment -%}
          {%- if product.options -%}
            {%- assign cleaned_options = "" -%}
            {%- for option in product.options -%}
              {%- assign cleaned_option = option | remove: "Select a " -%}
              {%- assign cleaned_options = cleaned_options | append: cleaned_option -%}
              {%- unless forloop.last -%}
                {%- assign cleaned_options = cleaned_options | append: '|' -%}
              {%- endunless -%}
            {%- endfor -%}
            "variesBy" : {{ cleaned_options | split: '|' | json }},
          {%- endif -%}
        {%- else -%}
          "@type": "Product",
          "@id": "{{ product_url }}#product",
        {%- endif -%}
        "name": "{{ product.title | escape }}",
        "description": "{{ description | strip_html | strip_newlines | replace: '"', '' }}",
        "url": "{{ product_url }}",
        "sku": "{{ product.selected_or_first_available_variant.sku | escape }}",
        {%- assign category = '' -%}
        {%- for link in linklists['main-menu-image'].links -%}
          {%- assign collection_handle = link.url | split: '/' | last -%}
          {%- if product.tags contains collection_handle -%}
            {%- for collection in collections -%}
              {%- if collection.handle == collection_handle -%}
                {%- assign category = collection.title -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          {%- if category != '' -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
        "category": "{{ category | default: product.type | escape }}",
        "brand": {
          "@type": "Brand",
          "name": "{{ product.vendor }}"
        },
        {%- if product.metafields.productmeta.product_sizes contains 'size' -%}
          {%- assign productsizes = product.metafields.productmeta.product_sizes -%}
          {%- assign size_array = '' -%}
          {%- assign opt_parts = productsizes | split: '[opt]' -%}
          {%- for part in opt_parts offset: 1 -%}
            {%- assign opt_value = part | split: '[/opt]' | first | strip -%}
            {%- if size_array != blank -%}
              {%- assign size_array = size_array | append: '|' -%}
            {%- endif -%}
            {%- assign size_array = size_array | append: opt_value -%}
          {%- endfor -%}
          {%- assign final_sizes = size_array | split: '|' -%}
          "size" : {{ final_sizes | json }},
        {%- endif -%}
        {%- comment -%} "productGroupID" : "{{ product.variants.first.id }}", {%- endcomment -%}
        {%- assign certification_array = "" -%}
        {%- assign badges_meta = product.metafields.productmeta.badges | strip | split:'|' -%}
        {%- for badge in badges_meta -%}
          {%- for metaobj_badge in shop.metaobjects.product_badges.values -%}
              {%- if badge ==  metaobj_badge.badge_name.value -%}
                {%- if metaobj_badge.structured_data.value != blank -%}
                  {%- capture certification_item -%}
                    {{ metaobj_badge.structured_data.value | json }} 
                  {%- endcapture -%}
                  
                  {%- if certification_array != blank -%}
                    {%- assign certification_array = certification_array | append: ',' -%}
                  {%- endif -%}

                  {%- assign certification_array = certification_array | append: certification_item -%} 
                
                {%- endif -%}
              {%- endif -%} 
            {%- endfor -%}
        {%- endfor -%} 
        {%- if certification_array != blank -%}
          "hasCertification": [
            {{ certification_array }}
          ],
        {%- endif -%}
        "hasMerchantReturnPolicy": {
          "@type": "MerchantReturnPolicy",
          "applicableCountry": "AU",
          "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
          "merchantReturnDays": 14,
          "returnMethod": "https://schema.org/ReturnByMail",
          "returnFees": "https://schema.org/FreeReturn",
          "refundType": "https://schema.org/FullRefund"
        },
        {%- assign spec_rows = specification | split: '<div class="pro-detail-row">' -%}
        "additionalProperty": [
          {%- assign first = true -%}
          {%- for row in spec_rows -%}
            {%- if row == blank -%}{%- continue -%}{%- endif -%}
            {%- assign key = row | split: '<span>' | last | split: '</span>' | first | strip -%}
            {%- assign value = row | split: '<p>' | last | split: '</p>' | first | strip -%}
            {%- if key != blank and value != blank -%}
              {%- unless first -%},{%- endunless -%}
              {
                "@type": "PropertyValue",
                "name": "{{ key }}",
                "value": "{{ value | strip_html }}"
              }
              {%- assign first = false -%}
            {%- endif -%}
          {%- endfor -%}
        ],
        {% if product.featured_image %}
        "image": [
            {% assign featured_image_url = product.featured_image | img_url: 'master' %}
            {% unless featured_image_url contains 'https://' or  featured_image_url contains 'http://' %}
              {% assign featured_image_url = product.featured_image | img_url: 'master' |  prepend: 'https:'  %}
            {% endunless %}
          "{{ featured_image_url }}"
          {%- for image in product.images offset: 1 limit: 3 -%}
            {% assign productimg = image | img_url: 'master' %}
            {% unless productimg contains 'https://' or productimg contains 'http://' %}
              {% assign productimg = image | img_url: 'master' |  prepend: 'https:'  %}
            {% endunless %}
          ,"{{ productimg }}"
          {%- endfor -%}
        ],
        {% endif %}
        "offers": {
          "@type": "AggregateOffer",
          {% if product.metafields.productmeta.warranty_info  %}
          "warranty": {
              "@type": "WarrantyPromise",
              "durationOfWarranty": {
                  "@type": "QuantitativeValue",
                  "value": {{ product.metafields.productmeta.warranty_info | remove: 'year' | remove : 'years' | remove: ' ' }},
                  "unitCode": "ANN"
              },
              "warrantyScope": "http://purl.org/goodrelations/v1#PartsAndLabor-BringIn",
              "description": "{%  render 'product_warranty_description', productwarranty: product.metafields.productmeta.warranty_info %}"
          },
          {% endif %}
          "priceCurrency": "{{ cart.currency.iso_code }}",
          "lowPrice": "{{ product.price_min | divided_by: 100.00 }}",
          "highPrice": "{{ product.price_max | divided_by: 100.00 }}",
          "offerCount": {{ product.variants.size }},
          "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
          "url": "{{ product_url }}",
          "shippingDetails": {
            "@type": "OfferShippingDetails",
            "shippingDestination": {
              "@type": "DefinedRegion",
              "addressCountry": "AU",
              "addressRegion": [
                "NSW",
                "VIC",
                "QLD",
                "SA",
                "WA",
                "TAS",
                "ACT",
                "NT"
              ]
            },
            "deliveryTime": {
              "@type": "ShippingDeliveryTime",
              "handlingTime": {
                "@type": "QuantitativeValue",
                "minValue": 1,
                "maxValue": 5,
                "unitCode": "DAY"
              },
              "transitTime": {
                "@type": "QuantitativeValue",
                "minValue": 3,
                "maxValue": 9,
                "unitCode": "DAY"
              },
              "cutoffTime": "15:00:00+10:00",
              "businessDays": {
                "@type": "OpeningHoursSpecification",
                "dayOfWeek": [
                  "https://schema.org/Monday",
                  "https://schema.org/Tuesday",
                  "https://schema.org/Wednesday",
                  "https://schema.org/Thursday",
                  "https://schema.org/Friday"
                ]
              }
            },
            "additionalProperty": {
              "@type": "PropertyValue",
              "name": "Delivery restriction",
              "value": "Metro areas and ground floor only. Contact for non-standard access or regional delivery."
            }
          }
        }
        {%- if product.metafields.app--2519111--reviews.review_average_rating >= 3 -%},
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "{{ product.metafields.app--2519111--reviews.review_average_rating }}",
          "reviewCount": "{{ product.metafields.app--2519111--reviews.review_count }}"
        }
        {%- endif -%}
        {%- if product.variants.size > 1 -%}
        ,
        "hasVariant": [
          {% for variant in product.variants %}
            {%- assign sku_parts = variant.sku | split: '|' -%}
            {%- assign mpn_parts = sku_parts[0] | split: ',' -%}
            {%- assign mpn = '' -%}
            {%- for part in mpn_parts -%}
              {%- if part != 'NONE' and mpn == '' -%}
                {%- assign mpn = part -%}
              {%- endif -%}
            {%- endfor -%}
            {
              "@type": "Product",
              "@id": "{{ product_url }}?variant={{ variant.id }}#variant",
              "name": "{{ product.title | escape }} - {{ variant.title | escape }}",
              "url": "{{ product_url }}?variant={{ variant.id }}",
              "sku": "{{ variant.sku }}",
              {%- if mpn != '' -%}
              "mpn": "{{ mpn }}",
              {%- endif -%}
              {% assign variant_feat_img = variant.featured_image | default: product.featured_image | image_url: width: 1200 %}
              {% unless variant_feat_img contains 'https://' or  variant_feat_img contains 'http://' %}
                {% assign variant_feat_img = variant.featured_image | default: product.featured_image | image_url: width: 1200 |  prepend: 'https:'  %}
              {% endunless %}
              "image": "{{ variant_feat_img }}",
              {% if cleaned_options contains "size" %}
                "size": "{{ variant.option1 }}", 
              {% endif %}
              {% if product.options -%}
              "additionalProperty": [
                {%- for option in product.options -%}
                  {
                    "@type": "PropertyValue",
                    "name": "{{ option |  remove: 'Select a ' }}",
                    "value": "{{ variant.options[forloop.index0] | escape }}"
                  }{%- unless forloop.last -%},{%- endunless -%}
                {%- endfor -%}
              ],
              {% endif -%}
              "isVariantOf": {
                "@type": "ProductGroup",
                "@id": "{{ product_url }}#productgroup",
                "name": "{{ product.title | escape }}"
                {%- comment -%} "productGroupID": "{{ product.variants.first.id }}" {%- endcomment -%}
              },
              "offers": {
                "@type": "Offer",
                "priceCurrency": "{{ cart.currency.iso_code }}",
                "price": "{{ variant.price | divided_by: 100.00 }}",
                "itemCondition": "https://schema.org/NewCondition",
                "availability": "{% if variant.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
                "url": "{{ product_url }}?variant={{ variant.id }}"
              }
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
        {%- endif -%}
      }
    </script>
  </div>
