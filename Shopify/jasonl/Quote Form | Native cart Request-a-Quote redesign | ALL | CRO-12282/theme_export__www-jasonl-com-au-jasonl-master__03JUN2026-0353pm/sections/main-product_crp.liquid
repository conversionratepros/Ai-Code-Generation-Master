                                                        {% assign size_opt_array = size_itemvalue | split:'[opt]' %}
                                                        {% for size_optvalue in size_opt_array %}
                                                             {% if size_optvalue contains '[/opt]' %}
                                                                {% assign size_opt_array_value = size_optvalue | split:'[/opt]' %}
                                                                {% assign size_optonly = size_opt_array_value[0] %}
                                                            {% endif %}
                                                        {% endfor %}
                                                    {% endif %}

                                                    {% if size_itemvalue contains '[redirect]' %}
                                                        {% assign redirect_array = size_itemvalue | split:'[redirect]' %}
                                                        {% for redirectvalue in redirect_array %}
                                                            {% if redirectvalue contains '[/redirect]' %}
                                                                {% assign redirect_arrayvalue = redirectvalue | split:'[/redirect]' %}
                                                                {% assign redirectonly = redirect_arrayvalue[0] %}
                                                            {% endif %}
                                                        {% endfor %}
                                                    {% endif %}


                                                  {% if size_itemvalue contains '[default]' %}
                                                    {% assign selected_size = size_optonly %}
                                                        <li {% if product.handle == redirectonly %}class="active" {% endif %} data-selected="selected"><a href="{{ routes.root_url }}products/{{ redirectonly }}">{{ size_optonly }}</a></li>
                                                  {% else %}
                                                        <li {% if product.handle == redirectonly %}class="active" {% endif %} ><a href="{{ routes.root_url }}products/{{ redirectonly }}">{{ size_optonly }}</a></li>
                                                  {% endif %}
                                               {% endif %}
