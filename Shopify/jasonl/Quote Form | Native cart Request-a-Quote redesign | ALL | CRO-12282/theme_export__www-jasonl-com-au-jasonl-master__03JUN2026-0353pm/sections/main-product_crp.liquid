                </li>
                {%- assign crp_today_ts = 'now' | date: '%s' -%}
                {%- assign crp_avail_ts = product.metafields.productmeta.custom_availability_date | date: '%s' -%}
                {%- if product.metafields.productmeta.custom_availability_date != blank and crp_avail_ts > crp_today_ts -%}
                  {%- assign crp_backorder_date = product.metafields.productmeta.custom_availability_date | date: "%a, %d %b, %Y" -%}
                {%- else -%}
                  {%- assign crp_backorder_date = shop.metafields.custom_fields.availability_date | date: "%a, %d %b, %Y" -%}
                {%- endif -%}
                {%- unless product.available == false and crp_backorder_date == blank -%}
                  <li class="crp-fulfillment-item crp-instock-item">
                    <span class="crp-fulfillment-icon" aria-hidden="true">
                      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M8 14.6667V8M10.6667 11.3333L12 12.6667L14.6667 10" stroke="#161616" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M14 7.41802V5.33335C13.9995 4.85748 13.7454 4.41795 13.3333 4.18002L8.66667 1.51335C8.25413 1.27517 7.74587 1.27517 7.33333 1.51335L2.66667 4.18002C2.25455 4.41795 2.00049 4.85748 2 5.33335V10.6667C2.00073 11.1423 2.25476 11.5815 2.66667 11.8194L7.33333 14.486C7.74575 14.7244 8.25401 14.7247 8.66667 14.4867L9.54667 13.9847" stroke="#161616" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M2.19336 4.66668L8.00003 8.00001L13.8067 4.66668M5.00003 2.84668L10.998 6.27868" stroke="#161616" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                    <span class="crp-fulfillment-text">
                      {%- if product.available -%}{%- unless product.tags contains 'contact-to-purchase' -%}<span class="crp-instock-text"><strong>In stock</strong> - ready to ship now. Get it by <strong class="crp-instock-date">...</strong></span>{%- endunless -%}{%- endif -%}
                      {%- if crp_backorder_date != blank -%}<span class="crp-backorder-text">Estimated availability date: <strong>{{ crp_backorder_date }}</strong></span>{%- endif -%}
                    </span>
                  </li>
                {%- endunless -%}
                <li class="crp-fulfillment-item">
                  <span class="crp-fulfillment-icon" aria-hidden="true">
                   <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                     <path d="M9.33325 12V4.00002C9.33325 3.26413 8.73581 2.66669 7.99992 2.66669H2.66659C1.9307 2.66669 1.33325 3.26413 1.33325 4.00002V11.3334C1.33325 11.7013 1.63198 12 1.99992 12H3.33325M9.99992 12H5.99992M12.6666 12H13.9999C14.3679 12 14.6666 11.7013 14.6666 11.3334V8.90002C14.6663 8.74873 14.6146 8.60203 14.5199 8.48402L12.1999 5.58402C12.0736 5.42586 11.8823 5.33364 11.6799 5.33335H9.33325" stroke="#161616" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
                     <path d="M10 12C10 12.7359 10.5974 13.3334 11.3333 13.3334C12.0692 13.3334 12.6667 12.7359 12.6667 12C12.6667 11.2641 12.0692 10.6667 11.3333 10.6667C10.5974 10.6667 10 11.2641 10 12V12" stroke="#161616" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
                     <path d="M3.33325 12C3.33325 12.7359 3.9307 13.3334 4.66659 13.3334C5.40247 13.3334 5.99992 12.7359 5.99992 12C5.99992 11.2641 5.40247 10.6667 4.66659 10.6667C3.9307 10.6667 3.33325 11.2641 3.33325 12V12" stroke="#161616" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
                   </svg>

                  </span>
                  <span class="crp-fulfillment-text"><strong>10-day fitouts</strong> - completed <strong>anywhere in Australia</strong> in under 10-days.</span>
                </li>
              </ul>
              {%- if product.available and crp_deliverdays > 0 -%}
                <script>
                  document.addEventListener('DOMContentLoaded', function() {
                    if (!document.querySelector('quick-add-modal')) {
                      var el = document.querySelector('.crp-instock-date');
                      if (!el) return;
                      var deliveryDays = {{ crp_deliverdays }};
                      var today = new Date();
                      var hours = today.getHours();
                      var dayName = today.toString().split(' ')[0];
                      if (dayName === 'Sat' || dayName === 'Sun') deliveryDays++;
                      if (hours >= 15 && dayName !== 'Sat' && dayName !== 'Sun') deliveryDays++;
                      for (var i = 0; i < deliveryDays; i++) {
                        today.setDate(today.getDate() + 1);
                        dayName = today.toString().split(' ')[0];
                        if (dayName === 'Sat' || dayName === 'Sun') deliveryDays++;
                      }
                      var days = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
                      var months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
                      el.textContent = days[today.getDay()] + ', ' + today.getDate() + ' ' + months[today.getMonth()] + ' ' + today.getFullYear();
                    }
                  });
                </script>
              {%- endif -%}
              {%- endif -%}

              <div class="qty-cartBtn-holder">
