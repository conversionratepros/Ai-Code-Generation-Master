{%- if settings.assembly_1_title != blank -%}
<li>
  <a class="animate" href="{{ shop.url }}/pages/assembly-detail?category={{settings.assembly_1_title}}">
    {%- if settings.assembly_1_icon != '' and settings.assembly_1_icon != 'null' -%}
    {%- assign icon_url = settings.assembly_1_icon -%}
    {%- render icon_url | prepend: '' | downcase -%}
    {%- endif -%}
    <h4>{{settings.assembly_1_title}}?
      {%- if settings.assembly_1_subtitle != '' and settings.assembly_1_subtitle != 'null' -%}
      <span>{{settings.assembly_1_subtitle}}</span>
      {%- endif -%}
    </h4>
  </a>
</li>
{%- assign assemblyinfo = settings.assembly_1_title | append:'=' | append:settings.assembly_1_subtitle | append:'='| append: icon_url -%}  
{%- endif -%}
