
<details id="Details-menu-drawer-menu-item-resource-{{ forloop.index }}">
    <summary
    id="HeaderDrawer-resource-{{ link.handle }}"
    class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.child_active %} menu-drawer__menu-item--active{% endif %}"
    >
        <strong>Resources</strong>
        <span class="svg-wrapper">
            {{- 'icon-arrow.svg' | inline_asset_content -}}
        </span>
        <span class="svg-wrapper">
            {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
    </summary>
    <div
    id="link-resources-{{ link.handle | escape }}"
    class="menu-drawer__submenu has-submenu gradient motion-reduce"
    tabindex="-1"
    >
        <div class="menu-drawer__inner-submenu">
            <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
            <span class="svg-wrapper">
                {{- 'icon-arrow.svg' | inline_asset_content -}}
            </span>
            Back to Main Menu
            </button>
            {% assign menu = linklists['resources'] %}
            
            
            <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
            {% for childlink in menu.links %}
                <li>
                {% if childlink.links != blank %}
                    <details id="Details-menu-drawer-menu-item-resource-grand-chil">
                        <summary id="HeaderDrawer-resource-child-{{ link.handle }}" class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.child_active %} menu-drawer__menu-item--active{% endif %}">
                                {{ childlink.title | escape }}
                            <span class="svg-wrapper">
                                {{- 'icon-arrow.svg' | inline_asset_content -}}
                            </span>
                            <span class="svg-wrapper">
                                {{- 'icon-caret.svg' | inline_asset_content -}}
                            </span>
                        </summary>

                        <div id="link-{{ link.handle | escape }}" class="menu-drawer__submenu has-submenu gradient motion-reduce" tabindex="-1">
                            <div class="menu-drawer__inner-submenu">
                                <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
                                    <span class="svg-wrapper">
                                        {{- 'icon-arrow.svg' | inline_asset_content -}}
                                    </span>
                                    Back to Resources Menu
                                </button>
                                <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
                                    {%- for grand_child in childlink.links -%}
                                        <li class="">
                                            <a id="HeaderDrawer-resource-{{ grand_child.handle }}-{{ grand_child.handle }}" href="{{ grand_child.url }}" class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if grand_child.current %} menu-drawer__menu-item--active{% endif %}"
                                                {% if grand_child.current %}
                                                aria-current="page"
                                                {% endif %}
                                            >
                                                {{ grand_child.title | escape }}
                                            </a>
                                        </li>
                                    {%- endfor -%}
                                </ul>
                            </div>
                        </div>
                    </details>
                {% else %}
                        <a
                    id="HeaderDrawer-resource-{{ link.handle }}-{{ childlink.handle }}"
                    href="{{ childlink.url }}"
                    class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if childlink.current %} menu-drawer__menu-item--active{% endif %}"
                    {% if childlink.current %}
                        aria-current="page"
                    {% endif %}
                    >
                    {{ childlink.title | escape }}
                    </a>
                {% endif %}
                </li>
            {%- endfor -%}
            
            </ul>
        </div>
    </div>
</details>