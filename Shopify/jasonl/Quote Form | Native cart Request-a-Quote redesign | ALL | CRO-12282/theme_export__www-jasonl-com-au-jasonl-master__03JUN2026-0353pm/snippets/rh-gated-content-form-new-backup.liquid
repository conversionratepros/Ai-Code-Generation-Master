      let utm_label_selector =  form_fields_hidden[i].querySelector('div[name="SIGNUP_FORM_LABEL"]');
      let utm_label = utm_label_selector.textContent;
      let utm_label_remove_blankspace = utm_label.replace(/^\s+|\s+$/gm,'');
