{% comment %} <script>
  function reloadPage(){
    let elements = document.querySelectorAll('#zcOptinSuccessPopup, #zcOptinOverLay');

    elements.forEach(function(element) {
        element.addEventListener('click', function() {
            window.location.reload();
        });
    });
  }
  let demo = document.querySelector(".article-template");

      function callback(mutationList, observer) {
        for (let list of mutationList) {
          if(list.target.id == "zcOptinSuccessPopup"){
            reloadPage();
          }
        }
      }

      let mo = new MutationObserver(callback);
      mo.observe(demo, { childList: true, attributes: true, subtree: true });
</script> 
