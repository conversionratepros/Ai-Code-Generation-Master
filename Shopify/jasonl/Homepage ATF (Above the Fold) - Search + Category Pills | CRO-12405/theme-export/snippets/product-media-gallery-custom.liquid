            </div>
            {% endif %}
            <div class="swiper-wrapper">
                
                    {%- assign counter = 0 -%}
                    {%- assign selected_variant_counter = 1 -%}
                    {%- for media in product.media -%}
                        {%- assign counter = counter | plus:1 -%}

                        {%- comment -%}variant image {%- endcomment -%}
                        {%- for v in product.variants -%}
                            {%- assign variant_id = '' -%}
                            {%- assign variant_options = v.option1 | append: ' ' | append: v.option2 | append: ' ' | append: v.option3 -%}

                            {%- if v.image == media.preview_image-%}
                                {%- assign variant_id = v.id -%}
                                        {%- comment -%} 
                                                Find out index of selected_or_first_available_variant to do active slide item on slider.
                                        {%- endcomment-%}
                                        {%- if variant_id == product.selected_or_first_available_variant.id -%}
                                                {%- assign selected_variant_counter = counter -%}
                                        {%- endif -%}
                                        {%- break -%}
                            {%- endif -%}
                        {%- endfor -%}

                    
                    <div class="swiper-slide" data-media-index="{{counter}}" {% if variant_id != empty %}  data-media-id = "{{media.id}}" data-variant-id = "{{variant_id}}" {% endif %}>
                        <picture>
                            <!-- Source for tablet and desktop devices (min-width: 769px) with retina resolution (2x) -->
                            <source srcset="{{media.preview_image | img_url:'2002x'}} 2x" media="(min-width: 769px) and (min-resolution: 2dppx)">
                            <img src="{{media.preview_image | img_url:'1001x'}}"  alt="{{product.title}}-{{variant_options}}" width="1001" height="667" loading="lazy"/>
                        </picture>
                     </div>
                {%- endfor -%}
            </div>
        </div>
        <!-- Navigation -->
        <div class="nav-and-pagination-wrap">
            <div class="nav-wrap">
                {% if slidenumber > 1 %}<div class="swiper-button-prev swiper-button-prev-prod-gallery"></div>{% endif %}
                <div class="swiper-button-close" id="swiper-button-close">&#10005;</div>
                {% if slidenumber > 1 %}<div class="swiper-button-next swiper-button-next-prod-gallery"></div>{% endif %}
                <!-- If we need pagination -->
            </div>
            <div class="swiper-pagination swiper-pagination-product-slider"></div>
        </div>

        <!-- slider thumbnaile -->
        <div class="swiper-container thumbs-container">
            <div class="swiper-wrapper">
                {%- for media in product.media -%}
                        <div class="swiper-slide">
                            <img src="{{media.preview_image | img_url:'100x'}}" alt="{{product.title}} - Thumbnail {{forloop.index}} " width="100" height="67" loading="lazy"/>
                        </div>
                {%- endfor -%}
            </div>
        </div>


        </div> <!-- product-slider-cnt -->
    </div>
</div>


