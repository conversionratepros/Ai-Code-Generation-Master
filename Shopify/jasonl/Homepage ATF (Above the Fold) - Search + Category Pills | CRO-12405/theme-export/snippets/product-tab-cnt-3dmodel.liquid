<div class="product-models-container">
    <div class="product-models-col-outer">
        <div class="product-models-col">
            <h3 class="title-with-icon">
                <div class="resource-file resource-revit tracking-revit-button">
                    <svg viewBox="0 0 188.3 230.7"><path fill="#112a71" d="M99.5 62.2L27.3 35l81.1 85z"></path><path fill="#174ebe" d="M0 224.7l43.2 6L55 167l-43.3-23.3z"></path><path fill="#123c8f" d="M99.5 62.2l44.3 16.7L89.5 0 27.3 35l72.2 27.2z"></path><path fill="#164dbc" d="M108.4 120l28.4-8.5 7-32.6-44.3-16.7z"></path><path d="M99.5 62.2l44.3 16.7-44.3-16.7z"></path><path fill="#113b8f" d="M108.4 120L27.3 35 11.7 143.7 55 167l8-38.2z"></path><path fill="#164cb9" d="M188.3 203.7L108.4 120 63 128.8 55 167l119.5 63.7z"></path></svg>
                </div>
                Revit (.rfa)
