

{%- assign cities = shop.metafields.fitoutlist.topfitoutlist -%}

{% if cities != empty %}

    {{ 'companies-slider-section-v2.css' | asset_url | stylesheet_tag }}

 {%- assign metaobj_fitout_logos = shop.metaobjects.completed_fitouts_logo.values -%}
    {%- assign metaobj_data = '' -%}
    {%- for item in metaobj_fitout_logos  -%}
        {%- assign img_svg = item.logo_file |  file_url -%}
        {%- assign metaobj_data = metaobj_data | append:item.fitout_name | append:':' | append:img_svg -%}
        {%- unless forloop.last -%}
            {%- assign metaobj_data = metaobj_data |  append: '|' %}
        {%- endunless %}
    {%- endfor %}

{%- assign metaobj_obj = metaobj_data |  split: '|' | json -%} 



    {%- assign desktop_static_logo = "" -%}
    {%- if page.metafields.accentuate.showrom_lp_desktop_static_logo -%}
        {%- assign desktop_static_logo = "has_desktop_static_logo" -%}
    {%- endif -%}

<div class="companies-slider-section {{ desktop_static_logo }}" >
    <div class="slider-title-number-wrap">
        <h2 class="slider-section-title">
            Partnering with 
            {% if page.title contains "Perth" %}
                Perth's
            {% else %}
                Adelaide's 
            {% endif %}
            best
        </h2>
        <div class="slider-title">
            <div class="fitout-number-wrap"><span id="completed-fitouts-number"></span> Fitouts <i>completed</i> this week!</div>
            <img src="{{ 'traiangle-bottom.svg' | asset_url }}" alt="icon" width="100" height="100" class="bottom-arrow" loading="lazy">
        </div>
    </div>
    {%- comment -%} <!-- Slider main container --> {%- endcomment %}
    {%- if desktop_static_logo == "has_desktop_static_logo" -%}
        <div class="lg-static-logo-image">
            <picture>
                <source srcset="{{ page.metafields.accentuate.showrom_lp_desktop_static_logo | file_img_url : '1960x' }} 2x" media="(min-width: 769px) and (min-resolution: 2dppx)">
                <img src="{{ page.metafields.accentuate.showrom_lp_desktop_static_logo | file_img_url : '980x' }}" alt="logo" width="980" height="97" loading="lazy">
            </picture>
        </div>
    {%- endif -%}

    <div class="swiper companies-slider-swpier">
        <div class="swiper-wrapper" id="companies-swiper-wrapper">
           {% for item in page.metafields.accentuate.logo %}
               <div class="swiper-slide logo-only">
                   <div class="swiper-slide-inner">
                       {{ item }}
                   </div>
               </div>
           {% endfor %}
            {%- comment -%} 
            ---------------------------------------------------
            Fitout will be injected here from Javascript
            ---------------------------------------------------
            {%- endcomment %}
        </div>
        <div class="swiper-pagination"></div>
        <div class="swiper-button-prev"></div>
        <div class="swiper-button-next"></div>
        <div class="swiper-scrollbar"></div>
    </div>
</div>
<div>

</div>

<script>
    var metaobj_logos = {{metaobj_obj}};
    var cities = {{ cities | json }};
    let data_items = cities.topfitout;
    document.getElementById('completed-fitouts-number').innerText = cities.totalfitout;
</script>
{% comment %} <script src="{{'companies_list_slider.js' | asset_url }}"></script> {% endcomment %}
 <script>
    const swiperlogo = new Swiper('.companies-slider-swpier', {
        slidesPerView: "auto",
        spaceBetween: 22,
        speed: 400,
        autoplay: {
            delay:3000,
            pauseOnMouseEnter:true
        },
        autoplay: true,
        loop:true,
        breakpoints: {
            768: {  // For screens **768px and above**
                slidesPerView: "auto"
            },
            0: {  // For **mobile screens (0px to 767px)**
                slidesPerView: 3,
                // spaceBetween: 10 // Adjust space for mobile if needed
            }
        }
    });
 </script>


