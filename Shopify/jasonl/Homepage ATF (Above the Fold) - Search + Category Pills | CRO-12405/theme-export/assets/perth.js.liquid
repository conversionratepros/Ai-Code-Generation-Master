// collection page: remove localstorage data for region.showroom to null 
// region.showroom is required just to block collection page redirection to perth URL when filtered from showroom location 
function remove_showroom_data_from_localstorage(force_remove = false ){
  let storedRegion = localStorage.getItem('region');
  if(storedRegion){
    let obj = JSON.parse(storedRegion);
    //TODO: create theme setting for let showrooms below
    let showrooms = ['Sydney','Melbourne','Brisbane','Adelaide','Canberra','Perth','Australia-wide'];
        // Exclude Perth from above array. Above array could be dynamic in future, so below line required in order to minimize modifications in future.
         showrooms = showrooms.filter(city => city !== 'Perth');

    let windowURL = window.location.href;
    
    let foundShowroom = showrooms.find(city => windowURL.toLowerCase().includes(city.toLowerCase()));
   //let foundShowroom = showrooms.find(city => windowURL.toLowerCase().includes('sydney'));
    let is_foundShowroom = !!foundShowroom; // This will be true if foundShowroom is not null or undefined

    if(obj.showroom == null){
      if(is_foundShowroom ){
        // when direct url with location get accessed 
        set_showroom_perth_to_localstorage(window.location.pathname, foundShowroom.toLowerCase());
      }
      return ;
    } 
    let do_showroom_null = false; 
    //if(obj.showroom.name != '' && window.location.href != 'https://'+window.location.host+obj.showroom.url){
    if(obj.showroom.name != '' && is_foundShowroom != true  && obj.showroom.name != 'australia-wide'){
      do_showroom_null = true; 
    }
    if(force_remove == true ){
      do_showroom_null = true;
    }
    if(obj.showroom.name == 'australia-wide' && (windowURL.toLowerCase().includes('perth') || window.location.pathname != obj.showroom.url )){
      do_showroom_null = true;
    }
    if(do_showroom_null == true){
      obj.showroom = null;
      let updatedObject = JSON.stringify(obj);
      localStorage.setItem('region', updatedObject);
    }          
  }
}

  remove_showroom_data_from_localstorage();

