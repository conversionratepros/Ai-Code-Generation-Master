function toggleFeatureCollection(region_data){
  const perthProducts = document.querySelectorAll(".perth-products");
  const allProducts = document.querySelectorAll(".all-products");
  if(region_data.code == 'WA'){
    allProducts.forEach(product => product.classList.add("hidden"));
    perthProducts.forEach(product => product.classList.remove("hidden"));
 }else{
   allProducts.forEach(product => product.classList.remove("hidden"));
   perthProducts.forEach(product => product.classList.add("hidden"));
 }
}