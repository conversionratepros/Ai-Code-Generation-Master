  function updateMenuUrl(region){
        //const region_wa = 'NSW';
        const region_wa = region_perth;
        let currentURL = window.location.pathname.replace(/\/perth$|\+perth$/, '');

        let data_attribute;
            // if region is WA (Western Australia) update url, else normal state even if it out of Australia
            (region == region_wa)?data_attribute = 'data-wa':data_attribute = 'data-nsw';

            //let menuLinks = document.querySelectorAll('.header-main-menu a');
            let menuLinks = document.querySelectorAll('a[data-js_updatemenuurl]');
            menuLinks.forEach((element, index) => {
                let regionURL = element.getAttribute(data_attribute);
                element.setAttribute('href',regionURL);

                let nonRegionURL = new URL(regionURL, window.location.origin).pathname.replace(/\/perth$|\+perth$/, '');
        
                if (currentURL === nonRegionURL) {
                    element.closest('li').classList.add('childmenu-item--active');
                }
            }); 
  }
  
