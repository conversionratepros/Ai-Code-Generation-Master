{% comment %} 
Check if template is collection
Check if it is location collection page except perth

{% endcomment %}

{% if template == 'collection' %}
  {%- assign cities = shop.metafields.custom_fields.location_collection__locations | split: ',' -%}
  {%- assign showroom_locations_except_perth = cities | remove: 'perth' -%}
  {% assign has_city_tag = false %}
  {% for tag in current_tags %}
    {% assign tag_downcase = tag | downcase %}
    {% if showroom_locations_except_perth contains tag_downcase %}
      {% assign has_city_tag = true %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}

{{ 'customer-reviews.css' | asset_url | stylesheet_tag }}
<div
  class="customer-reviews"
  {% if template == 'collection' or template == 'collection.rewards' %}
    {%- unless has_city_tag %}
      style="display: none;"
    {% endunless %}
  {% endif %}
>
  <div class="page-width">
    {%- render 'google-reviews', reviewsLimit: 4 -%}
  </div>
</div>

{% schema %}
{ "name": "Customer Reviews", "tag": "section", "class": "section--customer-reviews left-shadow" }
{% endschema %}
