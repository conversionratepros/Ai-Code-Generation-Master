<script>
    document.addEventListener("DOMContentLoaded", function () {
    const featuredServicePlaceholder = document.getElementById("featured-service-placeholder");
    if (!featuredServicePlaceholder) return;

    const observer = new IntersectionObserver((entries, obs) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        const el = entry.target;

        // add data 
        function handleResponse() {
          JSON.parse(this.responseText);
          // console.log(Object.values(JSON.parse(this.responseText))[0]);
          featuredServicePlaceholder.innerHTML = Object.values(JSON.parse(this.responseText))[0];
          loadScript("{{ 'custom-dot-animate-slider.js' | asset_url }}", function () {
            myScriptInit();
          });
        }

        function myScriptInit() {
          console.log("loaded dot slider");
        }

        function loadScript(src, callback) {
          const script = document.createElement("script");
          script.src = src;
          script.onload = callback;
          script.type = "module"; 
          document.body.appendChild(script);
        }
        const request = new XMLHttpRequest();
        request.addEventListener('load', handleResponse);
        request.open('GET', '/?sections=featured-services-b', true);
        request.send();
        
        // Stop observing after load
        obs.unobserve(el);

      });
    }, {
      rootMargin: "300px"
    });

  observer.observe(featuredServicePlaceholder);
  //   sections.forEach(section => observer.observe(section));
  }); 

</script>
{%- schema -%}
{
"name": "feat-ser-b-placeholder",
"settings": [
{
    "type": "select",
    "id": "bg-color",
    "label": "Section backgound color",
    "options": [
        {
        "value": "light",
        "label": "light"
        },
        {
        "value": "dark",
        "label": "dark"
        }
    ],
    "default": "light"
}
]
}
{%- endschema -%}