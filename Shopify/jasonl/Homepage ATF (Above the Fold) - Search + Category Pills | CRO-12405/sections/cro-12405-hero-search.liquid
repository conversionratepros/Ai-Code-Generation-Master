{{ 'cro-12405-hero-search.css' | asset_url | stylesheet_tag }}

<div class="cro-12405-hero">
  <div class="cro-12405-hero__inner">

    <div class="cro-12405-hero__top">
      <h1 class="cro-12405-hero__heading">
        {{ section.settings.heading_line_1 }}<br>
        <span class="cro-12405-hero__heading-accent">{{ section.settings.heading_accent }}</span>
      </h1>

      <div class="cro-12405-search-wrap">
        {%- if settings.predictive_search_enabled -%}
          <predictive-search class="cro-12405-search" data-loading-text="{{ 'accessibility.loading' | t }}">
        {%- else -%}
          <search-form class="cro-12405-search">
        {%- endif -%}
          <form action="{{ routes.search_url }}" method="get" role="search" class="cro-12405-search__form">
            <div class="cro-12405-search__field">
              <input
                class="cro-12405-search__input"
                id="cro-12405-hero-search-input"
                type="search"
                name="q"
                value="{{ search.terms | escape }}"
                placeholder="{{ section.settings.search_placeholder | escape }}"
                {% if settings.predictive_search_enabled %}
                  role="combobox"
                  aria-expanded="false"
                  aria-owns="predictive-search-results"
                  aria-controls="predictive-search-results"
                  aria-haspopup="listbox"
                  aria-autocomplete="list"
                  autocorrect="off"
                  autocomplete="off"
                  autocapitalize="off"
                  spellcheck="false"
                {% endif %}
              >
              <input type="hidden" name="options[prefix]" value="last">
              <button
                type="reset"
                class="cro-12405-search__reset{% if search.terms == blank %} hidden{% endif %}"
                aria-label="{{ 'general.search.reset' | t }}"
              >
                <span class="cro-12405-search__reset-icon">{{ 'icon-reset.svg' | inline_asset_content }}</span>
              </button>
              <button type="submit" class="cro-12405-search__submit" aria-label="{{ 'general.search.search' | t }}">
                <span class="cro-12405-search__submit-label">{{ section.settings.search_button_label }}</span>
                <span class="cro-12405-search__submit-icon">{{ 'icon-search.svg' | inline_asset_content }}</span>
              </button>
            </div>

            {%- if settings.predictive_search_enabled -%}
              <div class="predictive-search predictive-search--header" tabindex="-1" data-predictive-search>
                {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
              </div>
              <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
            {%- endif -%}
          </form>
        {%- if settings.predictive_search_enabled -%}
          </predictive-search>
        {%- else -%}
          </search-form>
        {%- endif -%}
      </div>

      <div class="cro-12405-hero__quote">
        <span class="cro-12405-hero__quote-text">{{ section.settings.quote_prompt_text }}</span>
        <a
          href="javascript:void(0)"
          class="cro-12405-hero__quote-link get-a-quote-btn-ab get-a-quote-btn-a typeform-share getaquoteclick header-getaquote typeform-embed"
          {{ settings.typeformurls_url_1 }}
          data-tf-on-ready="ready"
        >
          <span>{{ section.settings.quote_link_text }}</span>
          <span class="cro-12405-hero__quote-arrow">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
        </a>
      </div>
    </div>

    <div class="cro-12405-categories">
      <p class="cro-12405-categories__label">{{ section.settings.category_label }}</p>

      <div class="cro-12405-categories__row">
        <button type="button" class="cro-12405-categories__prev" data-cro-12405-prev aria-label="Show previous categories">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M10 4L6 8l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="cro-12405-categories__scroller" data-cro-12405-tiles>
          {%- for block in section.blocks -%}
            {%- if block.type == 'category' -%}
              {%- assign fallback_index = forloop.index0 | modulo: 8 -%}
          {%- liquid
            case fallback_index
              when 0
                assign fallback_data_uri = 'data:image/png;base64,'
              when 1
                assign fallback_data_uri = 'data:image/png;base64,'
              when 2
                assign fallback_data_uri = 'data:image/png;base64,'
              when 3
                assign fallback_data_uri = 'data:image/png;base64,'
              when 4
                assign fallback_data_uri = 'data:image/png;base64,'
              when 5
                assign fallback_data_uri = 'data:image/png;base64,'
              when 6
                assign fallback_data_uri = 'data:image/png;base64,'
              when 7
                assign fallback_data_uri = 'data:image/png;base64,'
            endcase
          -%}
              <a
                href="{{ block.settings.url | default: '#' }}"
                class="cro-12405-tile"
                {{ block.shopify_attributes }}
              >
                <span class="cro-12405-tile__image-wrap">
                  {%- if block.settings.image -%}
                    <img
                      class="cro-12405-tile__image"
                      src="{{ block.settings.image | image_url: width: 192 }}"
                      srcset="{{ block.settings.image | image_url: width: 96 }} 1x, {{ block.settings.image | image_url: width: 192 }} 2x"
                      alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                      width="96"
                      height="96"
                      loading="lazy"
                    >
                  {%- else -%}
                    <img
                      class="cro-12405-tile__image"
                      src="{{ fallback_data_uri }}"
                      alt="{{ block.settings.title | escape }}"
                      width="96"
                      height="96"
                      loading="lazy"
                    >
                  {%- endif -%}
                </span>
                <span class="cro-12405-tile__name">{{ block.settings.title }}</span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <button type="button" class="cro-12405-categories__next" data-cro-12405-next aria-label="Show next categories">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>

  </div>
</div>

<script src="{{ 'cro-12405-hero-search.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "CRO-12405 Hero Search",
  "class": "cro-12405-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Headline (line 1)",
      "default": "Find the perfect pieces for"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Headline (accent line)",
      "default": "your workspace."
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search for chairs, desks, workstations..."
    },
    {
      "type": "text",
      "id": "search_button_label",
      "label": "Search button label (desktop)",
      "default": "Search"
    },
    {
      "type": "text",
      "id": "quote_prompt_text",
      "label": "Quote prompt text",
      "default": "Need a custom fitout solution?"
    },
    {
      "type": "text",
      "id": "quote_link_text",
      "label": "Quote link text",
      "default": "Get a Quote"
    },
    {
      "type": "text",
      "id": "category_label",
      "label": "Category row label",
      "default": "Or browse by category"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Optional — until an image is set, a placeholder image is shown."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category name",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "CRO-12405 Hero Search",
      "blocks": [
        { "type": "category", "settings": { "title": "Chairs" } },
        { "type": "category", "settings": { "title": "Storage" } },
        { "type": "category", "settings": { "title": "Tables" } },
        { "type": "category", "settings": { "title": "Desks" } },
        { "type": "category", "settings": { "title": "Cafe & Breakout" } },
        { "type": "category", "settings": { "title": "Workstations" } },
        { "type": "category", "settings": { "title": "Pods & Acoustics" } },
        { "type": "category", "settings": { "title": "Monitor Arms" } }
      ]
    }
  ]
}
{% endschema %}
