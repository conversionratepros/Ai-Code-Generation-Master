        },
        "case-3": {
          "type": "case",
          "settings": {
            "segment": "enterprise",
            "staff": "120 staff",
            "client": "CreditorWatch",
            "city": "Sydney",
            "scope": "Full fitout",
            "days": "9 days",
            "quote": "They hit every deadline. We've continued to use them for over five years now.",
            "attribution": "Patrick Coghlan — CEO, CreditorWatch"
          }
        }
