    "how_it_works": {
      "type": "cro-hp-how-it-works",
      "blocks": {
        "step-1": {
          "type": "step",
          "settings": {
            "stamp": "Day 0",
            "title": "Chat & measure",
            "desc": "Tell us your headcount, floor and deadline. We'll come and measure — or work straight from your floorplan."
          }
        },
        "step-2": {
          "type": "step",
          "settings": {
            "stamp": "Days 1–2",
            "title": "Free layout & quote",
            "desc": "A real layout for your actual space, with an itemised quote. Yours to keep, no obligation."
          }
        },
        "step-3": {
          "type": "step",
          "settings": {
            "stamp": "Days 3–8",
            "title": "We pick & deliver",
            "desc": "Everything's in stock in our Australian warehouses — not on a ship. Our trucks, our schedule."
          }
        },
        "step-4": {
          "type": "step",
          "settings": {
            "stamp": "By day 10",
            "title": "Installed & working",
            "desc": "Our own installers build it, place it and take every box away. You walk in to a finished office."
          }
        }
      },
      "block_order": [
        "step-1",
        "step-2",
        "step-3",
        "step-4"
      ],
      "settings": {}
    },
