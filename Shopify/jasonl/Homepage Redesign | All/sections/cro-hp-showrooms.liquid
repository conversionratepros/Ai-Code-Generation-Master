{%- comment -%}
  CRO-HP — S9 Showrooms. PORTED from CRO-12526 v2's QA-hardened section
  (cro-12526-v2-showrooms.liquid, 15 QA rounds) — same 2026 design system.
  Class names kept verbatim (cro12526v2-*); styles live in cro-hp.css
  (ported block), behaviour in cro-hp.js (initShowrooms12526).

  Kept from the 12526 build: store{N}_showroom_* global settings as the
  data source; East Coast Distribution + Granville exclusions; address
  note-line cleanup (Bug 22); handleized modal names (Bug 23 — "&" broke
  the modal selector); native custom-modal-virtual-tour reuse with hidden
  trigger forwarded by JS; hover/focus-driven side image; mobile
  accordion with single-open + toggle-off (Bug 56).

  Homepage adaptations: crohp-container instead of page-width (band
  alignment with the other cro-hp sections); id="cro-hp-showrooms" kept
  for the footer/final-CTA anchors; the ten-beat spec's soft-conversion
  CTA ("Book a showroom walk-through", sitewide Typeform) kept in the
  title row.
{%- endcomment -%}

{{ 'cro-hp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cro-hp.js' | asset_url }}" defer="defer"></script>

<div class="cro12526v2-showrooms" id="cro-hp-showrooms">
  <div class="crohp-container">
    <div class="crohp-rooms-head-row">
      <div class="cro12526v2-showrooms__title">
        <div class="cro12526v2-eyebrow">
          <span class="cro12526v2-eyebrow__dot" aria-hidden="true"></span>
          <span class="cro12526v2-eyebrow__text">{{ section.settings.eyebrow }}</span>
        </div>
        <h2 class="cro12526v2-showrooms__heading">{{ section.settings.heading }}</h2>
        {%- if section.settings.mobile_subtext != blank -%}
          <p class="cro12526v2-showrooms__subtext">{{ section.settings.mobile_subtext }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.cta_label != blank -%}
        <a class="crohp-btn crohp-btn--lime crohp-rooms-cta typeform-share getaquoteclick typeform-embed"
          {{ settings.typeformurls_url_1 }}
          href="javascript:void(0)"
          data-tf-on-ready="ready"
          data-crohp-typeform>
          {{- section.settings.cta_label -}}
        </a>
      {%- endif -%}
    </div>

    <div class="cro12526v2-showrooms__layout">
      <div class="cro12526v2-showrooms__rows">
        {%- assign store_counts = 8 -%}
        {%- assign row_index = 0 -%}
        {%- for i in (1..store_counts) -%}
          {%- liquid
            assign itemid_name = 'store' | append: i | append: '_showroom_name'
            assign itemid_address = 'store' | append: i | append: '_showroom_address'
            assign itemid_phone = 'store' | append: i | append: '_showroom_phone'
            assign itemid_img_photo = 'store' | append: i | append: '_showroom_img_photo'
            assign itemid_page_url = 'store' | append: i | append: '_showroom_page'
            assign itemid_matterport = 'store' | append: i | append: '_matterport_id'
            assign itemid_order = 'store' | append: i | append: '_showroom_order'
            assign itemid_gmaplink = 'store' | append: i | append: '_showroom_link'
            assign sr_name = settings[itemid_name]
          -%}
          {%- if sr_name == blank -%}{%- continue -%}{%- endif -%}
          {%- if sr_name contains 'East Coast Distribution' -%}{%- continue -%}{%- endif -%}
          {%- unless settings[itemid_address] contains 'Granville' -%}
            {%- assign row_index = row_index | plus: 1 -%}
            <div
              class="cro12526v2-showrooms__row{% if row_index == 1 %} is-active{% endif %}"
              data-cro12526v2-showroom-row
              data-cro12526v2-showroom-index="{{ row_index }}"
              style="order:{{ settings[itemid_order] | default: row_index }}"
            >
              <p class="cro12526v2-showrooms__name">
                <span>{{ sr_name | remove: 'showroom' | remove: 'Showroom' | remove: '& Distribution Centre' | remove: '&amp; Distribution Centre' | strip }}</span>
                <span class="cro12526v2-showrooms__chevron" aria-hidden="true"></span>
              </p>
              {%- liquid
                assign sr_address = settings[itemid_address] | newline_to_br | replace: '<br />', ' ' | replace: '<br/>', ' ' | replace: '<br>', ' ' | strip_html
                assign sr_address = sr_address | split: '(' | first
                assign sr_address = sr_address | split: 'Opposite' | first | strip
                assign sr_last = sr_address | slice: -1, 1
                if sr_last == ','
                  assign sr_trim_len = sr_address.size | minus: 1
                  assign sr_address = sr_address | slice: 0, sr_trim_len
                endif
              -%}
              <p class="cro12526v2-showrooms__address">{{ sr_address }}</p>
              <div class="cro12526v2-showrooms__tour" data-cro12526v2-tour>
                {%- if settings[itemid_matterport] != blank -%}
                  <button type="button" class="cro12526v2-showrooms__tour-btn" data-cro12526v2-tour-btn>
                    <strong>360&deg;</strong>&nbsp;Virtual walk-through
                  </button>
                  <div class="cro12526v2-showrooms__tour-native" hidden>
                    {%- assign sr_modal_name = sr_name | handleize -%}
                    {%- render 'custom-modal-virtual-tour', location_name: sr_modal_name, matterportlink: settings[itemid_matterport] -%}
                  </div>
                {%- endif -%}
              </div>
              <a class="cro12526v2-showrooms__phone" href="tel:{{ settings[itemid_phone] | replace: ' ', '' }}">{{ settings[itemid_phone] }}</a>
              {%- if settings[itemid_gmaplink] != blank -%}
                <a class="cro12526v2-showrooms__google" href="{{ settings[itemid_gmaplink] }}" target="_blank" rel="noopener noreferrer">
                  <span>See on Google</span>
                  <svg width="20" height="8" viewBox="0 0 20 8" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M1 4H19M19 4L15.5 1M19 4L15.5 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              {%- endif -%}
              <a class="cro12526v2-showrooms__link" href="/pages/{{ settings[itemid_page_url] }}" aria-label="View {{ sr_name | escape }} page">
                <svg width="20" height="8" viewBox="0 0 20 8" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M1 4H19M19 4L15.5 1M19 4L15.5 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
              {%- if settings[itemid_img_photo] -%}
                <template data-cro12526v2-showroom-img>
                  <img
                    src="{{ settings[itemid_img_photo] | image_url: width: 742 }}"
                    alt="{{ sr_name | escape }}"
                    width="371"
                    height="664"
                    loading="lazy"
                  >
                </template>
              {%- endif -%}
            </div>
          {%- endunless -%}
        {%- endfor -%}
      </div>

      <div class="cro12526v2-showrooms__image" data-cro12526v2-showroom-image aria-hidden="true"></div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CRO HP Showrooms",
  "tag": "section",
  "class": "cro-hp-rooms-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Come see it" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Showrooms? Seven of them" },
    {
      "type": "textarea",
      "id": "mobile_subtext",
      "label": "Mobile sub-text (under the heading, mobile only)",
      "default": "Tell us the headcount and the space. We'll come back with a layout, a single quote and an install date — desks, chairs, storage, pods, the lot. One conversation instead of forty product pages."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label (opens Typeform)",
      "default": "Book a showroom walk-through"
    },
    {
      "type": "paragraph",
      "content": "Showroom names, addresses, phones, images and 360° tour IDs come from Theme settings → the global store1–store8 showroom fields (same source as the site's existing showrooms)."
    }
  ],
  "presets": [{ "name": "CRO HP Showrooms" }]
}
{% endschema %}
