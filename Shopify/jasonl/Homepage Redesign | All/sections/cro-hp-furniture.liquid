{% comment %}
  CRO-HP — S7 Furniture door: "Need furniture only? Sorted." Board node 2:107.
  Self-contained, clearly-labelled retail zone AFTER the complete fitout
  argument — product merchandising never interleaves into the fitout story.
  Grid data is live from a merchant-picked collection (no hand-typed SKUs —
  the duplicated-SKU bug is the cautionary tale). Deduped by handle,
  unavailable products skipped.
  Section id anchor "cro-hp-furniture" is the hero's default
  "Shop furniture" jump target.
{% endcomment %}

{{ 'cro-hp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cro-hp.js' | asset_url }}" defer="defer"></script>

<section class="crohp-section crohp-furn" id="cro-hp-furniture">
  <div class="crohp-container">
    <div class="crohp-furn__head">
      <div class="crohp-head">
        <p class="crohp-head__eyebrow crohp-eyebrow"><span class="crohp-head__dot" aria-hidden="true"></span>{{ section.settings.eyebrow }}</p>
        <h2 class="crohp-head__title">{{ section.settings.heading }}</h2>
        <p class="crohp-furn__intro">{{ section.settings.intro }}</p>
      </div>
      {%- if section.settings.shop_all_label != blank -%}
        <a class="crohp-btn crohp-btn--outline-light" href="{{ section.settings.shop_all_url | default: routes.all_products_collection_url }}">
          {{- section.settings.shop_all_label -}}
          <span class="crohp-btn__arrow">
            <svg width="20" height="8" viewBox="0 0 19.263 7.194" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M15.5754 0L14.5041 1.0447L16.3749 2.86773H0V4.34578H16.3504L14.5 6.14932L15.5715 7.19402L19.263 3.59474L15.5754 0Z" fill="currentColor"/></svg>
          </span>
        </a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="crohp-furn__chips">
        {%- for block in section.blocks -%}
          {%- assign chip_url = block.settings.url -%}
          {%- if chip_url == blank and block.settings.collection != blank -%}
            {%- assign chip_url = block.settings.collection.url -%}
          {%- endif -%}
          <a class="crohp-furn__chip" href="{{ chip_url }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- liquid
      comment
        Template JSON can't preset a collection picker, so fall back to the
        automatic all-products collection — the grid is never empty on first
        render. Pick a curated collection in the editor for the real test.
      endcomment
      assign grid_collection = section.settings.collection
      if grid_collection == blank
        assign grid_collection = collections.all
      endif
    -%}
    {%- if grid_collection != blank -%}
      <div class="crohp-furn__grid">
        {%- assign shown = 0 -%}
        {%- assign seen_handles = '' -%}
        {%- for product in grid_collection.products limit: 24 -%}
          {%- if shown >= section.settings.product_limit -%}{%- break -%}{%- endif -%}
          {%- assign handle_token = product.handle | append: '|' -%}
          {%- unless seen_handles contains handle_token or product.available == false -%}
            {%- assign seen_handles = seen_handles | append: handle_token -%}
            {%- assign shown = shown | plus: 1 -%}
            <a class="crohp-furn__card" href="{{ product.url }}">
              <span class="crohp-furn__thumb">
                {%- if product.featured_image -%}
                  <img src="{{ product.featured_image | image_url: width: 300 }}" alt="{{ product.title | escape }}" loading="lazy" width="150" height="100">
                {%- endif -%}
              </span>
              <span>
                <span class="crohp-furn__card-title">{{ product.title }}</span>
                <span class="crohp-furn__card-price">
                  {%- if product.price_varies -%}from {% endif -%}
                  {{- product.price | money -}}
                </span>
              </span>
            </a>
          {%- endunless -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "CRO HP Furniture Door",
  "tag": "section",
  "class": "cro-hp-furniture-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The other door"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Need furniture only? Sorted."
    },
    {
      "type": "inline_richtext",
      "id": "intro",
      "label": "Intro line",
      "default": "<strong>4,000+ commercial-grade products in stock</strong> — with same-day or next-day delivery in metro Sydney, Melbourne and Brisbane."
    },
    {
      "type": "text",
      "id": "shop_all_label",
      "label": "Button label",
      "default": "Shop all furniture"
    },
    {
      "type": "url",
      "id": "shop_all_url",
      "label": "Button link",
      "info": "Blank = /collections/all"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Product grid collection",
      "info": "Live data — prices and availability always current; duplicates deduped by handle"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Products shown",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Category chip",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Chairs" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "url", "label": "Custom link (overrides collection)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "CRO HP Furniture Door",
      "blocks": [
        { "type": "chip", "settings": { "label": "Chairs" } },
        { "type": "chip", "settings": { "label": "Desks" } },
        { "type": "chip", "settings": { "label": "Workstations" } },
        { "type": "chip", "settings": { "label": "Storage" } },
        { "type": "chip", "settings": { "label": "Tables" } },
        { "type": "chip", "settings": { "label": "Privacy pods" } },
        { "type": "chip", "settings": { "label": "Sofas & lounges" } },
        { "type": "chip", "settings": { "label": "Whiteboards" } },
        { "type": "chip", "settings": { "label": "Acoustics" } }
      ]
    }
  ]
}
{% endschema %}
