{% comment %}
  CRO-HP — S5 Case studies: "See for yourself." Board node 2:243.
  Three STATIC cards — no carousel (hidden slides are unseen slides).
  Rules (spec): quotes must be specific and verified; three genuinely
  different segments; the "days" figure on every card.
  QA must-fixes carried in defaults for visibility until content lands:
  4.5 identical quotes → replace with three verified distinct quotes;
  4.6 ABC Ballarat city label (board says Perth) → verify;
  4.7 subcopy no longer duplicates How It Works (fixed here).
{% endcomment %}

{{ 'cro-hp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cro-hp.js' | asset_url }}" defer="defer"></script>

<section class="crohp-section crohp-cases" id="cro-hp-cases">
  <div class="crohp-container">
    <div class="crohp-cases__head">
      <div class="crohp-head">
        <p class="crohp-head__eyebrow crohp-eyebrow"><span class="crohp-head__dot" aria-hidden="true"></span>{{ section.settings.eyebrow }}</p>
        <h2 class="crohp-head__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.sub != blank -%}
          <p class="crohp-head__sub">{{ section.settings.sub }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.all_label != blank -%}
        <a class="crohp-btn crohp-btn--lime" href="{{ section.settings.all_url }}">
          {{- section.settings.all_label -}}
          <span class="crohp-btn__arrow">
            <svg width="20" height="8" viewBox="0 0 19.263 7.194" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M15.5754 0L14.5041 1.0447L16.3749 2.86773H0V4.34578H16.3504L14.5 6.14932L15.5715 7.19402L19.263 3.59474L15.5754 0Z" fill="currentColor"/></svg>
          </span>
        </a>
      {%- endif -%}
    </div>

    <div class="crohp-cases__grid">
      {%- for block in section.blocks -%}
        <article class="crohp-case" {{ block.shopify_attributes }}>
          <div class="crohp-case__photo">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 956 }}" alt="{{ block.settings.client | escape }} fitout" loading="lazy" width="478" height="370">
            {%- endif -%}
            {%- if block.settings.segment != blank -%}
              <span class="crohp-case__tag"><strong>{{ block.settings.segment }}</strong>&nbsp;&nbsp;&bull;&nbsp;&nbsp;{{ block.settings.staff }}</span>
            {%- endif -%}
          </div>
          <h3 class="crohp-case__client">{{ block.settings.client }}</h3>
          <p class="crohp-case__data">{{ block.settings.city }}&nbsp;&nbsp;&bull;&nbsp;&nbsp;{{ block.settings.scope }}&nbsp;&nbsp;&bull;&nbsp;&nbsp;{{ block.settings.days }}</p>
          <div class="crohp-case__quote">
            <p>&ldquo;{{ block.settings.quote }}&rdquo;</p>
            <p class="crohp-case__attr">{{ block.settings.attribution }}</p>
          </div>
          {%- if block.settings.url != blank -%}
            <a class="crohp-case__link" href="{{ block.settings.url }}">
              {{ section.settings.card_link_label }}
              <svg width="18" height="7" viewBox="0 0 19.263 7.194" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M15.5754 0L14.5041 1.0447L16.3749 2.86773H0V4.34578H16.3504L14.5 6.14932L15.5715 7.19402L19.263 3.59474L15.5754 0Z" fill="currentColor"/></svg>
            </a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CRO HP Case Studies",
  "tag": "section",
  "class": "cro-hp-cases-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Recent fitouts"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See for yourself.",
      "info": "Board draft alternative: \"Big or small, we've done one like yours.\""
    },
    {
      "type": "textarea",
      "id": "sub",
      "label": "Subcopy",
      "default": "Three recent projects — different sizes, different scopes, same deadline.",
      "info": "QA 4.7: must NOT duplicate the How It Works subcopy"
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "Section button label",
      "default": "All case studies"
    },
    {
      "type": "url",
      "id": "all_url",
      "label": "Section button link"
    },
    {
      "type": "text",
      "id": "card_link_label",
      "label": "Card link label",
      "default": "See the fitout"
    }
  ],
  "blocks": [
    {
      "type": "case",
      "name": "Case study",
      "limit": 3,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "segment", "label": "Segment tag (bold)", "default": "small business", "info": "The three cards must show three genuinely different segments" },
        { "type": "text", "id": "staff", "label": "Headcount tag", "default": "6 staff" },
        { "type": "text", "id": "client", "label": "Client name", "default": "Loftwork Studio" },
        { "type": "text", "id": "city", "label": "City", "default": "Sydney" },
        { "type": "text", "id": "scope", "label": "Scope", "default": "Desks, seating & storage" },
        { "type": "text", "id": "days", "label": "Days", "default": "3 days", "info": "Spec rule: the days figure appears on every card" },
        { "type": "textarea", "id": "quote", "label": "Client quote (no quote marks)", "info": "QA 4.5 must-fix: specific, verified, distinct per card — deadlines hit, problems handled, repeat business. Never generic." },
        { "type": "text", "id": "attribution", "label": "Attribution", "default": "Name — Role, Company" },
        { "type": "url", "id": "url", "label": "Case study link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "CRO HP Case Studies",
      "blocks": [
        {
          "type": "case",
          "settings": {
            "segment": "small business", "staff": "6 staff", "client": "Loftwork Studio",
            "city": "Sydney", "scope": "Desks, seating & storage", "days": "3 days",
            "quote": "[QA 4.5 — replace with a verified Loftwork Studio quote]",
            "attribution": "Emma Gourley — CEO, Loftwork Studio"
          }
        },
        {
          "type": "case",
          "settings": {
            "segment": "growing team", "staff": "25 staff", "client": "ABC Ballarat",
            "city": "Perth", "scope": "Workstations & Breakout", "days": "6 days",
            "quote": "[QA 4.5 — replace with a verified ABC Ballarat quote; QA 4.6 — verify city (board says Perth for a Ballarat-named client)]",
            "attribution": "Jennifer Ammy — CEO, ABC Ballarat"
          }
        },
        {
          "type": "case",
          "settings": {
            "segment": "enterprise", "staff": "120 staff", "client": "CreditorWatch",
            "city": "Sydney", "scope": "Full fitout", "days": "9 days",
            "quote": "They hit every deadline. We've continued to use them for over five years now.",
            "attribution": "Patrick Coghlan — CEO, CreditorWatch"
          }
        }
      ]
    }
  ]
}
{% endschema %}
