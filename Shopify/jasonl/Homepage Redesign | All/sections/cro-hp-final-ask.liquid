{%- comment -%}
  CRO-HP — S10 Final ask. PORTED from CRO-12526 v2's QA-hardened section
  (cro-12526-v2-final-cta.liquid) — same 2026 design system, class names
  kept verbatim; styles in cro-hp.css (ported block).

  Homepage adaptations:
  - crohp-container instead of page-width
  - data-crohp-final-ask on the wrapper (sticky mobile bar hides while
    this band is in view — cro-hp.js observer)
  - data-crohp-typeform on the CTA (estimator answers ride into the
    Typeform as hidden fields)
  - showroom link defaults to this page's #cro-hp-showrooms anchor
  - the 12526 mobile-only brand block is omitted: the homepage renders
    its own footer (cro-hp-footer) with the brand block on all viewports
{%- endcomment -%}

{{ 'cro-hp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cro-hp.js' | asset_url }}" defer="defer"></script>

<div class="cro12526v2-finalcta" data-crohp-final-ask>
  <div class="crohp-container cro12526v2-finalcta__inner">
    <div class="cro12526v2-finalcta__left">
      <div class="cro12526v2-eyebrow cro12526v2-eyebrow--ondark">
        <span class="cro12526v2-eyebrow__dot" aria-hidden="true"></span>
        <span class="cro12526v2-eyebrow__text">{{ section.settings.eyebrow }}</span>
      </div>
      <h2 class="cro12526v2-finalcta__heading">{{ section.settings.heading }}</h2>
      <a class="cro12526v2-finalcta__btn typeform-share get-a-quote-btn-ab getaquoteclick"
        href="javascript:void(0)"
        {{ settings.typeformurls_url_1 }}
        data-tf-on-ready="ready"
        data-crohp-typeform>
        <span>{{ section.settings.button_label }}</span>
        <svg width="20" height="8" viewBox="0 0 20 8" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M1 4H19M19 4L15.5 1M19 4L15.5 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <p class="cro12526v2-finalcta__note">{{ section.settings.note }} <strong>{{ section.settings.note_bold }}</strong></p>
    </div>
    <div class="cro12526v2-finalcta__right">
      <p class="cro12526v2-finalcta__copy">{{ section.settings.copy }}</p>
      <p class="cro12526v2-finalcta__call">
        Call <a href="tel:{{ section.settings.phone | replace: ' ', '' }}">{{ section.settings.phone }}</a>
      </p>
      <p class="cro12526v2-finalcta__meta">
        <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
        <span aria-hidden="true">&nbsp;&middot;&nbsp;</span>
        Prefer to see it first?
        <a class="cro12526v2-finalcta__showroom-link" href="{{ section.settings.showroom_url | default: '#cro-hp-showrooms' }}"><strong>Book a showroom visit</strong>&nbsp;&rarr;</a>
      </p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CRO HP Final Ask",
  "tag": "section",
  "class": "cro-hp-ask-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "No obligation, no runaround" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tell us what you're planning." },
    { "type": "text", "id": "button_label", "label": "Button label (opens Typeform)", "default": "Plan my fitout" },
    { "type": "text", "id": "note", "label": "Note under button", "default": "Takes 60 seconds." },
    { "type": "text", "id": "note_bold", "label": "Note bold tail", "default": "No spam, no obligation" },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Right column copy",
      "default": "JasonL team will come back within 2 business hours on weekdays — no obligation, no runaround. And if we're not the right fit, we'll tell you."
    },
    { "type": "text", "id": "phone", "label": "Phone", "default": "1300 864 264" },
    { "type": "text", "id": "email", "label": "Email", "default": "sales@jasonl.com.au" },
    { "type": "url", "id": "showroom_url", "label": "Showroom link", "info": "Blank = jump to the showrooms section" }
  ],
  "presets": [{ "name": "CRO HP Final Ask" }]
}
{% endschema %}
