{% comment %}
  CRO-HP — S8 People: "Delightful support from real people." Board node 2:88.
  Zac's section preserved almost verbatim (photo, tenure story, signature)
  + the DigiDirect testimonial as a quote bubble.
  NEW: "Talk to Zac's team" — first time this section has a conversion job
  (opens the sitewide Typeform popup).
  Photo/signature ship as bundled board exports (cro-hp-zac.png,
  cro-hp-zac-signature.png); merchant uploads win when set.
{% endcomment %}

{{ 'cro-hp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cro-hp.js' | asset_url }}" defer="defer"></script>

<section class="crohp-section crohp-people">
  <div class="crohp-container">
    <div class="crohp-people__grid">
      <div class="crohp-people__visual">
        {%- if section.settings.photo != blank -%}
          <img class="crohp-people__photo" src="{{ section.settings.photo | image_url: width: 1840 }}" alt="{{ section.settings.photo.alt | default: 'Zac, Chief Operating Officer' | escape }}" loading="lazy" width="920" height="799">
        {%- else -%}
          <img class="crohp-people__photo" src="{{ 'cro-hp-zac.png' | asset_url }}" alt="Zac, Chief Operating Officer" loading="lazy" width="920" height="799">
        {%- endif -%}

        {%- if section.settings.quote != blank -%}
          <div class="crohp-people__quote">
            <p>&ldquo;{{ section.settings.quote }}&rdquo;</p>
            <p class="crohp-people__quote-attr">{{ section.settings.quote_attr }}</p>
          </div>
        {%- endif -%}
      </div>

      <div class="crohp-people__content">
        <div class="crohp-head">
          <p class="crohp-head__eyebrow crohp-eyebrow"><span class="crohp-head__dot" aria-hidden="true"></span>{{ section.settings.eyebrow }}</p>
          <h2 class="crohp-head__title" style="max-width:500px;">{{ section.settings.heading }}</h2>
        </div>
        <div class="crohp-people__body">{{ section.settings.body }}</div>

        <div class="crohp-people__cta">
          <a class="crohp-btn crohp-btn--lime typeform-share getaquoteclick typeform-embed"
            {{ settings.typeformurls_url_1 }}
            href="javascript:void(0)"
            data-tf-on-ready="ready"
            data-crohp-typeform>
            {{- section.settings.cta_label -}}
            <span class="crohp-btn__arrow">
              <svg width="20" height="8" viewBox="0 0 19.263 7.194" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M15.5754 0L14.5041 1.0447L16.3749 2.86773H0V4.34578H16.3504L14.5 6.14932L15.5715 7.19402L19.263 3.59474L15.5754 0Z" fill="currentColor"/></svg>
            </span>
          </a>
        </div>

        {%- if section.settings.signature != blank -%}
          <img class="crohp-people__signature" src="{{ section.settings.signature | image_url: width: 314 }}" alt="Signature" loading="lazy" width="157" height="49">
        {%- else -%}
          <img class="crohp-people__signature" src="{{ 'cro-hp-zac-signature.png' | asset_url }}" alt="Signature" loading="lazy" width="157" height="49">
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CRO HP People",
  "tag": "section",
  "class": "cro-hp-people-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Real people"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Delightful support from real people."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Meet Zac, our Chief Operating Officer. With over 10 years at JasonL, Zac was one of our first hires and packed every shipment when we were starting out. His hands-on approach still drives our commitment to fast, personalised fitouts.</p><p>When you enquire, it's Zac's team that answers — accountable adults who've done this a couple of thousand times.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label (opens Typeform)",
      "default": "Talk to Zac's team"
    },
    {
      "type": "image_picker",
      "id": "photo",
      "label": "Photo",
      "info": "Blank = bundled board export of Zac"
    },
    {
      "type": "image_picker",
      "id": "signature",
      "label": "Signature",
      "info": "Blank = bundled board export"
    },
    { "type": "header", "content": "Testimonial bubble" },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote (no quote marks)",
      "default": "When they came on day one, they felt like part of our team — they made us feel at home, which made half of the job easier."
    },
    {
      "type": "text",
      "id": "quote_attr",
      "label": "Attribution",
      "default": "George Graoroski — DigiDirect"
    }
  ],
  "presets": [{ "name": "CRO HP People" }]
}
{% endschema %}
