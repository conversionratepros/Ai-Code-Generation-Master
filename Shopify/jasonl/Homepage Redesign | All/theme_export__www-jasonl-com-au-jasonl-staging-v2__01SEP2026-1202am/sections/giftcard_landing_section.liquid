				<div class="header-right">
					<div class="nav-list">
						<a href="{{ shop.url }}">Visit website</a>
						<a class="phonenumber" href="tel:{{shop.phone}}">{{ shop.phone }}</a>
					</div>
				</div>
			</div>
			<div class="giftpack-conent-main">
				<div class="mini-intro">A FREE GIFT PACK - ON US</div>
				<div class="section-title"><span>Get your
					</span> <br> <span class="highlight-txt">goodie pack</span><span class="small-hide">&nbsp;&nbsp;</span>below</div>
				<div class="section-description">
					<div class="des-title">A little something from us.</div>
					<p>Add your details below for our courier partner Aramex and they'll send it straight out.</p>
				</div>
				<div class="form-container">
					<div data-tf-live="01KSEQ26DF63HYT8F5G321WMPK" data-tf-auto-resize="true"></div>
					<script src="https://embed.typeform.com/next/embed.js"></script>
				</div>
			</div>
			<div class="gift-pack-footer">
				<div class="footer-left">
					<div class="nav-list">
						{% comment %} <span class="link-style">2026 Catalogue: 200 pages</span>
						<span class="link-style">One pair of JasonL socks</span>
						<span class="link-style">Thank you note</span> {% endcomment %}
					</div>
				</div>
				<div class="footer-right">
					&copy; JasonL {{ "now" | date: "%Y" }} 
				</div>
			</div>
		</div>
	</div>
</div>
