{{ 'giftcard_landing_section.css' | asset_url | stylesheet_tag }}
<!-- Community Involvement -->
<div class="giftcard_landing_section">
	{%- assign img_url = 'Gift-pack-background.webp' | file_url -%}

	<img 
		src="{{ 'Gift-pack-background.webp' | file_url }}&width=480" 
		srcset="
			{{ 'Gift-pack-background.webp' | file_url }}&width=480 480w,
			{{ 'Gift-pack-background.webp' | file_url }}&width=768 768w,
			{{ 'Gift-pack-background.webp' | file_url }}&width=1200 1200w,
			{{ 'Gift-pack-background.webp' | file_url }}&width=1600 1600w,
			{{ 'Gift-pack-background.webp' | file_url }}&width=2000 2000w
		"
		sizes="
			(max-width: 768px) 50vw,
        	(max-width: 1200px) 50vw,
        	(max-width: 1600px) 70vw,
        	100vw" 
		class="body-bg" 
		alt="Jasonl gift pack" 
		width="2000" 
		height="2000">
	{% comment %} <img src="{{ 'Gift-pack-background.webp'| file_url }}" class="body-bg" alt="Jasonl gift pack" width="2000" height="2000"> {% endcomment %}
