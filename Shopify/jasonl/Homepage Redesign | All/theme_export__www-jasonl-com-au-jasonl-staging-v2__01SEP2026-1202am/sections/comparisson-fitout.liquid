{{ 'comparisson-fitout.css' | asset_url | stylesheet_tag }}
<div class="comparisson-fitout">
  <div class="page-width">
    <p class="eyebrow">NOT ALL FITOUTS ARE BUILT THE SAME</p>
    <div class="process-fitout-section-top">
      <div class="left-col">
        <h2 class="section-heading">
          Here's where <br>
          we're different.
        </h2>
      </div>
    </div>
    <div class="comparison-section">
      <div class="comparison-scroll">
        <table class="comparison-table">
          <thead>
            <tr>
              <th class="comparison-th">COMPARISON</th>
              <th class="comparison-th comparison-th--highlight">jason.l</th>
              <th class="comparison-th">TYPICAL FITOUT AGENCY</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison-row">
              <td class="comparison-td">Time from sign-off to install</td>
              <td class="comparison-td comparison-td--highlight">
                <span class="comparison-icon comparison-icon--check">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20 6L9 17l-5-5" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                7-10 business days
              </td>
              <td class="comparison-td">
                <span class="comparison-icon comparison-icon--cross">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M18 6L6 18M6 6l12 12" stroke="#e0574c" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                8-14 weeks
              </td>
            </tr>
            <tr class="comparison-row">
              <td class="comparison-td">Stock location</td>
              <td class="comparison-td comparison-td--highlight">
                <span class="comparison-icon comparison-icon--check">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20 6L9 17l-5-5" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                6 Australian warehouses
              </td>
              <td class="comparison-td">
                <span class="comparison-icon comparison-icon--cross">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M18 6L6 18M6 6l12 12" stroke="#e0574c" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                Indent order, overseas
              </td>
            </tr>
            <tr class="comparison-row">
              <td class="comparison-td">Layout &amp; 3D plan</td>
              <td class="comparison-td comparison-td--highlight">
                <span class="comparison-icon comparison-icon--check">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20 6L9 17l-5-5" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                Free, unlimited revisions
              </td>
              <td class="comparison-td">
                <span class="comparison-icon comparison-icon--cross">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M18 6L6 18M6 6l12 12" stroke="#e0574c" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                $5k-$25k design fee
              </td>
            </tr>
            <tr class="comparison-row">
              <td class="comparison-td">Install crew</td>
              <td class="comparison-td comparison-td--highlight">
                <span class="comparison-icon comparison-icon--check">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20 6L9 17l-5-5" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                In-house, employed
              </td>
              <td class="comparison-td">
                <span class="comparison-icon comparison-icon--cross">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M18 6L6 18M6 6l12 12" stroke="#e0574c" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                Subcontracted
              </td>
            </tr>
            <tr class="comparison-row">
              <td class="comparison-td">Project manager</td>
              <td class="comparison-td comparison-td--highlight">
                <span class="comparison-icon comparison-icon--check">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20 6L9 17l-5-5" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                One named contract, start to finish
              </td>
              <td class="comparison-td">
                <span class="comparison-icon comparison-icon--cross">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M18 6L6 18M6 6l12 12" stroke="#e0574c" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                3-4 handoffs
              </td>
            </tr>
            <tr class="comparison-row">
              <td class="comparison-td">Post-install warranty</td>
              <td class="comparison-td comparison-td--highlight">
                <span class="comparison-icon comparison-icon--check">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20 6L9 17l-5-5" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                10-year, local service
              </td>
              <td class="comparison-td">
                <span class="comparison-icon comparison-icon--cross">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M18 6L6 18M6 6l12 12" stroke="#e0574c" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                Manufacturer only
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "comparisson-fitout"
}
{% endschema %}
