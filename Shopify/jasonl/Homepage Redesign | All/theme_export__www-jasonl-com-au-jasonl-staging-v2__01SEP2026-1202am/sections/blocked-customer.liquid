          <div class="bc-user" id="customer-name"></div> {% if  page.metafields.custom_fields.intro_text %} <h3 class="label-date">{{ page.metafields.custom_fields.intro_text }}</h3> {% endif %} <h3 class="label-method"> Select how you prefer to be contacted. </h3>
          <ul class="bc-steps">
            <li class="active"> {% if  page.metafields.custom_fields.title_step_1 %} <span class="step-num">1</span>
              {{ page.metafields.custom_fields.title_step_1 }} {% render 'icon-arrow' %} {{tickicon}} {% endif %}
            </li>
            <li> {% if  page.metafields.custom_fields.title_step_2 %} <span class="step-num">2</span>
