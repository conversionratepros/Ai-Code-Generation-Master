{{ "landingpage-hero.css" | asset_url | stylesheet_tag }}
{{ "landingpage-hero2.css" | asset_url | stylesheet_tag }}
<div class="hero-container hero-container-2">
        <div class="hero-main-wrapper">
                <picture class="hero-picture">
                    <source media="(max-width:465px)" srcset="{{'landingpage2-hero-img-mob.png' | file_img_url:'master'}}">
                    <img src="{{'landingpage2-hero-img.png' | file_img_url:'master'}}" alt="Blank canvas to beautiful fitout. Fast!" width="" height="" />
                </picture>
            <div class="page-width">
                <div class="hero-main-innner-container">
                    <div class="hero-text">
                        <h1 class="h1-style">Blank canvas <br>to beautiful <br>fitout. Fast!</h1>
                        <ul class="disc-number-bullets disc-number-bullets-2">
                            <li>No-obligation floor plan & quote</li>
                            <li>Dedicated project manager every step of the way</li>
                            <li>± 5000 tailored products to choose from</li>
                            <li>Delivery & complete assembly</li>
                        </ul>
                        <a class="typeform-share getaquoteclick button button-secondary" {{ settings.typeformurls_url_1 }} href="javascript:void(0)">
                            Get a quote
                            </a>
                       {% comment %} {%- render 'landingpage-typeform' -%} {% endcomment %}
                    </div>
                    {% comment %} <div class="typeform-snippet-wrap">
                        <div id="typeform-rvv9MINp-1" class="typeform-snippet typeform-share typeform-embed" data-tf-on-submit="submit" data-tf-widget="rvv9MINp" data-tf-iframe-props="title=JasonL - Get A Quote - Inbound" data-tf-medium="snippet" data-tf-hidden="" style="width:390px;height:550px;"></div>
                    </div> {% endcomment %}
                    </div>
                </div>
        </div>

        <div class="hero-column-wrapper">
            <div class="page-width">
                <div class="hero-column">
                    <div class="hero-column-left">
                        <p>Go from an empty office to a quality fitout. Get Australia's #1 most internationally recognised team to help you pick the best product, deliver to your door and assemble, all while your dedicated project manager guides you through every step of the way.</p>
                    </div>
                    <div class="hero-column-right">
                        <div class="img-holder">
                            <img src="{{'landingpage2-chair.png' | file_img_url : 'master'}}" alt="Go from an empty office to a quality fitout" width="" height="" >
                        </div>
                        


                        <div id="typeform-rvv9MINp-1" class="typeform-snippet typeform-share typeform-embed" data-tf-on-submit="submit" data-tf-widget="rvv9MINp" data-tf-iframe-props="title=JasonL - Get A Quote - Inbound" data-tf-medium="snippet" data-tf-hidden="" style="width:390px;height:550px;"></div>
                    

