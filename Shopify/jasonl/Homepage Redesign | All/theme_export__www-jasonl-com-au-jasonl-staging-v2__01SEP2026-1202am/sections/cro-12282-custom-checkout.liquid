{{ 'custom-checkout.css' | asset_url | stylesheet_tag }}
{{ 'cro-12282.css' | asset_url | stylesheet_tag }}

<div class="custom-checkout-holder cro-12282-holder">
  {% render 'cro-12282-header' %}
  <div class="custom-checkout-main">
    <div class="page-width">
      {%- if cart != empty -%}
        <div class="custom-checkout-cols">
          <div class="cols-item cols-left">
            {%- render 'cro-12282-form' -%}
          </div>
          <div class="cols-item cols-right">
            {%- render 'cro-12282-cart-products' -%}
          </div>
        </div>
      {%- else -%}
        <h3>Your cart is currently empty.</h3>
        <p>
          Continue browsing
          <a href="https://www.jasonl.com.au/">here</a>.
        </p>
        <style>
          h3 { margin-top: 30px; margin-bottom: 0; }
          .custom-checkout-main:after { display: none; }
        </style>
      {%- endif -%}
    </div>
  </div>
  <div class="page-width">
    {% render 'form-thankyou-msg' %}
  </div>
</div>

{% schema %}
{
  "name": "CRO-12282 Custom Checkout",
  "settings": []
}
{% endschema %}