<div class="payments-wrapper">
    <div class="page-width">
        <div class="page-header">
            <h1>Payments</h1>
            <p>Select payment method</p>
        </div>
        <div class="has-payment-quote_id" id="has-order-id-info">
            Thank you for approving the quote for Order ID <span id="quote-order-id"></span>. <br>
            Please proceed by selecting your preferred payment option below.
        </div>
    </div>

    <div class="payment-cnt-wrapper">
        <div class="page-width">
            <div class="page-content">
                <div class="payment-options">
                    <a href="#payment-creditcard" class="option creaditcard" data-payment="payment-creditcard">
                        <div class="option-cnt" >
                            <div class="option-cnt-left">
                                <div class="payment-icon">{{cardsIcon}}</div>
                                <p><strong>Credit card</strong></p>
                                <p>1.2% surcharge</p>
                            </div>
                            <div class="option-cnt-left">
                            <button class="button button--primary"></button>
                            </div>
                        </div>
                    </a>
                  {%- comment -%} 
                    date: Wed 18 Sep 2024
                    disabled due issue on payto logic. 
                    disabled files: payments.liquid, cart-payment-options.liquid
                    ==========================================================================
                    <a href="#payment-payto" class="option payto" data-payment="payment-payto">
                            <div class="option-cnt" >
                                <div class="option-cnt-left">
                                    <div class="payment-icon">{{paytoIcon}}</div>
                                    <p><strong>Payto (Bank Transfer)</strong></p>
                                    <p>0% surcharge</p>
                                </div>
                                <div class="option-cnt-left">
                                <button class="button button--primary"></button>
                                </div>
                            </div>
                    </a>
                    ==========================================================================
                    {%- endcomment -%}
                    <div class="option fund-transfer">
                        <div class="extra-info-holder">
                            <div class="option-cnt">
                                {% if  page.metafields.payments.bank_transfer_info  %}
                                    {{ page.metafields.payments.bank_transfer_info }}
                                {% endif  %}
                            </div>
                            <div class="extra-info">
                                {% if page.metafields.payments.bank_transfer_info__more  %}
                                    {{ page.metafields.payments.bank_transfer_info__more }}
                                {% endif %}
                            </div>
                        </div>
                        {% capture  eft_modal_content %}
                            <strong>Electronic funds transfer (EFT)</strong>
                            {% if page.metafields.payments.bank_transfer_info__more  %}
                                    {{ page.metafields.payments.bank_transfer_info__more }}
                                {% endif %}
                            {% endcapture %}
                        <modal-opener class="simple-popup-modal__opener" data-modal="#PopupModal-show-moreinfo-eft">
                            <button class="button button--primary" data-payment="payment-electronicfundtransfer">More info</button>
                        </modal-opener>
                        {%- render 'simple-popup-modal', 
                        modal_id: 'show-moreinfo-eft', 
                        modal_class: '',
                        modal_size:'small', 
                        modal_label:'', 
                        modal_content: eft_modal_content -%}
                    </div>
                </div>
                <div class="payment-content">
                    <div id="payment-creditcard" class="content-item content-item1">
                        {{ page.content }}
                        <div class="powered-by-stripe">
                            <img src="{{'powered-by-stripe-logos.png' |  file_img_url : '150x'}}" alt="powered by stripe" />
                        </div>
                    </div>
                    <div id="payment-payto" class="content-item content-item2">{% render 'payments-payto' %}</div>
                    <div id="payment-electronicfundtransfer" class="content-item content-item3"></div>
                </div>
                </div>
            </div>
            <div class="page-footer">
                <div class="payment-footer-img">
                    <img loading="lazy" src="{{'payment-bg-img.png' |  file_img_url : '742x' }}" alt="Payment" />
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const order_id = localStorage.getItem("quote_automation_order_id");
    console.log(order_id);
    console.log("Quote Automation Prefill form test");
    if(!order_id){
        document.getElementById('has-order-id-info').style.display = 'none';
    }
    if(order_id){
        document.getElementById('has-order-id-info').style.display = 'block';
        /* document.addEventListener('DOMContentLoaded', function(){
            document.getElementById('quote-order-id').innerHTML = order_id;
        }); */
        $.ajax({
            //url: 'https://poptopdesk.com/quotationautomate/Getpipedrivedeals/handlePaymentPrefill/', 
            url: 'https://prnt.jasonl.com.au/quotationautomate/Getpipedrivedeals/handlePaymentPrefill/', 
            type: 'POST', 
            data: {
                order_id: order_id
            },
            dataType: 'json', 
            success: function(response) {
                console.log('Success:', response);
                $("#ajaxcontent").html(response.message);
                var customer_name = encodeURIComponent(response.customername);
                var organization = encodeURIComponent(response.organization);
                var email = encodeURIComponent(response.email);
                var order_number = encodeURIComponent(response.order_number);
                var total = encodeURIComponent(response.total);
                var baseUrl = "https://jasonl.formstack.com/forms/jasonl_payments_v2_copy"; // your original iframe src (without query)
                if(baseUrl = "https://jasonl.formstack.com/forms/jasonl_payments_v2_copy"){
                    //test
                    var newSrc = baseUrl + "?field189558996=" + customer_name + "&field189558997=" + organization + "&field189558998=" + email + "&field189558999=" + order_number + "&field189559000=" + total;
                }else{
                    // live 
                    var newSrc = baseUrl + "?field163531280=" + customer_name + "&field163531281=" + organization + "&field163531282=" + email + "&field163531283=" + order_number + "&field163531284=" + total;
                }
                
                $('#jasonl_payments').attr('src', newSrc);
                document.getElementById('quote-order-id').innerHTML = response.order_number;
            },
            error: function(xhr, status, error) {
                console.log('Error:', status);
                // Handle errors
            }
        });
    }

    
</script>





<script>
    let btns = document.querySelectorAll('[data-payment]');
    btns.forEach((btn,index) => {
        btn.addEventListener('click', function(){
            if(document.querySelectorAll('.active[data-payment]').length > 0){
                document.querySelector('.active[data-payment]').classList.remove('active');
            }
            this.classList.add('active');
            console.log(this.getAttribute('data-payment'));
            let paymentItemId = this.getAttribute('data-payment');
            if(document.querySelectorAll('.content-item.active').length > 0){
                document.querySelector('.content-item.active').classList.remove('active');
            }
            let paymentItem = document.getElementById(paymentItemId);
            paymentItem.classList.add('active');
            if(document.querySelectorAll('.payto_validate_loaded').length < 1){
                if(paymentItemId == 'payment-payto'){
                    initValidate();
                }   
            }
            

        } )
    })

    function initValidate(){
         console.log('init validation');
         document.getElementById('payto_form').classList.add('payto_validate_loaded');
        const validate = new window.JustValidate('#payto_form',{
             submitFormAutomatically: true
        });
        
            validate.addField('#first_name', [
                {
                    rule: 'required',
                },
            ]);
            validate.addField('#last_name', [
                {
                    rule: 'required',
                },
            ]);
            validate.addField('#email', [
                {
                    rule: 'required',
                },
                {
                    rule: 'email',
                }
            ]);
            validate.addField('#invoiceNumber', [
                {
                    rule: 'required',
                },
                {
                rule: 'integer',
                },
            ]);
            validate.addField('#invoiceAmount', [
                {
                    rule: 'required',
                },{
                    rule: 'maxNumber',
                    value: 25000,
                    errorMessage: "Payto doesn't allow payment above AUD 25000. Please use Credit card or EFT",
                },
                {
                    rule: 'minNumber',
                    value: 1,
                }
                 
                
            ]);
    }



</script>
