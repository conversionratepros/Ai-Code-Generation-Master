{{ 'intro-heading-stat-section.css' | asset_url | stylesheet_tag }}
<section class="intro-heading-stat-sec">
  <div class="page-width">
    <p class="eyebrow">ABOUT JASONL</p>
    <h2 class="section-heading">Australia's office fitout specialists</h2>
    <div class="about-section">
      <div class="about-left">
        <p class="body-text">JasonL is an Australian office furniture and fitout company, founded to give businesses a faster, more transparent alternative to traditional fitout agencies. We operate across Sydney, Melbourne, Brisbane, Adelaide, Perth and the Gold Coast, supplying and installing commercial office furniture for businesses of all sizes.</p>
        <p class="body-text">Unlike most fitout companies, JasonL manages the entire process in-house: space planning, furniture selection, interior styling, delivery and installation. There are no freight markups, subcontracted install crews, or surprise costs. Every fitout includes a 10-year structural warranty and a single point of contact from brief to sign-off.</p>
        <p class="body-text">With Australian-held inventory, most fitouts are completed within 7–10 business days from sign-off — not the 10–12 weeks typical of the industry.</p>
      </div>
      <div class="about-right">
        <div class="stat">
          <p class="stat-number">7–10</p>
          <p class="stat-label">Business days, typical install</p>
        </div>
        <div class="stat">
          <p class="stat-number">1,400+</p>
          <p class="stat-label">Fitouts completed</p>
        </div>
        <div class="stat">
          <p class="stat-number">5 States</p>
          <p class="stat-label">With Showrooms</p>
        </div>
        <div class="stat">
          <p class="stat-number">10yr</p>
          <p class="stat-label">Structural warranty</p>
        </div>
      </div>
    </div>
  </div>
</section>

