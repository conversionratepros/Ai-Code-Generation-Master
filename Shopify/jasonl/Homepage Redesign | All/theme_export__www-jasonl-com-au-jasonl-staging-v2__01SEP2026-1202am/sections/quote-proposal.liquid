                                                fill-rule: evenodd;
                                            }

                                            .phoneiconcls-2 {
                                                fill: #c6d644;
                                            }
                                            </style>
                                        </defs>
                                        <g id="phoneiconLayer_1-2" data-name="phoneiconLayer 1">
