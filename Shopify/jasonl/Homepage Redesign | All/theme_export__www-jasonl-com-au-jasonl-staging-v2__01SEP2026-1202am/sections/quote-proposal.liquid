                                            </g>
                                        </g>
                                    </svg>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="info-wrap-section">
                <div class="animatable animate-css">
                    <div class="info-wrap">
                        <div class="quote-info-box">
                            <p>Quote Date: <span id="quote_date"></span> <br>
                                Quote No: <span id="quote_no"></span></p>
                        </div>
                    </div>
                    <div class="info-wrap">
                        <div class="quote-info-box">
                            {{ section.settings.office_address }}
                        </div>
                    </div>
                    <div class="info-wrap">
                        <div class="quote-info-box">
                            <div class="quote-to">
                                <p>
                                <strong>Quote to:</strong> <br>
                                <span class="quote_to_addresss_block"> </span>
                                {% comment %} 
                                <span id="quote_to_name" class="w-100"></span>
                                <span id="quote_to_address_street" class="w-100"></span>
                                <span id="quote_to_address_deliverystate"> </span>
                                <span id="quote_to_address_territorycode"> </span>
                                <span id="quote_to_address_territory"> </span> 
                                {% endcomment %}
                                <br> 
                                <span id="quote_to_address_phone" class="w-100"> </span> <br>
                                {% comment %} CENTURIA <br>
                                Georges Terrace St, <br>
                                WA 6000, Perth.<br>
                                Phone: 0447763226.<br> 
                                {% endcomment %}
                                </p>
                            </div>
                            <div class="deliver-to">
                                <p>
                                <strong>Deliver to:</strong> <br>
                                <span class="deliver_to_addresss_block"> </span>
                                {% comment %} 
                                <span id="deliver_to_name" class="w-100"></span>
                                <span id="deliver_to_street" class="w-100"></span>
                                <span id="deliver_to_deliverystate"></span> 
                                <span id="deliver_to_territorycode"></span> 
                                <span id="deliver_to_territory"></span>
                                {% endcomment %}<br>
                                <span id="deliver_to_phone" class="w-100"></span> 
                                {% comment %} 
                                CENTURIA <br>
                                Georges Terrace St, <br>
                                WA 6000, Perth.<br>
                                Phone: 0447763226.<br> 
                                {% endcomment %}
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="quote-section animate-css">
                <div class="productlist" id="productList"></div>
                <div class="productlist projectservice" id="projectservice-wrap">
                    <div class="product">
                        <div class="product-img">
                        </div>
                        <div class="product-info">
                            <details>
                                <summary>
                                    Project Notes 
                                    <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="9px" height="4px" viewBox="0 0 9 4" class="arrow"><path fill-rule="evenodd"  fill="rgb(0, 0, 0)" d="M8.1000,4.002 L-0.010,4.002 L4.495,0.002 L8.1000,4.002 Z"/></svg> 
                                </summary>
                                <div>
                                    <ul class="project-service-list" id="project-note-list">
                                        <li> Delivery into premises</li>
                                        <li> On-site installation</li>
                                        <li> Damage coverage</li>
                                        <li> Rubbish removal</li>
                                        <li> Dedicated project manager</li>
                                    </ul>
                                </div>
                            </details>
                        </div>
                    </div>
                </div>
                <div class="total-section total-section-first-child">
                    <div class="total-section-inner">
                        <div class="total-row" id="shipping-row">
                            <span class="total-label">Shipping</span>
                            <span class="total-value">$ <span id="total-Shipping"> </span></span>
                        </div>
                        <div class="total-row" id="assembly-row">
                            <span class="total-label">Assembly</span>
                            <span class="total-value">$ <span id="total-assembly"> </span></span>
                        </div>
                        <div class="total-row" id="discount-row">
                            <span class="total-label">Discount</span>
                            <span class="total-value"> <span id="total-discount"> </span></span>
                        </div>
                        <div class="total-row" id="other-row">
                            <span class="total-label">Other</span>
                            <span class="total-value"> <span id="total-other"> </span></span>
                        </div>
                    </div>
                </div>
                <div class="total-section">
                    <div class="total-section-inner rm-bg">
                        <div class="total-row">
                            <span class="total-label">Total (Exc. GST)</span>
                            <span class="total-value">$ <span id="total-ex-gst"> </span></span>
                        </div>
                    </div>
                </div>
                <div class="total-section">
                    <div class="total-section-inner rm-bg">
                        <div class="total-row">
                            <span class="total-label">GST</span>
                            <span class="total-value">$ <span id="total-gst"> </span></span>
                        </div>
                    </div>
                </div>
                <div class="total-section">
                    <div class="total-section-inner rm-bg">
                        <div class="total-row">
                            <span class="total-label"><strong>Total (Inc. GST)</strong></span>
                            <span class="total-value"><strong>$ <span id="grand-total"> </span></strong></span>
                        </div>
                        <div class="row btn-row">
                            <button class="btn button button--primary" id="approve_quote_btn-modal-opener">APPROVE QUOTE</button>
                            <a href="#" class="sales-rep-photo-link">TALK WITH SALES REP<span class="hidden text-uppercase sales-rep-name"></span></a>
                        </div>
                        <div class="note-box">
                            <svg 
                            xmlns="http://www.w3.org/2000/svg"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            width="28px" height="24px" class="note-icon">
                            <path fill-rule="evenodd"  fill="rgb(244, 216, 118)"
                            d="M14.020,0.307 C14.659,0.230 15.323,0.493 15.748,0.967 C19.708,7.704 23.603,14.489 27.479,21.276 C27.919,22.484 27.132,23.765 25.861,23.924 L2.671,23.924 C1.427,23.771 0.637,22.528 1.032,21.333 C4.897,14.518 8.820,7.725 12.784,0.967 C13.068,0.639 13.589,0.359 14.020,0.307 ZM13.371,8.014 C13.167,8.208 12.992,8.527 12.963,8.811 L12.966,14.497 C13.269,15.931 15.275,15.924 15.559,14.490 L15.566,8.735 C15.381,7.744 14.110,7.314 13.371,8.014 ZM15.584,18.208 C15.584,17.480 14.994,16.889 14.266,16.889 C13.538,16.889 12.948,17.480 12.948,18.208 C12.948,18.936 13.538,19.526 14.266,19.526 C14.994,19.526 15.584,18.936 15.584,18.208 Z"/>
                            </svg>
                            <p>
                                This quotation is valid for thirty (30) days and may be amended at any time to reflect supplier price increases and currency fluctuations.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="payment-screen" id="payment-screen">
        {% render 'payments-screen' %}
    </div>
    <div class="thankyou-msg" id="thankyou_msg_box">
        {% render 'thankyou-msg-content' %}
    </div>
</div>
<div class="popup-confirm" style="display: none;" id="popup-confirm-modal">
    <div class="popup-confirm-inner"> 
        <div class="overlay" id="overlay"></div>
        <div class="popupbox" id="popupbox">
            <div class="error-status">
                Confirmation is required to proceed with the quote approval.
            </div>
            <div class="approved-quote-modal-info" style="display: none;">
                <strong>Thank you for approving your quote! <br></strong>
                <span>Please proceed to payment to complete your order.</span>
            </div>
            
            {% comment %} <form action="https://poptopdesk.com/quotationautomate/Getpipedrivedeals/approveQuote" id="approved-form" method="POST"> {% endcomment %}
            <form action="" id="approved-form" method="POST">
                <input type="hidden" name="order_id" value="" id="orderIdField">
                <input type="hidden" name="grand_total" value="" id="grand_total">
                <div class="checkbox-text-label-box">
                    <div class="checkbox-wrap">
                        <input type="checkbox" class="confirm-checkbox" id="confirm-checkbox" name="confirm-checkbox">
                        <div class="custom-checkbox">
                            <svg 
                            xmlns="http://www.w3.org/2000/svg"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            width="17px" height="13px">
                            <path fill-rule="evenodd"  fill="rgb(255, 255, 255)"
                            d="M16.081,2.641 L6.057,12.677 C5.882,12.852 5.599,12.852 5.424,12.677 L0.316,7.563 C0.141,7.388 0.141,7.104 0.316,6.929 L1.442,5.802 C1.617,5.627 1.900,5.627 2.075,5.802 L5.424,9.155 C5.599,9.330 5.882,9.330 6.057,9.155 L14.322,0.880 C14.497,0.705 14.780,0.705 14.955,0.880 L16.081,2.007 C16.256,2.183 16.256,2.466 16.081,2.641 Z"/>
                            </svg>
                        </div>
                    </div>
                    <label for="confirm-checkbox">
                        I confirm that I have carefully reviewed and approved this quote, including all products, pricing, and <a href="/pages/terms-and-condition" class="term-link">terms and conditions</a>.</label>
                </div>
                <div class="checkbox-text-label-box assembly-checkbox">
                    <div class="checkbox-wrap">
                        <input type="checkbox" class="confirm-checkbox" id="deliver-groundfloor-checkbox" name="deliver-groundfloor-checkbox">
                        <div class="custom-checkbox">
                            <svg 
                            xmlns="http://www.w3.org/2000/svg"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            width="17px" height="13px">
                            <path fill-rule="evenodd"  fill="rgb(255, 255, 255)"
                            d="M16.081,2.641 L6.057,12.677 C5.882,12.852 5.599,12.852 5.424,12.677 L0.316,7.563 C0.141,7.388 0.141,7.104 0.316,6.929 L1.442,5.802 C1.617,5.627 1.900,5.627 2.075,5.802 L5.424,9.155 C5.599,9.330 5.882,9.330 6.057,9.155 L14.322,0.880 C14.497,0.705 14.780,0.705 14.955,0.880 L16.081,2.007 C16.256,2.183 16.256,2.466 16.081,2.641 Z"/>
                            </svg>
                        </div>
                    </div>
                    <label for="deliver-groundfloor-checkbox">By choosing Delivery Only, I understand my order may be delivered to the ground floor, depending on service availability in my area.</label>
                </div>
                <div id="buttonwrap">
                    <button type="submit" class="btn button button--primary submitbtn" id="aprove_submit_btn" disabled>PROCEED TO PAYMENT</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% comment %} loader {% endcomment %}
