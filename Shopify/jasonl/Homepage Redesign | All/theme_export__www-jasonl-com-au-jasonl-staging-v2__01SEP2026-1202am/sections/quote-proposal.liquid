{{ 'quote-proposal.css' | asset_url | stylesheet_tag }}
<div class="loading-screen">
    {% render 'quote-delay-msg' %}
    <div class="loading-message"><strong>Please wait</strong> <span>Your quote is getting ready ...</span></div>
    <div class="loader"></div>
</div>
<div class="sticky-quote-info-sm" id="sticy-quote-sm">
    <div class="sticky-quote-info-wrap">
        <div class="quote-intro">
            <p>Quote Date: <span id="sticky-quote-date"></span></p>
            <p>Quote No: <span id="sticky-quote-number"></span></p>
        </div>
        <div class="row btn-row">
            <a class="btn button button--primary" onclick="window.scrollTo({top: 580, behavior: 'smooth'}); return false;" >VIEW QUOTE</a>
        </div>    
    </div>
</div>
