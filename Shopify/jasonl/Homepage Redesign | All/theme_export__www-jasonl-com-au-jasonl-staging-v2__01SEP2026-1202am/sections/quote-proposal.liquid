        // old data
        function fillDataOld(data){
            // Global gst rate
            var gstRate = 0.1; // gst 10% percent -> 0.1
    
            if(data.sales.signature){
                $('.signature').html(`<img src="${data.sales.signature}" alt="salesman signature" width="114px" height="auto">`);
            }
            if(data.sales.avatar){
                $('.avatar-img').attr('src', `${data.sales.avatar}`);
            }
            if(data.sales.name){
                $('.sales-rep-name').html(data.sales.name);
            }
            if(data.sales.designation){
                $('.sales-rep-role').html(data.sales.designation);
            }
            if(data.sales.phone){
                $('.sales-rep-phone').html(`<a href="tel:${data.sales.phone}">JasonL - Office Furniture</a>`);
                $('.sales-rep-photo-link').attr('href', `tel:${data.sales.phone}`);
            }
            if(data.sales.email){
                $('.sales-rep-email').html(`<a href="mailto:${data.sales.email}">${data.sales.email}</a>`);
            }
            if(data.quote_date){
                $('#quote_date').html(data.quote_date);
                $('#sticky-quote-date').html(data.quote_date);
            }
            if(data.quote_no){
                $('#quote_no').html(data.quote_no);
                $('#sticky-quote-number').html(data.quote_no);
            }
    
            // quote to :
            if(data.quote_to_info){
                $('.quote_to_addresss_block').html(data.quote_to_info);
            }
            if(data.quote_to.phone){
                $('#quote_to_address_phone').html(`<a href="tel:${data.quote_to.phone}">Phone: ${data.quote_to.phone} </a>`);
            }
    
            // deliver to : 
            if(data.deliver_to.name){
                $('#deliver_to_name').html(data.deliver_to.name);
            }
            if(data.deliver_to_info){
                $('.deliver_to_addresss_block').html(data.deliver_to_info);
            }
            if(data.deliver_to.phone){
                $('#deliver_to_phone').html(`<a href="tel:${data.deliver_to.phone}">Phone: ${data.deliver_to.phone} </a>`);
            }
            // total amount
            if(data.totalamount){
                if(!data.shipping[0]){
                    var total_shipping = 0;
                }else{
                    var total_shipping = parseFloat(data.shipping[0].unit_price).toFixed(2) / (1 + gstRate);
                }
                if(!data.assembly[0]){
                    var total_assembly = 0;
                }else{
                    var total_assembly = parseFloat(data.assembly[0].unit_price).toFixed(2) / (1 + gstRate);
                }
    
                var grandTotal = data.total_incl_tax; // grand total from pipeline
    
                var totalamtIncShipAssembly = grandTotal/(1 + gstRate); // total amount including shippping and assembly excluding gst * this total = grand total - gst
    
    
                var totalgst = grandTotal - totalamtIncShipAssembly;  // total gst 
                
    
                var totalAmtExcShipAssembly = totalamtIncShipAssembly - total_shipping - total_assembly; // total excluding shipping and Assembly
                
                
                $('#grand_total').val(grandTotal);
                $('#total-ex-gst').html(totalamtIncShipAssembly.toFixed(2)); // exclued shipping, assembly and gst
                if(total_assembly < 1 ){
                    document.getElementById('assembly-row').classList.add('hidden');
                } 
                $('#total-assembly').html(total_assembly.toFixed(2));
                $('#total-gst').html(totalgst.toFixed(2));
                $('#total-Shipping').html(total_shipping.toFixed(2));
                $('#total-discount').html(data.discount[0].item_price);
                $('#grand-total').html(grandTotal);
    
            }
    
            // Create final object with loop for product loop
            let payload = {
                line_items: []
            };
            // product loop 
            if(data && data.line_items){
                data.line_items.forEach(item => {
                    payload.line_items.push({
                        quantity: item.quantity,
                        image: item.image,
                        codetype: item.codetype,
                        itemcode: item.itemcode,
                        itemname: item.itemname,
                        unit_price: item.unit_price, 
                        item_color: item.itemcolor,
                        item_size: item.itemsize
                        
                    });
                });
            }
    
            console.log('Playload: ', payload );
           
            // Example: show items in HTML
            let html = "";
            payload.line_items.forEach((li, index) => {
                if(li.itemname.includes("Assembly")){
                    li.image = "https://cdn.shopify.com/s/files/1/1249/7859/files/assembly-product-for-existing-customers-270289_130x.jpg?v=1744283985";
                }
                html += `
                 <div class="product">
                                <div class="product-img">
                                    <picture>
                                        <img src="${li.image}" alt="product" width="130" height="auto"  onerror="this.onerror=null; this.src='https://cdn.shopify.com/s/files/1/1249/7859/files/logo-default.png?v=1768389452';">
                                    </picture>
                                    <div class="qty">${li.quantity}</div>
                                </div>
                                <div class="product-info">
                                    <h3>${li.itemname}</h3>
                                    <p class="product-color">${li.item_color}</p>
                                    <p class="product-color">${li.item_size}</p>
                                    <p>$${(li.unit_price / (1 + gstRate)).toFixed(2)}</p>
                                </div>
                            </div>`;
            });
            $("#productList").html(html);
        }
        // new data fill
        function fillDataNew(data){
            // Global gst rate
            var gstRate = 0.1; // gst 10% percent -> 0.1
    
            if(data.sales.signature){
                $('.signature').html(`<img src="${data.sales.signature}" alt="signature" width="114px" height="auto">`);
            }
            if(data.sales.avatar){
                $('.avatar-img').attr('src', `${data.sales.avatar}`);
            }
            if(data.sales.name){
                $('.sales-rep-name').html(data.sales.name);
            }
            if(data.sales.designation){
                $('.sales-rep-role').html(data.sales.designation);
            }
            if(data.sales.phone){
                $('.sales-rep-phone').html(`<a href="tel:${data.sales.phone}">JasonL - Office Furniture</a>`);
                $('.sales-rep-photo-link').attr('href', `tel:${data.sales.phone}`);
            }
            if(data.sales.email){
                $('.sales-rep-email').html(`<a href="mailto:${data.sales.email}">${data.sales.email}</a>`);
            }
            if(data.quote_date){
                $('#quote_date').html(data.quote_date);
                $('#sticky-quote-date').html(data.quote_date);
            }
            if(data.quote_no){
                $('#quote_no').html(data.quote_no);
                $('#sticky-quote-number').html(data.quote_no);
            }
    
            // quote to :
            if(data.quote_to_info){
                $('.quote_to_addresss_block').html(data.quote_to_info);
            }
            if(data.quote_to.phone){
                $('#quote_to_address_phone').html(`<a href="tel:${data.quote_to.phone}">Phone: ${data.quote_to.phone} </a>`);
            }
    
            // deliver to : 
            if(data.deliver_to.name){
                $('#deliver_to_name').html(data.deliver_to.name);
            }
            if(data.deliver_to_info){
                $('.deliver_to_addresss_block').html(data.deliver_to_info);
            }

            if(data.deliver_to.phone){
                $('#deliver_to_phone').html(`<a href="tel:${data.deliver_to.phone}">Phone: ${data.deliver_to.phone} </a>`);
            }
            // total amount
            if(data.total_incl_tax){
                if(!data.shipping[0]){
                    var total_shipping = 0;
                }else{
                    var total_shipping = data.shipping[0].unit_price_excl_tax;
                }
                if(!data.assembly[0]){
                    var total_assembly = 0;
                }else{
                    var total_assembly = data.assembly[0].unit_price_excl_tax;
                }
    
                var grandTotal = data.total_incl_tax; // grand total from pronto
    
                var totalamtIncShipAssembly = data.total_excl_tax; // total amount including shippping and assembly excluding gst * this total = grand total - gst
    
    
                var totalgst = data.gst_total;  // total gst 
                
    
                // var totalAmtExcShipAssembly = totalamtIncShipAssembly - total_shipping - total_assembly; // total excluding shipping and Assembly
                
                
                $('#grand_total').val(grandTotal);
                $('#total-ex-gst').html(totalamtIncShipAssembly); // exclued shipping, assembly and gst
                if(total_assembly < 1 ){
                    document.getElementById('assembly-row').classList.add('hidden');
                    toggleAllTotalSections();
                } 
                if(total_shipping < 1 ){
                    document.getElementById('shipping-row').classList.add('hidden');
                    toggleAllTotalSections();
                } 
                if(total_assembly > 1 && data.assembly[0].itemcode == "ASSEMS068") {
                    $('#assembly-row .total-label').html(data.assembly[0].itemname);
                }
                if(total_assembly > 1 && data.assembly[0].itemcode == "ASSEMWHSE") {
                    $('#assembly-row .total-label').html("Assembly<br>(Warehouse)");
                }
                $('#total-assembly').html(total_assembly);
                $('#total-gst').html(totalgst);
                $('#total-Shipping').html(total_shipping);
                if(!data.discount[0]){
                    document.getElementById('discount-row').classList.add('hidden');
                    toggleAllTotalSections();
                } else {
                    const discountValue = Number(data.discount[0].item_price);
                    const formattedDiscount = discountValue < 0
                        ? `-$ ${Math.abs(discountValue)}`
                        : `$ ${discountValue}`;

                    $('#total-discount').html(formattedDiscount);
                }

                if(!data.other_items[0]){
                    document.getElementById('other-row').classList.add('hidden');
                    toggleAllTotalSections();
                } else {
                    const otherValue = Number(data.other_items[0].item_price);
                    const formattedOther = otherValue < 0
                        ? `-$ ${Math.abs(otherValue)}`
                        : `$ ${otherValue}`;

                    $('#total-other').html(formattedOther);
                     $('#other-row .total-label').html(data.other_items[0].itemname);
                }
                $('#grand-total').html(grandTotal);
    
            }
            
            function toggleAllTotalSections() {
                const totalSections = document.querySelectorAll('.total-section');

                totalSections.forEach(section => {
                    const rows = section.querySelectorAll('.total-row');

                    // If this section has no rows, hide it
                    if (!rows.length) {
                        section.style.display = 'none';
                        return;
                    }

                    // Check if at least one row is visible
                    const hasVisibleRow = Array.from(rows).some(row => {
                        return !row.classList.contains('hidden') &&
                            row.style.display !== 'none';
                    });

                    // Toggle ONLY this section
                    section.style.display = hasVisibleRow ? '' : 'none';
                });
            }

            // Create final object with loop for product loop
            let payload = {
                line_items: []
            };
            // product loop 
            if(data && data.line_items){
                data.line_items.forEach(item => {

                    payload.line_items.push({
                        quantity: item.quantity,
                        image: item.image,
                        codetype: item.codetype,
                        itemcode: item.itemcode,
                        itemname: item.itemname,
                        unit_price: item.unit_price_excl_tax, 
                        item_color: item.itemcolor,
                        item_size: item.itemsize,
                        item_discount_percent : item.discount_percentage,
                        item_discount_amt: item.discount_amt
                    });
                });
            }
            console.log('Playload: ', payload );
           
            // Example: show items in HTML
            let html = "";
            payload.line_items.forEach((li, index) => {
                if(li.itemname.includes("Assembly")){
                    li.image = "https://cdn.shopify.com/s/files/1/1249/7859/files/assembly-product-for-existing-customers-270289_130x.jpg?v=1744283985";
                }
                html += `
                 <div class="product">
                                <div class="product-img">
                                    <picture>
                                        <img src="${li.image}" alt="product" width="130" height="auto"  height="auto"  onerror="this.onerror=null; this.src='https://cdn.shopify.com/s/files/1/1249/7859/files/logo-default.png?v=1768389452';">
                                    </picture>
                                    <div class="qty">${li.quantity}</div>
                                    ${li.item_discount_percent > 0 ? `<div class="dis_percent">${li.item_discount_percent}% OFF</div>` : ``}
                                </div>
                                <div class="product-info">
                                    <h3>${li.itemname}</h3>
                                    <p class="product-color">${li.item_color}</p>
                                    <p class="product-color">${li.item_size}</p>                                    
                                    <p> ${li.item_discount_amt > 0 ? `<i><del>$${(li.unit_price + li.item_discount_amt).toFixed(2)}</del></i>` : ``} $${li.unit_price}</p>
                                </div>
                            </div>`;
            });
            $("#productList").html(html);

            // for data note 
            if(data && data.notes.length > 0){
                const noteList = document.getElementById('project-note-list');
                noteList.innerHTML = '';

                data.notes.forEach(item => {
                    if (item.description && item.description.trim() !== '') {
                        const li = document.createElement('li');
                        li.textContent = item.description;
                        noteList.appendChild(li);
                    }
                })
            }else{
                document.getElementById('projectservice-wrap').innerHTML = '';
            }

        }
        function fillForm(response){
            // fill billing detail form 
            if(response.data.customer.name){
                document.getElementById("name").value=response.data.customer.name;
            }
            if(response.data.customer.email){
                document.getElementById("email").value=response.data.customer.email;
            }
            if(response.order_id){
                document.getElementById("order_id").value=response.order_id;
                document.getElementById("orderid-thankyou").innerHTML = response.order_id;
            }
            if(response.data.total_incl_tax){
                document.getElementById("amount").value=response.data.total_incl_tax;
            }
            if(response.data.customer.company){
                document.getElementById("company").value=response.data.customer.company;
            }else{
                document.getElementById("company").style.display = 'none';
                document.getElementById('company-label').style.display = 'none';
            }
        }

        // check for assembly product in the list
        function checkforAssembly(data){
            if(data.assembly.length > 0){
                var assembly = true;
                console.log("Assembly product found in the list");
                // approved-form
                document.getElementById('approved-form').classList.add('has-assembly');
    
            }else{
                var assembly = false;
                console.log("Assembly product not found in the list");
                document.getElementById('approved-form').classList.remove('has-assembly');
            }
        }


          async function initializeStripePayment(){


            const name = document.getElementById("name").value.trim();
            const email = document.getElementById("email").value.trim();
            const company = document.getElementById("company").value.trim();
            const order_id = document.getElementById("order_id").value.trim();
            const amount = parseFloat(document.getElementById("amount").value.trim());

            const amount_cents = Math.round(amount * 100);

            // const response = await fetch("https://prnt.jasonl.com.au/stripecheckout/payment/create_intent", {
            const response = await fetch("{{ url_create_intent }}", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    amount: amount_cents,
                        email: email,
                        name: name,
                        company: company,
                        order_id: order_id,
                        payment_portal: 'quotation_page'
                })
            });

            const data = await response.json();

            const clientSecret = data.clientSecret;
            const total_amount_cents = data.total_amount;

            const appearance = {
                theme: "flat",
                variables: { 
                    fontFamily: "Inter, sans-serif",
                    colorPrimary: "#000"
                }
            };

            const elements = stripe.elements({ appearance });

            const cardNumber = elements.create("cardNumber");
            const cardExpiry = elements.create("cardExpiry");
            const cardCvc    = elements.create("cardCvc");

            cardNumber.mount("#card-number");
            cardExpiry.mount("#card-expiry");
            cardCvc.mount("#card-cvc");

            const form = document.getElementById("payment-creditcard");

            form.addEventListener("submit", async function(e){

                e.preventDefault();

                const {paymentIntent, error} = await stripe.confirmCardPayment(clientSecret, {
                    payment_method: {
                        card: cardNumber
                    }
                });

                if(error){
                    document.getElementById("payment-message").innerText = error.message;
                }else if(paymentIntent.status === "succeeded"){
                    alert("Payment Successful!");
                }

            });
          const rightCol = document.getElementById("rightcol");

            function updateRightColState() {
            if (cardNumberComplete && cardExpiryComplete && cardCvcComplete) {
                rightCol.classList.add("card-complete");
            } else {
                rightCol.classList.remove("card-complete");
            }
            }

            cardNumber.on("change", (event) => {
            cardNumberComplete = event.complete;
            updateRightColState();
            });

            cardExpiry.on("change", (event) => {
            cardExpiryComplete = event.complete;
            updateRightColState();
            });

            cardCvc.on("change", (event) => {
            cardCvcComplete = event.complete;
            updateRightColState();
            });

            const paymentRequest = stripe.paymentRequest({
                country: 'AU',
                currency: 'aud',
                total: {
                label: 'Total',
                amount: total_amount_cents
                },
                requestPayerName: true,
                requestPayerEmail: true
            });

            const prButton = elements.create('paymentRequestButton', { paymentRequest });

            const leftRightColWrap = document.getElementById('left-right-col-wrap');

            paymentRequest.canMakePayment().then(result => {
                if (result) {
                document.getElementById("wallet-button").style.display = "block";
                document.getElementById("wallet-unavailable").style.display = "none";
                prButton.mount("#wallet-button");
                //document.getElementById("rightcol").style.display = "block";
                leftRightColWrap.classList.add("child-visible");
                document.getElementById("rightcol").classList.add('visible');
                document.getElementById('continue-btn').style.display = "none";
                if(window.innerWidth < 768){
                    document.getElementById("rightcol").scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
                } else {
                // No wallet available — show message
                //document.getElementById("rightcol").style.display = "block";
                leftRightColWrap.classList.add("child-visible");
                document.getElementById("rightcol").classList.add('visible');
                document.getElementById('continue-btn').style.display = "none";
                document.getElementById("wallet-unavailable").style.display = "block";
                document.getElementById("wallet-button").style.display = "none";
                if(window.innerWidth < 768){
                    document.getElementById("rightcol").scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
                }
            });


        // CARD BUTTON: "Pay Now"
        document.getElementById("pay-btn").addEventListener("click", async () => {
        // loading added in button clicked
        /* if(document.getElementById("card-element").classList.contains("StripeElement--complete")){
        } */
        document.getElementById('pay-btn').classList.add('loading');
        
        const message = document.getElementById("payment-message");

        const { error } = await stripe.confirmCardPayment(clientSecret, {
            payment_method: { card: cardNumber }
        });

        if (error) {
            message.innerHTML = `<svg 
            xmlns="http://www.w3.org/2000/svg"
            xmlns:xlink="http://www.w3.org/1999/xlink"
            width="17px" height="15px">
            <path fill-rule="evenodd"  fill="rgb(239, 243, 247)"
            d="M16.731,13.907 C16.355,14.588 15.670,14.995 14.898,14.995 L2.103,14.995 C1.331,14.995 0.646,14.588 0.270,13.907 C-0.106,13.226 -0.089,12.424 0.315,11.760 L6.711,1.019 C6.712,1.017 6.714,1.015 6.715,1.013 C7.100,0.382 7.767,0.006 8.500,0.006 C9.233,0.006 9.901,0.382 10.286,1.013 C10.287,1.015 10.288,1.017 10.290,1.019 L16.686,11.760 C17.089,12.424 17.106,13.226 16.731,13.907 ZM15.604,12.432 C15.603,12.430 15.602,12.428 15.600,12.426 L9.205,1.685 C9.050,1.433 8.793,1.289 8.500,1.289 C8.207,1.289 7.951,1.433 7.796,1.685 L1.400,12.426 C1.399,12.428 1.398,12.430 1.397,12.432 C1.236,12.694 1.229,13.012 1.378,13.281 C1.527,13.551 1.797,13.712 2.103,13.712 L14.898,13.712 C15.203,13.712 15.474,13.551 15.623,13.281 C15.771,13.012 15.764,12.694 15.604,12.432 ZM8.500,12.410 C7.969,12.410 7.538,11.975 7.538,11.437 C7.538,10.900 7.969,10.464 8.500,10.464 C9.032,10.464 9.462,10.900 9.462,11.437 C9.462,11.975 9.032,12.410 8.500,12.410 ZM8.500,9.621 C8.150,9.621 7.866,9.334 7.866,8.980 L7.866,4.340 C7.866,3.986 8.150,3.699 8.500,3.699 C8.851,3.699 9.135,3.986 9.135,4.340 L9.135,8.980 C9.135,9.334 8.851,9.621 8.500,9.621 Z"/>
            </svg> ${error.message}` ;
        document.getElementById("payment-message").classList.add("error");
        document.getElementById('pay-btn').classList.remove('loading');
        } else {
            const orderIdValue = document.getElementById("order_id").value.trim();
            const amountValue  = document.getElementById("amount").value.trim();
            const successUrl =  "https://www.jasonl.com.au/pages/payment-success" +
        "?orderid=" + encodeURIComponent(orderIdValue) +
        "&amount=" + encodeURIComponent(amountValue) +
        "&formtype=stripecheckout";

            // window.location.href = successUrl;
            // fill data after success form submit
            thankyouScreenHandle(orderIdValue, amountValue);
            {% comment %} window.location.href = "https://www.jasonl.com.au/pages/payment-success"; {% endcomment %}
        }
        });
    }
 });

    
   


</script>

