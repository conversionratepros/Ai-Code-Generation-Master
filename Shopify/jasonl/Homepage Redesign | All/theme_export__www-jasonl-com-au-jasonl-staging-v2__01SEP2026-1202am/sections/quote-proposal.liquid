            <div class="introduction-wrap">
                <div class="introduction-wrap-inner animate-css">
                    <p class="quote-greeting"><strong>Dear <span id="customername"></span>,</strong></p>   
                    <div class="quote_letter_body">
                        {{ section.settings.quote_letter_body }}
                    </div>
                    <div class="signature">
                        {% comment %} <img src="{{ 'signature_f8a95d6b-d470-4324-ba5c-764f5c3a069b.png' | file_img_url: '114x' }}" alt="" width="114px" height="auto"> {% endcomment %}
                    </div>
                    <div class="sale-rep">
                        <div class="sale-rep-title">
                            <span class="sales-rep-name"> &nbsp; </span>
                        </div>
                        <div class="sale-rep-label">Your Account Manager</div>
                        <p>
                            <span class="sales-rep-role"></span> 
                            <span class="sales-rep-phone"></span>
                            <span class="sales-rep-email"></span>
                        </p>
                        <div class="sales-rep-photos">
                            <a href="#" class="sales-rep-photo-in-wrap sales-rep-photo-link">
                                <picture class="salesman-img">
                                    <img src="{{ 'jasonl-default-img-thumb.png' | file_img_url: '102x' }}" alt="salesman placeholder" width="102" height="auto" class="avatar-img">
                                </picture>
                                <div class="icon-wrap">
                                   <svg id="phoneiconLayer_2" data-name="phoneiconLayer 2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 26.13 26.13">
