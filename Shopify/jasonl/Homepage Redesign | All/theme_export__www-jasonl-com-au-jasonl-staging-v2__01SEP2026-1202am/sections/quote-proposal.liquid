    <div class="expired-quotation-page">
        <div class="page-width">
            <div class="expired-quotation-wrap">
                <div class="expired-quotation-header">
                    <h2 class="expired-title">Expired Quotation:</h2>
                    <p class="expired-message-top">
                        Your quotation with the order id <span id="order-id"></span> has <strong>expired</strong>.
                    </p>
                    <p>
                        Please contact your sales representative to proceed with a new quotation.
                    </p>
                </div>
                <div class="sale-rep">
                    <div class="sale-rep-label">Your Account Manager</div>
                    <div class="sale-rep-title">
                        <span class="sales-rep-name"> &nbsp; </span>
                    </div>
                    <p>
                        <span class="sales-rep-role"></span> 
                        <span class="sales-rep-phone"></span>
                        <span class="sales-rep-email"></span>
                    </p>
                    <div class="sales-rep-photos">
                        <a href="#" class="sales-rep-photo-in-wrap sales-rep-photo-link">
                            <picture class="salesman-img">
                                <img src="{{ 'jasonl-default-img-thumb.png' | file_img_url: '102x' }}" alt="sales rep" width="102" height="auto" class="avatar-img">
