        const delayMsg = document.getElementById('ajax-delay-msg');
        // start 10s timer
        const delayTimer = setTimeout(() => {
        delayMsg.style.display = 'block';
        }, 10000);
        function clearDelayTimer() {
            clearTimeout(delayTimer);
            delayMsg.style.display = 'none';
        }
        $.ajax({
            // url: 'https://poptopdesk.com/quotationautomate/Getpipedrivedeals/quoteFollowUp/', 
            // url: 'https://prnt.jasonl.com.au/quotationautomate/Getpipedrivedeals/quoteFollowUp/', 
            url: '{{ url_quote_followup }}', 
            type: 'POST', 
            data: {
                order_id: order_id
            },
            // timeout: 20000,
            dataType: 'json', 
            success: function(response) {
                console.log('Success:', response);
                console.log(response.status);
                if(response.status == "error"){
                    // delay timer removed
                    clearDelayTimer();
                    document.querySelector('.loading-screen').classList.add('loaded');
                    $('body').addClass('quote-automation-timeout');
                    return;
                }
                //if(response.expired == true || response.status == "error"){
                if(response.expired == true){
                    // delay timer removed
                    clearDelayTimer();

                    $('body').addClass('form-error');
                }
                if(response.message === "Already Approved"){
                    checkforApprovedMsg(1);
                }
                else if (response.message === "Data from middleware") {
