                            document.querySelectorAll('.animate-css').forEach(function(infoWrap, index) {
                                infoWrap.classList.add('animate__animated', 'animate__fadeInUp');
                                infoWrap.style.setProperty('--animate-delay', `${index * 0.5}s`);
                            });
        
                             // modal open on page load if the local storage has quote_automation_order_id
                            const storedOrderId = localStorage.getItem('quote_automation_order_id');
                            if (storedOrderId && storedOrderId === order_id) {
                                    document.querySelector('body').classList.add('approved-quote-has-order-id');
                                    document.getElementById('popup-confirm-modal').style.display = 'block';
                                    document.querySelector('.approved-quote-modal-info').style.display = 'block';
