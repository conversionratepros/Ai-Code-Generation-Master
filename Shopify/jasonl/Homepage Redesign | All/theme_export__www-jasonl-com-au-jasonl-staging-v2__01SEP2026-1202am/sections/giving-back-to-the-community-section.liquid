{{ 'giving-back-to-the-community-section.css' | asset_url | stylesheet_tag }}

<div class="giving-back-to-the-community-section">
    <div class="community community--new give-back-section">
        <div class="page-width">
            <div class="community-intro remove-border-bottom">
                <h3>Giving back to the community</h3>
                <div class="community-info">
                    <p>At JasonL, we extend our commitment to inclusion and equity beyond our workplace by supporting charitable organizations, non-profit projects, and community-driven initiatives, making a positive impact.</p>
                </div>
            </div>
        </div>
    </div>
    <div class="community community--new give-back-slider-section">
        <div class="page-width slider-page-width">
            <div class="community-row image-row about-us-slider-row">
                <div class="more-about-collection-slider about-us-slider">
                    <div class="swiper-contianer">
                        {{ 'more-about-collection-slider.css' | asset_url | stylesheet_tag }}
                        {% comment %} <!-- Swiper --> {% endcomment %}
                        <div class="swiper more-about-collection-swiper">
                            <div class="swiper-wrapper">
                                {%- assign counter = 0 -%}
                            {%- for nonprofit_fitouts in blogs['fitouts'].articles -%}
                                {%- if nonprofit_fitouts.tags contains 'NPO' -%}
                                    {%- assign counter = counter | plus:1 -%}
                                    {%- render 'cards-nonprofit-fitouts', fitouts: nonprofit_fitouts -%}
                                {%- endif -%}
                                {%- if counter >= 4 -%}
                                    {%- break -%}
                                {%- endif -%}
                            {%- endfor -%}

                           
                          

