<div class="explore-more">
    <div class="page-width">
        <div class="explore-more-wrap">
            <div class="intro">
                {% comment %} <div class="eyebrow">FURNITURE GLOSSARY</div> {% endcomment %}
                <h2 class="section-title">Explore more office furniture</h2>
            </div>
            <div class="expolor-more-cat-wrap">
                {% comment %} make two div as per design {% endcomment %}
                <div class="explore-more-col explore-more-col--location">
                    <div class="explore-more-col__label">
                        {{ locationsvg }}
                        <span>By location</span>
                    </div>
                    <div class="explore-more-col__pills">
                        <a href="/collections/office-furniture/sydney" class="explore-pill">Office furniture in Sydney</a>
                        <a href="/collections/office-furniture/melbourne" class="explore-pill">Office furniture in Melbourne</a>
                        <a href="/collections/office-furniture/brisbane" class="explore-pill">Office furniture in Brisbane</a>
                        <a href="/collections/office-furniture/perth?location=true" class="explore-pill">Office furniture in Perth</a>
                        <a href="/collections/office-furniture/adelaide" class="explore-pill">Office furniture in Adelaide</a>
                    </div>
                </div>
                <div class="explore-more-col explore-more-col--category">
                    <div class="explore-more-col__label">
                        {{ categorysvg }}
                        <span>By category</span>
                    </div>
                    <div class="explore-more-col__pills">
                        <a href="/collections/office-chairs/ergonomic-chairs" class="explore-pill">Ergonomic office chairs</a>
                        <a href="/collections/office-desks/height-adjustable-desks" class="explore-pill">Sit-stand &amp; height-adjustable desks</a>
                        <a href="/collections/office-partitions/office-work-pods-booths" class="explore-pill">Office workstations &amp; pods</a>
                        <a href="/collections/tables/boardroom-tables" class="explore-pill">Boardroom &amp; meeting tables</a>
                        <a href="/pages/interior-design" class="explore-pill">Office fitout services</a>
                    </div>
                </div>
            </div>
        </div>
    </div> 
</div> 

