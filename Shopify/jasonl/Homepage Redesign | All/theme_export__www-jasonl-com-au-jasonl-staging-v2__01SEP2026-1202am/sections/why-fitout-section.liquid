{{ 'why-fitout-section.css' | asset_url | stylesheet_tag }}
<div class="why-fitout-section">
    <div class="page-width">
        <div class="why-fitout-grid">

            <div class="why-fitout-left">
                <p class="eyebrow">FOR FLEXIBLE, SCALABLE WORKPLACES</p>
                <h3 class="why-fitout-heading">Why businesses<br>choose JasonL</h3>
                <p class="why-fitout-subtext">We're not a traditional fitout company. We're built for speed, simplicity and real-world business needs.</p>
            </div>

            <div class="why-fitout-right">
                <div class="why-fitout-item">
                    <div class="why-fitout-number">01</div>
                    <div class="why-fitout-content">
                        <h3 class="why-fitout-title">Fast turnaround</h3>
                        <p class="why-fitout-desc">No long lead times. We work with stock that's ready to go.</p>
                    </div>
                </div>

                <div class="why-fitout-item">
                    <div class="why-fitout-number">02</div>
                    <div class="why-fitout-content">
                        <h3 class="why-fitout-title">Transparent pricing</h3>
                        <p class="why-fitout-desc">No surprise costs. What you see is what you pay.</p>
                    </div>
                </div>

                <div class="why-fitout-item">
                    <div class="why-fitout-number">03</div>
                    <div class="why-fitout-content">
                        <h3 class="why-fitout-title">Design that works</h3>
                        <p class="why-fitout-desc">Practical layouts built for how your team actually works.</p>
                    </div>
                </div>

                <div class="why-fitout-item">
                    <div class="why-fitout-number">04</div>
                    <div class="why-fitout-content">
                        <h3 class="why-fitout-title">End-to-end delivery</h3>
                        <p class="why-fitout-desc">From concept to install, handled by one team.</p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>  
