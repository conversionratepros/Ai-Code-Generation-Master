{% comment %} Direction/Location Engagements – GA4 event: location_engagement {% endcomment %}
<script>
  document.addEventListener("click", function(e){
    const ga4LocationEngagement = e.target.closest('[data-ga4="location_engagement"]');
    if(!ga4LocationEngagement) return;
    e.preventDefault();
    // push data to ga4
    const directionLocation = ga4LocationEngagement.getAttribute('direction_location');
    // console.log(window.location.href, directionLocation);
    
    window.dataLayer = window.dataLayer || [];
    dataLayer.push({
      event: 'location_engagement',
      page_location: window.location.href,
      page_type: 'content',
      location: directionLocation
    });

    // Open the link after tracking
    setTimeout(function() {
      window.open(ga4LocationEngagement.href, '_blank');
    }, 100);

  });
</script>
<link href="{{'contact-modal.css' | asset_url}}" rel="stylesheet" crossorigin="anonymous">
    <script>
      // gtm/ga4 script for assembly download
      document.addEventListener("click", function(e){
        const ga4AssemblyLink = e.target.closest('[data-ga4="assembly_downloads"]');
        
        if(!ga4AssemblyLink) return;

        const fileUrl = ga4AssemblyLink.getAttribute("href");
        const fileName = fileUrl.split('/').pop().split('?')[0];

        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: "assembly_file_download",
          file_name: fileName,
          file_url: fileUrl,
          page_location: window.location.href
        });
      });

      // 3D Tour Engagements – GA4 event: 3d_tour_engagement push data funcciton 
      function dL_3d_tour_engagement(viewedIframeSrc, storeLocation, pageLocaiton){
        // push data layer to GA4
        window.dataLayer = window.dataLayer || [];
        dataLayer.push({
          event: '3d_tour_engagement',
          page_location: pageLocaiton,
          page_type: 'content',
          location: storeLocation
        });
      }

      window.addEventListener('blur', function(){
        setTimeout(function(){
          const el = document.activeElement;
          if(
            el && 
            el.tagName === "IFRAME" && 
            el.hasAttribute("store_location") && 
            el.src.includes("matterport.com")
          ){
            let viewedIframeSrc = el.getAttribute("src");
            let storeLocation = el.getAttribute("store_location");
            let pageLocaiton =  window.location.href;
            // send data to 
            console.log(viewedIframeSrc, storeLocation, pageLocaiton);
            dL_3d_tour_engagement(viewedIframeSrc, storeLocation, pageLocaiton)
          }
        }, 100);
      });
    </script>
