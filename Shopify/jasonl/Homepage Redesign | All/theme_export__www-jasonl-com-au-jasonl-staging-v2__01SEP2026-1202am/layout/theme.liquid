  <head>
    {%- render 'google-review-redirection-script' -%}
    {% render 'collection-first-page-redirect' %}
    {%- if template == "cart" -%}
      <script>
        if (window.location.pathname === '/cart') {
            window.location.href = "/";
        }
      </script>
    {%- endif %}
    {%- if page.handle == "search-results-page" -%}
    <script>
      {%- comment -%} 
          Redirect app search page to default search page 
        {%- endcomment -%}
        (function() {
          // Check if the current URL matches the old search URL pattern
          if (window.location.pathname === '/pages/search-results-page') {
            // Extract the search query from the URL
            const query = new URLSearchParams(window.location.search).get('q');
            
            // Redirect to the new search URL
            if (query) {
              window.location.href = `/search?q=${encodeURIComponent(query)}`;
            } else {
              window.location.href = `/search?q=chair`;
            }
          }
        })();
        {%- comment -%} End redirect {%- endcomment %}
         
    </script>
  {% endif %}

