<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Poppins:wght@600&display=swap" rel="stylesheet">

<div class="custom-checkout-header cro-header">
  <div class="cro-header-inner">
    <div class="custom-checkout-logo">
      <a href="{{ shop.url }}">
        <span class="svg-logo">
          {%- render 'i-logo', logotype: 'logo_without_icon' -%}
        </span>
      </a>
    </div>
    <p class="cro-delivery-desktop">
      Fitouts delivered <span class="cro-highlight-text">within 10 days</span> across Australia
    </p>
  </div>
</div>

<div class="cro-delivery-strip">
  Fitouts delivered <strong>within 10 days</strong> across Australia
</div>