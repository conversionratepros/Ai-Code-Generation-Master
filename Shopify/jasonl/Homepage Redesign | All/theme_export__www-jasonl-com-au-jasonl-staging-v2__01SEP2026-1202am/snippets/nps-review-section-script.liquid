// Data ago converter
function timeAgo(dateString) {
   const date = new Date(dateString);
   const now = new Date();
   const seconds = Math.floor((now - date) / 1000);

   const intervals = {
      year: 31536000,
      month: 2592000,
      week: 604800,
      day: 86400,
      hour: 3600,
      minute: 60
   };

   for (const [unit, value] of Object.entries(intervals)) {
      const count = Math.floor(seconds / value);
      if (count >= 1) {
         return `${count} ${unit}${count > 1 ? "s" : ""} ago`;
      }
   }

   return "Just now";
}

// Wait until the Masonry script is ready
function checkMasonryInit(){
   const checkMasonry = setInterval(function() {
      if (typeof Masonry !== 'undefined') {
         clearInterval(checkMasonry);
         const grid = document.querySelector('.listing-masonry');
         if (!grid) return;
         
         // Initialize Masonry
         new Masonry(grid, {
            itemSelector: '.grid-item',
            columnWidth: '.grid-sizer',
            percentPosition: true,
            gutter: 20
         });
      }
   }, 100);
}
</script>