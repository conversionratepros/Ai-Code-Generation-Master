<script>
// for pagination
let currentPage = 1;
const perPage = 24;
let totalPages = 1;
const fetchUrl = "https://prnt.jasonl.com.au/nps/Nps/reviews";
let searchQuery = "";
let sortOrder = "desc";
let sourceFilter = "";
let totalresult = "";

// add nps review ajax start
async function loadReviews(page = 1) {
   try {
      // Build query parameters
      let queryParams = `count=${perPage}&page=${page}&sort=${sortOrder}`;
      
      // Add search query if present
      if (searchQuery) {
         queryParams += `&search=${encodeURIComponent(searchQuery)}`;
      }
      
      // Add source filter if selected
      if (sourceFilter) {
         // If GMB is selected, use wildcard or like query
         if (sourceFilter === 'gmb') {
            queryParams += `&source=gmb&filterType=contains`;
         } else {
            queryParams += `&source=${sourceFilter}`;
         }
      }

      const response = await fetch(`${fetchUrl}?${queryParams}`);
      const data = await response.json()
      
      if (data && data.status === "success" && data.results.length > 0) {
         const container = document.getElementById("nps-review-list-contianer");
         container.innerHTML = "";
         totalresult = data.total_count;
         
         // added total post count in totalpostcount div which is added after search
         let totalpostcount = document.getElementById("totalpostcount");
         if(totalpostcount){
            totalpostcount.innerHTML = `total ${totalresult} result found`;
         }
         
         data.results.forEach(function(review, index){
            if(index === 0){
               container.innerHTML = '<div class="grid-sizer"></div>';
            }
            addData(container, review);
         });
         
         
         
         // reinit masonry
         checkMasonryInit();
         
         // Update pagination
         updatePagination(data.page, data.total_pages, data.next_page, data.prev_page);
      } else {
         console.log("No reviews found.");
         const container = document.getElementById("nps-review-list-contianer");
         container.innerHTML = '<p style="text-align: center; padding: 20px;">No reviews found.</p>';
      }
   } catch (error) {
      console.error("Error loading reviews:", error);
   }
}

// Update pagination links
function updatePagination(current_page, total_pages, next_page, prev_page){
   let paginationContainer = document.querySelector('#nps-pagination ul');
   let prevBtn = document.getElementById('prev-pagination');
   let nextBtn = document.getElementById('next-pagination');
   let lastBtn = document.getElementById('last-pagination');
   
   // Remove old page number links and ellipsis
   let pageLinks = paginationContainer.querySelectorAll('li[id^="page-number-"], li[id^="ellipsis"]');
   pageLinks.forEach(link => link.remove());
   
   // Calculate range to show (current page ±1)
   let startPage = Math.max(1, current_page - 1);
   let endPage = Math.min(total_pages, current_page + 1);
   
   // Add left ellipsis if needed
   if (startPage > 1) {
      let li = document.createElement('li');
      li.id = 'ellipsis-left';
      let a = document.createElement('a');
      a.textContent = '...';
      a.href = '#';
      li.appendChild(a);
      paginationContainer.insertBefore(li, nextBtn);
   }
   
   // Insert page numbers before next button
   for (let i = startPage; i <= endPage; i++) {
      let li = document.createElement('li');
      li.id = `page-number-${i}`;
      let a = document.createElement('a');
      a.href = '#';
      a.textContent = i;
      
      if (i === current_page) {
         a.classList.add('pagination-current');
      }
      
      a.onclick = function(e) {
         e.preventDefault();
         goToPage(i);
      };
      
      li.appendChild(a);
      paginationContainer.insertBefore(li, nextBtn);
   }
   
   // Add right ellipsis if needed
   if (endPage < total_pages) {
      let li = document.createElement('li');
      li.id = 'ellipsis-right';
      let a = document.createElement('a');
      a.textContent = '...';
      a.href = '#';
      li.appendChild(a);
      paginationContainer.insertBefore(li, nextBtn);
   }
   
   // Update prev button
   if(current_page > 1){
      prevBtn.querySelector('a').onclick = function(e) {
         e.preventDefault();
         goToPage(current_page - 1);
      };
      prevBtn.classList.remove('disabled');
   } else {
      prevBtn.classList.add('disabled');
   }
   
   // Update next button - hide if no next page
   if(next_page != null){
      nextBtn.querySelector('a').onclick = function(e) {
         e.preventDefault();
         goToPage(current_page + 1);
      };
      nextBtn.classList.remove('disabled');
      nextBtn.style.display = 'inline-block';
   } else {
      nextBtn.classList.add('disabled');
      nextBtn.style.display = 'none';
   }

   // Update last button - hide if no next page
   if(next_page != null) {
      lastBtn.querySelector('a').onclick = function(e) {
         e.preventDefault();
         goToPage(total_pages);
      };
      lastBtn.style.display = 'inline-block';
   } else {
      lastBtn.style.display = 'none';
   }
   
   // Update first button - show only after page 3
   let firstBtn = document.getElementById('first-pagination');
   if (firstBtn) {
      firstBtn.querySelector('a').onclick = function(e) {
         e.preventDefault();
         goToPage(1);
      };
      
      if (current_page > 3) {
         firstBtn.style.display = 'inline-block';
         firstBtn.classList.remove('disabled');
      } else {
         firstBtn.style.display = 'none';
      }
   }

   // hide pagination if no next page
   if(next_page === null && prev_page === null){
      paginationContainer.style.display = "none";
   }else{
      paginationContainer.style.display = "flex";
   }
}

// Navigate to specific page
function goToPage(page) {
   currentPage = page;
   loadReviews(page);
   // Scroll to review container with 300px offset
   setTimeout(function() {
      let element = document.getElementById('nps-review-list-contianer');
      let elementPosition = element.getBoundingClientRect().top + window.scrollY;
      window.scrollTo({
         top: elementPosition - 300,
         behavior: 'smooth'
      });
   }, 100);
}

// Search functionality
document.addEventListener("DOMContentLoaded", function(){
   // Initial load
   loadReviews(1);
   checkMasonryInit();
   
   // Search input event with debounce
   const searchInput = document.getElementById("searchinput");

   function searchEnteredText(){
      if(!searchInput){
         // Initial load
         return;
      }
      searchQuery = searchInput.value.trim();
      currentPage = 1;
      loadReviews(1);

      // this will show search text in #search-value div
      const searchvalue = document.createElement("div");
      searchvalue.id = "searchvalue";
      document.getElementById('search-value').appendChild(searchvalue);
      if(searchQuery){
         document.getElementById('searchvalue').innerHTML = `Result for: <strong> "${searchQuery}"</strong> <span id="totalpostcount"></span>`;
      }else{
         document.getElementById('searchvalue').innerHTML = '';
      }
   }

   function addTextAreaCallback(textArea, callback, delay) {
      let timer = null;

      textArea.addEventListener("input", function(){
         clearTimeout(timer);

         const value = this.value.trim();

         timer = setTimeout(() => {
            callback();
         }, delay);
      });
   }
   addTextAreaCallback( searchInput, searchEnteredText, 1000 );

   /* old search 
   if(searchInput) {
      searchInput.addEventListener('input', function(e) {
         searchQuery = e.target.value;
         currentPage = 1;
         loadReviews(1);
      });
   } */
   
   // Date/Sort filter
   const dateSelect = document.getElementById("date");
   if(dateSelect) {
      dateSelect.addEventListener('change', function(e) {
         sortOrder = e.target.value || "desc";
         currentPage = 1;
         loadReviews(1);
      });
   }
   
   // Platform filter
   const platformSelect = document.getElementById("platform");
   if(platformSelect) {
      platformSelect.addEventListener('change', function(e) {
         sourceFilter = e.target.value;
         currentPage = 1;
         loadReviews(1);
      });
   }
   
   // Mobile search toggle
   const searchToggleBtn = document.getElementById("toogle-search-btn");
   const searchInputLabel = document.getElementById("search-input-label");
   if(searchToggleBtn && searchInputLabel) {
      searchToggleBtn.addEventListener('click', function(){
         searchInputLabel.classList.toggle("show");
      });
   }
});

// add data and save to variable and place them accordingly
function addData(container, review){
   let commet = " "; 
   let reviewer = " ";
   let updated = timeAgo(review.updated);
   let profilePhoto = " ";
   let npsScore = " ";
   let source = " ";
   let reviewphoto = "";
   
   if(review.source != null){
      source = reviewSourceHandler(review.source);
   }
   if (review.profile_photo_url != null) {
      profilePhoto = `<img src="${review.profile_photo_url}" alt="${review.reviewer}" width="50" height="50"/>`;
   }
   if(review.reviewer != null){
      reviewer = review.reviewer;
   }
   if(review.comment != null){
      commet = review.comment; 
   }
   
   // stars
   let starsHtml = " ";
   if(review.NPS_score != null){
      let startcount = Math.ceil(review.NPS_score/2);
      for(let i = 0; i < startcount; i++){
         starsHtml += `<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="20px" height="19px" viewBox="0 0 20 19">
         <path fill-rule="evenodd"  fill="rgb(248, 207, 86)" d="M9.767,0.573 L11.988,7.599 L19.404,7.541 L13.422,11.942 L15.692,19.000 L9.725,14.643 L3.712,19.000 L5.982,11.942 L-0.000,7.541 L7.359,7.574 L9.767,0.573 Z"/>
      </svg>`;
      }
   }
   
   // Create each review card
   const card = document.createElement("div");
   card.classList.add("nps-card", "grid-item");
   card.innerHTML = `
      <div class="card-body">
         <div class="rating">
            <span class="star-rating">
               ${starsHtml}
            </span>
         </div>
         <div class="review-content">
            <p class="review-text">${commet}</p>
            <div class="card-footer customer-with-logo">
               <div class="customer">
                  <p class="review-author">${reviewer}</p>
                  <div class="time">${updated}</div>
               </div>
               <div class="footer-logos">
                  ${source} ${profilePhoto}
               </div>
            </div>
         </div>
      </div>
   `;
   container.appendChild(card);
}

