{% stylesheet %}
    .contact-box-sidebar{
        background-color: #f3f7d6;
        padding: 29px 30px;
        max-width: 100%;
        border-radius: 10px;
        box-sizing: border-box;
        @media(min-width: 750px){
            width: 300px;
        }
    }
    .contact-box-sidebar .card-icon{
        background-color: #FFF;
        width: 38px;
        height: 38px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 50%;
    }
    h3.box-title {
        margin: 10px 0 0 0;
        padding: 0;
        font-weight: 600;
    }

    .contact-box-sidebar p {
        margin: 7px 0 0 0;
        padding: 0;
        line-height: 1.6;
        max-width: 210px;
    }

    .contact-box-sidebar a {
        margin-top: 16px;
        font-weight: 600;
        position: relative;
        display: inline-block;
    }
    .contact-box-sidebar a:hover::after{
        border-color: #afca00;
    }
    .contact-box-sidebar a:after{
        position: absolute;
        top: -2px;
        left: 0;
        width: 100%;
        height: 100%;
        content: "";
        display: block;
        border-bottom: 2px solid #000;
        transition: border-color 0.3s ease-in-out;
    }
{% endstylesheet %}