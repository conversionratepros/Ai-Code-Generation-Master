<script>

   async function getnpsScore(){
      const apiUrl = 'https://prnt.jasonl.com.au/nps/Nps/reviews';
      try{
         const response = await fetch(apiUrl);
         const data = await response.json();
         const totalCountElement = document.querySelector('#totalCount');
         if(data.average_val){
            document.querySelector('#average-val').innerText = data.average_val.toFixed(1);
         }
         if(data.total_count){
            const value = data.total_count;
            const digits = String(value).split('');
            let htmlValue = '';
            digits.forEach(function(digit){
               htmlValue += '<span>' + digit + '</span>';
            });
            totalCountElement.innerHTML = htmlValue;
            totalCountElement.classList.add('fetched');
         }
      }catch(error){
         console.error('Error Fetching nps score:', error);
      }
   }
   document.addEventListener('DOMContentLoaded', function() {
      getnpsScore();
   });
</script>