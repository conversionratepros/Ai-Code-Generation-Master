{%- comment -%}
===========================================
AB-TESTING.LIQUID SNIPPET
===========================================
Save this file as: snippets/ab-testing.liquid
Then include it in your theme.liquid with: {% render 'ab-testing' %}
{%- endcomment -%}

{% comment %} comment "Check if A/B testing is enabled globally" {% endcomment %}
{% comment %} comment "Generate consistent user assignment" {% endcomment %}
{%- liquid
  assign ab_testing_enabled = settings.enable_global_ab_testing | default: true
  
  if ab_testing_enabled
    assign customer_seed = customer.id | default: 0
    assign browser_fingerprint = request.path | append: request.host | append: request.user_agent | slice: 0, 50 | md5
    assign user_hash = customer_seed | plus: browser_fingerprint | slice: -2, 2 | plus: 0
    assign split_percentage = settings.ab_test_split_percentage | default: 50
    
    if user_hash < split_percentage
      assign global_ab_variant = 'A'
    else
      assign global_ab_variant = 'B'
    endif
  else
    assign global_ab_variant = 'A'
  endif
-%}

<style>
/* A/B Testing CSS - Hide/Show Logic */
.ab-test-group-A,
.ab-test-group-B {
    display: none !important;
}

/* Show Variant A */
body.ab-variant-A .ab-test-group-A {
    display: block !important;
}

body.ab-variant-A .ab-test-group-A.flex {
    display: flex !important;
}

body.ab-variant-A .ab-test-group-A.grid {
    display: grid !important;
}

body.ab-variant-A .ab-test-group-A.inline {
    display: inline !important;
}

body.ab-variant-A .ab-test-group-A.inline-block {
    display: inline-block !important;
}

body.ab-variant-A .ab-test-group-A.table {
    display: table !important;
}

body.ab-variant-A .ab-test-group-A.table-cell {
    display: table-cell !important;
}

/* Show Variant B */
body.ab-variant-B .ab-test-group-B {
    display: block !important;
}

body.ab-variant-B .ab-test-group-B.flex {
    display: flex !important;
}

body.ab-variant-B .ab-test-group-B.grid {
    display: grid !important;
}

body.ab-variant-B .ab-test-group-B.inline {
    display: inline !important;
}

body.ab-variant-B .ab-test-group-B.inline-block {
    display: inline-block !important;
}

body.ab-variant-B .ab-test-group-B.table {
    display: table !important;
}

body.ab-variant-B .ab-test-group-B.table-cell {
    display: table-cell !important;
}

/* Smooth transitions */
.ab-test-group-A,
.ab-test-group-B {
    transition: opacity 0.2s ease-in-out;
}

/* Debug indicator */
.ab-debug-indicator {
    position: fixed;
    top: 0;
    right: 0;
    background: #000;
    color: #fff;
    padding: 8px 12px;
    z-index: 9999;
    font-size: 12px;
    font-family: monospace;
    border-bottom-left-radius: 4px;
}
</style>

<script>
(function() {
    'use strict';
    
    // A/B Testing Controller
    var ABTesting = {
        variant: '{{ global_ab_variant }}',
        testName: '{{ settings.ab_test_name | default: "global_ab_test" }}',
        enabled: {{ ab_testing_enabled | json }},
        
        init: function() {
            if (!this.enabled) {
                this.variant = 'A';
            }
            
            this.handleURLOverrides();
            this.setBodyClass();
            this.trackPageView();
            this.setupEventListeners();
            this.storeVariant();
            this.debugMode();
        },
        
        handleURLOverrides: function() {
            var urlParams = new URLSearchParams(window.location.search);
            var forceVariant = urlParams.get('ab_variant');
            
            if (forceVariant === 'A' || forceVariant === 'B') {
                this.variant = forceVariant;
                console.log('🧪 A/B Test: Forced to variant', forceVariant);
            }
        },
        
        setBodyClass: function() {
            document.body.classList.add('ab-variant-' + this.variant);
            document.body.setAttribute('data-ab-variant', this.variant);
            document.body.setAttribute('data-ab-test', this.testName);
        },
        
        trackPageView: function() {
            var trackingData = {
                variant: this.variant,
                test_name: this.testName,
                page_location: window.location.href,
                page_title: document.title,
                timestamp: Date.now()
            };
            
            // Google Analytics 4
            if (typeof gtag !== 'undefined') {
                gtag('event', 'ab_test_view', {
                    variant: this.variant,
                    test_name: this.testName,
                    page_location: window.location.href,
                    page_title: document.title
                });
            }
            
            // Google Analytics Universal
            if (typeof ga !== 'undefined') {
                ga('send', 'event', 'A/B Test', 'Page View', this.testName + ' - Variant ' + this.variant);
            }
            
            // Facebook Pixel
            if (typeof fbq !== 'undefined') {
                fbq('trackCustom', 'ABTestView', {
                    variant: this.variant,
                    test_name: this.testName,
                    page: window.location.pathname
                });
            }
            
            // Shopify Analytics
            if (typeof ShopifyAnalytics !== 'undefined' && ShopifyAnalytics.lib) {
                ShopifyAnalytics.lib.track('A/B Test View', trackingData);
            }
            
            this.customTrack('page_view', trackingData);
        },
        
        setupEventListeners: function() {
            var self = this;
            
            // Track clicks within A/B test areas
            document.addEventListener('click', function(e) {
                var abTestContainer = e.target.closest('.ab-test-group-A, .ab-test-group-B');
                
                if (abTestContainer) {
                    self.trackClick(e.target, abTestContainer);
                }
            });
            
            // Track form submissions in A/B test areas
            document.addEventListener('submit', function(e) {
                var abTestContainer = e.target.closest('.ab-test-group-A, .ab-test-group-B');
                
                if (abTestContainer) {
                    self.trackFormSubmit(e.target, abTestContainer);
                }
            });
        },
        
        trackClick: function(element, container) {
            var isButton = element.matches('button, .btn, .button, a[href], input[type="submit"], input[type="button"]');
            var elementType = element.tagName.toLowerCase();
            var elementText = element.textContent.trim().substring(0, 50);
            var elementClass = element.className;
            var containerVariant = container.classList.contains('ab-test-group-A') ? 'A' : 'B';
            
            var trackingData = {
                variant: this.variant,
                container_variant: containerVariant,
                test_name: this.testName,
                element_type: elementType,
                element_text: elementText,
                element_class: elementClass,
                is_button: isButton,
                page: window.location.pathname,
                timestamp: Date.now()
            };
            
            // Google Analytics 4
            if (typeof gtag !== 'undefined') {
                gtag('event', 'ab_test_click', {
                    variant: this.variant,
                    test_name: this.testName,
                    element_type: elementType,
                    element_text: elementText,
                    is_button: isButton
                });
            }
            
            // Google Analytics Universal
            if (typeof ga !== 'undefined') {
                ga('send', 'event', 'A/B Test', 'Click', this.testName + ' - ' + elementText + ' (Variant ' + this.variant + ')');
            }
            
            // Facebook Pixel
            if (typeof fbq !== 'undefined') {
                fbq('trackCustom', 'ABTestClick', trackingData);
            }
            
            this.customTrack('click', trackingData);
        },
        
        trackFormSubmit: function(form, container) {
            var formId = form.id || 'unnamed_form';
            var containerVariant = container.classList.contains('ab-test-group-A') ? 'A' : 'B';
            
            var trackingData = {
                variant: this.variant,
                container_variant: containerVariant,
                test_name: this.testName,
                form_id: formId,
                page: window.location.pathname,
                timestamp: Date.now()
            };
            
            // Google Analytics 4
            if (typeof gtag !== 'undefined') {
                gtag('event', 'ab_test_form_submit', trackingData);
            }
            
            // Google Analytics Universal
            if (typeof ga !== 'undefined') {
                ga('send', 'event', 'A/B Test', 'Form Submit', this.testName + ' - ' + formId + ' (Variant ' + this.variant + ')');
            }
            
            this.customTrack('form_submit', trackingData);
        },
        
        customTrack: function(eventType, data) {
            // Custom analytics endpoint
            var payload = {
                event: 'ab_test_' + eventType,
                ...data,
                user_agent: navigator.userAgent,
                screen_resolution: screen.width + 'x' + screen.height,
                referrer: document.referrer
            };
            
            // Example: Send to custom endpoint
            // fetch('/api/ab-testing/track', {
            //     method: 'POST',
            //     headers: {
            //         'Content-Type': 'application/json',
            //         'X-Requested-With': 'XMLHttpRequest'
            //     },
            //     body: JSON.stringify(payload)
            // }).catch(function(error) {
            //     console.warn('A/B Testing: Failed to send custom tracking', error);
            // });
            
            // Debug logging
            if (this.isDebugMode()) {
                console.log('🧪 A/B Test Tracking (' + eventType + '):', payload);
            }
        },
        
        storeVariant: function() {
            try {
                localStorage.setItem('ab_test_variant', this.variant);
                localStorage.setItem('ab_test_name', this.testName);
                localStorage.setItem('ab_test_timestamp', Date.now());
            } catch(e) {
                // Fallback to cookies if localStorage fails
                var expires = new Date();
                expires.setTime(expires.getTime() + (7 * 24 * 60 * 60 * 1000)); // 7 days
                document.cookie = 'ab_test_variant=' + this.variant + '; expires=' + expires.toUTCString() + '; path=/; SameSite=Lax';
            }
        },
        
        isDebugMode: function() {
            return window.location.search.includes('ab_debug=true') || 
                   localStorage.getItem('ab_debug') === 'true';
        },
        
        debugMode: function() {
            if (this.isDebugMode()) {
                this.showDebugInfo();
                this.enableDebugLogging();
            }
        },
        
        showDebugInfo: function() {
            var debugInfo = document.createElement('div');
            debugInfo.className = 'ab-debug-indicator';
            debugInfo.innerHTML = '🧪 A/B Test: ' + this.variant + ' | ' + this.testName;
            document.body.appendChild(debugInfo);
            
            console.group('🧪 A/B Test Debug Info');
            console.log('Variant:', this.variant);
            console.log('Test Name:', this.testName);
            console.log('Enabled:', this.enabled);
            console.log('A/B Test Elements:', document.querySelectorAll('.ab-test-group-A, .ab-test-group-B'));
            console.log('Body Classes:', Array.from(document.body.classList));
            console.groupEnd();
        },
        
        enableDebugLogging: function() {
            // Override console methods to add A/B test context
            var originalLog = console.log;
            var self = this;
            
            window.addEventListener('error', function(e) {
                console.warn('🧪 A/B Test - Error in variant', self.variant + ':', e.error);
            });
        },
        
        // Public methods for manual testing
        switchVariant: function(newVariant) {
            if (newVariant !== 'A' && newVariant !== 'B') {
                console.error('Invalid variant. Use "A" or "B"');
                return;
            }
            
            document.body.classList.remove('ab-variant-A', 'ab-variant-B');
            document.body.classList.add('ab-variant-' + newVariant);
            document.body.setAttribute('data-ab-variant', newVariant);
            this.variant = newVariant;
            this.storeVariant();
            
            console.log('🧪 A/B Test: Switched to variant', newVariant);
        },
        
        getVariant: function() {
            return this.variant;
        },
        
        getTestName: function() {
            return this.testName;
        }
    };
    
    // Initialize when DOM is ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
            ABTesting.init();
        });
    } else {
        ABTesting.init();
    }
    
    // Make ABTesting globally accessible
    window.ABTesting = ABTesting;
    
})();
</script>

{%- comment -%}
Preconnect to analytics domains for better performance
{%- endcomment -%}
<link rel="preconnect" href="https://www.google-analytics.com">
<link rel="preconnect" href="https://www.googletagmanager.com">
<link rel="preconnect" href="https://connect.facebook.net">{%- comment -%}
===========================================
USAGE INSTRUCTIONS:
===========================================

1. Save this file as: snippets/ab-testing.liquid
2. Add to your theme.liquid in the <head> section: {% render 'ab-testing' %}
3. Add the settings to your config/settings_schema.json
4. Your existing .ab-test-group-A and .ab-test-group-B elements will work automatically

TESTING:
- Force variant: yoursite.com?ab_variant=A or ?ab_variant=B
- Debug mode: yoursite.com?ab_debug=true
- Console commands: ABTesting.switchVariant('B'), ABTesting.getVariant()

{%- endcomment -%}