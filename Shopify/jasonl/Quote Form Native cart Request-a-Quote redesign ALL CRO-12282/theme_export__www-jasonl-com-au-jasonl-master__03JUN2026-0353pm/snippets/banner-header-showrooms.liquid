NOTE:
This is special case for 
---------------------
NT - Randomise
Under 10 days
Spend & save

ACT - Randomise
Under 10 days
Spend & save

TAS - Randomise
Under 10 days
Spend & save
{%- endcomment-%}
<style>
/* not available showroom banner */
body[data-location="ACT"] .banner-header-perth,
body[data-location="NT"] .banner-header-perth,
body[data-location="TAS"] .banner-header-perth{
    display: none;
}
/* Available showroom banner */
.header-banner-10days,
.header-banner-save-n-send{
        display: none;
    }
    body[data-location="ACT"] .header-banner-10days,
    body[data-location="ACT"] .header-banner-save-n-send{
        display: block;
    }
    body[data-location="NT"] .header-banner-10days,
    body[data-location="NT"] .header-banner-save-n-send{
        display: block;
    }
    body[data-location="TAS"] .header-banner-10days,
    body[data-location="TAS"] .header-banner-save-n-send{
        display: block;
    }
</style>
{% comment %} NOTE: JUST FOR NO SHOWROOM BANNER {% endcomment %}
{%- assign min = 7 -%}
{%- assign numberOfItems = 4 -%} {% comment %}There are two Availablebanners. 1). 10days banner and 2) Save and Send banner 3) black friday v1 4) black friday v2 {% endcomment %}
{% comment %} {%- assign max = numberOfItems | plus: 1 -%}  {% endcomment %}
{%- assign max = 8 | plus: 1 -%} 
{%- assign diff = max | minus: min -%}
{%- assign randomNumber = "now" | date: "%N" | modulo: diff | plus: min -%}

                                 
{%- if randomNumber == 7 -%}
        {%- render 'banner-header-10days' -%}
{%-  elsif  randomNumber == 8 -%}
        {%- render 'banner-header-spend-n-save' -%}
{% elsif randomNumber == 9 %}
      {%- render 'banner-header-black-friday' -%}
{%- endif -%}
{% comment %} ------------------------------- {% endcomment %}