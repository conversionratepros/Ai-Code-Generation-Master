                            <path fill-rule="evenodd"  stroke="rgb(228, 233, 238)" stroke-width="2px" stroke-linecap="butt" stroke-linejoin="miter" fill="none" d="M2.639,1.805 L11.534,10.700 L2.639,19.595 "/>
                        </svg>
