{% endcapture %}
{% comment %} start inspired-section {% endcomment %}
<div class="inspired-section">
    <div class="inspired-image">
        <div class="hotspot-wrap">
            <div class="hotspot1 hotspot" hotspot="1" style="top: 64%; left: 16%;">
                {{ hotspot_svg }}
                <a href="/products/just-right-height-adjustable-desk" class="hotspotlink"></a>
            </div>
            <div class="hotspot2 hotspot" hotspot="2" style="top: 59.7%; left: 94.3%;">
                {{ hotspot_svg }}
                <a href="/products/lark-swivel-meeting-chair" class="hotspotlink"></a>
