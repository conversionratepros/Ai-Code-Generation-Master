{{ 'more-about-collection-section.css' | asset_url | stylesheet_tag }}

<div class="grid-custom1 grid-custom1--{{tagName}} more-about-collection-section">
    <div class="page-width">
        <span class="more-about-collection-heading">
            <h2>More about our <br> {{ collection.title }}</h2>
        </span>
        <div class="grid-3-column">
            <div class="grid-blocks__block ">
                <div class="thumbnail-card">
                    {% if item1_url != '' %}
                        {% assign item_url_first = item1_url %}
                    {% else %}
                        {% assign item_url_first = "#" %}
                    {% endif %}
                    <a href="{{ item_url_first }}" class="card-link-on-panel">
                        <img src="{{item1_image | file_img_url : '330x'}}" alt="{{item1_label}}" width="330px" height="auto" />
                        <div class="thumbnail-card-body">
                            <div class="card-title">
                                {{item1_label}}
                            </div>
                            <div class="card-link-icon">
                                <svg viewBox="0 0 14 10" fill="none" aria-hidden="true" focusable="false" role="presentation" class="icon icon-arrow" xmlns="http://www.w3.org/2000/svg">
                                    <path fill-rule="evenodd" clip-rule="evenodd" d="M8.537.808a.5.5 0 01.817-.162l4 4a.5.5 0 010 .708l-4 4a.5.5 0 11-.708-.708L11.793 5.5H1a.5.5 0 010-1h10.793L8.646 1.354a.5.5 0 01-.109-.546z" fill="currentColor">
                                    </path>
                                </svg>  
                            </div>
                        </div>
                    </a>
                </div>
            </div>    
            <div class="grid-blocks__block ">
                <div class="thumbnail-card">
                    {% if item2_url != '' %}
                        {% assign item2url = item2_url %}
                    {% else %}
                        {% assign item2url = "#" %}
                    {% endif %}
                    <a href="{{ item2url }}" class="card-link-on-panel">
                        <img src="{{item2_image | file_img_url : '330x'}}" alt="{{item2_label}}" / >
                        <div class="thumbnail-card-body">
                            <div class="card-title">
                                {{item2_label}}
                            </div>
                            <div class="card-link-icon">
                                <svg viewBox="0 0 14 10" fill="none" aria-hidden="true" focusable="false" role="presentation" class="icon icon-arrow" xmlns="http://www.w3.org/2000/svg">
                                    <path fill-rule="evenodd" clip-rule="evenodd" d="M8.537.808a.5.5 0 01.817-.162l4 4a.5.5 0 010 .708l-4 4a.5.5 0 11-.708-.708L11.793 5.5H1a.5.5 0 010-1h10.793L8.646 1.354a.5.5 0 01-.109-.546z" fill="currentColor">
                                    </path>
                                </svg>  
                            </div>
                        </div>
                    </a>
                </div>
            </div>
            <div class="grid-blocks__block ">
                <div class="thumbnail-card">
                    <a class="card-link-on-panel" {% if item3_url == '#' %}onclick="goToProductList()" href="javascript:void(0)" {% else %} href="{{item3_url}}" {% endif %}>
                        {%- assign videoImg = item3_image | file_img_url: '330x240', crop:'center' -%}
                        {%- if item3_video -%}
                            {% render 'custom-modal-video-more-about', cover_image: item3_image, video_url: item3_video %}
                        {% endif %}
                        <div class="thumbnail-card-body">
                            <div class="card-title">
                                {{item3_label}}
                            </div>
                            <div class="card-link-icon">
                                <svg viewBox="0 0 14 10" fill="none" aria-hidden="true" focusable="false" role="presentation" class="icon icon-arrow" xmlns="http://www.w3.org/2000/svg">
                                    <path fill-rule="evenodd" clip-rule="evenodd" d="M8.537.808a.5.5 0 01.817-.162l4 4a.5.5 0 010 .708l-4 4a.5.5 0 11-.708-.708L11.793 5.5H1a.5.5 0 010-1h10.793L8.646 1.354a.5.5 0 01-.109-.546z" fill="currentColor">
                                    </path>
                                </svg>  
                            </div>
                        </div>
                    </a>
                </div>
            </div>  

        </div>
    </div>
</div>