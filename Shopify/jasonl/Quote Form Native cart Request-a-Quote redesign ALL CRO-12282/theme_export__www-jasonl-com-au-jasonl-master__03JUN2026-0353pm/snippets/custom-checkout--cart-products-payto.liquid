   var shippingMethod = document.querySelectorAll('.checkbox-container input[name="shipping_method"]');

   function radioField(radioBtn){
        let radioBtn_value;
        for(var i = 0; i < radioBtn.length; i++){
            if(radioBtn[i].checked){
                radioBtn_value = radioBtn[i].value;
                showShippingRates(radioBtn[i]);
                togglePickup();
            }
             radioBtn[i].onclick = function() {
               radioField(radioBtn);
               if(calcRates.shipping_method == 'shipping-without-assembly'){
                 calcRates['total_shipping_price'] = calcRates.shipping;
               }else if(calcRates.shipping_method == 'shipping-with-assembly'){
                 calcRates['total_shipping_price'] = calcRates.shipping + calcRates.assembly;
               }else{
                 calcRates['total_shipping_price'] = 0;
               }
                   
            }
        }
        checkoutTotal();
        toggleAddressForms();
        disableShippingMethod(radioBtn_value);
        return radioBtn_value;
   }
   radioField(deliverMethod);
   radioField(shippingMethod);

   function disableShippingMethod(radioSelectedValue){
    if(radioSelectedValue == 'pickup'){
        document.getElementById('ccf_shippingmethod_disable').checked = true;
        document.getElementById('fields-block-shipping-method').style.display = 'none';
    }
    else{
        if(document.getElementById('ccf_shippingmethod_disable').checked){
             document.getElementById('ccf_ship_rate').checked = true;
        }
        document.getElementById('fields-block-shipping-method').style.display = 'block';
    }
   }

   function checkoutTotal(){
          let total = calcRates.subtotal;
          document.getElementById('checkoutShippingMethodLabel').innerHTML = 'Shipping';
          
        if(calcRates.delivery_method == 'pickup'){
            document.getElementById('checkoutShippingMethodLabel').innerHTML = 'Pickup';
            total = total;
            calcRates['total_shipping_price'] = 0;
        }else if(calcRates.delivery_method == 'ship' && calcRates.shipping_method == 'shipping-without-assembly'){
            total = calcRates.subtotal + calcRates.shipping;
            calcRates['total_shipping_price'] = calcRates.shipping;
          
        }else if(calcRates.delivery_method == 'ship' && calcRates.shipping_method == 'shipping-with-assembly'){
            document.getElementById('checkoutShippingMethodLabel').innerHTML = 'Shipping + Assembly';
            total = calcRates.subtotal + calcRates.shipping + calcRates.assembly;
            calcRates['total_shipping_price'] = calcRates.shipping + calcRates.assembly;
        }
        document.getElementById('checkoutTotal').innerHTML = "<span class='currency'>AUD</span><strong> $"+Intl.NumberFormat('en-US').format(total.toFixed(2))+"</strong>";
        document.getElementById('mob-checkoutTotal').innerHTML = "<span style='font-size:20px'> $"+Intl.NumberFormat('en-US').format(total.toFixed(2))+"</span>";

        return total;
   }





   function showRate(){
    let holders = [
        '[data-ratetype="shipping-rate"]',
        '[data-ratetype="assembly-rate"]',
        '[data-ratetype="total-shipping-assembly-rate"]'
    ]
    for(let i = 0; i < holders.length; i++){
        document.querySelectorAll(holders[i]).forEach(element => {
            if(holders[i] == '[data-ratetype="shipping-rate"]'){
                element.innerHTML = '$'+calcRates.shipping;
                let shippingLabel = document.getElementById('shipping-only-label').innerText;
                document.getElementById('ccf_ship_rate').setAttribute('value',shippingLabel);
            }else if(holders[i] == '[data-ratetype="assembly-rate"]'){
                if(calcRates.assembly > 0){
                    element.innerHTML = '$'+calcRates.assembly;
                    let shippingLabel = document.getElementById('shipping-with-assembly-label').innerText;
                    document.getElementById('ccf_ship_assembly_rate').setAttribute('value',shippingLabel);
                }else{
                    document.getElementById('ccf_ship_assembly_rate').parentNode.remove();
                } 
            }else{
                if(calcRates.assembly > 0){
                    element.innerHTML ='$'+(calcRates.assembly + calcRates.shipping);
                }
            }
        })
    }
    
   } 
   showRate();

   function togglePickup(){
        let pickupInfo = document.getElementById('pickup-info-holder');
        if(calcRates.delivery_method == 'pickup'){
            pickupInfo.classList.remove("hide");
        }else{
            pickupInfo.classList.add("hide");
        }
   }

    
   function toggleAddressForms(){
            if(calcRates.delivery_method == 'pickup'){
                document.getElementById('ccf_billing_address_checkbox').checked = false;
                document.getElementById('billing_address_form_holder').style.display = "block";
                document.getElementById('shipping_address_form_holder').style.display = "none";
                document.getElementById('ccf_billing_address_checkbox').parentElement.style.display = "none";
            }else{
                document.getElementById('ccf_billing_address_checkbox').checked = true;
                document.getElementById('billing_address_form_holder').style.display = "none";
                document.getElementById('shipping_address_form_holder').style.display = "block";
                document.getElementById('ccf_billing_address_checkbox').parentElement.style.display = "block";
            }
   }
