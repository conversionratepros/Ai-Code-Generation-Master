    function validatePhoneShipping(number) {
    // Regular expression for Australian landline numbers
    //var landlineRegex = /^(?:\((0\d)\)|0\d)\s?\d{4}\s?\d{4}$/;
    var landlineRegex = /^(?:\+?(61))? ?(?:\((?=.*\)))?(0?[2-57-8])\)? ?(\d\d(?:[- ](?=\d{3})|(?!\d\d[- ]?\d[- ]))\d\d[- ]?\d[- ]?\d{3})$/;
    // Regular expression for Australian mobile numbers
    var mobileRegex = /^04\d{8}$/;
    var specialNumberPattern = /^1300\d{6}$/;

    // Remove whitespace and hyphens from the number .replace("(","").replace(")","")
    number = number.replace(/\s+/g, '').replace(/-/g, '');

    // Check if the number matches either the landline or mobile regex
    return landlineRegex.test(number) || mobileRegex.test(number) || specialNumberPattern.test(number);
}

function validatePostalCode(state,postalcode){
    const australian_postcodes = {
        "Australian Capital Territory": ["0200-0221", "2600-2639", "2900-2920"],
        "New South Wales": ["1000-1999", "2000-2599", "2619-2899", "2921-2999"],
        "Northern Territory": ["0800-0899"],
        "Queensland": ["4000-4999", "9000-9999"],
        "South Australia": ["5000-5799", "5800-5999"],
        "Tasmania": ["7000-7799", "7800-7999"],
        "Victoria": ["3000-3999", "8000-8999"],
        "Western Australia": ["6000-6797", "6800-6999"]
    }

    console.log(australian_postcodes[state]);
   // if(calcRates.delivery_method == 'ship' && form == 'form_shipping_address'){
        let ranges = australian_postcodes[state];
        for(i=0; i<ranges.length; i++){
            console.log(ranges[i]);
            let range = ranges[i].split('-');
            let range_min = parseInt(range[0]);
            let range_max = parseInt(range[1]);
            console.log(`min ${range_min} - max: ${range_max}`);
            if(postalcode >= range_min && postalcode <= range_max){
                console.log('postalcode valid.');
                return true;
                break;
            }
        }
        return false;
   // }

}


