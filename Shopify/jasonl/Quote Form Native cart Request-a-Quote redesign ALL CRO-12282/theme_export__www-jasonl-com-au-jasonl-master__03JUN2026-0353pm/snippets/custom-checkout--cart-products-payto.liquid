<div class="mobile-order-summary">
    <p class="label">Show order summary </p>
    <div class="mobile-total" id="mob-checkoutTotal"></div>
</div>
<div class="cart-products">
    <ul>
        {%- for item in cart.items -%}
        <li>
            <div class="cart-prod-lt">
                {% if item.image %}
                <div class="prod-img">
                    <a href="{{item.url}}">
                        <img
                            class="cart-notification-product__image"
                            src="{{ item.image | img_url: '98x' }}"
                            alt="{{ item.image.alt | escape }}"
                            width="98"
                            height="{{ 98 | divided_by: item.image.aspect_ratio | ceil }}"
                            loading="lazy"
                        >
                    </a>
                    <span class="qty">{{ item.quantity }}</span>
                </div>
                {% endif %}
            </div>
            <div class="cart-prod-mid">
                <h4>
                    <a href="{{item.url}}">{{ item.product.title | escape }} </a>
                </h4>
                {%- unless item.product.has_only_default_variant -%}
                <dl>
                    {%- for option in item.options_with_values -%}
                    <div class="cart-notification-product__option h4" title="{{ option.name | remove:'Select a'  }}">
                        {% comment %} <dt>{{ option.name | remove:'Select a'  }}:</dt> {% endcomment %}
                        <dd>{{ option.value }}</dd>
                    </div>
                    {%- endfor -%}
                </dl>
                {%- endunless -%}
            </div>
            <div class="cart-prod-rt">
                <span class="price">{{item.price |  times: item.quantity | money}}</span>
            </div>
        </li>
        {%- endfor-%}
    </ul>
    <div class="cart-total-holder">
        <div class="cart-total-item">
            <div class="label">Subtotal</div>
            <div class="total">
                {% comment %} <span data-carttotal="{{cart.total_price | money_without_trailing_zeros | remove:',' | remove:'$'}}">{{cart.total_price | remove:',' | money_without_trailing_zeros}}</span> {% endcomment %}
                <span data-carttotal="{{cart.total_price | money_without_trailing_zeros | remove:',' | remove:'$'}}">{{cart.total_price  | money_without_trailing_zeros}}</span>
            </div>
        </div>
        <div class="cart-total-item">
            <div class="label" id="checkoutShippingMethodLabel">Shipping</div>
            <div class="total" id="shipping-cost"></div>
        </div>
        <div class="cart-total-item grand-total">
            <div class="label"><strong>Total</strong><span style="display: block">Including taxes</span></div>
            <div class="total" id="checkoutTotal"></div>
        </div>
        
    </div>
</div>
<script>
  
    const prodTotal = parseInt({{cart.total_price | money_without_trailing_zeros | remove:',' | remove:'$'}});
    const allRates = {{ shop.metafields.custom_fields.shipping_and_assembly_rates | json }};
    var calcRates = [];
    let getData = (obj) => {
        calcRates['subtotal'] = prodTotal;
        calcRates['is_billing_and_shipping_same'] = true;


      // get shipping rate and assembly rate comparing rate list from metafield
      
        for (let i in obj){
            for (let x in obj[i]){
                let minVal = parseInt(obj[i][x].min);
                let maxVal = parseInt(obj[i][x].max);
                calcRates[i] = 0;
                if(prodTotal > minVal && prodTotal < maxVal){
                        calcRates[i] = obj[i][x].cost;
                        break;
                }
            }
        }
      console.log(calcRates);
        return calcRates;
   }

   document.querySelector('.mobile-order-summary').addEventListener('click', function(){
    this.classList.toggle('active');
    if(this.classList.contains('active')){
        this.querySelector('.label').innerText = 'Hide order summary';
    }else{
        this.querySelector('.label').innerText = 'Show order summary';
    }
    
        document.querySelector('.cart-products').classList.toggle('active');
   })

   function showShippingRates(radioBtn){
    let rates = getData(allRates);
    const shippingEle = document.getElementById('shipping-cost');
    if(radioBtn.getAttribute('data-value') == 'shipping-method-ship-and-assembly'){
        shippingEle.innerHTML = '$'+(parseInt(rates.shipping)+parseInt(rates.assembly));
        calcRates['shipping_method'] = 'shipping-with-assembly';
        calcRates['delivery_method'] = 'ship';
    }else if(radioBtn.getAttribute('data-value') == 'pickup'){
        shippingEle.innerHTML = 'Free';
        calcRates['shipping_method'] = 'shipping-method-none';
        //calcRates['shipping_method'] = 'Pick-up at 2A/149 McCredie Road Smithfield, NSW 2164.';
        calcRates['delivery_method'] = 'pickup';
        calcRates['is_billing_and_shipping_same'] = false;
    }else{
         shippingEle.innerHTML = '$'+rates.shipping;
         calcRates['shipping_method'] = 'shipping-without-assembly';
         calcRates['delivery_method'] = 'ship';
    }
   }
   //showShippingRates('shipping-method-none');

//    function showAssemblyRates(){
