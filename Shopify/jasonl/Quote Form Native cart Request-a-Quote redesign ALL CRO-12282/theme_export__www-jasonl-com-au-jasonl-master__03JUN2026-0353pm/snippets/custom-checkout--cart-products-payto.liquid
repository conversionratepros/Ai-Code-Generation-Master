       isValidate_postalcode_shipping = false;
     }
     if(method == 'billing'){
       isValidate_postalcode_billing = false;
     }
       
       if(field_postalcode.value && field_state.value){
        let state = field_state.value;
        let postalcode = parseInt(field_postalcode.value);
        let isValidatePostalCode = validatePostalCode(state,postalcode);
        let errorLabel = field_postalcode.parentElement.querySelectorAll('.just-validate-error-label');
