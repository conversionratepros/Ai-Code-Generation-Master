<script>
// send typform opened id to gtm
function ready({ formId }) {
  let form_id = { formId };
  window.dataLayer = window.dataLayer || [];
  window.dataLayer.push({
    'event' : `typeform_opened_${form_id.formId}`
  });
}
</script>