                for (var i = 0; i < this.childNodes.length; i++) {
                  if (this.childNodes[i].className == "card-wrapper") {
                    let holder = this.childNodes[i];
                    let topCat = '';
                    //let topCategory = holder.querySelector("tag");
                      
                      {% comment %} 
                          if(holder.dataset.popular == 0)  topCat = 'Popular';
                          if(holder.dataset.popular == 1)  topCat = 'New';
                          if(holder.dataset.popular == 2)  topCat = 'Recommended'; 
                      {% endcomment %}
                      
                        // ga4 event through tagmanager 
                        window.dataLayer = window.dataLayer || [];
