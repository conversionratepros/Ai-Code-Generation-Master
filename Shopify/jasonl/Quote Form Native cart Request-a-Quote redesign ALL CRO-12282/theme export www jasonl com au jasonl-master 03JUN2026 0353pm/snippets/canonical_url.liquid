{% comment %} 
16 April 2025 : Add check for hide from search engines accentutate meta tag is checked
if so, then give first priority to content for header meta robots tag
{% endcomment %}

{%- assign has_meta_robots = false -%}
{%- if content_for_header contains '<meta name="robots"' -%}
    {%- assign has_meta_robots = true -%}
{%- endif -%}

{% if template =='product' -%}
    {%- assign productdesc = product.description | strip_newlines -%}
    {%- assign productdesc = productdesc | split: '<div id="size_option">' -%}
    {%- assign desccount = productdesc | size -%}
    {%- assign product_meta_robots = 'NOINDEX' -%}
    {%- if desccount > 1 -%}
          {%- assign desc = productdesc[1] | split: '[/redirect]' -%}
          {%- assign desc = desc[0] | split: '[redirect]' -%}
          {%- assign redirect = desc[1] -%}
          {% comment %} {%- assign urlproducthandle = product.handle | strip -%} {% endcomment %}
          {%- assign redirectstrip = redirect | strip -%}
          {%- comment -%}
          Apr 30 2026
          ------------------------------------
          Issue : duplicate meta description 
          Old logic : sizes url in cannonical
          Fixes : implemented base size url in all sizes 
          <link rel="canonical" href="{{ shop.url }}/products/{{ urlproducthandle }}"> 
          {%- endcomment -%}
          <link rel="canonical" href="{{ shop.url }}/products/{{ redirectstrip }}">
    {%- else -%}
        <link rel="canonical" href="{{ canonical_url }}">
        {%- comment -%} <META NAME="ROBOTS" CONTENT="INDEX, FOLLOW"> {%- endcomment -%}
    {%- endif -%}
	{%- assign product_meta_robots = 'INDEX, FOLLOW' -%}

    {%- comment -%}
      --------------------------------------------------------------------------
      Added on 16th April 2025
      1. Product variant should not be indexed by google but should be eligible in Google Merchant Center. 
      2. Should not be blocked by robots.txt
      page url =
    {%- endcomment -%}
    {%- if product.selected_variant.url -%}
        {%- assign product_meta_robots = 'NOINDEX, FOLLOW' -%}
    {%- endif -%}
    {%- comment -%} ------------------------------------------------------------ {%- endcomment %}

    {%- unless has_meta_robots -%}
        {%- render 'meta-robots', data_meta_robots: product_meta_robots -%}
    {%- endunless -%}
{%- elsif template contains 'collection' -%}
    {%- comment -%} 
        4/21/2026
        Check for double handle in url eg :  https://www.jasonl.com.au/collections/office-workstations/office-workstations
        this will have the canonical url: https://www.jasonl.com.au/collections/office-workstations
    {%- endcomment -%}
    {% assign duplicate_tag_handle_url = false %}
    {% for c_tag in current_tags %}
        {% if c_tag == collection.handle %}
            {% assign duplicate_tag_handle_url = true %}
            {% break %}
        {% endif %}    
    {% endfor %}
    {% if duplicate_tag_handle_url == true %}
        <link rel="canonical" href="{{ shop.url }}{{ collection.url }}">
    {% else %}
        {%- if collection.handle == 'office-furniture' %}
            <link rel="canonical" href="{{ canonical_url }}">
            {%- unless has_meta_robots -%}
                <META NAME="ROBOTS" CONTENT="NOINDEX">
            {%- endunless -%}
        {%- else -%}
                {%- assign is_firstPage = true -%}
                {%- if canonical_url contains '?page=' or canonical_url contains '&page='-%}
                    {%- assign is_firstPage = false -%}     
                {%- endif -%}
                {%- assign is_filterTag = false -%}
                {%- assign is_perth_page = false -%}
                {%- assign is_child_collection = false -%}

                {%- for ctag in current_tags -%}
                    {%- assign datavalue= ctag | downcase -%}
                    {%- assign datavalue= datavalue | replace: " ","" -%}
                    {%- assign datavalue= datavalue | slice: 0, 24 -%}
                    {%- assign colnamevalue= datavalue | append: "_t" -%}
                    {%- if shop.metafields.['tagproducts'][colnamevalue] -%}
                        {%- assign is_child_collection = true -%}
                    {%- else -%}
                        {%- assign collection_location_cities = shop.metafields.custom_fields.location_collection__locations | split:',' -%}
                        {%- assign cities_secondary =  shop.metafields.custom_fields.location_collection__locations__secondary   -%}
                        {%- assign cities_all = shop.metafields.custom_fields.location_collection__locations | append:',' | append : cities_secondary  | split:',' -%}

                        {%- assign dtag = ctag | downcase -%}
                            {%- comment -%} {%- unless collection_location_cities contains dtag  -%} {%- endcomment -%}
                        {%- unless cities_all contains dtag  -%}
                            {%- assign is_filterTag = true -%}
                            {%- break -%}
                        {%- endunless -%}
                    {%- endif -%}    
                {%- endfor -%}
                {%- if canonical_url contains '/perth' or canonical_url contains '+perth' or canonical_url contains 'perth?' -%}
                    {%- assign is_perth_page = true -%}
                {%- endif -%}
                {%- comment -%} get clean url spliting ?  {%- endcomment -%}
                {%- assign canonical_url_clean = canonical_url | split: '?' | first -%}
                {%- if is_child_collection == true -%}
                    <link rel="canonical" href="{%- render 'canonical-child-collection' -%}">
                {%- else -%}
                    <link rel="canonical" href="{{ canonical_url_clean }}">
                {%- endif %}
                {%- comment -%}
                5/5/2026
                old backup logic for canonical url 
                {%- if is_firstPage -%} 
                    {%- if is_child_collection == true -%}
                        <link rel="canonical" href="{%- render 'canonical-child-collection' -%}">
                    {%- else -%} 
                        <link rel="canonical" href="{{ canonical_url }}">
                    {%- endif -%}
                {%- else -%}
                    {%- assign canonical_url_clean = canonical_url | split: '?' | first -%}
                    {%- if is_child_collection == true -%}
                        <link rel="canonical" href="{%- render 'canonical-child-collection' -%}">
                    {%- else -%}
                        <link rel="canonical" href="{{ canonical_url_clean }}">
                    {%- endif -%}
                {%- endif %}  
                {%- endcomment -%}
                {%- if collection.metafields.seo.hidden -%}
                {%- else -%}
                    {%- unless has_meta_robots -%}
                        {% if is_filterTag == true or is_perth_page == true or is_firstPage == false -%}
                            <META NAME="ROBOTS" CONTENT="NOINDEX">
                        {%- else -%}
                            <META NAME="ROBOTS" CONTENT="INDEX, FOLLOW">
                        {%- endif -%}
                    {%- endunless -%}
                {%- endif -%}
        {%- endif -%}
    {% endif %}
{%- elsif template == 'blog' and current_tags -%}
    <link rel="canonical" href="{{ canonical_url }}">
    {%- unless has_meta_robots -%}
        <META NAME="ROBOTS" CONTENT="NOINDEX, FOLLOW"> 
    {%- endunless -%}
{%- elsif template == 'search' -%}
    <link rel="canonical" href="{{ canonical_url }}">
    {%- unless has_meta_robots -%}
        <META NAME="ROBOTS" CONTENT="NOINDEX, FOLLOW">  
    {%- endunless -%}
{%- elsif  template == 'blog.fitouts' and current_tags  -%}
    <link rel="canonical" href="{{ canonical_url }}">
    {%- unless has_meta_robots -%}
        <META NAME="ROBOTS" CONTENT="NOINDEX, FOLLOW">   
    {%- endunless -%}
{%- elsif  template == 'page.ab-test-home-b' -%}
    <link rel="canonical" href="https://www.jasonl.com.au/">
    {%- else -%}
    <link rel="canonical" href="{{ canonical_url }}">
    {%- unless has_meta_robots -%}
        <META NAME="ROBOTS" CONTENT="INDEX, FOLLOW">
    {%- endunless -%}
{%- endif -%}
{%- comment -%}
<!-- ===================
END :: Canonical URL 
======================== -->
{%- endcomment -%}