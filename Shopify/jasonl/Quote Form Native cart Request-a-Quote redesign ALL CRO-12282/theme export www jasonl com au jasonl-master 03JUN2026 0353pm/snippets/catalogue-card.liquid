{%- assign catalogue_link = 'https://builder.jasonl.com.au/catalogue/' -%}
{%- if type == 1 -%}
<a href="{{catalogue_link}}" class="card-with-icon catalogue-card-with-icon" target="_blank" rel="noopener noreferrer">
    <div class="icon bookmark-icon">{{- 'icon-bookmark.svg' | inline_asset_content -}}</div>
    <div class="icon-card-body">
        <div class="icon-card-body-title"><h3>CATALOGUE</h3></div>
        <div class="icon-card-body-content cataglogue-content">
            View our 2026 product catalogue.
        </div>
        </div>
        <div class="catalogue-link-icon"><span class="icon-left"></span></div>
</a>
{%- elsif type == 2 -%} 
    <a href="{{catalogue_link}}" class="catalogue-card" style="background-image: url('{{ 'vertical-catalogue-bg-img.jpg' | asset_url }}')" target="_blank" rel="noopener noreferrer">
        {% comment %} <img src="{{ 'vertical-catalogue-bg-img.jpg' | asset_url }}" width="auto" height="auto" alt="Catalogue"> {% endcomment %}
        <div class="icon bookmark-icon">{{- 'icon-bookmark.svg' | inline_asset_content -}}</div>
        <h2 class="catalogue-card-title">CATALOGUE</h2>
        <p class="catalogue-card-content">View our 2026 product catalogue.</p>
        <div class="catalogue-link-icon"><span class="icon-left"></span></div>
    </a>
{%- endif -%}



