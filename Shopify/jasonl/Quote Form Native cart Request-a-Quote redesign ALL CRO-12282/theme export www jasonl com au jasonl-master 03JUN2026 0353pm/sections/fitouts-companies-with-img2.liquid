            {{ "component-company-logo.css" | asset_url | stylesheet_tag }}
            {{ "fitouts-companies-with-img.css" | asset_url | stylesheet_tag }}
            {%- assign perPageLimit = 6 -%}
            {%- assign fitout_card_counter = 0 -%}
            {%- assign heading_main = section.settings.fitoutscompaniesimg_heading -%}
            {%- assign heading_text = section.settings.fitoutscompaniesimg_paragraph -%}
            {%- assign button_text = section.settings.fitoutscompaniesimg_button -%}
            {%- assign button_url = section.settings.fitoutscompaniesimg_buttonurl -%}
            {%- assign button_class = section.settings.fitoutscompaniesimg_buttonclass -%}
            {%- assign button_attr = section.settings.fitoutscompaniesimg_buttonattr -%}
            {%- assign button_text_2 = section.settings.fitoutscompaniesimg_button2 -%}
            {%- assign button_url_2 = section.settings.fitoutscompaniesimg_buttonurl2 -%}
            {%- assign button_class_2 = section.settings.fitoutscompaniesimg_buttonclass2 -%}
            {%- assign button_attr_2 = section.settings.fitoutscompaniesimg_buttonattr2 -%}

            {%-comment-%} using render gets an error {%-endcomment-%}
            {%- assign fitout_articles = blogs['fitouts'].articles  -%}
            <div class="page-width">
                <div class="fitouts-list-with-img">
                    <div class="fitoutsImg__heading">
                        {%- if heading_main != empty -%}
                            <h2>{{heading_main}}</h2>
                        {%- endif -%}
                        {%- if heading_text != empty -%}
                            <P>{{heading_text | replace: '[product.name]', product.title }}</P>
                        {%- endif -%}
                        {%- if button_text != empty or button_text_2 != empty-%}
                            <div class="button-holder">
                                {%- if button_text != empty -%}
                                <a href="{{button_url}}"
                                    class="button {% if button_class == empty %}button--primary fitoutsImg__loadmore{% else %}{{button_class}}{% endif %}" {{button_attr}}>
                                    {{button_text}}
                                </a>
                                {%- endif -%}
                                {%- if button_text_2 != empty -%}
                                <a href="{%- if button_url_2 != blank -%}{{button_url_2}}{% else %}javascript:void(0) {%- endif -%}"
                                    class="button {% if button_class_2 == empty %}button--primary fitoutsImg__loadmore{% else %}{{button_class_2}}{% endif %}" {{button_attr_2}}>
                                    {{button_text_2}}
                                </a>
                                {%-endif-%}

                            </div>
                        {%-endif-%}
                    </div>
                    <div class="fitoutsImg__col3">
                        <div class="fitoutsImg__list">
                            {%- assign articleTitle_fromActivePage = article.title -%}


            {%- comment -%}
            this condition added for article fitout template. There is two fitouts listing section. Both are display same list.
            Hence Fitouts with latest fitouts list will be after 7th index to make them different.
            This condition can be removed after some time.
            {%- endcomment -%}
            {%- if template == "article.fitouts" -%}
                            {%- for article in fitout_articles -%}
                                {%- if forloop.index > 7 -%}
                                    {%- assign articleTitle_fromBlogList = article.title -%}
                                    {% unless articleTitle_fromActivePage == articleTitle_fromBlogList %}
                                        {% unless  article.tags contains 'fitouts-inspiration' or article.tags contains 'fitouts-enviro' or article.tags contains 'external-fitouts'%}
                                        {%- render 'fitout-card', article:article -%}
                                        {%- assign fitout_card_counter = fitout_card_counter | plus:1-%}
                                        {%- if fitout_card_counter == perPageLimit -%}
                                            {%- break -%}
                                        {%- endif -%}
                                        {% endunless %}
                                    {% endunless %}
                                {%-endif-%}
                            {%- endfor -%}
            {%- else -%}
                            {%- for article in fitout_articles -%}
                                {%- assign articleTitle_fromBlogList = article.title -%}
                                {% unless articleTitle_fromActivePage == articleTitle_fromBlogList %}
                                    {% unless  article.tags contains 'fitouts-inspiration' or article.tags contains 'fitouts-enviro' or article.tags contains 'external-fitouts'%}
                                    {%- render 'fitout-card', article:article -%}
                                    {%- assign fitout_card_counter = fitout_card_counter | plus:1-%}
                                    {%- if fitout_card_counter == perPageLimit -%}
                                        {%- break -%}
                                    {%- endif -%}
                                    {% endunless %}
                                {% endunless %}
                            {%- endfor -%}
            {%- endif -%}



                        </div>
                    </div>
                </div>
            </div>






