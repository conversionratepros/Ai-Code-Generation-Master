<script>
  {% comment %} 
    {% comment %} this is for toogle  accordion functionality if you want to hide the current selection accordion {% endcomment %}
    document.addEventListener("DOMContentLoaded", (event) => {
      const accordion = document.querySelectorAll(".accordion");
      const panel = document.querySelectorAll(".panel");

      accordion.forEach((tab, i) => {
        tab.addEventListener("click", function () {
          const isActive = this.classList.contains("active");

          // Remove active from all tabs and hide all panels
          accordion.forEach((tab) => tab.classList.remove("active"));
          panel.forEach((content) => content.classList.add("hidden"));

          // Toggle current tab/panel if not already active
          if (!isActive) {
            this.classList.add("active");
            panel[i].classList.remove("hidden");
          }
        });
      });
    }); 
  {% endcomment %}




  document.addEventListener("DOMContentLoaded",(event) => {
    const accordion = document.querySelectorAll(".accordion");
    const panel = document.querySelectorAll(".panel");

    accordion.forEach((tab, i) => {
      tab.addEventListener("click", function () {
        accordion.forEach((tab) => tab.classList.remove("active"));
        this.classList.add("active");
        panel.forEach((content) => content.classList.add("hidden"));
        panel[i].classList.remove("hidden");
      });
    });

  });

</script>
<script>
  let location_list_item = document.querySelectorAll('.location-map-1-holder .location-list .location-list-item');
  let location_list_item_all = document.querySelector('.location-map-1-holder .location-list .location-list-item-all');
  let au_map_all = document.querySelector('.au-map-holder .au-map-all');

  let addresses = document.querySelectorAll('.address-holder-item');

  for (let i = 0; i < location_list_item.length; i++) {
    let showroom_name = location_list_item[i].getAttribute('data-showroom');

    // Mouse Enter 
    location_list_item[i].addEventListener('mouseenter', () => {
      // let activeItem = document.querySelector('.location-map-1-holder .location-list .location-list-item-all.active');
      // let activeShowroom = document.querySelector('.location-map-1-holder .location-list .location-list-item.active');
      // let activeAddressHolder = document.querySelector('.location-map-1-holder .location-address-holder .address-holder-item.active');
      // let activeMap = document.querySelector('.location-map-1-holder .au-map-selected .au-map.active');

      // activeItem && activeItem.classList.remove('active');
      // activeShowroom && activeShowroom.classList.remove('active');
      // activeAddressHolder && activeAddressHolder.classList.remove('active');
      // activeMap && activeMap.classList.remove('active');

      //     addresses.forEach(address => {                  
      //       if (!address.classList.contains('active')) {
      //           address.classList.add('disabled');
      //       }else{
      //         address.classList.remove('disabled');
      //       }           
      // });

      document.querySelectorAll('.location-map-1-holder .location-list .location-list-item-all.active, .location-map-1-holder .location-list .location-list-item.active, .location-map-1-holder .location-address-holder .address-holder-item.active, .location-map-1-holder .au-map-selected .au-map.active,.au-map-holder .au-map-all.active')
        .forEach(activeElement => activeElement.classList.remove('active'));

      //Location List
      let location_list = document.querySelectorAll(`.location-map-1-holder .location-list-item[data-showroom="${showroom_name}"]`);

      location_list.forEach(item => {
        item.classList.add('active');
      });

      //Address Holder
      document.querySelector(`.location-map-1-holder .location-address-holder .address-holder-item[data-showroom="${showroom_name}"]`).classList.add('active');

      //Map   
      document.querySelector(`.location-map-1-holder .au-map-selected .au-map-${showroom_name}`).classList.add('active');

      addresses.forEach(address => {
        address.classList.toggle('disabled', !address.classList.contains('active'));
      });
    })
  }

  location_list_item_all.addEventListener("mouseenter", () => {
    location_list_item_all.classList.add("active");
    au_map_all.classList.add("active");
    document
      .querySelectorAll(
        ".location-map-1-holder .location-list .location-list-item.active, .location-map-1-holder .location-address-holder .address-holder-item.active, .location-map-1-holder .au-map-selected .au-map.active"
      )
      .forEach((activeElement) => activeElement.classList.remove("active"));
    addresses.forEach((address) => address.classList.remove("disabled"));
  });
</script>


