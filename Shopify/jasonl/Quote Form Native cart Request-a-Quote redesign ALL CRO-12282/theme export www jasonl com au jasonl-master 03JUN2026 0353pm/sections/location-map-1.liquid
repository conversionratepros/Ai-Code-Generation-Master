{% comment %} 
<div class="page-width groupb-showroom-section ab-test-group-B">
  <div class="accordion-wrapper">
    <h2>Want the full JasonL experience? <br /> Stop by a showroom and say hello.</h2>


    {%  for block in section.blocks %}
      <div class="accordion-list">
        <button class="accordion {% if forloop.index == 1 %}active{% endif %}">
          <div class="toggle-title">
            <div class="toggle-title-text">{{ block.settings.address_name }} </div>
            <address>
              <div>
                <strong>{{ block.settings.address_name }} </strong>
              </div>
              <div>
                {{ block.settings.address }}
              </div>
              <a class="location-call" href="tel:{{ block.settings.phone }}">Call: {{ block.settings.phone }}</a> <br />
              <a href="{{ block.settings.location_link }}" class="location-call getdirectionbtn" target="_blank" rel="noopener noreferrer">Get Directions</a>
            </address>
          </div>
        </button>
        <div class="panel {% if forloop.index != 1 %}hidden{% endif %}">
          <address>
            <div class="address-title">
              <strong>{{ block.settings.address_name }} </strong>
            </div>
            <div>{{ block.settings.address }}</div>
            <a class="location-call" href="tel: {{ block.settings.phone }}">Call: {{ block.settings.phone }}</a> <br />
            <a href="{{ block.settings.location_link }}" class="location-call getdirectionbtn" target="_blank" rel="noopener noreferrer">Get Directions</a>
          </address>
          <div class="matterport-with-thumbnail">
            <ul>
              {% for i in (1..4) %}
                {% assign thumbnailnumber = 'thumbnail_' | append: i %}
                {% assign thumbimg = block.settings[thumbnailnumber] %}
                {% if thumbimg %}
                  <li>
                    <picture>
                      {{
                        thumbimg
                        | image_url: width: 258
                        | image_tag:
                          sizes: sizes,
                          widths: '258'
                      }}
                    </picture>
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
            <div class="iframe-container" style="background-image: url('{% if block.settings.LocationBannerImage and block.settings.matterport_url == nil %} {{ block.settings.LocationBannerImage | image_url }} {% endif %} ');">
              {% if block.settings.matterport_url %}
                <iframe src="{{ block.settings.matterport_url }}" allowfullscreen></iframe>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    {% endfor %}
    {% comment %} 
