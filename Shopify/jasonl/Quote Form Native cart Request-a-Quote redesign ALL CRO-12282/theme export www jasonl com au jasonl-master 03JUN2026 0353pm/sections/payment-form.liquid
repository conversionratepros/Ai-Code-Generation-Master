// check form input for validation and enable continue button
document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('.box-row.box-body').forEach(formBox => {

    const requiredInputs = formBox.querySelectorAll('input[required]');
    const emailInput = formBox.querySelector('#email');
    const amountInput = formBox.querySelector('#amount');
    const continueBtn = formBox.querySelector('#continue-btn');

    function isEmailValid(email) {
      // Simple & safe email regex
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    }

    function checkFormFilled() {
      let allValid = true;

      requiredInputs.forEach(input => {
        if (input.value.trim() === '') {
          allValid = false;
        }
      });

      // Email validation
      if (!isEmailValid(emailInput.value.trim())) {
        allValid = false;
      }

      // Amount validation (> 0)
      if (Number(amountInput.value) <= 0) {
        allValid = false;
      }

      continueBtn.classList.toggle('enable', allValid);
    }

    requiredInputs.forEach(input => {
      input.addEventListener('input', checkFormFilled);
      input.addEventListener('blur', checkFormFilled);
    });

    checkFormFilled(); // initial check
  });
});
</script>

