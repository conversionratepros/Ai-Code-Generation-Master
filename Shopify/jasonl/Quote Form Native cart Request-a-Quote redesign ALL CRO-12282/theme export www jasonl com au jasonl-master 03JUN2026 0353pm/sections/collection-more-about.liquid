{{ 'grid-custom1.css' | asset_url | stylesheet_tag }}
{% comment %} new more-about-collection-section {% endcomment %}
{% comment %} this section has slider {% endcomment %}
{{ 'more-about-collection-section.css' | asset_url | stylesheet_tag }}
<div class="grid-custom1 grid-custom1--{{tagName}} more-about-collection-section">
    <div class="page-width slider-page-width">
        <span class="more-about-collection-heading">
            <h2>More about our <br class="visible-lg"> {%- render 'collection-title' -%}</h2>
        </span>
        <div class="more-about-collection-slider">
            <div class="swiper-contianer">
                {{ 'more-about-collection-slider.css' | asset_url | stylesheet_tag }}
                {% comment %} <!-- Swiper --> {% endcomment %}
                <div class="swiper more-about-collection-swiper">
                    <div class="swiper-wrapper">
                    <div class="swiper-slide">
                        <div class="thumbnail-card">
                            {% if item1_url != '' %}
                                {% assign item_url_first = item1_url %}
                            {% else %}
                                {% assign item_url_first = "#" %}
                            {% endif %}
                            <a href="{{ item_url_first }}" class="card-link-on-panel">
                                <picture class="card-image-wrapper">
                                    <img src="{{item1_image | file_img_url : '375x'}}" loading="lazy" alt="{{item1_label}}" width="370" height="209" />
                                </picture>
                                <div class="thumbnail-card-body">
                                    <div class="card-title">
                                        {{item1_label}}
                                    </div>
                                    <div class="card-link-icon">
                                        <svg viewBox="0 0 14 10" fill="none" aria-hidden="true" focusable="false" role="presentation" class="icon icon-arrow" xmlns="http://www.w3.org/2000/svg">
                                            <path fill-rule="evenodd" clip-rule="evenodd" d="M8.537.808a.5.5 0 01.817-.162l4 4a.5.5 0 010 .708l-4 4a.5.5 0 11-.708-.708L11.793 5.5H1a.5.5 0 010-1h10.793L8.646 1.354a.5.5 0 01-.109-.546z" fill="currentColor">
                                            </path>
                                        </svg>  
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                    <div class="swiper-slide">
                        <div class="thumbnail-card">
                            {% if item2_url != '' %}
                                {% assign item_url_2 = item2_url %}
                            {% else %}
                                {% assign item_url_2 = "#" %}
                            {% endif %}
                            <a href="{{ item_url_2 }}" class="card-link-on-panel">
                                <picture class="card-image-wrapper">
                                    <img src="{{item2_image | file_img_url : '375x'}}" loading="lazy" alt="{{item2_label}}"  width="370" height="209" />
                                </picture>
                                <div class="thumbnail-card-body">
                                    <div class="card-title">
                                        {{item2_label}}
                                    </div>
                                    <div class="card-link-icon">
                                        <svg viewBox="0 0 14 10" fill="none" aria-hidden="true" focusable="false" role="presentation" class="icon icon-arrow" xmlns="http://www.w3.org/2000/svg">
                                            <path fill-rule="evenodd" clip-rule="evenodd" d="M8.537.808a.5.5 0 01.817-.162l4 4a.5.5 0 010 .708l-4 4a.5.5 0 11-.708-.708L11.793 5.5H1a.5.5 0 010-1h10.793L8.646 1.354a.5.5 0 01-.109-.546z" fill="currentColor">
                                            </path>
                                        </svg>  
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                    <div class="swiper-slide">
                        <div class="thumbnail-card">
                            {% comment %} {%- assign videoImg = item3_image | file_img_url: '330x240', crop:'center' -%} {% endcomment %}
                            {%- if item3_video -%}
                                <div class="card-image-wrapper">
                                    {% render 'custom-modal-video-more-about', cover_image: item3_image, youtube_id: item3_video, item3_label:item3_label,
                                        youtube_title: item3_youtube_title, 
                                        youtube_description: item3_youtube_description, 
                                        youtube_uploaded_date: item3_youtube_date %}
                                </div>
                                <modal-opener class="no-js-hidden" data-modal="#PopupModal-{{ item3_video }}">
                                    <button  type="button" aria-haspopup="dialog" data-media-id="{{item3_video}}" style="background-color: transparent; border:0px; width:100%; padding: 0;">
                                        <div class="thumbnail-card-body hover_pointer video-caption">
                                            <div class="card-title">
                                                {{item3_label}}
                                            </div>
                                            <div class="card-link-icon">
                                                <svg viewBox="0 0 14 10" fill="none" aria-hidden="true" focusable="false" role="presentation" class="icon icon-arrow" xmlns="http://www.w3.org/2000/svg">
                                                    <path fill-rule="evenodd" clip-rule="evenodd" d="M8.537.808a.5.5 0 01.817-.162l4 4a.5.5 0 010 .708l-4 4a.5.5 0 11-.708-.708L11.793 5.5H1a.5.5 0 010-1h10.793L8.646 1.354a.5.5 0 01-.109-.546z" fill="currentColor">
                                                    </path>
                                                </svg>  
                                            </div>
                                        </div>
                                    </button>
                                </modal-opener>
                            {%- else -%}
                                {% if item3_url != '' %}
                                    {% assign item_url_3 = item3_url %}
                                {% else %}
                                    {% assign item_url_3 = "#" %}
                                {% endif %}
                                <a href="{{ item_url_3 }}" class="card-link-on-panel">
                                    <div class="card-image-wrapper">
                                        <img src="{{item3_image | file_img_url : '375x'}}" alt="{{item3_label}}" width='775px' height="" loading="lazy" />
                                    </div>
                                    <div class="thumbnail-card-body">
                                        <div class="card-title">
                                            {{item3_label}}
                                        </div>
                                        <div class="card-link-icon">
                                            <svg viewBox="0 0 14 10" fill="none" aria-hidden="true" focusable="false" role="presentation" class="icon icon-arrow" xmlns="http://www.w3.org/2000/svg">
                                                <path fill-rule="evenodd" clip-rule="evenodd" d="M8.537.808a.5.5 0 01.817-.162l4 4a.5.5 0 010 .708l-4 4a.5.5 0 11-.708-.708L11.793 5.5H1a.5.5 0 010-1h10.793L8.646 1.354a.5.5 0 01-.109-.546z" fill="currentColor">
                                                </path>
                                            </svg>  
                                        </div>
                                    </div>
                                </a>
                            {% endif %}
                        </div>
                    </div>
                    </div>
                    <div class="swiper-pagination"></div>
                </div>

                <!-- Initialize Swiper -->
                <script>
                    
                    window.addEventListener("load", (event) => {
                        
                        var swiper = new Swiper(".more-about-collection-swiper", {
                            slidesPerView: 1.2,
                            spaceBetween: 10,
                            pagination: {
                                el: ".swiper-pagination",
                                type: "fraction"
                            },
                            breakpoints: {
                                800: {
                                    spaceBetween: 30,
                                    slidesPerView: 3
                                }
                            }

                        });

                        if (window.innerWidth > 768) {
                            swiper.destroy(true, true);
                        } 
                    });
                    
                </script>
            </div>
        </div>
    </div>
</div> {% comment %} end more-about-collection-section {% endcomment %}
{% comment %} this section has slider end {% endcomment %}

{%- endif -%}

