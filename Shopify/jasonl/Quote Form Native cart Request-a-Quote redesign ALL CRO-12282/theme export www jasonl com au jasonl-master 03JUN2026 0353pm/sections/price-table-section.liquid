<script>
   const swiper = new Swiper('.interiror-styling-swiper', {
        speed: 400,
        spaceBetween: 10,
        slidesPerView: 1.3,
        centeredSlides: true,
        initialSlide: 1,
        navigation: {
            nextEl: ".nextbtn",
            prevEl: ".prevbtn",
        },
        breakpoints: {
            768:{
                initialSlide: 0,
                centeredSlides: false,
                spaceBetween: 20,
                slidesPerView: 1.2,
            },
            992:{
                spaceBetween: 20,
                centeredSlides: false,
                slidesPerView: 2.1,
            },
            1320: {
                spaceBetween: 20,
                centeredSlides: false,
                slidesPerView: 3,
            },
        }
    }); 
</script>

