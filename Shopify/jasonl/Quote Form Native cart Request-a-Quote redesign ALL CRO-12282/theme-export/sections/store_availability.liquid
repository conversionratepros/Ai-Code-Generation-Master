    <script type="application/json">
      {
      "store_availability":{
      "variant": "{{ product.selected_variant.title }}",
      "location_info":[
            {%- for l in product.selected_variant.store_availabilities -%}
                    {%- if l.location.id == 27868748 -%}
                      {%- assign locationCode = 'NSW' -%}
                    {%- else -%}
                      {%- assign locationCode = 'WA' -%}
                    {%- endif -%}
                    {
                      "locationCode":"{{ locationCode }}",
                      "locationName" : "{{l.location.name}}",
                      "locationMetafields" : "{{l.location.metafields}}",
                      "locationId" : "{{ l.location.id }}",
                      "available" : "{{ l.available}}"
                    } {% unless forloop.last %},{% endunless %}
            {%- endfor -%}
            ]
      }
    }
    </script>
    
