{{ "education-landingpage-hero.css" | asset_url | stylesheet_tag }}

<div class="hero-container hero-container-2">
        <div class="hero-main-wrapper">
                <picture class="hero-picture">
                    {% comment %} 
                    <source media="(max-width:465px)" srcset="{{'landingpage2-hero-img-mob.png' | file_img_url:'master'}}">
                    <img src="{{'landingpage2-hero-img.png' | file_img_url:'master'}}" alt="Blank canvas to beautiful fitout. Fast!" width="" height="" /> 
                    {% endcomment %}
                    <source media="(min-width:768px)" srcset="{{ 'education-hero-banner-lg.jpg' | file_img_url:'1920x' }}">
                    <img src="{{ 'education-hero-banner-sm.jpg' | file_img_url:'375x' }}" alt="Blank canvas to beautiful fitout. Fast!" width="375px" height="226px" />
                </picture>
            <div class="page-width">
                <div class="hero-main-innner-container">
                    <div class="hero-text">
                        <h1 class="h1-style">Furnish your <br class="large-hide"> campus <br class="small-hide"> in under 10 days - <br class="small-hide">guaranteed.</h1>
                        
                        <a class="typeform-share getaquoteclick link" {{ settings.typeformurls_url_1 }} href="javascript:void(0)">
                            GET A QUOTE TODAY
                            </a>
