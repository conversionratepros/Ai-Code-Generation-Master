    <div class="bs-body">
      <div class="bs-body-item page-index active">
        <div class="bs-body-cnt">
          <picture class="banner-img">
            <source media="(max-width:650px)" srcset="https://cdn.shopify.com/s/files/1/1249/7859/files/block-sequence-main-img-mobile-2.png?v=1698663225">
            <img src="https://cdn.shopify.com/s/files/1/1249/7859/files/block-sequence-main-img.png?v=1697537310" alt="I want to schedule a call" />
          </picture>
          <div class="options-body">
            <div class="body-cnt">
              <span class="hi">Hi there!</span>
              <strong class="heading">
                <span class="lg">Please select the action that <br>best suits <span>you</span>
                </span>
                <span class="sm">Please select the <br> action that best <br> suits <span>you</span>
                </span>
              </strong>
              <ul class="options">
                <li>
                  <a id="link-schedule-call" class="button bs-ga4-button-track" href="" data-ga4-param-option="Schedule call">I want to schedule a call</a>
                </li>
                <li>
                  <span class="button triggerBtn bs-ga4-button-track" data-ga4-param-option="No longer interested" data-target="page-survey-pick">I am no longer interested</span>
                </li>
                <li>
                  <div class="button triggerBtn" data-target="page-catalogue">
                    <span class="lg bs-ga4-button-track" data-ga4-param-option="Send me Catalogue">Please send me a JasonL product catalogue</span>
                    <span class="sm bs-ga4-button-track" data-ga4-param-option="Send me Catalogue">Send me a JasonL catalogue</span>
                  </div>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
      <!-- item -->
      <div class="bs-body-item page-survey-pick">
        <div class="bs-body-cnt">
          <div class="options-body">
            <div class="body-cnt">
              <strong class="heading">
                <span class="lg">We will not contact you.</span>
                <span class="sm">Sales will not be contacting you as you requested</span>
              </strong>
              <p>
                <span class="lg">However we would love to know WHY you are no longer interested.</span>
                <span class="sm">We will love to know more about your decision. Your input is very valuable to us.</span>
              </p>
              <ul class="options">
                <li>
                  <span class="button triggerBtn bs-ga4-button-track" data-target="page-survey" data-ga4-param-option="Take survey">Take survey(1min)</span>
                </li>
                <li>
                  <div class="button triggerBtn" data-target="page-catalogue">
                    <span class="lg bs-ga4-button-track" data-ga4-param-option="Send me Catalogue">Please send me a JasonL product catalogue</span>
                    <span class="sm bs-ga4-button-track" data-ga4-param-option="Send me Catalogue">Send me a JasonL catalogue</span>
                  </div>
                </li>
              </ul>
              <!-- <button class="button button-submit">Submit {% render 'icon-arrow' %}</button> -->
            </div>
          </div>
        </div>
      </div>
      <!-- item -->
      <div class="bs-body-item page-survey">
        <div class="bs-body-cnt">
          <div class="options-body">
            <div class="body-cnt">
              <strong class="heading">Thank you for choosing to help <br>us improve our service </strong>
              <p>Please choose the reason that best describe why you are no <br>longer interested in hearing from JasonL </p>
              <ul class="options">
                <li>
                  <label class="radio-container">
                    <span class="label">I am no longer looking for office furniture</span>
                    <input type="radio" name="reason" value="I am no longer looking for office furniture">
                    <span class="checkmark"></span>
                  </label>
                </li>
                <li>
                  <label class="radio-container">
                    <span class="label">I have decided to use another supplier</span>
                    <input type="radio" name="reason" value="I have decided to use another supplier">
                    <span class="checkmark"></span>
                  </label>
                </li>
                <li>
                  <label class="radio-container">
                    <span class="label">I found what I was looking for cheaper somewhere else</span>
                    <input type="radio" name="reason" value="I found what I was looking for cheaper somewhere else">
                    <span class="checkmark"></span>
                  </label>
                </li>
                <li>
                  <label class="radio-container">
                    <span class="label">I found a better quality product somewhere else</span>
                    <input type="radio" name="reason" value="I found a better quality product somewhere else">
                    <span class="checkmark"></span>
                  </label>
                </li>
                <li>
                  <label class="radio-container">
                    <span class="label">Other: </span>
                    <input class="other-reason-radio" type="radio" name="reason" value="other">
                    <span class="checkmark"></span>
                    <input class="other-reason-text" type="text" name="other" value="" onKeyPress="inputOtherReason()" onKeyUp="inputOtherReason()">
                  </label>
                </li>
              </ul>
              <p class="enter-reason">Select any reason from above list. </p>
              <div class="button-holder">
                <button class="button button-submit" disabled>Submit {% render 'icon-arrow' %}</button>
                <div class="lds-ring">
                  <div></div>
                  <div></div>
                  <div></div>
                  <div></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- item -->
      <div class="bs-body-item page-catalogue">
        <div class="bs-body-cnt">
          <div class="options-body">
            <div class="body-cnt">
              <strong class="heading">
                <span class="lg">We know you are going to love <br>our product catalogue </span>
                <span class="sm">You will love our product catalogue</span>
              </strong>
              <p>
                <span class="lg"> Please provide your full name, address and phone. <br> One of our sales reps will send you our catalogue ASAP </span>
                <span class="sm"> Please enter your Name, Address and Phone and a Sales Rep will send you the catalogue ASAP</span>
              </p>
              <div class="options ">
                <div class="form-holder">
                  <form action="" method="post" name="requestacatalogueform" id="form-catalogue-full" class="block-sequence-catalogue-form">
                    <div class="field-item">
                      <!-- <label>Full Name</label> -->
                      <input type="text" name="name" placeholder="Full Name*">
                      <div class="name_error">Your name is required</div>
                    </div>
                    <div class="field-item" style="display:none">
                      <input type="text" id="hidfield" name="hidfield">
                    </div>
                    <div class="field-item" style="display:none">
                      <input type="text" id="catalogueName" name="cataloguename" value="full catalogue">
                    </div>
                    <div class="field-item">
                      <!-- <label>Address</label><span class="required">*</span> -->
                      <input type="text" name="address" placeholder="Address*">
                      <div class="address_error">Your address is required</div>
                    </div>
                    <div class="field-item select-dropdowns-holder">
                      <div class="select-dropdowns">
                        <select name="state" id="catalogueState">
                          <option value="" disabled="" selected="">State</option>
                          <option value="New South Wales">New South Wales</option>
                          <option value="Victoria">Victoria</option>
                          <option value="Queensland">Queensland</option>
                          <option value="South Australia">South Australia</option>
                          <option value="Australian Capital Territory">Australian Capital Territory</option>
                          <option value="Western Australia">Western Australia</option>
                          <option value="Tasmania">Tasmania</option>
                        </select>
                      </div>
                      <div class="state_error">State is required</div>
                    </div>
                    <!-- <div class="field-item"><input type="text" name="email" placeholder="Email Address*"><div class="email_error">Your email is required</div><div class="email_invalid_error">Invalid email</div></div> -->
                    <div class="field-item">
                      <!-- <label>Phone number</label><span class="required">*</span> -->
                      <input type="text" name="phone" placeholder="Phone*">
                      <div class="phone_error">Your phone number is required</div>
                      <div class="phone_invalid_error">Invalid phone</div>
                    </div>
                    <div class="form-submit-successful" id="formsubmitstatus"></div>
                    <div class="field-item">
                      <input type="submit" class="button button--primary" value="Send me the catalogue">
                    </div>
                  </form>
                </div>
                <!-- form-holder-->
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- item -->
      <div class="bs-body-item page-thankyou">
        <div class="bs-body-cnt">
          <div class="thankyou-box">
            <strong id="thankyou-msg" style="opacity: 1;">Thank you for <span>your Feedback!</span>
            </strong>
            <svg id="thankyou-svg" style="opacity: 1;" width="110" height="114" viewBox="0 0 110 114" fill="none" xmlns="http://www.w3.org/2000/svg">
