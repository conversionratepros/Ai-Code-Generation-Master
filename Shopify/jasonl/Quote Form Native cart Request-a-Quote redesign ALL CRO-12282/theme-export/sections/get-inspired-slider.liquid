{{ 'get-inspired-slider.css' | asset_url | stylesheet_tag }} 
<div class="get-inspired-holder">
  <div class="page-width">
    {%- assign section_title = section.settings.section_title -%}
    <h2>Get Inspired</h2>

    <div class="item-holder">
      {%- assign fitouts = blogs['fitouts'].articles -%} <!-- Fetching blog articles -->
      {%- if fitouts.size > 0 -%}
        <div class="get-inspired-slider swiper">
          <ul class="swiper-wrapper">
            {%- for article in fitouts -%}
              {%- assign fitoutsIndex = forloop.index -%}
              {%- assign size1 = forloop.index | modulo: 5 -%}
              {%- assign size2 = forloop.index | modulo: 3 -%}

              {% if forloop.index == 1 or size2 == 0 %}
                {% assign imgWtHt = '385x290' %}
                {% assign imgHt = '290' %}
              {% elsif forloop.index == 2 or size1 == 0 %}
                {% assign imgWtHt = '385x290' %}
                {% assign imgHt = '290' %}
              {% else %}
                {% assign imgWtHt = '385x290' %}
                {% assign imgHt = '290' %}
              {% endif %}

              {%- if article.metafields.fitout_blog.inspired_image -%}
                {%- assign imgSrc = article.metafields.fitout_blog.inspired_image[0] -%}  <!-- Get only the first image -->
                
                <li class="swiper-slide">
                  <div>
                    <a href="{{ article.url }}" title="{{ article.title }}">
                      <img src="{{ imgSrc | file_img_url: imgWtHt, crop: 'center' }}" alt="{{ article.title }}" width="" height="">
                      <div class="item-cnt">
                        <span class="label">by</span>
                        <h4 class="title">{{ article.title }}</h4>
                      </div>
                    </a>
                  </div>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
        <button class="swiper-button-next" id="swiper-btn-next"></button>
        <button class="swiper-button-prev" id="swiper-btn-previous"></button>
      {%- endif -%}
    </div>
  </div>
</div>

{%- if fitouts.size > 0 -%}
<script>
window.addEventListener("load", (event) => {
  const swiper = new Swiper('.get-inspired-slider', {
    slidesPerView: 2,
    spaceBetween: 15,
    autoplay: false,
    breakpoints: {
      640: {
        slidesPerView: 3,
        spaceBetween: 20,
        grid: {
          rows: 1,
        },
      },
      1024: {
        slidesPerView: 4,
        spaceBetween: 20,
        centeredSlides: false,
      },
    },
    navigation: {
      nextEl: '.swiper-button-next',
      prevEl: '.swiper-button-prev',
    },
  });
});
</script>
{%- endif -%}

{% schema %}
{
  "name": "Get Inspired Slider",
  "settings": []
}
{% endschema %}
