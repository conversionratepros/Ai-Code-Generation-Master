{%-comment-%}{% assign ref_product = article.metafields.fitout_blog.fitout_products.value %}{%-endcomment-%}
{% assign ref_product = article.metafields.fitout_blog.fitout_products %}
{%- if ref_product != '' -%}
<!-- fitout product listing start -->
{{ 'fitouts-product-listing.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-product-grid.css' | asset_url | stylesheet_tag }}
{{ 'product-listing.css' | asset_url | stylesheet_tag }}

{% comment %}
