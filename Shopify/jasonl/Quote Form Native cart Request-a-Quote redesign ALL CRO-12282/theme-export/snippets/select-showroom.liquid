        {% endif %}
    
{%- endif -%}




{{"collection-location-hero-banner.css" | asset_url | stylesheet_tag }}


{% capture location_banner %} 
    <div class="banner-section {% unless iframemap contains 'iframe' %} no-map{% endunless %}" id="location-banner">
        <div class="container page-width banner-container">
            <div class="heading-col">
                {%- if showroom == true-%}
                    <h1>Office furniture <span style="font-style: italic;">in</span> <span class="city">{{city |  capitalize}}.</span></h1>
                    <strong class="h1">Easy. Fast!</strong>
                {%- else -%}
                    <h1>{{- collectionTitle -}}<span style="padding-left: 8px;">in</span> <span class="city">{{city |  capitalize | remove: "."}}.</span></h1>
                {%- endif -%}
            </div>
            <div class="location-col">
                {%  if address != empty %}
                <div class="icon-card icon-shop">
                    <h2 class="h3 icon-title">Visit our showroom</h2>
                    <div class="icon-card-content">
                            {{address}}
                    </div>
                </div>
                {% endif %}
                {%  if phoneNumber != empty or emailAddress != empty %}
                <div class="icon-card icon-phone">
                    <h2 class="h3 icon-title">Contact us</h2>
                    <div class="icon-card-content">
                        {%  if phoneNumber != empty %}
                        <div>Call {{ phoneNumber }} </div>
                        {% endif %}
                        {%  if emailAddress != empty %}
                        <div>{{ emailAddress }}</div>
                        {% endif %}
                    </div>
                </div>
                {% endif %}
            </div>
            <div class="banner-img-map-col {% if videoId == empty %}no-video-walkthrought-section{% endif %}">
                {%  if videoId != empty %}
                <div class="walkthrought-section">
                    <div class="iframe-container">
                        <iframe src="{{videoId}}" allowfullscreen store_location="{{ city }} showroom" id="mpIframe"></iframe>
                    </div>
                </div>
            {%  elsif showroomImage != empty %}
                <div class="image-only-banner">
                    <picture>
                        <source srcset="{{showroomImage | file_img_url:'1416x'}} 2x" media="(min-width: 768px) and (min-resolution: 2dppx)">
                        <img src="{{showroomImage | file_img_url:'708x'}}" alt="Showroom {{ city }}" width="708" height="306">
                    </picture>
                </div>
                {% endif %}
                <div class="img-grid">
                    <ul>
                        <li>
                            {% capture bannerimages %}
                                {%- if mapImage != '' -%}
                                    <img src="{{mapImage | file_img_url:'380x'}}" alt="Banner {{ city }}" width="229" height="138" />
                                {%- else -%}
                                        {% if imgs contains ',' %}
                                                {%- assign imgList = imgs | split : ','-%}
                                                <img src="{{ imgList[0] | file_img_url:'380x'}}" alt="{{ city }}" width="229" height="138" />
                                        {%- else -%}
                                                <img src="{{ img | file_img_url:'380x'}}" alt="{{ city }}"  width="229" height="138" />
                                        {%- endif -%}
                                {%- endif -%}
                            {% endcapture %}

                            {%  if getDirection == "" or getDirection == nil or getDirection == blank %}
                                    {{ bannerimages }}
                                {% else %}
                                    <a href="{{getDirection}}" target="_blank" rel="noopener noreferrer" class="get-direction-btn" data-ga4="location_engagement" direction_location="{{ city | remove: "showroom" | remove: "Showroom"}} showroom">
                                        <div class="get-direction-overlay-btn">
                                            <span class="btn">Get Directions {% render 'icon-marker' %}</span>
                                        </div>
                                        {{ bannerimages }}
                                        </a>
                            {% endif %}
                            
                        </li>
                        {%- if imgs != empty and imgs != blank and imgs -%}
                                {% if imgs contains ',' %}
                                    {%- assign imgList = imgs | split : ','-%}
                                    {% for img in imgList limit:2 %}
                                <li> <img src="{{ img | file_img_url:'380x'}}" srcset="{{ img | file_img_url:'245x'}} 1920w, {{ img | file_img_url:'380x'}} 1550w, {{ img | file_img_url:'598x'}} 2x" alt="{{ city }}"  width="229" height="138"/></li>
                                    {% endfor %}
                                {%- else -%}
                                    {%- assign img  = imgs -%}
                                    <li> <img src="{{ img | file_img_url:'master'}}" alt="{{ city }}" width="229" height="138"/></li>
                                {%- endif -%} 
                        {%- endif -%}
                    </ul>
                </div>
            </div>
        </div>
    </div>
{% endcapture %}

{% if template == "collection" or template == "collection.rewards" %}
    {% if has_city_tag %}
        {{ location_banner }}
        {% else %}
    {% endif %} 
{% else %}
    {{ location_banner }}
{% endif %}


{% if template == "collection" %}
<script>
  document.addEventListener('DOMContentLoaded', function() {
    (function () {
      const url = new URL(window.location.href);
      const hasLocationParam = url.searchParams.has('location');
    
 
      if (hasLocationParam) {
        let bannerSections = document.getElementById('location-banner');
        if (bannerSections) {
          bannerSections.style.display = 'block';
        }
      }
    })();
  });
</script>
{% endif %}