{%- comment -%} This is for itemprop {%- endcomment -%}
<meta itemprop="name" content="{{ metatitle | strip }}">
<meta itemprop="description" content="{{ metadescription | strip }}">
{%- if template == "index" -%}
    {% comment %} <meta itemprop="image" content="https://cdn.shopify.com/s/files/1/1249/7859/files/JasonL_Office_Furniture_Australia.jpg"> {% endcomment %}
<meta itemprop="image" content="https:{{ page_image | image_url }}">
{%- elsif template =='blog.fitouts' %}
<meta itemprop="image" content="https://cdn.shopify.com/s/files/1/1249/7859/articles/057A9713.jpg">
{%- elsif tagimagevalue != '' -%}
    {%- assign imageurl= tagimagevalue | strip -%}
    {%- assign submenu_imgsrc = imageurl | file_img_url: 'original' %}
<meta itemprop="image" content="https:{{ submenu_imgsrc }}">
{%- else -%}
{%- if page_image %}
<meta itemprop="image" content="https:{{ page_image | img_url: 'master' }}">
{%- endif -%}
{%- endif %}