<details class="filtermenu-static-holder facets__disclosure js-filter sidebar-width filterbytype-sidebar small-hide" data-index="60" open>
    <summary class="facets__summary caption-large focus-offset filter-heading">
        <div><span><strong>Categories</strong></span>
            <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-caret" viewBox="0 0 10 6">
                <path fill-rule="evenodd" clip-rule="evenodd"
                    d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z"
                    fill="currentColor"></path>
            </svg>
        </div>
    </summary>

    {%- assign navigation_handle = 'main-nav-header' -%}

    {% if linklists[navigation_handle] %}
        {%- for link in linklists[navigation_handle].links -%}
                <div class="filtermenu-item-holder">
                    <ul id="filtermenu-list" class="list-type-1 remove-bottom-spacing">
                        <li class="{% if link.active %}filtermenu-nav--active{% endif %}">
                            <a href="{{ link.url }}" data-collectiontag="{{ link.title }}" data-colHandle="{{ link.handle }}">
                                {{ link.title | escape }}  
                                <div class="custom-checkbox-holder">
                                    <svg class="icon icon-checkmark" width="11" height="7" viewBox="0 0 11 7" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M1.5 3.5L2.83333 4.75L4.16667 6L9.5 1" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
                                    </svg>
                                </div>
                            </a>
                        </li>
                    </ul>
                </div>
        {%- endfor -%}
    {% else %}
        <p>No links available for this navigation.</p>
    {% endif %}
</details>


<style>
    .filtermenu-static-holder.facets__disclosure{
        margin-right: 0;
    }
    .filtermenu.facets__display{
        max-height: unset;
    }
    .filtermenu-item-holder ul{
        padding:0 0 23px;
        margin-top: 0;
        @media(max-width:767px){
            padding-left: 0px;
        }
    }
    .filtermenu-item-holder ul li{
        /* padding:3px 0; */
        padding: 0px;
    }
    .list-type-1 li{
            display: block;
    padding: 3px 0 5px;
    }
    .list-type-1 li a, #filter_view_all_categories.view-all-categories {
    position: relative;
    display: block;
    padding: 4px 25px 10px 36px;
    font-size: 13px;
    line-height: 16px;
    }
    .list-type-1 li a:hover, .list-type-1 li.active a, .list-type-1 li.filtermenu-nav--active a {
    /* font-weight: 700; */
    }
    #filtermenu-list .hide{
        display: none;
    }
    @media screen and (min-width: 750px){
        .facets-vertical .facets__summary.filter-heading{
            padding-bottom: 1.3rem;
        }
    }
</style>


