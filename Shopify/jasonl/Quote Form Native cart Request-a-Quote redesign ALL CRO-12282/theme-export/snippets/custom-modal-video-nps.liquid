{%- assign video_id_with_params = video_url | split: "v=" | last -%}
{%- assign video_url_id = video_id_with_params | split: "&" | first -%}
{%- if video_url contains "youtube" -%}
  {%- assign video_type = "youtube" -%}
{%- elsif video_url contains "vimeo" -%}
  {%- assign video_type = "vimeo" -%}
{%- else -%}
  {%- assign video_type = "unknown" -%}
{%- endif -%}

{% comment %} {% if youtube_title and youtube_uploaded_date %} {% endcomment %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
          "@type": "VideoObject",
          "name": "{{youtube_title}}",
          "description": "{{youtube_description}}",
          "thumbnailUrl": [
              "https://img.youtube.com/vi/{{video_url_id}}/default.jpg", 
            "https://img.youtube.com/vi/{{video_url_id}}/hqdefault.jpg", 
            "https://img.youtube.com/vi/{{video_url_id}}/mqdefault.jpg", 
              "https://img.youtube.com/vi/{{video_url_id}}/sddefault.jpg"
          ], 
          "uploadDate": "{{youtube_uploaded_date}}",
          "embedUrl": "https://www.youtube.com/embed/{{video_url_id}}"
          }
    </script>
{% comment %} {%- endif -%} {% endcomment %}

{%- unless render_card_css == false -%} {{ 'component-card.css' | asset_url | stylesheet_tag }} {%- endunless -%}
{%- unless render_price_css == false -%}{{ 'component-price.css' | asset_url | stylesheet_tag }}{%- endunless -%}
{{ 'component-modal-video.css' | asset_url | stylesheet_tag }}
{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

              <modal-opener data-modal="#PopupModal-var-{{video_url_id}}">
                  <div class="deferred-media">
                    
                    <button
                      class="deferred-media__poster full-unstyled-link"
                      type="button"
                      aria-label="{{ 'sections.video.load_video' | t: description: block.settings.description | escape }}"
                      aria-haspopup="dialog"
                      data-media-id="{{ video_url_id }}"
                    >
                      <div
                        class="media media--transparent ratio"
                        {%- assign is_full_img_url = false -%}
                        {% unless cover_image contains 'https' %} 
                              {%- assign is_full_img_url = true -%}
                        {% endunless %}
                                {% if cover_image != blank and is_full_img_url != false %}
                                  style="--ratio-percent: {{ 1 | divided_by: cover_image.aspect_ratio | times: 100 }}%"
                                {% else %}
                                  style="--ratio-percent: 100%"
                                {% endif %}
                     
                      >
                        <span class="deferred-media__poster-button motion-reduce">
                          <span class="svg-wrapper">
                            {% comment %} <svg xmlns="http://www.w3.org/2000/svg" fill="none" class="icon icon-play" viewBox="0 0 10 14"><path fill="currentColor" fill-rule="evenodd" d="M1.482.815A1 1 0 0 0 0 1.69v10.517a1 1 0 0 0 1.525.851L10.54 7.5a1 1 0 0 0-.043-1.728z" clip-rule="evenodd"/></svg> {% endcomment %}
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 118.93 146.54" class="icon icon-play">
                              <g data-name="Layer 1">
                                <path d="m0,146.54l118.93-81.52L0,0v146.54Z"/>
                              </g>
                            </svg>
                            {% comment %} {{- 'icon-play.svg' | inline_asset_content -}} {% endcomment %}
                          </span>
                        </span>
                        {% if static_cover_image != '' %}
                            <img src="{{ static_cover_image }}" width="" height="" alt="video thumbnail"/>
                        {% else %}
                            {%- if cover_image != blank -%}
                            {%- capture sizes -%}
                                (min-width: {{ settings.page_width }}px)
                                {% if section.blocks.size == 1 -%}
                                calc({{ settings.page_width }}px - 100px)
                                {%- else -%}
                                {{- settings.page_width | minus: 100 | times: 0.67 | round }}px
                                {%- endif -%}
                                , (min-width: 750px)
                                {%- if section.blocks.size == 1 %} calc(100vw - 100px){% else %} 500px{% endif -%}
                                , calc(100vw - 30px)
                            {%- endcapture -%} 

                            {% if cover_image contains 'https' or has_custom_thumbnial %}
                                    {% comment %} {% assign cover_image = cover_image %} {% endcomment %}
                                    <img src="{{cover_image | width:'310x'}}" width=""  height="" alt="thumbnail"/>
                            {% else %}
                                    {{
                                    cover_image
                                    | image_url: width: 310
                                    | image_tag: sizes: sizes, widths: '550, 720, 990, 1100, 1500, 2200, 3000'
                                    }}  
                            {% endif %}
                                
                            {%- else -%}
                            {{ 'hero-apparel-3' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
                            {%- endif -%} 
                        {% endif %}
                      </div>
                    </button>
                  </div>
                </modal-opener>
                <modal-dialog
                  id="PopupModal-var-{{video_url_id}}"
                  class="modal-video media-modal color-{{ settings.color_schemes | first }}"
                >
                  <div
                    class="modal-video__content"
                    role="dialog"
                    aria-label="{{ block.settings.description | escape }}"
                    aria-modal="true"
                    tabindex="-1"
                  >
                    <button
                      id="ModalClose-{{ block.id }}"
                      type="button"
                      class="modal-video__toggle"
                      aria-label="{{ 'accessibility.close' | t }}"
                    >
                      <span class="svg-wrapper">
                        {{- 'icon-close.svg' | inline_asset_content -}}
                      </span>
                    </button>
                    <div class="modal-video__content-info">
                      <deferred-media class="modal-video__video template-popup">
                        <template>
                          {%- if video_type == 'youtube' -%}
                            <iframe
                              src="https://www.youtube.com/embed/{{ video_url_id }}?enablejsapi=1"
                              class="js-youtube"
                              allow="autoplay; encrypted-media"
                              allowfullscreen
                              title="{{ block.settings.description | escape }}"
                            ></iframe>
                          {%- else -%}
                            <iframe
                              src="https://player.vimeo.com/video/{{ video_url_id }}"
                              class="js-vimeo"
                              allow="autoplay; encrypted-media"
                              allowfullscreen
                              title="{{ block.settings.description | escape }}"
                            ></iframe>
                          {%- endif -%}
                        </template>
                      </deferred-media>
                    </div>
                  </div>
                </modal-dialog>

                {% comment %}
                --  
                {%- unless youtube_title and youtube_uploaded_date -%}
                <script>
                  document.addEventListener("DOMContentLoaded", () => {
                    function youtube_schema() {
                      const YOUTUBE_API_KEY = "AIzaSyDp4s5VrEIvohon4rwG6K6BHbfemgpUY68"; 
                      const youtubeId = "{{ video_url_id }}"; 
                
                      if (!youtubeId) return;
                
                      const url = `https://www.googleapis.com/youtube/v3/videos?part=snippet&id=${youtubeId}&key=${YOUTUBE_API_KEY}`;
                      fetch(url)
                        .then(response => response.json())
                        .then(data => {
                          if (data.items.length > 0) {
                            const video = data.items[0].snippet;
                            const jsonld = {
                              "@context": "http://schema.org",
                              "@type": "VideoObject",
                              "name": video.title,
                              "description": video.description,
                              "thumbnailUrl": [
                                video.thumbnails.default.url,
                                video.thumbnails.medium.url,
                                video.thumbnails.high.url
                              ],
                              "uploadDate": video.publishedAt,
                              "embedUrl": `https://www.youtube.com/embed/${youtubeId}`
                            };
                            console.log(jsonld);
                            const el = document.createElement("script");
                            el.type = "application/ld+json";
                            el.textContent = JSON.stringify(jsonld);
                            document.head.appendChild(el);
                            console.log("Appending to head:", el);
                          }
                        })
                        .catch(error => console.error("Error fetching YouTube data:", error));
                    }
                
                    youtube_schema();
                  });
                </script>
                {%- endunless -%}
                 {% endcomment %}