<div id="zoho-form-holder" data-form-loaded="false">
{% assign forms = shop.metaobjects.gated_content_forms.values %}
{% assign matched_forms = "" %}
{% for tag in article.tags %}
  {% for form_data in forms %}
    {% assign format_form_data = form_data.tag |  remove:'["' | remove:'"]' %}
    {% if format_form_data == tag %}
      {% assign matched_forms = matched_forms | append: forloop.index0 | append: "|" %}
    {% endif %}
  {% endfor %}
{% endfor %}

{% assign matched_forms_num_array = matched_forms | split: "|" %}

{% assign matched_forms_array_size = matched_forms_num_array.size %}
{%- assign random_form = "" -%}
{% if matched_forms_array_size > 1 %}
      {%- assign max = matched_forms_array_size -%}
      {%- assign random_number = "now" | date: "%N" | modulo: max -%}

       {% comment %} {% if random_number > 7 %}
            {%  assign random_number = 7  %}
      {% endif %} {% endcomment %}
      
      {% assign random_form = matched_forms_array[random_number] %}
{% elsif matched_forms_array_size == 1 %}
      {% assign random_form = matched_forms_array[0] %}
{% endif %}


{% if random_form != "" %}
  
        {% for meta in shop.metaobjects.gated_content_forms.values %}
              {% assign randNum = matched_forms_num_array[random_number] |  strip  |  times: 1%}
          {% comment %}{% assign randNum = 5 %} {% endcomment %}

              {% if forloop.index0 == randNum %}
                          {%- assign buttonLabel = meta.button_label -%}
                          {%- assign metaHeaderText = meta.header -%}
                          {%- assign metaIntroText = meta.sub_header -%}
                          {%- assign metaUTMCampaign = meta.utm_campaign -%}
                          {%- assign metaUTMMedium = meta.utm_medium -%}
                          {%- assign metaDownloadItem = meta.download_item -%}
                          {%- assign metaUTMSource = meta.utm_source -%}
                          {%- assign metaUTMContent = meta.utm_content -%}
                          {%- assign metaSource = meta.source -%}
                          {%- capture formHtml -%}
                              {% render 'rh-zohoform-embed-script',  default_utm_source:metaUTMSource, default_utm_medium:metaUTMMedium, default_utm_campaign:metaUTMCampaign, default_utm_content:metaUTMContent, default_source:metaSource, download_item:metaDownloadItem, headerText: metaHeaderText, introText: metaIntroText %}
                          {%- endcapture -%}
                          {{ 'rh-gated-content--raw-html-form.css' | asset_url | stylesheet_tag }}
                          {% assign className =  'button button--primary zoho-cta-btn ' | append : meta.url | append:' ' | append : randNum %}
                          {%- render 'simple-popup-modal', 
                                      modal_id: 'get-content-form', 
                                      modal_class: 'get-content-form',
                                      modal_size:'small', 
                                      modal_label:buttonLabel , 
                                      modal_button_class:className,
                                      modal_content: formHtml -%}
                {% endif %}
          {% endfor %} 

{% else %}
  <!-- <div>No matching form found.</div> -->
{% endif %} 



 






<!-- FORM -->
</div>



