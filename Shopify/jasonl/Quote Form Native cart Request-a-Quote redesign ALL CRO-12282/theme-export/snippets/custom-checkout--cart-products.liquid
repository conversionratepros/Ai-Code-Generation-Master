<div class="mobile-order-summary">
    <p class="label">Show order summary </p>
    <div class="mobile-total" id="mob-checkoutTotal">{{cart.total_price |  money_without_trailing_zeros}}</div>
</div>
<div class="cart-products">
    <ul>
        {%- for item in cart.items -%}
        {% assign product = item.product %}
        <li data_product_collection= "{% render 'get_product_category', product: product %}">
            <div class="cart-prod-lt">
                {% if item.image %}
                <div class="prod-img">
                    <a href="{{item.url}}">
                        <img
                            class="cart-notification-product__image"
                            src="{{ item.image | img_url: '98x' }}"
                            alt="{{ item.image.alt | escape }}"
                            width="98"
                            height="{{ 98 | divided_by: item.image.aspect_ratio | ceil }}"
                            loading="lazy"
                        >
                    </a>
                    <span class="qty">{{ item.quantity }}</span>
                </div>
                {% endif %}
            </div>
            <div class="cart-prod-mid">
                <h4>
                    <a href="{{item.url}}">{{ item.product.title | escape }}</a>
                </h4>
                {%- unless item.product.has_only_default_variant -%}
                <dl>
                    {%- for option in item.options_with_values -%}
                    <div class="cart-notification-product__option h4">
                        <dt>{{ option.name | remove:'Select a'  }}:</dt>
                        <dd>{{ option.value }}</dd>
                    </div>
                    {%- endfor -%}
                </dl>
                {%- endunless -%}
            </div>
            <div class="cart-prod-rt">
                <span class="price">{{ item.price | money | remove: '.00' }}</span>
            </div>
        </li>
        {%- endfor-%}
    </ul>
    <div class="cart-total-holder">
        <div class="cart-total-item">
            <div class="label"><strong>Total</strong></div>
            <div class="total"><span class="currency">AUD</span>
                <strong data-carttotal="{{cart.total_price | money_without_trailing_zeros | remove:',' | remove:'$'}}">{{cart.total_price | remove:',' | money_without_trailing_zeros}}</strong>
            </div>
        </div>
    </div>
</div>
