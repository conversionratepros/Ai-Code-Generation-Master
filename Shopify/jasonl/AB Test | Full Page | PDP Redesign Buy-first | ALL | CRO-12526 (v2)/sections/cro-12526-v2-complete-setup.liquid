{%- comment -%}
  CRO-12526 (v2) — "Complete the setup" (replaces control's cross-sell
  "Combines well with" section in the variant template).

  Product sourcing is the control's cross-sell logic VERBATIM
  (sections/cross-sell.liquid): walk product.tags → `{tag}_c` key on
  shop.metafields.tagproducts (a list of tag-keys) → each key + `_x` maps to
  comma-separated product handles; interleave the per-key lists; fall back to
  the [redirect] parent product's tags for size-variant products; skip
  products with zero inventory. Only the CARD MARKUP + copy are new (Figma
  node 33:357): white 12px-radius card, image, category eyebrow, title,
  price, lime Add to Cart, small Add to quote link (spec requires it even
  though the comp omits it).

  Per-card Add to Cart uses a real product form inside Dawn's <product-form>
  element, so the fetch → cart-drawer flow is identical to the buy box.
  cro-12526-v2-pdp.js sets the drawer pre-select (pay-online / request-quote)
  before submitting, and MOQ products submit their minimum quantity — same
  rules buy-buttons_crp applies for card-context adds.

  Theme editor: heading is set per main product collection via blocks
  (client supplies per-collection headings — pending action point); eyebrow,
  default heading and sub-line are settings.
{%- endcomment -%}

{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'cro-12526-v2-pdp.css' | asset_url | stylesheet_tag }}

{%- comment -%} ============ Control cross-sell handle resolution (verbatim logic) ============ {%- endcomment -%}
{%- assign crossellList = '' -%}
{%- assign allhandllist = '' -%}
{%- assign remaininghandles = '' -%}

{% for tagz in product.tags %}
  {% assign tag_data = tagz | downcase %}
  {% assign tag_data = tag_data | replace: ' ', '' %}
  {% assign tag_data = tag_data | slice: 0, 24 %}
  {% assign crossselltagz = tag_data | append: '_c' %}
  {% if shop.metafields.tagproducts[crossselltagz] %}
    {% assign crosssellproducts = shop.metafields.tagproducts[crossselltagz] %}
    {% assign crossList = crosssellproducts | split: ',' %}
    {%- for individuallist in crossList -%}
      {% assign cross_tag_filter = individuallist | downcase | strip %}
      {% assign cross_tag_filter = cross_tag_filter | replace: ' ', '' %}
      {% assign cross_tag_filter = cross_tag_filter | slice: 0, 24 %}
      {% assign cross_tag_filter = cross_tag_filter | append: '_x' %}
      {% if shop.metafields.tagproducts[cross_tag_filter] %}
        {% unless crossellList contains cross_tag_filter %}
          {% assign crossconcatvalue = cross_tag_filter | split: ',' %}
          {% if crossellList != '' %}
            {% assign crossellList = crossellList | concat: crossconcatvalue %}
          {% else %}
            {% assign crossellList = crossconcatvalue %}
          {% endif %}
        {% endunless %}
      {% endif %}
    {%- endfor -%}
  {% endif %}
{% endfor %}

{%- if crossellList == '' -%}
  {% if product.description contains '[redirect]' %}
    {%- assign productDescription = product.description | split: '[redirect]' -%}
    {%- assign handlevalue = productDescription[1] | split: '[/redirect]' -%}
    {% assign mainProductHandle = handlevalue[0] %}
    {% if mainProductHandle %}
      {% assign mainProductHandle = mainProductHandle | strip %}
      {% unless mainProductHandle == product.handle %}
        {% for mainproduct_tags in all_products[mainProductHandle].tags %}
          {% assign tag_data = mainproduct_tags | downcase %}
          {% assign tag_data = tag_data | replace: ' ', '' %}
          {% assign tag_data = tag_data | slice: 0, 24 %}
          {% assign crossselltagz = tag_data | append: '_c' %}
          {% if shop.metafields.tagproducts[crossselltagz] %}
            {% assign crosssellproducts = shop.metafields.tagproducts[crossselltagz] %}
            {% assign crossList = crosssellproducts | split: ',' %}
            {%- for individuallist in crossList -%}
              {% assign cross_tag_filter = individuallist | downcase | strip %}
              {% assign cross_tag_filter = cross_tag_filter | replace: ' ', '' %}
              {% assign cross_tag_filter = cross_tag_filter | slice: 0, 24 %}
              {% assign cross_tag_filter = cross_tag_filter | append: '_x' %}
              {% if shop.metafields.tagproducts[cross_tag_filter] %}
                {% unless crossellList contains cross_tag_filter %}
                  {% assign crossconcatvalue = cross_tag_filter | split: ',' %}
                  {% if crossellList != '' %}
                    {% assign crossellList = crossellList | concat: crossconcatvalue %}
                  {% else %}
                    {% assign crossellList = crossconcatvalue %}
                  {% endif %}
                {% endunless %}
              {% endif %}
            {%- endfor -%}
          {% endif %}
        {% endfor %}
      {% endunless %}
    {% endif %}
  {% endif %}
{%- endif -%}

{%- if crossellList != '' -%}
  {%- assign requiredTags = 5 -%}
  {%- assign totalNoofTags = crossellList | size -%}
  {%- assign totalTagtoFloat = totalNoofTags | times: 1.0 -%}
  {%- assign dividedNumber = requiredTags | divided_by: totalTagtoFloat -%}
  {%- assign dividedNumberInt = dividedNumber | ceil -%}
  {%- for productlevel in crossellList -%}
    {% assign producthandlelist = shop.metafields.tagproducts[productlevel] %}
    {% assign products_handle_array = producthandlelist | split: ',' %}
    {% assign counterval = 1 %}
    {%- for individualhandles in products_handle_array -%}
      {% unless allhandllist contains individualhandles %}
        {% if counterval > dividedNumberInt %}
          {% assign individualconcat = individualhandles | split: ',' %}
          {% if remaininghandles != '' %}
            {% assign remaininghandles = remaininghandles | concat: individualconcat %}
          {% else %}
            {% assign remaininghandles = individualconcat %}
          {% endif %}
          {% break %}
        {% endif %}
        {% assign individualconcat = individualhandles | split: ',' %}
        {% if allhandllist != '' %}
          {% assign allhandllist = allhandllist | concat: individualconcat %}
        {% else %}
          {% assign allhandllist = individualconcat %}
        {% endif %}
        {%- assign counterval = counterval | plus: 1 -%}
      {% endunless %}
    {%- endfor -%}
  {%- endfor -%}
  {% if remaininghandles != '' %}
    {% assign allhandllist = allhandllist | concat: remaininghandles %}
  {% endif %}
{%- endif -%}
{%- comment -%} ============ End control logic ============ {%- endcomment -%}

{%- if allhandllist != '' -%}
  {%- liquid
    comment
      Client update 2026-08-04: heading + sub-line are STATIC copy — the
      dynamic [category] heading was scrapped. heading_static is a NEW
      setting id on purpose: the theme editor persisted the old heading
      into the template JSON and stored values beat schema defaults, so a
      fresh id starts clean. Per-collection blocks kept as a manual
      override only (none configured).
    endcomment
    assign cs_heading = section.settings.heading_static | default: 'Great on its own. Better as a set.'
    for block in section.blocks
      if block.type == 'collection_heading' and block.settings.collection != blank
        for coll in product.collections
          if coll.handle == block.settings.collection.handle and block.settings.heading != blank
            assign cs_heading = block.settings.heading
            break
          endif
        endfor
      endif
    endfor
  -%}

  <div class="cro12526v2-setup" id="cro12526v2-setup">
    <div class="page-width">
      <div class="cro12526v2-eyebrow">
        <span class="cro12526v2-eyebrow__dot" aria-hidden="true"></span>
        <span class="cro12526v2-eyebrow__text">{{ section.settings.eyebrow | default: 'Complete the setup' }}</span>
      </div>
      <h2 class="cro12526v2-setup__heading">{{ cs_heading }}</h2>
      <p class="cro12526v2-setup__subline">{{ section.settings.subline }}</p>

      <ul class="cro12526v2-setup__grid" role="list">
        {%- assign shown = 0 -%}
        {%- for cross_sell in allhandllist limit: 6 -%}
          {%- if shown >= 4 -%}{%- break -%}{%- endif -%}
          {%- assign cs_product = all_products[cross_sell] -%}
          {%- if cs_product.title != '' -%}
            {%- comment -%} Control parity: only show products with stock. {%- endcomment -%}
            {%- assign product_qty = 0 -%}
            {%- for variantz in cs_product.variants -%}
              {%- if variantz.inventory_quantity > 0 -%}
                {%- assign product_qty = product_qty | plus: variantz.inventory_quantity -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if product_qty <= 0 -%}{%- continue -%}{%- endif -%}
            {%- assign shown = shown | plus: 1 -%}

            {%- liquid
              assign cs_variant = cs_product.selected_or_first_available_variant
              assign cs_min_qty = 1
              if cs_variant.metafields.custom.min_order_quantity_variant
                assign cs_min_qty = cs_variant.metafields.custom.min_order_quantity_variant
              elsif cs_product.metafields.custom.min_order_quantity
                assign cs_min_qty = cs_product.metafields.custom.min_order_quantity
              endif
              assign cs_category = ''
              for coll in cs_product.collections
                assign cs_coll_check = coll.title | downcase
                unless coll.handle == 'all' or coll.template_suffix contains 'range' or cs_coll_check contains 'dummy' or cs_coll_check contains 'remove later'
                  assign cs_category = coll.title
                  break
                endunless
              endfor
              assign cs_form_id = 'cro12526v2-setup-form-' | append: section.id | append: '-' | append: forloop.index
            -%}

            <li class="cro12526v2-setup-card">
              <a class="cro12526v2-setup-card__media" href="{{ cs_product.url }}" tabindex="-1" aria-hidden="true">
                {%- if cs_product.featured_image -%}
                  <img
                    src="{{ cs_product.featured_image | image_url: width: 740 }}"
                    alt="{{ cs_product.featured_image.alt | default: cs_product.title | escape }}"
                    width="370"
                    height="270"
                    loading="lazy"
                  >
                {%- endif -%}
              </a>
              <div class="cro12526v2-setup-card__body">
                <div class="cro12526v2-setup-card__text">
                  {%- if cs_category != '' -%}
                    <p class="cro12526v2-setup-card__category">{{ cs_category }}</p>
                  {%- endif -%}
                  <a class="cro12526v2-setup-card__title" href="{{ cs_product.url }}">{{ cs_product.title | truncatewords: 8 }}</a>
                  <p class="cro12526v2-setup-card__price">{{ cs_variant.price | money_without_trailing_zeros }}</p>
                </div>

                <product-form class="product-form cro12526v2-setup-card__form" data-section-id="{{ section.id }}">
                  <div class="product-form__error-message-wrapper" role="alert" hidden>
                    <span class="product-form__error-message"></span>
                  </div>
                  {%- form 'product', cs_product, id: cs_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                    <input type="hidden" name="id" value="{{ cs_variant.id }}" {% if cs_variant.available == false %}disabled{% endif %} class="product-variant-id">
                    <input type="hidden" name="quantity" value="{{ cs_min_qty }}">
                    <button
                      type="submit"
                      name="add"
                      class="cro12526v2-btn cro12526v2-setup-card__atc"
                      data-cro12526v2-setup-atc
                      {% if cs_variant.available == false %}disabled{% endif %}
                    >
                      <span>{%- if cs_variant.available -%}Add to Cart{%- else -%}Sold out{%- endif -%}</span>
                      {%- render 'loading-spinner' -%}
                    </button>
                    {%- comment -%}
                      Bug 9 (QA): spec requires this link even though the comp
                      omits it — restored after an interim removal request.
                    {%- endcomment -%}
                    <button
                      type="button"
                      class="cro12526v2-setup-card__atq"
                      data-cro12526v2-setup-atq
                      data-cro12526v2-setup-form="{{ cs_form_id }}"
                      {% if cs_variant.available == false %}disabled{% endif %}
                    >
                      Add to quote
                    </button>
                  {%- endform -%}
                </product-form>
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "CRO-12526 V2 Setup",
  "tag": "section",
  "class": "section-cro12526v2-setup",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow line",
      "default": "Complete the setup"
    },
    {
      "type": "text",
      "id": "heading_static",
      "label": "Heading",
      "default": "Great on its own. Better as a set."
    },
    {
      "type": "text",
      "id": "subline",
      "label": "Sub-line",
      "default": "Add the pieces that finish it — or take the lot as a bundle and save."
    }
  ],
  "blocks": [
    {
      "type": "collection_heading",
      "name": "Per-collection heading",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Main product collection"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading for this collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CRO-12526 V2 Setup"
    }
  ]
}
{% endschema %}
