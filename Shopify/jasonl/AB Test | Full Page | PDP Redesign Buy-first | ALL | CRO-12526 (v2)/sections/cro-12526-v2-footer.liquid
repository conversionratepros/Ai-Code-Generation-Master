        <p class="cro12526v2-footer__blurb">{{ section.settings.blurb }}</p>
        <p class="cro12526v2-footer__rating">
          <span class="cro12526v2-footer__star" aria-hidden="true">&#9733;</span>
          {{ section.settings.rating_line }}
        </p>
      </div>

      <nav class="cro12526v2-footer__menus" aria-label="Footer">
        {%- for i in (1..3) -%}
          {%- liquid
            assign heading_key = 'heading_' | append: i
            assign col_heading = section.settings[heading_key]
            assign col_key = i | append: ''
          -%}
          <div class="cro12526v2-footer__col" data-cro12526v2-footer-col>
            <button type="button" class="cro12526v2-footer__col-head" data-cro12526v2-footer-toggle aria-expanded="false">
              <span class="cro12526v2-footer__col-title">{{ col_heading }}</span>
              <span class="cro12526v2-footer__chevron" aria-hidden="true"></span>
            </button>
            <ul class="cro12526v2-footer__list" role="list">
              {%- for block in section.blocks -%}
                {%- if block.type == 'link' and block.settings.column == col_key and block.settings.label != blank -%}
                  <li {{ block.shopify_attributes }}>
                    <a class="cro12526v2-footer__link" href="{{ block.settings.url | default: '#' }}">{{ block.settings.label }}</a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endfor -%}
      </nav>
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('cro12526v2-footer');
    if (!root) return;
    root.querySelectorAll('[data-cro12526v2-footer-toggle]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        // Accordion is a mobile-only behaviour; desktop lists are always open.
        if (!window.matchMedia('(max-width: 749px)').matches) return;
        var col = btn.closest('[data-cro12526v2-footer-col]');
        var open = col.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    });
  })();
</script>

