{%- comment -%}
  CRO-12526 — "Planning a whole office?" section (design.html's "hole" typo
  corrected to "whole" per spec). 4 day-labelled steps as schema blocks, bottom bar
  CTA whose link destination is a PENDING client action — kept as an editable
  schema URL setting so it can be wired without a code deploy.
{%- endcomment -%}

{{ 'cro-12526-pdp.css' | asset_url | stylesheet_tag }}

<div class="cro12526-planning" id="cro12526-planning">
  <div class="page-width">
    <div class="cro12526-section-head cro12526-section-head--center">
      <div class="cro12526-eyebrow"><span class="cro12526-eyebrow__dot" aria-hidden="true"></span>{{ section.settings.eyebrow }}</div>
      <h2 class="cro12526-section-heading">{{ section.settings.heading }}</h2>
      <p class="cro12526-section-subline cro12526-section-subline--wide">{{ section.settings.paragraph }}</p>
    </div>

    <div class="cro12526-planning__days">
      {%- for block in section.blocks -%}
        {%- if block.type == 'day_step' -%}
          <div class="cro12526-planning__step" {{ block.shopify_attributes }}>
            <p class="cro12526-planning__day-label">{{ block.settings.day_label }}</p>
            <h3 class="cro12526-planning__step-title">{{ block.settings.title }}</h3>
            <p class="cro12526-planning__step-copy">{{ block.settings.copy }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="cro12526-planning__bar">
      <div class="cro12526-planning__bar-copy">
        <p><strong>{{ section.settings.bar_bold_copy }}</strong> {{ section.settings.bar_copy }}</p>
      </div>
      {%- comment -%}
        PENDING client action: destination URL is a merchant-editable schema setting
        (see test-analysis.md) — defaults to the Typeform trigger pattern used
        everywhere else on this page so the button is never a dead link, but the
        client may prefer a dedicated consult-booking page/Calendly link instead.
      {%- endcomment -%}
      {%- if section.settings.bar_button_url != blank -%}
        <a href="{{ section.settings.bar_button_url }}" class="cro12526-btn cro12526-btn--pill">
          {{ section.settings.bar_button_text }}
        </a>
      {%- else -%}
        <a href="javascript:void(0)" class="cro12526-btn cro12526-btn--pill typeform-share getaquoteclick" {{ settings.typeformurls_url_1 }} data-tf-on-ready="ready">
          {{ section.settings.bar_button_text }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CRO-12526 Planning",
  "tag": "section",
  "class": "section-cro12526-planning",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Planning a whole office?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Don't pick it part by part. Let's plan it." },
    {
      "type": "textarea",
      "id": "paragraph",
      "label": "Paragraph",
      "default": "Tell us the headcount and the space. We'll come back with a layout, a single quote and an install date — desks, chairs, storage, pods, the lot. One conversation instead of forty product pages."
    },
    { "type": "header", "content": "Bottom bar" },
    { "type": "text", "id": "bar_bold_copy", "label": "Bar bold copy", "default": "How is 10 days possible?" },
    { "type": "text", "id": "bar_copy", "label": "Bar copy", "default": "Stocked Australian warehouses and our own install crews. No middlemen, no shipping delays — it's logistics, not marketing." },
    { "type": "text", "id": "bar_button_text", "label": "Button text", "default": "Start step 1 — book a free consult" },
    {
      "type": "url",
      "id": "bar_button_url",
      "label": "Button link (PENDING client action)",
      "info": "Leave blank to fall back to the sitewide Get a Quote Typeform popup. Set this once the client confirms the real consult-booking destination."
    }
  ],
  "blocks": [
    {
      "type": "day_step",
      "name": "Day step",
      "settings": [
        { "type": "text", "id": "day_label", "label": "Day label", "default": "Day 0" },
        { "type": "text", "id": "title", "label": "Title", "default": "Chat & measure" },
        { "type": "textarea", "id": "copy", "label": "Copy", "default": "Tell us your headcount, floor and deadline. We'll come and measure — or work straight from your floorplan." }
      ]
    }
  ],
  "max_blocks": 4
}
{% endschema %}
