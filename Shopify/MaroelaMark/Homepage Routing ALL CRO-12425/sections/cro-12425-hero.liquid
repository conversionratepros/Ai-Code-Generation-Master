{% comment %}
  CRO-12425 | Hero
  Rebuild of the homepage hero: background image, centred heading and a
  single centred button, all editable in the theme editor.
  Replaces dynamic-slideshow on the variant template.
{% endcomment %}

<script
  type="application/json"
  data-section-id="{{ section.id }}"
  data-section-type="cro-12425-hero"
></script>

{% style %}
  .cro-12425-hero {
    position: relative;
    width: 100%;
    height: {{ section.settings.height_desktop }}px;
    overflow: hidden;
  }

  .cro-12425-hero__image,
  .cro-12425-hero__image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .cro-12425-hero__image img {
    object-fit: cover;
    object-position: center;
  }

  .cro-12425-hero__image--mobile {
    display: none;
  }

  .cro-12425-hero__overlay {
    position: absolute;
    inset: 0;
    background-color: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }

  .cro-12425-hero__content {
    position: relative;
    z-index: 1;
    height: 100%;
    max-width: 680px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .cro-12425-hero__heading {
    margin: 0 0 16px;
    font-weight: 800;
    font-size: 40px;
    line-height: 1.2;
    color: {{ section.settings.heading_color }};
  }

  .cro-12425-hero__button {
    display: inline-block;
    padding: 12px 24px;
    background-color: {{ section.settings.button_color }};
    border-radius: 4px;
    color: {{ section.settings.button_text_color }};
    font-weight: 700;
    font-size: 17px;
    line-height: 1.15;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }

  .cro-12425-hero__button:hover,
  .cro-12425-hero__button:focus {
    opacity: 0.85;
    color: {{ section.settings.button_text_color }};
  }

  @media screen and (max-width: 859px) {
    .cro-12425-hero {
      height: {{ section.settings.height_mobile }}px;
    }

    .cro-12425-hero__heading {
      font-size: 26px;
    }

    {% if section.settings.image_mobile %}
      .cro-12425-hero__image--desktop {
        display: none;
      }

      .cro-12425-hero__image--mobile {
        display: block;
      }
    {% endif %}
  }
{% endstyle %}

<div class="cro-12425-hero">
  {% if section.settings.image %}
    <div class="cro-12425-hero__image cro-12425-hero__image--desktop">
      {%
        render 'rimg',
        img: section.settings.image,
        size: '2048x',
        lazy: false,
      %}
    </div>
  {% endif %}

  {% if section.settings.image_mobile %}
    <div class="cro-12425-hero__image cro-12425-hero__image--mobile">
      {%
        render 'rimg',
        img: section.settings.image_mobile,
        size: '900x',
        lazy: false,
      %}
    </div>
  {% endif %}

  <div class="cro-12425-hero__overlay"></div>

  <div class="cro-12425-hero__content">
    {% if section.settings.heading != blank %}
      <h1 class="cro-12425-hero__heading">{{ section.settings.heading | escape }}</h1>
    {% endif %}

    {% if section.settings.button_label != blank %}
      <a class="cro-12425-hero__button" href="{{ section.settings.button_link | default: '#' }}">
        {{ section.settings.button_label | escape }}
      </a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "CRO-12425 Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Background image (mobile)",
      "info": "Optional. Falls back to the desktop image."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Maroela-mark is jou aanlyn markplein"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Koop nou"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button colour",
      "default": "#e99114"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text colour",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay colour",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Height (desktop)",
      "min": 300,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 420
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Height (mobile)",
      "min": 180,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 250
    }
  ],
  "presets": [
    {
      "name": "CRO-12425 Hero",
      "category": "CRO"
    }
  ]
}
{% endschema %}
