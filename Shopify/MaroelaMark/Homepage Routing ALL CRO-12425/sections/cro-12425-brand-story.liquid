{% comment %}
  CRO-12425 | Brand-story text banner ("Die Afrikaanse aanlyn mark")
  Centred heading, body copy, "Lees meer" link and a footer line with a
  "Word 'n verskaffer" link. Copy, links and colours editable.
{% endcomment %}

<script
  type="application/json"
  data-section-id="{{ section.id }}"
  data-section-type="cro-12425-brand-story"
></script>

{% style %}
  .cro-12425-story {
    background-color: {{ section.settings.background_color }};
  }

  .cro-12425-story__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 40px {{ section.settings.padding_bottom }}px;
    border-top: 1px solid #e0e0e0;
    text-align: center;
  }

  .cro-12425-story__heading {
    margin: 0;
    font-weight: 800;
    font-size: 28px;
    line-height: 1.15;
    color: {{ section.settings.text_color }};
  }

  .cro-12425-story__body {
    max-width: 560px;
    margin: 14px auto;
    font-size: 16px;
    line-height: 1.55;
    color: {{ section.settings.body_color }};
  }

  .cro-12425-story__body p {
    margin: 0 0 8px;
  }

  .cro-12425-story__body p:last-child {
    margin-bottom: 0;
  }

  .cro-12425-story__link {
    display: inline-block;
    font-weight: 700;
    font-size: 16px;
    color: {{ section.settings.link_color }};
    text-decoration: underline;
  }

  .cro-12425-story__link:hover {
    color: {{ section.settings.link_color }};
    opacity: 0.8;
  }

  .cro-12425-story__footer {
    margin: 18px 0 0;
    font-size: 14px;
    color: #737373;
  }

  .cro-12425-story__footer a {
    color: #737373;
    text-decoration: underline;
  }

  .cro-12425-story__footer a:hover {
    color: {{ section.settings.link_color }};
  }

  @media screen and (max-width: 859px) {
    .cro-12425-story__inner {
      padding-left: 24px;
      padding-right: 24px;
    }

    .cro-12425-story__heading {
      font-size: 23px;
    }
  }
{% endstyle %}

<div class="cro-12425-story">
  <div class="cro-12425-story__inner">
    {% if section.settings.heading != blank %}
      <h2 class="cro-12425-story__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    {% if section.settings.body != blank %}
      <div class="cro-12425-story__body">{{ section.settings.body }}</div>
    {% endif %}

    {% if section.settings.link_label != blank and section.settings.link != blank %}
      <a class="cro-12425-story__link" href="{{ section.settings.link }}">
        {{ section.settings.link_label | escape }}
      </a>
    {% endif %}

    {% if section.settings.footer_text != blank or section.settings.footer_link_label != blank %}
      <p class="cro-12425-story__footer">
        {{ section.settings.footer_text | escape }}
        {% if section.settings.footer_link_label != blank and section.settings.footer_link != blank %}
          <a href="{{ section.settings.footer_link }}">{{ section.settings.footer_link_label | escape }}</a>
        {% endif %}
      </p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "CRO-12425 Brand Story",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Die Afrikaanse aanlyn mark"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>Maroela-mark is die aanlyn markplein waar Afrikaanse skeppers en klein besighede hul handgemaakte en plaaslike produkte verkoop. As jy 'n stadsboer of plaasboer is, of selfs net Afrikaans in jou hart ronddra, is dit die plek waar jy wil aanklop.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Read more label",
      "default": "Lees meer"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Read more link"
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer text",
      "default": "Maak jy self iets moois?"
    },
    {
      "type": "text",
      "id": "footer_link_label",
      "label": "Footer link label",
      "default": "Word 'n verskaffer"
    },
    {
      "type": "url",
      "id": "footer_link",
      "label": "Footer link"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading colour",
      "default": "#1d1d1d"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text colour",
      "default": "#4d4d4d"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link colour",
      "default": "#007a80"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background colour",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "CRO-12425 Brand Story",
      "category": "CRO"
    }
  ]
}
{% endschema %}
