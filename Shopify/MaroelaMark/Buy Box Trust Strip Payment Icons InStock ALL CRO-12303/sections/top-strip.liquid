<section class="top-strip" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="top-strip-wrapper">
  {%- comment -%} 1. Configurable Supplier Link {%- endcomment -%}
<a href="{{ section.settings.supplier_link_url }}" class="top-strip-link">
  {{ section.settings.supplier_link_label }}
</a>

  
  <span class="divider">|</span>
  
  {%- comment -%} 2. Account Link with Icon {%- endcomment -%}
{% if customer %}
  <a href="/account" class="top-strip-link">
    <svg class="person-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
      <circle cx="12" cy="7" r="4"></circle>
    </svg>
    My rekening
  </a>
{% else %}
  <a href="/account/login" class="top-strip-link">
    <svg class="person-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
      <circle cx="12" cy="7" r="4"></circle>
    </svg>
    Meld aan
  </a>
{% endif %}


  <span class="divider">|</span>

  {%- comment -%} 3. Cart Link {%- endcomment -%}
  <a href="/cart" class="top-strip-cart">
    <svg class="trolley-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="9" cy="21" r="1"></circle>
      <circle cx="20" cy="21" r="1"></circle>
      <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
    </svg>
    <span class="cart-count">({{ cart.item_count }})</span>
  </a>
</div>

</section>

{% schema %}
{
  "name": "Top Strip",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#ffffff" },
    { "type": "header", "content": "Supplier Link Settings" },
    { 
      "type": "text", 
      "id": "supplier_link_label", 
      "label": "Supplier Link Label", 
      "default": "Suppliers" 
    },
    { 
      "type": "url", 
      "id": "supplier_link_url", 
      "label": "Supplier Link URL" 
    }
  ],
  "presets": [{ "name": "Top Strip" }]
}
{% endschema %}


<style>
.top-strip-wrapper {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 15px;
  padding: 8px 20px;
  font-size: 13px;
  max-width: 100%;
}
.top-strip-link, .top-strip-cart {
  text-decoration: none;
  color: inherit;
  display: flex;
  align-items: center;
  gap: 6px;
}
.divider { padding: 0 5px; opacity: 0.6; }
.icon-person {
  width: 14px; height: 14px; background: currentColor;
  mask: url("data:image/svg+xml;charset=UTF-8,%3Csvg xmlns='http://w3.org' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2'%3E%3C/path%3E%3Ccircle cx='12' cy='7' r='4'%3E%3C/circle%3E%3C/svg%3E") no-repeat center;
  -webkit-mask: url("data:image/svg+xml;charset=UTF-8,%3Csvg xmlns='http://w3.org' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2'%3E%3C/path%3E%3Ccircle cx='12' cy='7' r='4'%3E%3C/circle%3E%3C/svg%3E") no-repeat center;
}
</style>
