{"sections":{"dynamic_custom_liquid_cCDiXV":{"type":"dynamic-custom-liquid","custom_css":[".custom-html--container,.custom-liquid--container {margin-top: 10px; background: #f9f9f9; padding: 1px;}"],"name":"t:sections.custom_liquid.presets.custom_liquid.name","settings":{"custom_liquid":"{% render 'breadcrumbs' %}"}},"pxs_image_with_text_overlay_LyanNG":{"type":"pxs-image-with-text-overlay","settings":{"section_height":"medium","image":"shopify:\/\/shop_images\/AdobeStock_840220319.jpg","title":"Maroela-mark is jou aanlyn markplein","text":"<p>Ons verkoop dalk nie windpompe, sproeiers en voer vir jou vee nie, maar as jy 'n stadsboer of plaasboer is, of selfs net Afrikaans in jou hart ronddra, is ons die Maroela-mark die plek waar jy wil aanklop<\/p>","content_position":"center-center","color":"#ffffff","overlay_background":"#000000","overlay_opacity":50,"link":"","button_text":""}},"main":{"type":"page","custom_css":["div {background-color: #007a80;}"],"settings":{}},"dynamic_html_YPRGdT":{"type":"dynamic-html","settings":{"title":"","custom_html":"<div style=\"text-align: center;\">Ons soek verskaffers en verkopers met die hand uit sodat jy al jou inkopies maklik op een plek kan aanskaf. <\/div>\n<p><\/p>\n<div style=\"text-align: center;\">Die maroela-mark gee vir verkopers die geleentheid om 'n winkeltjie op die mark te open. Jy bestel en koop dus direk by die verkoper<\/div>\n<p><\/p>\n<div style=\"text-align: center;\">Bederf jouself, bederf jou geliefdes. Maroela-mark is 'n projek van Maroela Media.<\/div>\n<div style=\"text-align: center;\"><br><\/div>\n<div style=\"text-align: center;\">\n<a href=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0623\/7906\/5530\/files\/Besigheid_in_n_boks.pdf?v=1772179762\" target=\"_blank\" title=\"Besigheid in n boks\" rel=\"noopener\">\n<button style=\"background-color: #007a80; color: white; padding: 10px 20px; border: none; border-radius: 5px; cursor: pointer;\">\n  Klik hier vir ŉ volledige dokument oor hoe die Maroela-mark jou kan help om jou besigheid te groei \n<\/button><\/a>\n<\/div>"}},"dynamic_custom_liquid_4yAMUV":{"type":"dynamic-custom-liquid","settings":{"custom_liquid":"<div>\n<iframe style=\"border: 1px solid #dfe3e8;\" src=\"https:\/\/register.shipturtle.com?company_id=263183&amp;shop_id=6248&amp;custom_domain=\" height=\"1000\" width=\"100%\" title=\"Vendor Registration Page\">\n<\/iframe>\n<\/div>"}},"pxs_newsletter_decWzN":{"type":"pxs-newsletter","custom_css":["div {background-color: #007a80;}","@media screen and (min-width: 680px) {.pxs-newsletter-content {padding-top: 15px; padding-bottom: 15px; }}","h2.pxs-newsletter-heading {color: #fff;}",".pxs-newsletter-text {color: #fff;}"],"settings":{"title":"Weet eerste van nuwe produkte","text":"<p>Bly altyd ingelig oor nuwe produkte, verskaffers, winkskopies en vele meer.<\/p>","desktop_alignment":"left","mobile_alignment":"top"}},"1729364712f3819867":{"type":"apps","blocks":{"forms_inline_xE4KBL":{"type":"shopify:\/\/apps\/forms\/blocks\/inline\/8744a304-fcb1-4347-b211-bb6b4759a76a","disabled":true,"settings":{"form_id":"213162","text_color":"#202020","button_background_color":"#202020","button_label_color":"#ffffff","links_color":"#1878b9","errors_color":"#e02229","text_alignment":"center","form_alignment":"center","padding_top":0,"padding_bottom":0,"padding_right":0,"padding_left":0}}},"block_order":["forms_inline_xE4KBL"],"settings":{"include_padding":true}}},"order":["dynamic_custom_liquid_cCDiXV","pxs_image_with_text_overlay_LyanNG","main","dynamic_html_YPRGdT","dynamic_custom_liquid_4yAMUV","pxs_newsletter_decWzN","1729364712f3819867"]}