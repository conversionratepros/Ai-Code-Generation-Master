{%- comment -%}
  ─────────────────────────────────────────────────────────────────────
  Pre-lander Footer Banner (CRP)
  Self-contained closing section: background image with gradient
  overlay, heading, paragraph, optional USP list (renders the
  pre-lander-crp-usp-list snippet, which iterates this section's
  usp_item blocks), primary CTA button, and an optional secondary
  link. Drop into any page template; self-contained.
  ─────────────────────────────────────────────────────────────────────
{%- endcomment -%}

{%- liquid
  assign button_target = ''
  if section.settings.button_new_window
    assign button_target = ' target="_blank" rel="noopener"'
  endif

  assign secondary_target = ''
  if section.settings.secondary_new_window
    assign secondary_target = ' target="_blank" rel="noopener"'
  endif

  assign bg_image_url = section.settings.background_image | image_url: width: 2880
  if section.settings.background_image == blank
    assign bg_image_url = 'pre-lander-crp-bottom-hero.jpg' | asset_url
  endif

  assign button_icon_url = section.settings.button_icon | image_url
  if section.settings.button_icon == blank
    assign button_icon_url = 'pre-lander-crp-arrow-right.svg' | asset_url
  endif

  assign secondary_icon_url = 'pre-lander-crp-arrow-right-black.svg' | asset_url
-%}

<section
  class="pre-lander-crp-footer-banner"
  data-section-id="{{ section.id }}"
  style="--overlay-color: {{ section.settings.gradient_overlay_color }}; --overlay-opacity-desktop: {{ section.settings.gradient_overlay_opacity_desktop | default: 100 }}%; --gradient-start-desktop: {{ section.settings.gradient_start_position_desktop | default: 15 }}%; --gradient-end-desktop: {{ section.settings.gradient_end_position_desktop | default: 65 }}%; --overlay-opacity-mobile: {{ section.settings.gradient_overlay_opacity_mobile | default: 100 }}%; --gradient-start-mobile: {{ section.settings.gradient_start_position_mobile | default: 45 }}%; --gradient-end-mobile: {{ section.settings.gradient_end_position_mobile | default: 75 }}%; --heading-color: {{ section.settings.heading_color }}; --paragraph-color: {{ section.settings.paragraph_color }}; --button-bg: {{ section.settings.button_color }}; --secondary-color: {{ section.settings.secondary_color }};"
>
  {%- if bg_image_url != blank -%}
    <img class="pre-lander-crp-footer-banner__bg" src="{{ bg_image_url }}" alt="" aria-hidden="true" />
  {%- endif -%}

  <div class="pre-lander-crp-footer-banner__fade" aria-hidden="true"></div>

  <div class="pre-lander-crp-footer-banner__content">
    {%- if section.settings.heading_text != blank -%}
      <h2 class="pre-lander-crp-footer-banner__heading">{{ section.settings.heading_text | escape }}</h2>
    {%- endif -%}

    {%- if section.settings.paragraph_text != blank -%}
      <p class="pre-lander-crp-footer-banner__paragraph">{{ section.settings.paragraph_text | escape | newline_to_br }}</p>
    {%- endif -%}

    {%- if section.settings.show_usp_list -%}
      {% render 'pre-lander-crp-usp-list' %}
    {%- endif -%}

    {%- if section.settings.button_text != blank -%}
      <a class="pre-lander-crp-footer-banner__cta" href="{{ section.settings.button_link | default: '#' }}"{{ button_target }}>
        <span>{{ section.settings.button_text | escape }}</span>
        {%- if button_icon_url != blank -%}
          <img class="pre-lander-crp-footer-banner__cta-icon" src="{{ button_icon_url }}" alt="" aria-hidden="true" />
        {%- endif -%}
      </a>
    {%- endif -%}

    {%- if section.settings.secondary_text != blank -%}
      <a class="pre-lander-crp-footer-banner__secondary" href="{{ section.settings.secondary_link | default: '#' }}"{{ secondary_target }}>
        <span>{{ section.settings.secondary_text | escape }}</span>
        <img class="pre-lander-crp-footer-banner__secondary-icon" src="{{ secondary_icon_url }}" alt="" aria-hidden="true" />
      </a>
    {%- endif -%}
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&display=swap');

  .pre-lander-crp-footer-banner {
    position: relative;
    min-height: 550px;
    overflow: hidden;
    background-color: var(--overlay-color, #FFFFFF);
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    font-family: 'Montserrat', system-ui, -apple-system, sans-serif;
    color: #1C1917;
    box-sizing: border-box;
  }

  .pre-lander-crp-footer-banner *,
  .pre-lander-crp-footer-banner *::before,
  .pre-lander-crp-footer-banner *::after { box-sizing: border-box; }

  .pre-lander-crp-footer-banner__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: bottom right;
    display: block;
    z-index: 0;
  }

  .pre-lander-crp-footer-banner__fade {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: var(--overlay-opacity-desktop, 100%);
    background: linear-gradient(
      to right,
      var(--overlay-color, #FFFFFF) var(--gradient-start-desktop, 15%),
      transparent var(--gradient-end-desktop, 65%)
    );
  }

  .pre-lander-crp-footer-banner__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 36px;
    width: 547px;
    max-width: 100%;
    padding: 80px 0;
    margin-left: max(120px, calc(50vw - 600px));
  }

  .pre-lander-crp-footer-banner__heading {
    margin: 0;
    font-size: 40px;
    font-weight: 700;
    line-height: 1.1;
    max-width: 480px;
    color: var(--heading-color, #1C1917);
  }

  .pre-lander-crp-footer-banner__paragraph {
    margin: 0;
    font-size: 20px;
    line-height: 1.5;
    color: var(--paragraph-color, #1C1917);
  }

  .pre-lander-crp-footer-banner__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 480px;
    max-width: 100%;
    padding: 16px;
    background: var(--button-bg, #E8862B);
    color: #FFFFFF;
    font-weight: 600;
    font-size: 16px;
    line-height: 1;
    border-radius: 2px;
    text-decoration: none;
    cursor: pointer;
    transition: filter 0.15s ease;
  }
  .pre-lander-crp-footer-banner__cta:hover { filter: brightness(0.92); }
  .pre-lander-crp-footer-banner__cta-icon {
    width: 24px;
    height: 24px;
    display: block;
  }

  .pre-lander-crp-footer-banner__secondary {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    font-size: 16px;
    font-weight: 600;
    color: var(--secondary-color, #1C1917);
    text-decoration: none;
    align-self: flex-start;
  }
  .pre-lander-crp-footer-banner__secondary-icon {
    width: 6px;
    height: 12px;
    display: block;
  }

  /* USP list styling for the rendered snippet output */
  .pre-lander-crp-footer-banner .cro-usp-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin: 0;
    padding: 0;
  }
  .pre-lander-crp-footer-banner .cro-usp-item {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 16px;
    line-height: 1.5;
    color: #1C1917;
  }
  .pre-lander-crp-footer-banner .cro-usp-item__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }
  .pre-lander-crp-footer-banner .cro-usp-item__icon img,
  .pre-lander-crp-footer-banner .cro-usp-item__icon svg {
    width: 24px;
    height: 24px;
    display: block;
  }

  @media (max-width: 768px) {
    .pre-lander-crp-footer-banner {
      min-height: 720px;
    }
    .pre-lander-crp-footer-banner__bg {
      object-position: center bottom;
    }
    .pre-lander-crp-footer-banner__fade {
      opacity: var(--overlay-opacity-mobile, 100%);
      background: linear-gradient(
        to bottom,
        var(--overlay-color, #FFFFFF) var(--gradient-start-mobile, 45%),
        transparent var(--gradient-end-mobile, 75%)
      );
    }
    .pre-lander-crp-footer-banner__content {
      width: auto;
      max-width: 100%;
      margin: 0;
      margin-left: 0;
      padding: 50px 20px;
      gap: 25px;
    }
    .pre-lander-crp-footer-banner__heading { font-size: 32px; }
    .pre-lander-crp-footer-banner__paragraph { font-size: 16px; }
    .pre-lander-crp-footer-banner__paragraph br { display: none; }
    .pre-lander-crp-footer-banner__cta { width: 100%; }
    .pre-lander-crp-footer-banner__secondary { font-size: 16px; gap: 4px; }
    .pre-lander-crp-footer-banner__secondary-icon { width: 24px; height: 24px; }
    .pre-lander-crp-footer-banner .cro-usp-list { gap: 16px; }
    .pre-lander-crp-footer-banner .cro-usp-item { font-size: 14px; }
    .pre-lander-crp-footer-banner .cro-usp-item__icon,
    .pre-lander-crp-footer-banner .cro-usp-item__icon img,
    .pre-lander-crp-footer-banner .cro-usp-item__icon svg { width: 20px; height: 20px; }
  }
</style>

{% schema %}
{
  "name": "Pre-lander Footer Banner",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "color", "id": "gradient_overlay_color", "label": "Gradient overlay colour (fades to transparent)", "default": "#FFFFFF" },

    { "type": "header", "content": "Overlay gradient — desktop" },
    { "type": "range", "id": "gradient_overlay_opacity_desktop", "label": "Overlay opacity", "min": 0, "max": 100, "step": 5, "default": 100, "unit": "%" },
    { "type": "range", "id": "gradient_start_position_desktop", "label": "Gradient start (solid colour through this point)", "min": 0, "max": 50, "step": 5, "default": 15, "unit": "%" },
    { "type": "range", "id": "gradient_end_position_desktop", "label": "Gradient end (transparent reached at this point)", "min": 30, "max": 100, "step": 5, "default": 65, "unit": "%" },

    { "type": "header", "content": "Overlay gradient — mobile" },
    { "type": "range", "id": "gradient_overlay_opacity_mobile", "label": "Overlay opacity", "min": 0, "max": 100, "step": 5, "default": 100, "unit": "%" },
    { "type": "range", "id": "gradient_start_position_mobile", "label": "Gradient start (solid colour through this point)", "min": 0, "max": 80, "step": 5, "default": 45, "unit": "%" },
    { "type": "range", "id": "gradient_end_position_mobile", "label": "Gradient end (transparent reached at this point)", "min": 30, "max": 100, "step": 5, "default": 75, "unit": "%" },

    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading_text", "label": "Heading text", "default": "Add the pink one to your basket" },
    { "type": "color", "id": "heading_color", "label": "Heading colour", "default": "#1C1917" },

    { "type": "header", "content": "Paragraph" },
    { "type": "textarea", "id": "paragraph_text", "label": "Paragraph text", "default": "R95. 8cm tall. Cool pink enamel by Eersteklas.\nThe kind of cup that slowly earns its place on the shelf." },
    { "type": "color", "id": "paragraph_color", "label": "Paragraph colour", "default": "#1C1917" },

    { "type": "header", "content": "USP list" },
    { "type": "checkbox", "id": "show_usp_list", "label": "Show USP list", "default": true },

    { "type": "header", "content": "Primary button" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Add the pink one to your basket" },
    { "type": "color", "id": "button_color", "label": "Button colour", "default": "#E8862B" },
    { "type": "image_picker", "id": "button_icon", "label": "Button icon (SVG recommended)" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "button_new_window", "label": "Open button in a new window", "default": false },

    { "type": "header", "content": "Secondary link (below button)" },
    { "type": "text", "id": "secondary_text", "label": "Secondary link text", "default": "Or see the rest of the Maroelamark shelf" },
    { "type": "color", "id": "secondary_color", "label": "Secondary link colour", "default": "#1C1917" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link URL" },
    { "type": "checkbox", "id": "secondary_new_window", "label": "Open secondary link in a new window", "default": false }
  ],
  "blocks": [
    {
      "name": "USP item",
      "type": "usp_item",
      "settings": [
        { "type": "image_picker", "id": "icon_image", "label": "Icon image (SVG recommended)" },
        { "type": "text", "id": "label", "label": "Label text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pre-lander Footer Banner",
      "blocks": [
        { "type": "usp_item", "settings": { "label": "Secure payment." } },
        { "type": "usp_item", "settings": { "label": "7-day returns if it does not feel right." } },
        { "type": "usp_item", "settings": { "label": "Delivery anywhere in South Africa." } }
      ]
    }
  ]
}
{% endschema %}
