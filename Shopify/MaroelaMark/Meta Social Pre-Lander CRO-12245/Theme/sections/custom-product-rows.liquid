{% comment %}
  Custom Product Rows Section for Shopify Empire v12.3.0
  Fully Compiled Production Build
  Features:
  - Conditional Reviews Layer: Automatically hides star rows completely if rating count is 0
  - Clickable Dots Navigation: Clicking a pagination dot scrolls smoothly to its corresponding card
  - Fixed Height Swap Box Area: Add to Cart button seamlessly overlaps Price on desktop hover
  - JavaScript Fisher-Yates Randomization Shuffler mapped directly to Schema Settings
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} .custom-section-outer {
    padding-top: {{ section.settings.top_padding }}px;
    padding-bottom: {{ section.settings.bottom_padding }}px;
    background-color: #ffffff;
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
  }

  .custom-rows-heading {
    font-family: 'Cutive', serif;
    font-weight: 400;
    color: #484848;
    text-align: center;
    margin-bottom: 28px;
    font-size: 2.2rem;
  }

  /* Carousel Positioning Box wrapper */
  .custom-row-container {
    width: 100%;
    padding: 0 50px;
    box-sizing: border-box;
    position: relative;
  }

  /* Structural Scrolling Container */
  .custom-track-engine {
    display: flex !important;
    flex-wrap: nowrap !important;
    justify-content: flex-start !important;
    overflow-x: auto !important;
    overflow-y: hidden !important;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    gap: 16px;
    padding: 10px 0 20px 0;
    margin-bottom: -20px;
    width: 100%;
  }

  .custom-track-engine::-webkit-scrollbar {
    display: none !important;
    width: 0 !important;
    height: 0 !important;
  }

  /* Card layout blueprints matching your exact specs */
  .custom-spec-card {
    flex: 0 0 80% !important;
    width: 80% !important;
    max-width: 80% !important;
    scroll-snap-align: start;
    box-sizing: border-box;
    background: #ffffff;
    transition: box-shadow 0.3s ease;
    position: relative;
    padding: 14px;
    display: flex;
    flex-direction: column;
    border: 1px solid #f1f1f1;
    overflow: hidden;
  }

  .custom-spec-card.is-hidden {
    display: none !important;
  }

  @media screen and (min-width: 769px) {
    .custom-track-engine {
      gap: 20px;
    }
    .custom-spec-card {
      flex: 0 0 calc((100% - (5 * 20px)) / 5.5) !important;
      width: calc((100% - (5 * 20px)) / 5.5) !important;
      max-width: calc((100% - (5 * 20px)) / 5.5) !important;
    }
    .custom-spec-card:hover {
      box-shadow: 0 10px 25px rgba(0,0,0,0.12);
      z-index: 5;
    }
  }

  /* --- Absolute Positioned Navigation Arrows --- */
  .custom-carousel-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    background-color: #007a80;
    border: none;
    border-radius: 50%;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    box-shadow: 0 4px 10px rgba(0,0,0,0.15);
    transition: all 0.2s ease;
  }

  .custom-carousel-arrow:not(.is-disabled):hover {
    background-color: #d68928;
  }

  .custom-carousel-arrow.is-disabled {
    background-color: #e0e0e0 !important;
    color: #a1a1a1 !important;
    cursor: default !important;
    box-shadow: none !important;
    opacity: 0.6;
  }

  .custom-arrow-prev { left: 5px; }
  .custom-arrow-next { right: 5px; }
  .custom-carousel-arrow svg { width: 16px; height: 16px; fill: currentColor; }

  /* --- Image Containers --- */
  .custom-img-box {
    position: relative;
    width: 100%;
    padding-top: 100%;
    background: #ffffff;
    margin-bottom: 12px;
  }

  .custom-img-box img {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .custom-badge-sale {
    position: absolute;
    top: 8px;
    left: 8px;
    background-color: #da5b5b;
    color: #ffffff;
    padding: 4px 12px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    z-index: 2;
  }

  /* --- Typography Rules --- */
  .custom-txt-title {
    font-family: 'Proxima Nova', sans-serif;
    font-weight: 700;
    color: #007a80;
    text-align: center;
    font-size: 1.05rem;
    margin: 16px 0 10px 0;
    text-decoration: none;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    height: 2.8em;
  }

  .custom-txt-vendor {
    font-family: 'Cutive', serif;
    font-weight: 400;
    color: #737373;
    text-align: center;
    font-size: 0.85rem;
    margin: 0 0 12px 0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* --- Fixed Height Absolute Swap Container --- */
  .custom-interaction-deck {
    position: relative;
    width: 100%;
    height: 48px;
    margin: 4px 0 12px 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: auto;
  }

  .custom-price-visible-block {
    position: absolute;
    width: 100%;
    text-align: center;
    transition: opacity 0.2s ease, visibility 0.2s ease;
    opacity: 1;
    visibility: visible;
    z-index: 2;
  }

  .custom-txt-price {
    font-family: 'Proxima Nova', sans-serif;
    font-weight: 700;
    color: #484848;
    font-size: 1.15rem;
    margin: 0;
    line-height: 48px;
  }

  /* Add to Cart Container Layer */
  .custom-action-form {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    z-index: 3;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  .custom-btn-atc {
    width: 100%;
    height: 100%;
    background-color: #d68928;
    color: #ffffff;
    border: none;
    padding: 0 10px;
    font-weight: 700;
    text-align: center;
    cursor: pointer;
    font-size: 0.95rem;
    line-height: 48px;
    display: block;
    box-sizing: border-box;
    transition: background 0.2s ease;
  }

  /* --- Persistent Review Grid Layout Row --- */
  .custom-review-row {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 6px;
    font-family: 'Roboto', sans-serif;
    font-weight: 400;
    color: #737373;
    font-size: 0.85rem;
    margin: 0 0 8px 0;
  }
  .custom-review-row .stars-gold { color: #ffb500; letter-spacing: 1px; }

  /* Responsive Swap Viewports */
  @media screen and (max-width: 768px) {
    .custom-interaction-deck {
      height: auto !important;
      display: block !important;
    }
    .custom-price-visible-block {
      position: relative !important;
      opacity: 1 !important;
      visibility: visible !important;
      height: auto !important;
    }
    .custom-txt-price {
      line-height: 1.4 !important;
      margin-bottom: 12px !important;
    }
    .custom-action-form {
      position: relative !important;
      opacity: 1 !important;
      visibility: visible !important;
      height: 48px !important;
      margin-bottom: 12px;
    }
  }

  @media screen and (min-width: 769px) {
    .custom-action-form {
      opacity: 0;
      visibility: hidden;
    }
    .custom-spec-card:hover .custom-price-visible-block {
      opacity: 0;
      visibility: hidden;
    }
    .custom-spec-card:hover .custom-action-form {
      opacity: 1;
      visibility: visible;
    }
  }

  .custom-dot-navigation { display: flex; justify-content: center; gap: 8px; margin: 24px 0 12px 0; }
  .custom-nav-dot { width: 8px; height: 8px; border-radius: 50%; background-color: #e0e0e0; transition: background-color 0.3s ease; cursor: pointer; }
  .custom-nav-dot.is-active { background-color: #007a80; }

  .custom-shopall-wrap { display: flex; justify-content: center; margin-top: 16px; }
  .custom-btn-shopall { background-color: #007a80; color: #ffffff; font-family: 'Proxima Nova', sans-serif; font-weight: 700; padding: 12px 36px; text-decoration: none; text-transform: uppercase; transition: opacity 0.2s; }
{%- endstyle -%}

<div class="custom-section-outer" data-section-id="{{ section.id }}">
  {%- if section.settings.show_heading and section.settings.heading_text != blank -%}
    <h2 class="custom-rows-heading">{{ section.settings.heading_text | escape }}</h2>
  {%- endif -%}

  {%- assign selected_collection = collections[section.settings.collection] -%}

  <div class="custom-row-container">
    <button class="custom-carousel-arrow custom-arrow-prev" id="PrevArrow-{{ section.id }}" aria-label="Scroll left">
      <svg viewBox="0 0 24 24"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
    </button>
    <button class="custom-carousel-arrow custom-arrow-next" id="NextArrow-{{ section.id }}" aria-label="Scroll right">
      <svg viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
    </button>

    <div class="custom-track-engine" id="CustomTrack-{{ section.id }}">
      {%- if selected_collection != blank and selected_collection.products_count > 0 -%}
        {%- for product in selected_collection.products limit: 50 -%}
          <div class="custom-spec-card is-hidden" data-pool-item>
            <div class="custom-img-box">
              {%- if product.compare_at_price > product.price -%}
                <span class="custom-badge-sale">uitverkoping</span>
              {%- endif -%}
              <a href="{{ product.url }}">
                {%- if product.featured_image != blank -%}
                  <img src="{{ product.featured_image | img_url: '500x500' }}" alt="{{ product.title | escape }}" loading="lazy">
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag }}
                {%- endif -%}
              </a>
            </div>

            <!-- 1. Product Title -->
            <a href="{{ product.url }}" class="custom-txt-title">{{ product.title }}</a>
            
            <!-- 2. Supplier Info -->
            <div class="custom-txt-vendor">{{ product.vendor | default: "Supplier" }}</div>

            <!-- 3. Dynamic Swap Container Area (Price & ATC Button) -->
            <div class="custom-interaction-deck">
              
              <!-- Layer A: Default Visible Price Block -->
              <div class="custom-price-visible-block">
                <div class="custom-txt-price">
                  {%- if product.price_varies -%}
                    {{ product.price_min | money }} - {{ product.price_max | money }}
                  {%- else -%}
                    {{ product.price | money }}
                  {%- endif -%}
                </div>
              </div>

              <!-- Layer B: Hover Replaced Add to Cart Form Button -->
              <div class="custom-action-form">
                {%- assign variant = product.selected_or_first_available_variant -%}
                <form action="/cart/add" method="post" enctype="multipart/form-data" style="height:100%; margin:0;">
                  <input type="hidden" name="id" value="{{ variant.id }}">
                  <button type="submit" class="custom-btn-atc" {% unless variant.available %}disabled{% endunless %}>
                    {%- if variant.available -%}Gooi in mandjie{%- else -%}Sold Out{%- endif -%}
                  </button>
                </form>
              </div>

            </div>

            <!-- 4. Review Ratings Line (Conditionally hidden when rating count equals 0) -->
            {%- assign rating_count = product.metafields.reviews.rating_count | default: 0 | plus: 0 -%}
            {%- if rating_count > 0 -%}
              <div class="custom-review-row" data-has-reviews="true">
                <span class="stars-gold">★★★★★</span>
                <span>({{ rating_count }})</span>
              </div>
            {%- endif -%}

          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..6) -%}
          <div class="custom-spec-card">
            <div class="custom-img-box">{{ 'product-' | append: i | placeholder_svg_tag }}</div>
            <a href="#" class="custom-txt-title">Sample Product Title Block</a>
            <div class="custom-txt-vendor">Supplier</div>
            <div class="custom-interaction-deck">
              <div class="custom-price-visible-block">
                <div class="custom-txt-price">R150.00 - R200.00</div>
              </div>
              <div class="custom-action-form">
                <button class="custom-btn-atc">Gooi in mandjie</button>
              </div>
            </div>
            <!-- Showcase placeholder mockup rating to display style inside customization dashboard fields -->
            <div class="custom-review-row"><span class="stars-gold">★★★★★</span> <span>(3)</span></div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>

  <div class="custom-dot-navigation" id="CustomDots-{{ section.id }}"></div>

  {%- if section.settings.enable_cta and selected_collection != blank -%}
    <div class="custom-shopall-wrap">
      <a href="{{ selected_collection.url }}" class="custom-btn-shopall">
        {%- if section.settings.cta_text != blank -%}
          {{ section.settings.cta_text | escape }}
        {%- else -%}
          Shop all {{ selected_collection.title }}
        {%- endif -%}
      </a>
    </div>
  {%- endif -%}
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const initSection = () => {
      const track = document.getElementById("CustomTrack-{{ section.id }}");
      const prevBtn = document.getElementById("PrevArrow-{{ section.id }}");
      const nextBtn = document.getElementById("NextArrow-{{ section.id }}");
      const dotsContainer = document.getElementById("CustomDots-{{ section.id }}");
      
      if(!track) return;
      
      let cardsPool = Array.from(track.querySelectorAll("[data-pool-item]"));
      if(cardsPool.length === 0) return;

      // Fisher-Yates Randomization Shuffle Strategy
      for (let i = cardsPool.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [cardsPool[i], cardsPool[j]] = [cardsPool[j], cardsPool[i]];
      }

      const displayLimit = parseInt("{{ section.settings.max_products | default: 12 }}", 10);
      const selectedCards = cardsPool.slice(0, displayLimit);

      while (track.firstChild) {
        track.removeChild(track.firstChild);
      }
      dotsContainer.innerHTML = "";

      selectedCards.forEach((card, index) => {
        card.setAttribute("data-index", index);
        card.classList.remove("is-hidden");
        track.appendChild(card);

        const dotSpan = document.createElement("span");
        dotSpan.className = index === 0 ? "custom-nav-dot is-active" : "custom-nav-dot";
        dotSpan.setAttribute("data-target", index);
        dotsContainer.appendChild(dotSpan);
      });

      const cards = track.querySelectorAll(".custom-spec-card");
      const dots = dotsContainer.querySelectorAll(".custom-nav-dot");

      const updateArrowStates = () => {
        const scrollLeft = track.scrollLeft;
        const maxScrollLeft = track.scrollWidth - track.clientWidth;

        if (scrollLeft <= 5) {
          prevBtn.classList.add("is-disabled");
          prevBtn.setAttribute("disabled", "true");
        } else {
          prevBtn.classList.remove("is-disabled");
          prevBtn.removeAttribute("disabled");
        }

        if (scrollLeft >= maxScrollLeft - 5) {
          nextBtn.classList.add("is-disabled");
          nextBtn.setAttribute("disabled", "true");
        } else {
          nextBtn.classList.remove("is-disabled");
          nextBtn.removeAttribute("disabled");
        }
      };

      prevBtn.replaceWith(prevBtn.cloneNode(true));
      nextBtn.replaceWith(nextBtn.cloneNode(true));
      
      const newPrevBtn = document.getElementById("PrevArrow-{{ section.id }}");
      const newNextBtn = document.getElementById("NextArrow-{{ section.id }}");

      newPrevBtn.addEventListener("click", function() {
        if (newPrevBtn.classList.contains("is-disabled")) return;
        const singleCardSpace = track.querySelector(".custom-spec-card").offsetWidth + 20; 
        track.scrollBy({ left: -(singleCardSpace * 4), behavior: 'smooth' });
      });

      newNextBtn.addEventListener("click", function() {
        if (newNextBtn.classList.contains("is-disabled")) return;
        const singleCardSpace = track.querySelector(".custom-spec-card").offsetWidth + 20;
        track.scrollBy({ left: (singleCardSpace * 4), behavior: 'smooth' });
      });

      dotsContainer.addEventListener("click", function(e) {
        const targetDot = e.target.closest(".custom-nav-dot");
        if (!targetDot) return;
        
        const targetIndex = parseInt(targetDot.getAttribute("data-target"), 10);
        const targetCard = track.querySelector(`.custom-spec-card[data-index="${targetIndex}"]`);
        
        if (targetCard) {
          const trackLeft = track.getBoundingClientRect().left;
          const cardLeft = targetCard.getBoundingClientRect().left;
          const scrollTargetPosition = track.scrollLeft + (cardLeft - trackLeft);
          
          track.scrollTo({
            left: scrollTargetPosition,
            behavior: "smooth"
          });
        }
      });

      track.addEventListener("scroll", updateArrowStates);
      updateArrowStates();

      const observerOptions = {
        root: track,
        threshold: 0.5,
        rootMargin: "0px"
      };

      const observerCallback = (entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const activeIndex = entry.target.getAttribute("data-index");
            dots.forEach((dot, index) => {
              if (index == activeIndex) {
                dot.classList.add("is-active");
              } else {
                dot.classList.remove("is-active");
              }
            });
          }
        });
      };

      const observer = new IntersectionObserver(observerCallback, observerOptions);
      cards.forEach(card => observer.observe(card));
    };

    initSection();
    
    document.addEventListener("shopify:section:load", function(e) {
      if (e.detail.sectionId === "{{ section.id }}") initSection();
    });
  });
</script>

{% schema %}
{
  "name": "Product Rows Custom",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Product source" },
    { "type": "text", "id": "heading_text", "label": "Heading text", "default": "Fresh Produce" },
    { "type": "checkbox", "id": "show_heading", "label": "Show heading", "default": true },
    { "type": "checkbox", "id": "enable_cta", "label": "Enable CTA button", "default": true },
    { "type": "text", "id": "cta_text", "label": "CTA Button Text Override", "info": "Leave blank to automatically use 'Shop all [Collection Name]'", "default": "Shop all [category name]" },
    { "type": "number", "id": "max_products", "label": "Maximum products to show", "default": 12 },
    { "type": "range", "id": "top_padding", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Section top padding", "default": 36 },
    { "type": "range", "id": "bottom_padding", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Section bottom padding", "default": 36 }
  ],
  "presets": [
    { "name": "Product Rows Custom", "category": "Collection" }
  ]
}
{% endschema %}
