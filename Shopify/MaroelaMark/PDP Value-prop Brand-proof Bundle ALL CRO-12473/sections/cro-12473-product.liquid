        { "value": "always",   "label": "t:sections.product.gallery_click_to_zoom.option_2" },
        { "value": "desktop",  "label": "t:sections.product.gallery_click_to_zoom.option_3" },
        { "value": "mobile",   "label": "t:sections.product.gallery_click_to_zoom.option_4" }
      ],
      "default": "always",
      "info": "t:sections.product.gallery_click_to_zoom.info"
    },
    {
