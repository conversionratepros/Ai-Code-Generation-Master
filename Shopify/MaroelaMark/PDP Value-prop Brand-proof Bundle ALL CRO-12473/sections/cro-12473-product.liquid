{% comment %}
  CRO-12473 | PDP — Value-prop + Brand-proof + Bundle (Sprint 2)
  ─────────────────────────────────────────────────────────────────────
  New product template section for CRO testing. Stacks on top of the
  Sprint 1 trust strip (CRO-12303) — that mount + assets are kept as-is.

  Sprint 2 adds:
    A1. Value-prop line under the title (metafield custom.value_prop,
        fallback: first sentence of the short description)
    A3. Short description surfaced beneath the price
    A2. Long description REMOVED from the buy box (description block is
        not in this template's block_order) and rendered by the new
        cro-12473-description section directly below this one
    B1. Brand-trust line in the empty rating slot (zero-review products)
    B2. Zero-review Judge.me review section suppressed (server-gated CSS)
    C.  "Gaan goed saam met" curated bundle below the ATC form

  Architecture (same as CRO-12303):
    1. Renders the product exactly as static-product does (no changes).
    2. Server-renders the new elements in a hidden mount div.
    3. cro-12473-pdp.js moves each into its positioned block wrapper
       (value_prop / short_desc / bundle blocks render empty wrappers
       via product.liquid at the exact block_order position).
    4. section.blocks + settings drive content (theme editor editable).
{% endcomment %}

{% liquid
  comment
    Short-description source, in priority order (catalog audit 2026-08-06:
    only 10 of 2 567 products have the authored entry-content shape; 2 458
    are plain <p>-led HTML — those get the first-paragraph fallback so the
    buy box does not lose its blurb on most of the catalogue):
      1. custom.short_description product metafield (same convention as the
         CRO-12257 Glutathione PDP build — per-product, content-managed)
      2. entry-content div (authored "Short description:" shape)
      3. first <p> paragraph, when the description starts with one and the
         paragraph is short enough to read as a blurb (<= 350 chars text)
      4. nothing (pre-blocks / heading-led / empty descriptions)
    cro-12473-description.liquid applies the SAME split so the surfaced
    part never duplicates below — keep the two files in sync.
  endcomment
  assign cro_desc = product.description | split: '<!-- more -->' | first
  capture cro_short_mf
    echo product.metafields.custom.short_description | metafield_tag
  endcapture
  assign cro_short_mf = cro_short_mf | strip
  assign cro_short_html = ''
  if cro_short_mf != blank
    assign cro_short_html = cro_short_mf
  elsif cro_desc contains '<div class="entry-content">'
    assign cro_sd_parts = cro_desc | split: '<div class="entry-content">'
    assign cro_short_html = cro_sd_parts[1] | split: '</div>' | first
  else
    assign cro_lead = cro_desc | strip | slice: 0, 3
    if cro_lead == '<p>' or cro_lead == '<p '
      assign cro_first_p = cro_desc | strip | split: '</p>' | first | append: '</p>'
      assign cro_first_p_text = cro_first_p | strip_html | strip
      if cro_first_p_text != blank and cro_first_p_text.size <= 350
        assign cro_short_html = cro_first_p
      endif
    endif
  endif

  assign cro_value_prop = product.metafields.custom.value_prop.value | strip
  if cro_value_prop == blank
    assign cro_short_text = cro_short_html | strip_html | strip
    assign cro_first_sentence = cro_short_text | split: '.' | first | strip
    if cro_first_sentence.size >= 10 and cro_first_sentence.size <= 120
      assign cro_value_prop = cro_first_sentence | append: '.'
    endif
  endif

  assign cro_review_count = product.metafields.reviews.rating_count | default: 0
%}

<script
  type="application/json"
  data-section-type="static-product"
  data-section-id="{{ section.id }}"
  data-section-data
>
  {
    "settings": {
      "cart_redirection": {{ settings.enable_cart_redirection | json }},
      "money_format": {{ shop.money_format | strip_html | json }},
      "swatches_enable": {{ settings.swatches_enable | json }},
      "sold_out_options": {{ settings.sold_out_options | json }},
      "select_first_available_variant": {{ settings.select_first_available_variant | json }}
    },
    "context": {
      "select_variant": {{ 'product.general.select_variant' | t | json }},
      "product_available": {{ 'product.buttons.add_to_cart' | t | json }},
      "product_sold_out": {{ 'product.buttons.sold_out' | t | json }},
      "product_unavailable": {{ 'product.buttons.unavailable' | t | json }},
      "product_preorder": {{ 'product.buttons.pre_order' | t | json }},
      "request_message_empty": {{ 'product.blocks.request_quote.request_message_empty' | t | json }}
    },
    "product": {{ product | json }},
    "product_recommendation_limit": null
  }
</script>

{% render 'breadcrumbs' %}

<section
  class="product__container product__container--two-columns"
  data-product-wrapper
>
  {%
    render 'product',
    is_product_modal: false,
    show_dynamic_checkout_button: settings.show_dynamic_checkout_button,
    select_first_available_variant: settings.select_first_available_variant,
    gallery_aspect_ratio: section.settings.gallery_aspect_ratio,
    gallery_thumbnail_position: section.settings.gallery_thumbnail_position,
    gallery_thumbnail_layout: section.settings.gallery_thumbnail_layout,
    gallery_image_crop: section.settings.gallery_image_crop,
    gallery_click_to_zoom: section.settings.gallery_click_to_zoom,
    gallery_hover_zoom: section.settings.gallery_hover_zoom,
    gallery_video_autoplay: section.settings.gallery_video_autoplay,
    gallery_video_looping: section.settings.gallery_video_looping
  %}
</section>

{% comment %} ── Sprint 1 (CRO-12303) Trust Mount — unchanged ────────
  The Sprint 1 snippets + assets already live in the theme; reuse
  them verbatim so the trust strip appears in this variant too.
{% endcomment %}
<div data-cro-trust-mount aria-hidden="true">
  {% render 'cro-12303-in-stock' %}
  {% render 'cro-12303-payment-strip' %}
  {% render 'cro-12303-usp-list' %}
</div>

{% comment %} ── CRO-12473 Sprint 2 Mount ─────────────────────────────
  Elements are server-rendered here, then cro-12473-pdp.js moves each
  into its empty positioned block wrapper (.product-block--value_prop,
  .product-block--short_desc, .product-block--rating,
  .product-block--bundle). Hidden until injection completes.
{% endcomment %}
<div
  data-cro-12473-mount
  aria-hidden="true"
  {% if cro_review_count < 1 %}data-cro-no-reviews="true"{% endif %}
>
  {% if cro_value_prop != blank %}
    {% render 'cro-12473-value-prop', value_prop: cro_value_prop %}
  {% endif %}

  {% if cro_short_html != blank %}
    {% render 'cro-12473-short-desc', short_html: cro_short_html %}
  {% endif %}

  {% if cro_review_count < 1 %}
    {% render 'cro-12473-trust-line', trust_text: section.settings.cro_trust_line %}
  {% endif %}

  {% render 'cro-12473-bundle', product: product %}
</div>

{% comment %} ── B2: suppress the empty review section (server-gated) ──
  Only zero-review products get this rule. The apps section holding the
  Judge.me review widget is the only .shopify-section containing
  .jdgm-review-widget (the footer only carries a preview badge — do NOT
  widen this selector to .jdgm-widget or the footer gets hidden).
  cro-12473-pdp.js provides a fallback where :has() is unsupported.
{% endcomment %}
{% if cro_review_count < 1 %}
  <style>
    .shopify-section:has(.jdgm-review-widget) {
      display: none !important;
    }
  </style>
{% endif %}

{{ 'cro-12303-buy-box.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cro-12303-buy-box.js' | asset_url }}" defer></script>

{{ 'cro-12473-pdp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cro-12473-pdp.js' | asset_url }}" defer></script>

{% schema %}
