      "content": "Secure Payment Strip"
    },
    {
      "type": "text",
      "id": "cro_payment_label",
      "label": "Payment strip label",
      "default": "Secure payments via",
      "info": "Displayed to the left of the payment icons."
    },
    {
      "type": "header",
      "content": "CRO-12473 — Brand-trust line"
    },
    {
