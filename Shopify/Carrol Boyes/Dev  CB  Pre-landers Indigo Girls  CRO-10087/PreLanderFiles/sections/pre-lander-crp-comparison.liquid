    letter-spacing: 1.8px;
    text-transform: uppercase;
  }

  .pre-lander-crp-comparison__table .th-cb span {
    color: #333;
    font-size: 12px;
    font-weight: 700;
    line-height: 16px;
    letter-spacing: 1.8px;
    text-transform: uppercase;
  }

  .pre-lander-crp-comparison__table td {
    padding: 32.5px 16px;
    font-size: 14px;
    font-weight: 400;
    line-height: 24px;
