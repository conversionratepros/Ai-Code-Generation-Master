    vertical-align: top;
    border-bottom: 1px solid rgba(233, 233, 233, 0.80);
  }

  .pre-lander-crp-comparison__table td:first-child {
    width: 256px;
    padding-left: 0;
    color: #fff;
    font-size: 16px;
    font-weight: 500;
    line-height: 24px;
  }

  .pre-lander-crp-comparison__table td.competitor {
    padding-left: 0;
  }

  .pre-lander-crp-comparison__table td:last-child {
    background: #f7f7f7;
    color: #333;
    padding-left: 32px;
    border-radius: 0 0 2px 2px;
  }

  .pre-lander-crp-comparison__table .td-check,
  .pre-lander-crp-comparison__table .td-cross {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
  }

  .pre-lander-crp-comparison__table .td-check::before {
    content: '';
    width: 24px;
    height: 24px;
    display: inline-block;
    flex-shrink: 0;
    background-image: url('{{ "pre-lander-crp-comparison-check.png" | asset_url }}');
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
  }

  .pre-lander-crp-comparison__table .td-cross::before {
    content: '';
    width: 24px;
    height: 24px;
    display: inline-block;
    flex-shrink: 0;
    background-image: url('{{ "pre-lander-crp-comparison-cross.svg" | asset_url }}');
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
  }

  @media (max-width: 768px) {
    .pre-lander-crp-comparison {
      padding: 50px 0;
      overflow-x: auto;
    }

    .pre-lander-crp-comparison__inner {
      width: 100%;
      min-width: 320px;
      padding: 0 15px;
    }

    .pre-lander-crp-comparison__heading {
      font-size: 24px;
      line-height: normal;
      letter-spacing: 0.48px;
      margin-bottom: 30px;
    }

    .pre-lander-crp-comparison__table {
      font-size: 12px;
    }

    .pre-lander-crp-comparison__table th,
    .pre-lander-crp-comparison__table td {
      padding: 12px 8px;
    }

    .pre-lander-crp-comparison__table td:first-child,
    .pre-lander-crp-comparison__table th:first-child {
      display: none;
    }

    .pre-lander-crp-comparison__table .td-check,
    .pre-lander-crp-comparison__table .td-cross {
      flex-direction: column;
      gap: 12px;
      font-size: 12px;
      font-weight: 400;
      line-height: 160%;
    }

    .pre-lander-crp-comparison__table td {
      text-align: center;
    }

    .pre-lander-crp-comparison__table td:last-child {
      padding-left: 8px;
    }

    .pre-lander-crp-comparison__table td.competitor {
      padding-left: 8px;
    }

    .pre-lander-crp-comparison__table .th-competitor .th-header-img {
      width: 100%;
      max-width: 103px;
      height: 56px;
    }

    .pre-lander-crp-comparison__table .th-cb .th-header-img {
      width: 100%;
      max-width: 118px;
      height: 56px;
    }

    .pre-lander-crp-comparison__table .th-cb span,
    .pre-lander-crp-comparison__table .th-competitor span {
      text-align: center;
    }

    .pre-lander-crp-comparison__table .th-label {
      justify-content: center;
      align-items: center;
    }

    .pre-lander-crp-comparison__table .th-cb {
      padding-left: 8px;
      padding-top: 20px;
    }
  }
</style>

