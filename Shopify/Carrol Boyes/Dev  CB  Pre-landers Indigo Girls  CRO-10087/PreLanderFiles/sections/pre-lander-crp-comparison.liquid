<section class="pre-lander-crp-comparison">
  <div class="pre-lander-crp-comparison__inner">
    <h2 class="pre-lander-crp-comparison__heading">Most pantry canisters share the same problems. The Indigo Girls Set was designed around them.</h2>

    <table class="pre-lander-crp-comparison__table">
      <thead>
        <tr>
          <th></th>
          <th class="th-competitor">
            <div class="th-label">
              <img class="th-header-img" src="{{ 'pre-lander-crp-comparison-competitor.png' | asset_url }}" alt="">
              <span>MASS-PRODUCED CANISTERS</span>
            </div>
          </th>
          <th class="th-cb">
            <div class="th-label">
              <img class="th-header-img" src="{{ 'pre-lander-crp-comparison-cb.png' | asset_url }}" alt="">
              <span>CARROL BOYES INDIGO GIRLS</span>
            </div>
          </th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Material</td>
          <td class="competitor"><span class="td-cross">Plastic or thin glass</span></td>
          <td><span class="td-check">Durable porcelain with clear glaze</span></td>
        </tr>
        <tr>
          <td>Seal</td>
          <td class="competitor"><span class="td-cross">Loose-fitting, contents go stale</span></td>
          <td><span class="td-check">Silicone-sealed lids keep contents dry &amp; fresh</span></td>
        </tr>
        <tr>
          <td>Design</td>
          <td class="competitor"><span class="td-cross">Generic factory moulds</span></td>
          <td><span class="td-check">Designed by Carrol Boyes, inspired by West African indigo dyeing</span></td>
        </tr>
        <tr>
          <td>The set</td>
          <td class="competitor"><span class="td-cross">Three of the same jar</span></td>
          <td><span class="td-check">Three brand-new illustrations, designed to display together</span></td>
        </tr>
        <tr>
          <td>Care</td>
          <td class="competitor"><span class="td-cross">Hand-wash only</span></td>
          <td><span class="td-check">Dishwasher safe, microwave safe, food safe</span></td>
        </tr>
        <tr>
          <td>Why it sits on the counter</td>
          <td class="competitor"><span class="td-cross">Hidden in the cupboard</span></td>
          <td><span class="td-check">Designed to be seen — a Carrol Boyes piece holds its value</span></td>
        </tr>
      </tbody>
    </table>
  </div>
</section>

<style>
  .pre-lander-crp-comparison {
    background: #000;
    padding: 80px 15px;
    display: flex;
    justify-content: center;
    font-family: 'Poppins', sans-serif;
  }

  .pre-lander-crp-comparison__inner {
    width: 1024px;
  }

  .pre-lander-crp-comparison__heading {
    font-size: 30px;
    font-weight: 500;
    letter-spacing: 0.6px;
    line-height: 45px;
    color: #fff;
    max-width: 918px;
    margin: 0 auto 48px;
    text-align: center;
    text-transform: uppercase;
  }

  .pre-lander-crp-comparison__table {
    width: 100%;
    border-collapse: collapse;
  }

  .pre-lander-crp-comparison__table thead tr {
    border-bottom: 1px solid rgba(233, 233, 233, 0.80);
  }

  .pre-lander-crp-comparison__table th {
    padding: 20px 16px;
    text-align: left;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    vertical-align: bottom;
  }

  .pre-lander-crp-comparison__table th:first-child {
    color: transparent;
    width: 256px;
  }

  .pre-lander-crp-comparison__table .th-competitor {
    color: rgba(255, 255, 255, 0.5);
    width: 309px;
    padding-left: 0;
  }

  .pre-lander-crp-comparison__table .th-cb {
    color: #fff;
    width: 459px;
    background: #f7f7f7;
    border-radius: 2px 2px 0 0;
    padding-left: 32px;
    padding-top: 28px;
  }

  .pre-lander-crp-comparison__table .th-label {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .pre-lander-crp-comparison__table .th-header-img {
    width: 100%;
    height: 80px;
    object-fit: cover;
    display: block;
    margin-bottom: 8px;
    border-radius: 2px;
  }

  .pre-lander-crp-comparison__table .th-competitor .th-header-img {
    width: 100%;
    max-width: 147px;
  }

  .pre-lander-crp-comparison__table .th-cb .th-header-img {
    width: 100%;
    max-width: 169px;
  }

  .pre-lander-crp-comparison__table .th-competitor span {
    color: #fff;
    font-size: 12px;
    font-weight: 700;
