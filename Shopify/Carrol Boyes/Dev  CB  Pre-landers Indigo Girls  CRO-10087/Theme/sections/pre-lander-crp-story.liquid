<section class="pre-lander-crp-story">
  <div class="pre-lander-crp-story__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="pre-lander-crp-story__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.settings.intro != blank -%}
      <div class="pre-lander-crp-story__intro">{{ section.settings.intro }}</div>
    {%- endif -%}

    {%- if section.settings.image -%}
      <img
        class="pre-lander-crp-story__image"
        src="{{ section.settings.image | image_url: width: 1548 }}"
        alt=""
        loading="lazy"
        width="774"
        height="400"
      >
    {%- else -%}
      <img
        class="pre-lander-crp-story__image"
        src="{{ 'pre-lander-crp-story-product.jpg' | asset_url }}"
        alt=""
        loading="lazy"
        width="774"
        height="400"
      >
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <div class="pre-lander-crp-story__body">{{ section.settings.body }}</div>
    {%- endif -%}
  </div>
</section>

<style>
  .pre-lander-crp-story {
    background: #fff;
    padding: 80px 10px;
    position: relative;
    overflow: hidden;
    width: 100%;
    font-family: 'Poppins', sans-serif;
  }

  .pre-lander-crp-story__inner {
    max-width: 774px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 30px;
    position: relative;
    z-index: 2;
  }

  .pre-lander-crp-story__heading {
    font-size: 30px;
    font-weight: 500;
    letter-spacing: 0.6px;
    line-height: 45px;
    color: #000;
    text-align: center;
    margin: 0;
  }

  .pre-lander-crp-story__intro {
    text-align: center;
  }
  .pre-lander-crp-story__intro p {
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    color: #333;
    margin: 0;
  }

  .pre-lander-crp-story__image {
    width: 100%;
    max-width: 774px;
    height: 400px;
    object-fit: cover;
    display: block;
  }

  .pre-lander-crp-story__body {
    display: flex;
    flex-direction: column;
    gap: 30px;
    text-align: center;
  }
  .pre-lander-crp-story__body p {
    font-size: 14px;
    font-weight: 400;
    line-height: 21px;
    color: #333;
    margin: 0;
  }

  @media (max-width: 768px) {
    .pre-lander-crp-story {
      padding: 50px 0;
    }

    .pre-lander-crp-story__inner {
      gap: 20px;
    }

    .pre-lander-crp-story__heading,
    .pre-lander-crp-story__intro,
    .pre-lander-crp-story__body {
      padding-left: 15px;
      padding-right: 15px;
    }

    .pre-lander-crp-story__heading {
      font-size: 24px;
      letter-spacing: 0.48px;
      line-height: normal;
    }

    .pre-lander-crp-story__image {
      max-width: 100%;
      height: 250px;
    }

    .pre-lander-crp-story__body {
      gap: 20px;
    }
  }
</style>

{% schema %}
{
  "name": "Pre-lander Story",
  "tag": "section",
  "class": "section-pre-lander-crp-story",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE INDIGO GIRLS STORY"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro paragraph",
      "default": "<p>You've thought about every other surface in your kitchen. The countertops. The finishes. The cabinetry. Everything considered, everything intentional.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Falls back to the bundled pre-lander-crp-story-product.jpg if empty."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body paragraphs",
      "info": "Supports multiple paragraphs — use the editor's enter key for paragraph breaks.",
      "default": "<p>Then you needed somewhere to put the coffee, sugar and tea. And the options were plastic tubs, generic glass jars, or another forgettable ceramic set. Functional, sure. But nothing you'd choose to leave on the counter.</p><p>The Indigo Girls collection is Carrol Boyes' tribute to a West African tribe known for their deep indigo cloth dyeing traditions — translated onto durable porcelain by one of South Africa's most recognised design names.</p><p>This mixed set brings three brand-new illustrations together: not three copies of the same canister, but a small curated trio designed to live together on display.</p>"
    }
  ],
  "presets": [
    {
      "name": "Pre-lander Story"
    }
  ]
}
{% endschema %}
