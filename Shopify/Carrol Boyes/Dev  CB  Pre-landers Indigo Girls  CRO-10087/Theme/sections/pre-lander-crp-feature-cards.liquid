<section class="pre-lander-crp-feature-cards">
  {%- if section.settings.show_heading and section.settings.heading != blank -%}
    <h2 class="pre-lander-crp-feature-cards__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- if block.type == 'feature_card' -%}
      {%- assign card_fallback_index = forloop.index0 | modulo: 3 | plus: 1 -%}
      {%- assign card_fallback_filename = 'pre-lander-crp-feature-card-image-0' | append: card_fallback_index | append: '.png' -%}
      {%- if block.settings.image -%}
        {%- assign card_image_url = block.settings.image | image_url: width: 1088 -%}
      {%- else -%}
        {%- assign card_image_url = card_fallback_filename | asset_url -%}
      {%- endif -%}

      {%- if block.settings.icon_row_icon -%}
        {%- assign icon_url = block.settings.icon_row_icon | image_url: width: 80 -%}
      {%- else -%}
        {%- assign icon_url = 'pre-lander-crp-feature-card-icon.png' | asset_url -%}
      {%- endif -%}

      <div class="pre-lander-crp-feature-cards__card pre-lander-crp-feature-cards__card--image-{{ block.settings.image_position }}" {{ block.shopify_attributes }}>
        <div class="pre-lander-crp-feature-cards__text">
          {%- if block.settings.number != blank -%}
            <span class="pre-lander-crp-feature-cards__number">{{ block.settings.number | escape }}</span>
          {%- endif -%}

          {%- if block.settings.heading != blank -%}
            <h3 class="pre-lander-crp-feature-cards__title">{{ block.settings.heading | escape }}</h3>
          {%- endif -%}

          {%- if block.settings.paragraph != blank -%}
            <div class="pre-lander-crp-feature-cards__body">{{ block.settings.paragraph }}</div>
          {%- endif -%}

          {%- if block.settings.show_icon_row -%}
            <div class="pre-lander-crp-feature-cards__icon-row">
              <span class="pre-lander-crp-feature-cards__icon" style="background-color: {{ block.settings.icon_row_bg_color }};">
                <img src="{{ icon_url }}" alt="" width="40" height="40" loading="lazy">
              </span>
              {%- if block.settings.icon_row_text != blank -%}
                <span class="pre-lander-crp-feature-cards__icon-text">{{ block.settings.icon_row_text | escape }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if block.settings.show_review -%}
            <div class="pre-lander-crp-feature-cards__review">
              <div class="pre-lander-crp-feature-cards__review-top">
                {%- if block.settings.star_count > 0 -%}
                  <div class="pre-lander-crp-feature-cards__stars" aria-label="{{ block.settings.star_count }} out of 5 stars">
                    {%- for i in (1..block.settings.star_count) -%}
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M7.68336 1.53009C7.74296 1.40969 7.86568 1.3335 8.00003 1.3335C8.13438 1.3335 8.2571 1.40969 8.3167 1.53009L9.8567 4.64943C10.0624 5.06642 10.46 5.35558 10.92 5.42276L14.364 5.92676C14.4972 5.94605 14.6078 6.03925 14.6494 6.16716C14.691 6.29508 14.6563 6.43552 14.56 6.52943L12.0694 8.95476C11.7356 9.2795 11.5833 9.7478 11.662 10.2068L12.25 13.6334C12.2735 13.7665 12.2191 13.9013 12.1097 13.9808C12.0004 14.0602 11.8553 14.0703 11.736 14.0068L8.65736 12.3881C8.24563 12.1716 7.75376 12.1716 7.34203 12.3881L4.26403 14.0068C4.14479 14.0699 4.00001 14.0596 3.89089 13.9802C3.78178 13.9009 3.72738 13.7663 3.7507 13.6334L4.33803 10.2074C4.41703 9.74825 4.26465 9.27965 3.9307 8.95476L1.44003 6.53009C1.34291 6.43628 1.30774 6.29532 1.34942 6.16689C1.39109 6.03845 1.50233 5.945 1.63603 5.92609L5.07936 5.42276C5.53993 5.35599 5.93811 5.06677 6.14403 4.64943L7.68336 1.53009Z" fill="black" fill-opacity="0.8"/></svg>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
                {%- if block.settings.show_verified -%}
                  <div class="pre-lander-crp-feature-cards__verified">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="11" viewBox="0 0 15 11" fill="none" aria-hidden="true"><path d="M13.0905 0.197756L5.05821 8.23005L1.37208 5.2811V5.28088C1.13238 5.10074 0.815884 5.05905 0.537705 5.17093C0.259292 5.2828 0.0597914 5.53186 0.0112938 5.82769C-0.0371994 6.12375 0.0725487 6.42341 0.300553 6.61828L4.58671 10.0473C4.75112 10.179 4.95807 10.2457 5.16844 10.2347C5.37858 10.2236 5.57745 10.1356 5.72698 9.98733L14.2994 1.4149C14.4883 1.19413 14.5527 0.89275 14.4702 0.614124C14.3879 0.335499 14.1699 0.117704 13.8912 0.0351702C13.6126 -0.0471401 13.3112 0.0170929 13.0907 0.206174L13.0905 0.197756Z" fill="black" fill-opacity="0.8"/></svg>
                    <span>Verified Buyer</span>
                  </div>
                {%- endif -%}
              </div>

              {%- if block.settings.review_text != blank -%}
                <div class="pre-lander-crp-feature-cards__review-text">{{ block.settings.review_text }}</div>
              {%- endif -%}

              <div class="pre-lander-crp-feature-cards__reviewer">
                <div class="pre-lander-crp-feature-cards__reviewer-left">
                  {%- if block.settings.reviewer_name != blank -%}
                    <div class="pre-lander-crp-feature-cards__reviewer-avatar">{{ block.settings.reviewer_name | slice: 0, 1 | upcase }}</div>
                    <span class="pre-lander-crp-feature-cards__reviewer-name">{{ block.settings.reviewer_name | escape }}</span>
                  {%- endif -%}
                </div>
                {%- if block.settings.review_date != blank -%}
                  <span class="pre-lander-crp-feature-cards__reviewer-date">{{ block.settings.review_date | escape }}</span>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        </div>

        <img class="pre-lander-crp-feature-cards__image" src="{{ card_image_url }}" alt="" loading="lazy">
      </div>
    {%- endif -%}
  {%- endfor -%}
</section>

<style>
  .pre-lander-crp-feature-cards {
    background: #fff;
    padding: 80px 15px 50px;
    font-family: 'Poppins', sans-serif;
  }

  .pre-lander-crp-feature-cards__heading {
    font-size: 30px;
    font-weight: 500;
    letter-spacing: 0.6px;
    line-height: 45px;
    text-align: center;
    margin: 0 0 50px;
    text-transform: uppercase;
    color: #000;
  }

  .pre-lander-crp-feature-cards__card {
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 1173px;
    margin: 0 auto 35px;
    min-height: 500px;
    background: #f7f7f7;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 2px;
    overflow: hidden;
    justify-content: space-between;
    gap: 35px;
  }

  .pre-lander-crp-feature-cards__card--image-right { flex-direction: row; }
  .pre-lander-crp-feature-cards__card--image-left { flex-direction: row-reverse; }

  .pre-lander-crp-feature-cards__text {
    flex: 0 0 544px;
    padding: 50px;
    display: flex;
    flex-direction: column;
    gap: 25px;
  }

  .pre-lander-crp-feature-cards__card--image-right .pre-lander-crp-feature-cards__text {
    flex: 0 0 594px;
    padding-right: 0;
  }

  .pre-lander-crp-feature-cards__card--image-left .pre-lander-crp-feature-cards__text {
    padding-left: 0;
  }

  .pre-lander-crp-feature-cards__number {
    color: rgba(102, 102, 102, 0.30);
    font-size: 60px;
    font-weight: 400;
    line-height: 1;
  }

  .pre-lander-crp-feature-cards__title {
    font-size: 22px;
    font-weight: 500;
    line-height: normal;
    color: #000;
    letter-spacing: 0.44px;
    text-transform: uppercase;
    margin: 0;
  }

  .pre-lander-crp-feature-cards__body {
    color: #333;
  }
  .pre-lander-crp-feature-cards__body p {
    font-size: 14px;
    font-weight: 400;
    line-height: 21px;
    color: #333;
    margin: 0;
  }

  .pre-lander-crp-feature-cards__icon-row {
    display: flex;
    align-items: center;
    gap: 20px;
    font-size: 16px;
    letter-spacing: 0.32px;
    color: #000;
  }
  .pre-lander-crp-feature-cards__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
  }
  .pre-lander-crp-feature-cards__icon img {
    width: 40px;
    height: 40px;
    display: block;
  }

  .pre-lander-crp-feature-cards__review {
    padding: 20px 24px;
    border-radius: 2px;
    border: 1px solid rgba(0, 0, 0, 0.10);
    background: #fff;
  }
  .pre-lander-crp-feature-cards__review-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }
  .pre-lander-crp-feature-cards__stars {
    display: flex;
    align-items: center;
    gap: 0;
  }
  .pre-lander-crp-feature-cards__stars svg {
    width: 16px;
    height: 16px;
  }
  .pre-lander-crp-feature-cards__verified {
    display: flex;
    align-items: center;
    gap: 5px;
    color: rgba(0, 0, 0, 0.80);
    font-size: 12px;
    font-weight: 500;
    line-height: 160%;
  }
  .pre-lander-crp-feature-cards__review-text {
    margin-bottom: 16px;
  }
  .pre-lander-crp-feature-cards__review-text p {
    font-size: 14px;
    font-weight: 400;
    line-height: 150%;
    color: #333;
    margin: 0;
  }
  .pre-lander-crp-feature-cards__reviewer {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .pre-lander-crp-feature-cards__reviewer-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .pre-lander-crp-feature-cards__reviewer-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #000;
    color: #fff;
    font-size: 16px;
    font-weight: 400;
    line-height: 20px;
    letter-spacing: 1.4px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pre-lander-crp-feature-cards__reviewer-name {
    color: #000;
    font-size: 14px;
    font-weight: 400;
    line-height: normal;
    letter-spacing: 1.12px;
    text-transform: uppercase;
  }
  .pre-lander-crp-feature-cards__reviewer-date {
    color: rgba(0, 0, 0, 0.80);
    font-size: 14px;
    font-weight: 400;
    line-height: 150%;
  }

  .pre-lander-crp-feature-cards__image {
    flex: 1;
    align-self: stretch;
    object-fit: cover;
    min-height: 500px;
    width: 100%;
    max-width: 544px;
  }

  @media (min-width: 769px) and (max-width: 1023px) {
    .pre-lander-crp-feature-cards__card--image-right .pre-lander-crp-feature-cards__text { flex: 0 0 345px; gap: 20px; }
    .pre-lander-crp-feature-cards__card--image-left .pre-lander-crp-feature-cards__text { flex: 0 0 360px; gap: 20px; }
  }

  @media (max-width: 768px) {
    .pre-lander-crp-feature-cards {
      padding: 50px 15px;
    }

    .pre-lander-crp-feature-cards__heading {
      font-size: 24px;
      letter-spacing: 0.48px;
      line-height: normal;
      margin-bottom: 30px;
    }

    .pre-lander-crp-feature-cards__card,
    .pre-lander-crp-feature-cards__card--image-right,
    .pre-lander-crp-feature-cards__card--image-left {
      flex-direction: column-reverse;
      min-height: unset;
      max-height: unset;
      gap: 20px;
      margin-bottom: 20px;
    }

    .pre-lander-crp-feature-cards__text,
    .pre-lander-crp-feature-cards__card--image-right .pre-lander-crp-feature-cards__text,
    .pre-lander-crp-feature-cards__card--image-left .pre-lander-crp-feature-cards__text {
      flex: 1 1 auto;
      width: 100%;
      padding: 0 16px 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
      text-align: center;
    }

    .pre-lander-crp-feature-cards__number {
      font-size: 40px;
    }

    .pre-lander-crp-feature-cards__title {
      font-size: 18px;
      letter-spacing: 0.36px;
      text-align: center;
    }

    .pre-lander-crp-feature-cards__body p {
      font-size: 12px;
      line-height: 160%;
      text-align: center;
    }

    .pre-lander-crp-feature-cards__icon {
      width: 34px;
      height: 34px;
    }
    .pre-lander-crp-feature-cards__icon img {
      width: 34px;
      height: 34px;
    }
    .pre-lander-crp-feature-cards__icon-row {
      font-size: 12px;
      line-height: 160%;
      gap: 12px;
    }

    .pre-lander-crp-feature-cards__review {
      width: 100%;
    }
    .pre-lander-crp-feature-cards__review-text p {
      font-size: 12px;
      line-height: 160%;
    }
    .pre-lander-crp-feature-cards__reviewer-name {
      font-size: 12px;
      letter-spacing: 0.96px;
    }
    .pre-lander-crp-feature-cards__reviewer-date {
      font-size: 12px;
      line-height: 160%;
    }

    .pre-lander-crp-feature-cards__image {
      flex: none;
      width: 100%;
      min-height: 300px;
      max-height: 320px;
      max-width: 100%;
      align-self: auto;
    }
  }
</style>

{% schema %}
{
  "name": "Pre-lander Feature Cards",
  "tag": "section",
  "class": "section-pre-lander-crp-feature-cards",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading text",
      "default": "THE CARROL BOYES DIFFERENCE"
    }
  ],
  "blocks": [
    {
      "type": "feature_card",
      "name": "Feature card",
      "settings": [
        { "type": "header", "content": "Card content" },
        { "type": "text", "id": "number", "label": "Number", "default": "01" },
        { "type": "text", "id": "heading", "label": "Card heading" },
        { "type": "richtext", "id": "paragraph", "label": "Paragraph" },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image",
          "info": "Falls back to a bundled image by block position (1st → image 1, 2nd → image 2, etc.)."
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image position",
          "options": [
            { "value": "right", "label": "Right (text on left)" },
            { "value": "left", "label": "Left (text on right)" }
          ],
          "default": "right"
        },

        { "type": "header", "content": "Icon row" },
        { "type": "checkbox", "id": "show_icon_row", "label": "Show icon row", "default": false },
        { "type": "color", "id": "icon_row_bg_color", "label": "Icon background colour", "default": "#F7F7F7" },
        {
          "type": "image_picker",
          "id": "icon_row_icon",
          "label": "Icon",
          "info": "Falls back to the bundled feature card icon if empty."
        },
        { "type": "text", "id": "icon_row_text", "label": "Text" },

        { "type": "header", "content": "Review" },
        { "type": "checkbox", "id": "show_review", "label": "Show review", "default": false },
        {
          "type": "range",
          "id": "star_count",
          "label": "Number of stars",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        },
        { "type": "checkbox", "id": "show_verified", "label": "Show 'Verified Buyer' badge", "default": true },
        { "type": "richtext", "id": "review_text", "label": "Review text" },
        {
          "type": "text",
          "id": "reviewer_name",
          "label": "Reviewer name",
          "info": "First letter is auto-used for the avatar circle."
        },
        { "type": "text", "id": "review_date", "label": "Date" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Pre-lander Feature Cards",
      "blocks": [
        {
          "type": "feature_card",
          "settings": {
            "number": "01",
            "heading": "A Tribute to West African Indigo Dyeing",
            "paragraph": "<p>The Indigo Girls collection is Carrol Boyes' tribute to a West African tribe celebrated for their deep indigo cloth dyeing traditions. Each illustration is a nod to centuries of textile artistry — translated onto durable porcelain so it can live in a modern South African kitchen.</p>",
            "image_position": "right",
            "show_icon_row": true,
            "icon_row_text": "30+ YEARS OF CARROL BOYES DESIGN"
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "number": "02",
            "heading": "Durable Porcelain, Not Plastic",
            "paragraph": "<p>Solid porcelain with a clear glaze finish — the kind of weight and feel you notice the moment you pick one up. Dishwasher safe, microwave safe, and food safe, so they keep up with everyday kitchen use without losing their finish.</p>",
            "image_position": "left",
            "show_review": true,
            "star_count": 5,
            "show_verified": true,
            "review_text": "<p>\"Bought it as a gift for my brothers wife. She absolutely loves it. Shes moved her usual cups to make space for her new babies\"</p>",
            "reviewer_name": "Mahlatse Ellah",
            "review_date": "7/24/25"
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "number": "03",
            "heading": "Three Brand-New Illustrations",
            "paragraph": "<p>This isn't three copies of the same jar. Each canister in the set features a different, brand-new Indigo Girls illustration — three pieces of the story, designed to sit together on the counter. A must-have for collectors of the range.</p>",
            "image_position": "right",
            "show_icon_row": true,
            "icon_row_text": "A MUST-HAVE FOR COLLECTORS OF THE RANGE"
          }
        }
      ]
    }
  ]
}
{% endschema %}
