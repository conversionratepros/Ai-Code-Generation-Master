{% doc %}
  @prompt
    generate an image section where i can display payment option. it must be small and in the centre of the page. I only have one payment method, can you give me an option to control the padding please 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-payment-options-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-payment-options-container-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: {{ block.settings.content_gap }}px;
    max-width: {{ block.settings.max_width }}px;
    width: 100%;
    text-align: center;
  }

  .ai-payment-options-heading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 600;
    margin: 0;
    font-family: var(--font-heading-family);
  }

  .ai-payment-options-subtext-{{ ai_gen_id }} {
    color: {{ block.settings.subtext_color }};
    font-size: {{ block.settings.subtext_size }}px;
    margin: 0;
    line-height: 1.4;
  }

  .ai-payment-options-image-wrapper-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  .ai-payment-options-image-{{ ai_gen_id }} {
    max-width: {{ block.settings.image_width }}px;
    height: auto;
    border-radius: {{ block.settings.image_border_radius }}px;
    box-shadow: {{ block.settings.show_shadow | if: '0 2px 8px rgba(0, 0, 0, 0.1)', 'none' }};
    transition: transform 0.2s ease;
  }

  .ai-payment-options-image-{{ ai_gen_id }}:hover {
    transform: {{ block.settings.hover_effect | if: 'scale(1.05)', 'none' }};
  }

  .ai-payment-options-placeholder-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
    border: 2px dashed #cccccc;
    border-radius: {{ block.settings.image_border_radius }}px;
    padding: 40px 20px;
    max-width: {{ block.settings.image_width }}px;
    width: 100%;
    min-height: 120px;
  }

  .ai-payment-options-placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    color: #999999;
    margin-bottom: 12px;
  }

  .ai-payment-options-placeholder-text-{{ ai_gen_id }} {
    color: #666666;
    font-size: 14px;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-payment-options-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top_mobile }}px {{ block.settings.padding_horizontal_mobile }}px {{ block.settings.padding_bottom_mobile }}px {{ block.settings.padding_horizontal_mobile }}px;
    }

    .ai-payment-options-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.85 }}px;
    }

    .ai-payment-options-subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtext_size | times: 0.9 }}px;
    }

    .ai-payment-options-image-{{ ai_gen_id }} {
      max-width: {{ block.settings.image_width | times: 0.8 }}px;
    }

    .ai-payment-options-placeholder-{{ ai_gen_id }} {
      max-width: {{ block.settings.image_width | times: 0.8 }}px;
      padding: 30px 15px;
      min-height: 100px;
    }

    .ai-payment-options-placeholder-{{ ai_gen_id }} svg {
      width: 50px;
      height: 50px;
    }
  }
{% endstyle %}

<div class="ai-payment-options-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-payment-options-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h3 class="ai-payment-options-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h3>
    {% endif %}

    {% if block.settings.subtext != blank %}
      <p class="ai-payment-options-subtext-{{ ai_gen_id }}">{{ block.settings.subtext }}</p>
    {% endif %}

    <div class="ai-payment-options-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.payment_image %}
        <img
          src="{{ block.settings.payment_image | image_url: width: 600 }}"
          alt="{{ block.settings.payment_image.alt | default: 'Payment options' | escape }}"
          class="ai-payment-options-image-{{ ai_gen_id }}"
          loading="lazy"
          width="{{ block.settings.payment_image.width }}"
          height="{{ block.settings.payment_image.height }}"
        >
      {% else %}
        <div class="ai-payment-options-placeholder-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
          </svg>
          <div class="ai-payment-options-placeholder-text-{{ ai_gen_id }}">
            Add your payment method image
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Payment options",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We accept"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Secure payment options available"
    },
    {
      "type": "image_picker",
      "id": "payment_image",
      "label": "Payment method image"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 200,
      "max": 600,
      "step": 20,
      "unit": "px",
      "label": "Maximum width",
      "default": 400
    },
    {
      "type": "range",
      "id": "image_width",
      "min": 100,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Image width",
      "default": 200
    },
    {
      "type": "range",
      "id": "content_gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Content spacing",
      "default": 16
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Left and right padding",
      "default": 20
    },
    {
      "type": "header",
      "content": "Mobile padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Top padding",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Bottom padding",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Left and right padding",
      "default": 15
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext color",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Heading size",
      "default": 20
    },
    {
      "type": "range",
      "id": "subtext_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Subtext size",
      "default": 14
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Image border radius",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_shadow",
      "label": "Show image shadow",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hover_effect",
      "label": "Enable hover effect",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Payment options"
    }
  ]
}
{% endschema %}