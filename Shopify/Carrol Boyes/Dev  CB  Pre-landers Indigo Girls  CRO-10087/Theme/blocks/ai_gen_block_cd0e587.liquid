{% doc %}
  @prompt
    can you geenrate a section with a image on the left in portrait view. on the right add two images that is half the hight and width of the portait image on the left. add text in the middle. This text must have a header and a sub heading. Also add a button in the centre of the section toward the bottom.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-text-layout-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: {{ block.settings.gap }}px;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    min-height: 500px;
    align-items: stretch;
  }

  .ai-image-text-layout__portrait-{{ ai_gen_id }} {
    grid-column: 1;
    grid-row: 1 / 3;
    position: relative;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-image-text-layout__portrait-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-image-text-layout__portrait-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-image-text-layout__portrait-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-image-text-layout__text-content-{{ ai_gen_id }} {
    grid-column: 2;
    grid-row: 1 / 3;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 40px 20px;
  }

  .ai-image-text-layout__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 16px 0;
    font-weight: 700;
  }

  .ai-image-text-layout__subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0 0 32px 0;
    line-height: 1.5;
  }

  .ai-image-text-layout__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    transition: background-color 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .ai-image-text-layout__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-image-text-layout__small-image-{{ ai_gen_id }} {
    grid-column: 3;
    position: relative;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-image-text-layout__small-image-1-{{ ai_gen_id }} {
    grid-row: 1;}

  .ai-image-text-layout__small-image-2-{{ ai_gen_id }} {
    grid-row: 2;
  }

  .ai-image-text-layout__small-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-image-text-layout__small-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-image-text-layout__small-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-image-text-layout__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 12px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 4px;
    font-size: 12px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 768px) {
    .ai-image-text-layout-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto auto;
      gap: {{ block.settings.mobile_gap }}px;
      padding: {{ block.settings.mobile_padding }}px;
    }

    .ai-image-text-layout__portrait-{{ ai_gen_id }} {
      grid-column: 1;
      grid-row: 1;
      min-height: 300px;
    }

    .ai-image-text-layout__text-content-{{ ai_gen_id }} {
      grid-column: 1;
      grid-row: 2;
      padding: 20px;
    }

    .ai-image-text-layout__small-image-1-{{ ai_gen_id }} {
      grid-column: 1;
      grid-row: 3;
      min-height: 200px;
    }

    .ai-image-text-layout__small-image-2-{{ ai_gen_id }} {
      grid-column: 1;
      grid-row: 4;
      min-height: 200px;
    }

    .ai-image-text-layout__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-image-text-layout__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-image-text-layout-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-text-layout__portrait-{{ ai_gen_id }}">
    {% if block.settings.portrait_image %}
      <img
        src="{{ block.settings.portrait_image | image_url: width: 600 }}"
        alt="{{ block.settings.portrait_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.portrait_image.width }}"
        height="{{ block.settings.portrait_image.height }}"
      >
    {% else %}
      <div class="ai-image-text-layout__portrait-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
        <div class="ai-image-text-layout__empty-state-{{ ai_gen_id }}">
          Add portrait image
        </div>
      </div>
    {% endif %}
  </div>

  <div class="ai-image-text-layout__text-content-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-image-text-layout__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}
    
    {% if block.settings.subheading != blank %}
      <p class="ai-image-text-layout__subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
    {% endif %}
    
    {% if block.settings.button_text != blank %}
      <a 
        href="{{ block.settings.button_link }}" 
        class="ai-image-text-layout__button-{{ ai_gen_id }}"
      >
        {{ block.settings.button_text }}
      </a>
    {% endif %}
  </div>

  <div class="ai-image-text-layout__small-image-{{ ai_gen_id }} ai-image-text-layout__small-image-1-{{ ai_gen_id }}">
    {% if block.settings.small_image_1 %}
      <img
        src="{{ block.settings.small_image_1 | image_url: width: 400 }}"
        alt="{{ block.settings.small_image_1.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.small_image_1.width }}"
        height="{{ block.settings.small_image_1.height }}"
      >
    {% else %}
      <div class="ai-image-text-layout__small-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
        <div class="ai-image-text-layout__empty-state-{{ ai_gen_id }}">
          Add small image 1
        </div>
      </div>
    {% endif %}
  </div>

  <div class="ai-image-text-layout__small-image-{{ ai_gen_id }} ai-image-text-layout__small-image-2-{{ ai_gen_id }}">
    {% if block.settings.small_image_2 %}
      <img
        src="{{ block.settings.small_image_2 | image_url: width: 400 }}"
        alt="{{ block.settings.small_image_2.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.small_image_2.width }}"
        height="{{ block.settings.small_image_2.height }}"
      >
    {% else %}
      <div class="ai-image-text-layout__small-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
        <div class="ai-image-text-layout__empty-state-{{ ai_gen_id }}">
          Add small image 2
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Image text layout",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "portrait_image",
      "label": "Portrait image"
    },
    {
      "type": "image_picker",
      "id": "small_image_1",
      "label": "Small image 1"
    },
    {
      "type": "image_picker",
      "id": "small_image_2",
      "label": "Small image 2"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Image border radius",
      "default": 8
    },
    {
      "type": "header",
      "content": "Text content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover Our Collection"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore our carefully curated selection of premium products designed to enhance your lifestyle."
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 32
    },
    {
      "type": "range",
      "id": "subheading_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subheading size",
      "default": 16
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button hover color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Button font size",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_padding_vertical",
      "min": 8,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Button vertical padding",
      "default": 12
    },
    {
      "type": "range",
      "id": "button_padding_horizontal",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Button horizontal padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Button border radius",
      "default": 6
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Gap between elements",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Section padding",
      "default": 40
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "min": 10,
      "max": 30,
      "step": 5,
      "unit": "px",
      "label": "Mobile gap",
      "default": 15
    },
    {
      "type": "range",
      "id": "mobile_padding",
      "min": 15,
      "max": 40,
      "step": 5,
      "unit": "px",
      "label": "Mobile padding",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Image text layout"
    }
  ],
  "tag": null
}
{% endschema %}