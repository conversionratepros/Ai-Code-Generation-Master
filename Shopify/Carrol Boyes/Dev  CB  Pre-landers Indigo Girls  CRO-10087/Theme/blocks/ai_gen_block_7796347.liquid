{% doc %}
  @prompt
    i would like a section with with nine text input fields. These nine input fields must allow me to change the text in them independently and allow me to connect a dynamic source such as a meta field. 
    The title must be on the right and next to it must be the meta field input. 
    So side by side to read as a the following: 
    Designer :  Carrol Boyes. 
    Collection : Dancing Girls 
    Finish : Clear Glaze
    Microwave Safe: Yes
    Food Safe: Yes
    Oven Safe: No 
    Dishwasher Safe: Yes, Can you add the option to apply padding to the mobile section. It is too tigh against the left boarder of the mobile device screen, Can you add a heading to this section by using the styling of the H2 heading. Then turn it into a collapsable row ( accordian ) with a + button to expand it. The same styling the current collapsable rows has in the theme. , i need this section to be able to go into the product information secction as a collapsable row, revert the last instruction , for desktop can you add more padding so that the heading is not against the left boarder. Needs to be away from the boarder on the left for both the heading and the content. Make them the same spacing as you did on the moble version
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-specs-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding }}px {{ block.settings.desktop_horizontal_padding }}px;
  }

  .ai-product-specs-accordion-{{ ai_gen_id }} {
    border-top: 1px solid {{ block.settings.divider_color }};
    border-bottom: 1px solid {{ block.settings.divider_color }};
  }

  .ai-product-specs-summary-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: {{ block.settings.heading_padding }}px 0;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .ai-product-specs-summary-{{ ai_gen_id }}::-webkit-details-marker {
    display: none;
  }

  .ai-product-specs-heading-{{ ai_gen_id }} {
    margin: 0;
    font-size: calc(var(--font-heading-scale) * 2rem);
    line-height: calc(1 + 0.3 / max(1, var(--font-heading-scale)));
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    letter-spacing: calc(var(--font-heading-scale) * var(--heading-letter-spacing));
    {% if settings.heading_uppercase %}
      text-transform: uppercase;
    {% endif %}
  }

  .ai-product-specs-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    margin-left: 190px;
    transition: transform 0.3s ease;
  }

  .ai-product-specs-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .ai-product-specs-details-{{ ai_gen_id }}[open] .ai-product-specs-icon-{{ ai_gen_id }} {
    transform: rotate(45deg);
  }

  .ai-product-specs-content-{{ ai_gen_id }} {
    overflow: hidden;
    padding-bottom: {{ block.settings.content_padding_bottom }}px;
  }

  .ai-product-specs-list-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.row_gap }}px;
    max-width: {{ block.settings.max_width }}px;
  }

  .ai-product-specs-row-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: {{ block.settings.label_width }}% 1fr;
    gap: {{ block.settings.column_gap }}px;
    align-items: {{ block.settings.vertical_alignment }};
    padding: {{ block.settings.row_padding }}px 0;
    {% if block.settings.show_divider %}
      border-bottom: {{ block.settings.divider_thickness }}px {{ block.settings.divider_style }} {{ block.settings.divider_color }};
    {% endif %}
  }

  .ai-product-specs-row-{{ ai_gen_id }}:last-child {
    {% if block.settings.hide_last_divider %}
      border-bottom: none;
    {% endif %}
  }

  .ai-product-specs-label-{{ ai_gen_id }} {
    font-family: {{ block.settings.label_font.family }}, {{ block.settings.label_font.fallback_families }};
    font-weight: {{ block.settings.label_font.weight }};
    font-size: {{ block.settings.label_font_size }}px;
    color: {{ block.settings.label_color }};
    text-align: {{ block.settings.label_alignment }};
  }

  .ai-product-specs-value-{{ ai_gen_id }} {
    font-family: {{ block.settings.value_font.family }}, {{ block.settings.value_font.fallback_families }};
    font-weight: {{ block.settings.value_font.weight }};
    font-size: {{ block.settings.value_font_size }}px;
    color: {{ block.settings.value_color }};
    text-align: {{ block.settings.value_alignment }};
  }

  @media screen and (max-width: 749px) {
    .ai-product-specs-{{ ai_gen_id }} {
      padding-left: {{ block.settings.mobile_horizontal_padding }}px;
      padding-right: {{ block.settings.mobile_horizontal_padding }}px;
    }

    .ai-product-specs-heading-{{ ai_gen_id }} {
      font-size: calc(var(--font-heading-scale) * 2rem * var(--heading-mobile-scale));
    }

    .ai-product-specs-row-{{ ai_gen_id }} {
      {% if block.settings.mobile_stack %}
        grid-template-columns: 1fr;
        gap: {{ block.settings.mobile_gap }}px;
      {% endif %}
    }

    .ai-product-specs-label-{{ ai_gen_id }} {
      font-size: {{ block.settings.label_font_size | times: 0.9 }}px;
      {% if block.settings.mobile_stack %}
        text-align: left;
      {% endif %}
    }

    .ai-product-specs-value-{{ ai_gen_id }} {
      font-size: {{ block.settings.value_font_size | times: 0.9 }}px;
      {% if block.settings.mobile_stack %}
        text-align: left;
      {% endif %}
    }
  }
{% endstyle %}

<div class="ai-product-specs-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <details class="ai-product-specs-details-{{ ai_gen_id }} ai-product-specs-accordion-{{ ai_gen_id }}" {% if block.settings.open_by_default %}open{% endif %}>
    <summary class="ai-product-specs-summary-{{ ai_gen_id }}">
      <h2 class="ai-product-specs-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      <span class="ai-product-specs-icon-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
      </span>
    </summary>
    <div class="ai-product-specs-content-{{ ai_gen_id }}">
      <div class="ai-product-specs-list-{{ ai_gen_id }}">
        {% if block.settings.field_1_label != blank or block.settings.field_1_value != blank %}
          <div class="ai-product-specs-row-{{ ai_gen_id }}">
            <div class="ai-product-specs-label-{{ ai_gen_id }}">{{ block.settings.field_1_label }}</div>
            <div class="ai-product-specs-value-{{ ai_gen_id }}">{{ block.settings.field_1_value }}</div>
          </div>
        {% endif %}

        {% if block.settings.field_2_label != blank or block.settings.field_2_value != blank %}
          <div class="ai-product-specs-row-{{ ai_gen_id }}">
            <div class="ai-product-specs-label-{{ ai_gen_id }}">{{ block.settings.field_2_label }}</div>
            <div class="ai-product-specs-value-{{ ai_gen_id }}">{{ block.settings.field_2_value }}</div>
          </div>
        {% endif %}

        {% if block.settings.field_3_label != blank or block.settings.field_3_value != blank %}
          <div class="ai-product-specs-row-{{ ai_gen_id }}">
            <div class="ai-product-specs-label-{{ ai_gen_id }}">{{ block.settings.field_3_label }}</div>
            <div class="ai-product-specs-value-{{ ai_gen_id }}">{{ block.settings.field_3_value }}</div>
          </div>
        {% endif %}

        {% if block.settings.field_4_label != blank or block.settings.field_4_value != blank %}
          <div class="ai-product-specs-row-{{ ai_gen_id }}">
            <div class="ai-product-specs-label-{{ ai_gen_id }}">{{ block.settings.field_4_label }}</div>
            <div class="ai-product-specs-value-{{ ai_gen_id }}">{{ block.settings.field_4_value }}</div>
          </div>
        {% endif %}

        {% if block.settings.field_5_label != blank or block.settings.field_5_value != blank %}
          <div class="ai-product-specs-row-{{ ai_gen_id }}">
            <div class="ai-product-specs-label-{{ ai_gen_id }}">{{ block.settings.field_5_label }}</div>
            <div class="ai-product-specs-value-{{ ai_gen_id }}">{{ block.settings.field_5_value }}</div>
          </div>
        {% endif %}

        {% if block.settings.field_6_label != blank or block.settings.field_6_value != blank %}
          <div class="ai-product-specs-row-{{ ai_gen_id }}">
            <div class="ai-product-specs-label-{{ ai_gen_id }}">{{ block.settings.field_6_label }}</div>
            <div class="ai-product-specs-value-{{ ai_gen_id }}">{{ block.settings.field_6_value }}</div>
          </div>
        {% endif %}

        {% if block.settings.field_7_label != blank or block.settings.field_7_value != blank %}
          <div class="ai-product-specs-row-{{ ai_gen_id }}">
            <div class="ai-product-specs-label-{{ ai_gen_id }}">{{ block.settings.field_7_label }}</div>
            <div class="ai-product-specs-value-{{ ai_gen_id }}">{{ block.settings.field_7_value }}</div>
          </div>
        {% endif %}

        {% if block.settings.field_8_label != blank or block.settings.field_8_value != blank %}
          <div class="ai-product-specs-row-{{ ai_gen_id }}">
            <div class="ai-product-specs-label-{{ ai_gen_id }}">{{ block.settings.field_8_label }}</div>
            <div class="ai-product-specs-value-{{ ai_gen_id }}">{{ block.settings.field_8_value }}</div>
          </div>
        {% endif %}

        {% if block.settings.field_9_label != blank or block.settings.field_9_value != blank %}
          <div class="ai-product-specs-row-{{ ai_gen_id }}">
            <div class="ai-product-specs-label-{{ ai_gen_id }}">{{ block.settings.field_9_label }}</div>
            <div class="ai-product-specs-value-{{ ai_gen_id }}">{{ block.settings.field_9_value }}</div>
          </div>
        {% endif %}
      </div>
    </div>
  </details>
</div>

