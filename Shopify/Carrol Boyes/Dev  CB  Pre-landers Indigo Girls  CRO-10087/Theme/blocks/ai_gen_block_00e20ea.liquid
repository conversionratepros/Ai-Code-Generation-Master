</product-tabs-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductTabs{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.tabButtons = this.querySelectorAll('.ai-product-tabs-button-{{ ai_gen_id }}');
        this.tabPanels = this.querySelectorAll('.ai-product-tabs-panel-{{ ai_gen_id }}');
        this.accordionButtons = this.querySelectorAll('.ai-product-tabs-accordion-header-{{ ai_gen_id }}');
        
        this.tabButtons.forEach(button => {
          button.addEventListener('click', this.switchTab.bind(this));
        });

        this.accordionButtons.forEach(button => {
          button.addEventListener('click', this.toggleAccordion.bind(this));
        });
      }

      switchTab(event) {
        const clickedButton = event.currentTarget;
        const targetTab = clickedButton.getAttribute('data-tab');
        
        this.tabButtons.forEach(button => {
          button.classList.remove('active');
          button.setAttribute('aria-selected', 'false');
        });
        
        this.tabPanels.forEach(panel => {
          panel.classList.remove('active');
        });
        
        clickedButton.classList.add('active');
        clickedButton.setAttribute('aria-selected', 'true');
        
        const targetPanel = this.querySelector('#ai-product-tabs-panel-' + targetTab + '-{{ ai_gen_id }}');
        if (targetPanel) {
          targetPanel.classList.add('active');
        }
      }

      toggleAccordion(event) {
        const clickedButton = event.currentTarget;
        const targetId = clickedButton.getAttribute('aria-controls');
        const targetContent = this.querySelector('#' + targetId);
        const isExpanded = clickedButton.getAttribute('aria-expanded') === 'true';
        
        clickedButton.setAttribute('aria-expanded', !isExpanded);
        targetContent.classList.toggle('active');
      }
    }

    customElements.define('product-tabs-{{ ai_gen_id }}', ProductTabs{{ ai_gen_id }});
  })();
</script>

