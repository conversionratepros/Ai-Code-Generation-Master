          id="ai-product-tabs-panel-4-{{ ai_gen_id }}"
          class="ai-product-tabs-panel-{{ ai_gen_id }}"
          role="tabpanel"
          aria-labelledby="ai-product-tabs-button-4-{{ ai_gen_id }}"
        >
          {% if block.settings.tab_4_content != blank %}
            <div class="ai-product-tabs-text-content-{{ ai_gen_id }}">
              {{ block.settings.tab_4_content }}
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.show_tab_5 and block.settings.tab_5_heading != blank %}
        <div
          id="ai-product-tabs-panel-5-{{ ai_gen_id }}"
          class="ai-product-tabs-panel-{{ ai_gen_id }}"
          role="tabpanel"
          aria-labelledby="ai-product-tabs-button-5-{{ ai_gen_id }}"
        >
          {% if block.settings.tab_5_content != blank %}
