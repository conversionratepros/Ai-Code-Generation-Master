        "custom_liquid": "<!-- CAROLYN BOYES PROFILE CARD -->\n<link href=\"https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n\n<div class=\"cb-profile\">\n  <style>\n    .cb-profile {\n      font-family: 'Poppins', sans-serif;\n      color: #2b2b2b;\n      max-width: 1000px;\n      margin: 0 auto;\n      padding: 3rem 1.5rem;\n    }\n\n    /* Card container */\n    .cb-card {\n      display: grid;\n      grid-template-columns: 1fr 1.2fr;\n      align-items: center;\n      gap: 40px;\n      background: #fff;\n      border-radius: 20px;\n      padding: 40px;\n      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08);\n    }\n\n    .cb-card img {\n      width: 100%;\n      border-radius: 12px;\n      object-fit: cover;\n      display: block;\n    }\n\n    .cb-text h2 {\n      font-size: 24px;\n      font-weight: 600;\n      margin-bottom: 10px;\n    }\n\n    .cb-text p {\n      font-size: 16px;\n      line-height: 1.7;\n      margin-bottom: 20px;\n      color: #555;\n    }\n\n    .cb-signature {\n      max-width: 120px;\n      height: auto;\n    }\n\n    /* Mobile responsiveness */\n    @media (max-width: 900px) {\n      .cb-card {\n        grid-template-columns: 1fr;\n        text-align: center;\n        padding: 30px 20px;\n      }\n      .cb-text h2 {\n        margin-top: 20px;\n      }\n      .cb-signature {\n        margin: 0 auto;\n      }\n    }\n  </style>\n\n  <!-- Profile card -->\n  <section class=\"cb-card\">\n    <figure>\n      <img src=\"https://cdn.shopify.com/s/files/1/0927/5224/9201/files/Art_Dept_Portraits_Caro.webp?v=1760450592\" alt=\"Portrait of Carolyn Boyes\">\n    </figure>\n    <div class=\"cb-text\">\n      <h2>Carolyn Boyes</h2>\n      <p>As a designer for the flourishing business and continuing the family heritage, Carolyn infuses her passion for art and culture into every creation. Her designs draw inspiration from the beauty of human form and the elegance of nature, making each piece a work of art.</p>\n      <img class=\"cb-signature\" src=\"https://cdn.shopify.com/s/files/1/0927/5224/9201/files/Caro_Signature.jpg?v=1760450592\" alt=\"Caro signature\">\n    </div>\n  </section>\n</div>",
