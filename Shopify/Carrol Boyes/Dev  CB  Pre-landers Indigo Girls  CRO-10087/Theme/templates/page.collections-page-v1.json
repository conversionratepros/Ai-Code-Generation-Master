        "card_rimRet": {
          "type": "card",
          "settings": {
            "image": "shopify://shop_images/salad_server_hanging_wave.webp",
            "title": "Hanging Wave",
            "text": "<p>The Hanging Wave Collection captures the fluid poetry of two spirals meeting in perfect harmony. Each elegantly designed cutlery piece reflects Carrol Boyes’ signature sculptural style, with the spirals forming graceful waves at the handle’s end. Functional yet artistic, this collection brings movement,<br/>sophistication and contemporary flair to every table setting.<br/></p>",
            "found_text": "<p>Designer: Carrol Boyes</p><p>Materials: Stainless Steel</p><p><a href=\"/collections/hanging-wave\" title=\"Hanging Wave\">Shop the Range</a></p>",
            "products": []
          }
