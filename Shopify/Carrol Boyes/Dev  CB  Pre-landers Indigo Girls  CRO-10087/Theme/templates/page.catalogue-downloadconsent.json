         });\n          </script>\n\n        {% else %}\n\n          {% if form.errors %}\n            <div class=\"catalogue-download-errors\">{{ form.errors | default_errors }}</div>\n          {% endif %}\n\n          <h3>Get the Catalogue digital download</h3>\n          <p class=\"catalogue-download-subtitle\">\n            Enter your email to access the free Catalogue download and receive updates from Carrol Boyes.\n          </p>\n\n          <label for=\"CatalogueDownloadEmail\" class=\"catalogue-download-label\">Email address</label>\n          <input\n            id=\"CatalogueDownloadEmail\"\n            type=\"email\"\n            name=\"contact[email]\"\n            required\n            placeholder=\"you@example.com\"\n            class=\"catalogue-download-input\"\n          >\n\n          <!-- Shopify Subscriber Tagging -->\n          <input type=\"hidden\" name=\"contact[tags]\" value=\"newsletter,digital-download,catalogue\">\n\n          <label class=\"catalogue-download-consent\">\n            <input\n              type=\"checkbox\"\n              name=\"consent_checkbox\"\n              id=\"CatalogueDownloadConsent\"\n              required\n            >\n            <span>I agree to receive marketing emails from Carrol Boyes.</span>\n          </label>\n\n          <!-- Disabled until consent -->\n          <button\n            type=\"submit\"\n            class=\"catalogue-download-button\"\n            id=\"CatalogueDownloadButton\"\n            disabled\n          >\n            Get my free download\n          </button>\n\n          <!-- JavaScrpit: enable button only when checkbox is ticked -->\n          <script>\n            document.addEventListener('DOMContentLoaded', function() {\n              var consent = document.getElementById('CatalogueDownloadConsent');\n              var button = document.getElementById('CatalogueDownloadButton');\n\n              if (consent && button) {\n                button.disabled = true;\n\n          