          "name": "Payment Method",
          "settings": {
            "custom_liquid": "{% if product.available %}\n  <!-- Product is in stock, buttons and quantity selector are visible -->\n{% else %}\n  <!-- Product is out of stock, hide only native Shopify buy button and quantity selector -->\n  <style>\n    /* Hide only the native Shopify quantity selector */\n    .product-form__quantity {\n      display: none !important;\n    }\n    \n    /* Hide only the native Shopify submit button, not app embeds */\n    .product-form button[type=\"submit\"],\n    .product-form .button--primary[type=\"submit\"],\n    .product-form .button--secondary[type=\"submit\"] {\n      display: none !important;\n    }\n    \n    /* Ensure app embed buttons remain visible */\n    .product-form [data-app-embed],\n    .product-form .app-embed,\n    .product-form iframe,\n    .product-form script {\n      display: block !important;\n      visibility: visible !important;\n    }\n  </style>\n{% endif %}"
          }
