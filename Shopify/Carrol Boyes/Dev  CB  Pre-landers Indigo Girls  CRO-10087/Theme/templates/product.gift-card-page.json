        "custom_liquid_VAF73c": {
          "type": "custom_liquid",
          "name": "Payment Method",
          "disabled": true,
          "settings": {
            "custom_liquid": "<style>\n.icon-list-custom {\n    display: flex;\n    flex-wrap: wrap;\n    list-style: none;\n    justify-content: center;\n    margin: 0;\n    gap: 8px;\n    padding: 0;\n    margin-top: -1rem;\n}\n\n.icon-list-custom li a {\n    display: inline-block;\n    cursor: pointer;\n}\n\n.payment-modal {\n    display: none; /* Hidden by default */\n    position: fixed;\n    z-index: 1000;\n    left: 0;\n    top: 0;\n    width: 100%;\n    height: 100%;\n    overflow: auto;\n    background-color: rgba(0,0,0,0.6);\n}\n\n.payment-modal-content {\n    background-color: #fff;\n    margin: 10% auto;\n    padding: 20px;\n    border-radius: 8px;\n    max-width: 400px;\n    text-align: center;\n    position: relative;\n}\n\n.payment-modal-content img {\n    max-width: 100%;\n    height: auto;\n}\n\n.payment-modal-close {\n    position: absolute;\n    top: 10px;\n    right: 15px;\n    font-size: 20px;\n    font-weight: bold;\n    cursor: pointer;\n}\n</style>\n\n<ul class=\"icon-list-custom\" role=\"list\">\n    {% assign enabled_payment_types = 'visa,master,apple_pay,google_pay,klarna' | remove: ' ' | split: ',' %}\n\n    {%- assign payment_links = \n        'https://visa.com,\n         https://mastercard.com,\n         https://apple.com/apple-pay,\n         https://pay.google.com,\n         https://www.klarna.com' | split: ',' -%}\n\n    {%- assign payment_images = \n        'https://cb-m2t.digitradenow.com/media/wysiwyg/LarryImagesForCode/New_Landing_Page_Assets-02.png,\n         https://via.placeholder.com/300x200?text=Mastercard+Info,\n         https://via.placeholder.com/300x200?text=Apple+Pay+Info,\n         https://via.placeholder.com/300x200?text=Google+Pay+Info,\n         https://via.placeholder.com/300x200?text=Klarna+Info' | split: ',' -%}\n\n    {% for type in enabled_payment_types %}\n        <li>\n            <a href=\"javascript:void(0);\" class=\"payment-icon\" data-image=\"{{ payment_images[forloop.index0] | strip }}\">\n                {{ type | payment_type_svg_tag: class: 'icon-svg' }}\n            </a>\n        </li>\n    {% endfor %}\n</ul>\n\n<!-- Popup Modal -->\n<div class=\"payment-modal\" id=\"paymentModal\">\n    <div class=\"payment-modal-content\">\n        <span class=\"payment-modal-close\" id=\"paymentModalClose\">&times;</span>\n        <img id=\"paymentModalImage\" src=\"\" alt=\"Payment Info\">\n    </div>\n</div>\n\n<script>\ndocument.addEventListener('DOMContentLoaded', function () {\n    var paymentIcons = document.querySelectorAll('.payment-icon');\n    var modal = document.getElementById('paymentModal');\n    var modalImage = document.getElementById('paymentModalImage');\n    var closeBtn = document.getElementById('paymentModalClose');\n\n    paymentIcons.forEach(function (icon) {\n        icon.addEventListener('click', function () {\n            var imageSrc = this.getAttribute('data-image');\n            modalImage.src = imageSrc;\n            modal.style.display = 'block';\n        });\n    });\n\n    closeBtn.addEventListener('click', function () {\n        modal.style.display = 'none';\n    });\n\n    window.addEventListener('click', function (event) {\n        if (event.target == modal) {\n            modal.style.display = 'none';\n        }\n    });\n});\n</script>"
          }
        },
