    "image_with_text_QB9tfB": {
      "type": "image-with-text",
      "blocks": {
        "badge_iyrREB": {
          "type": "badge",
          "settings": {
            "color_scheme": "scheme-inverse",
            "text": "- Over 30 Years - Present Day",
            "position_mobile": "right"
          }
