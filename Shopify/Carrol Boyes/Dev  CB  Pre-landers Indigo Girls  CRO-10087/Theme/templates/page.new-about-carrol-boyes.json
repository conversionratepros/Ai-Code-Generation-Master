    "image_with_text_7Y9Aep": {
      "type": "image-with-text",
      "blocks": {
        "badge_73fmMV": {
          "type": "badge",
          "settings": {
            "color_scheme": "scheme-inverse",
            "text": "-The Brand Grows - The year is 1999",
            "position_mobile": "right"
          }
        },
        "subheading_9qFpNV": {
          "type": "subheading",
          "settings": {
            "subheading": ""
          }
        },
        "heading_94Qx4N": {
          "type": "heading",
          "settings": {
            "heading": "The Brand Grows",
            "highlight_style": "none",
            "highlight_font_style": "italic",
            "highlight_style_color": "",
            "highlight_text_color": "",
            "heading_size": "h2"
          }
        },
        "text_PNgaVQ": {
          "type": "text",
          "settings": {
            "text": "<p>Two years after setting up her factory, Carrol received her first international order and Carrol’s pieces were catapulted into popularity with the demand for her products exceeding her expectations. In 1999, Carrol moved from her home office in Llandudno to her new office premises in Rose Street, Cape Town.</p>",
            "subtext_color": true
          }
        }
      },
      "block_order": [
        "badge_73fmMV",
        "subheading_9qFpNV",
