        "heading_M8t89c": {
          "type": "heading",
          "settings": {
            "heading": "Present Day",
            "highlight_style": "none",
            "highlight_font_style": "italic",
            "highlight_style_color": "",
            "highlight_text_color": "",
            "heading_size": "h2"
          }
        },
        "text_EApTKk": {
          "type": "text",
          "settings": {
            "text": "<p>After more than 30 years, the business is continually growing with an offering of over 1 000 products available. More than 27 countries currently stock the Carrol Boyes brand with some big names such as Bloomingdales and Nieman Marcus in the USA and David Jones in Australia among these retailers and stockists.</p>",
            "subtext_color": true
          }
        }
      },
